# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# local tooling
.claude/

# run output
analysis-results/
logs/
*.log

# secrets
.env
.env.*

# os
.DS_Store

# Torture corpus: the SCRIPT is committed, the corpus is regenerated.
# CPython test files are PSF-licensed and belong to the interpreter, not to us;
# checking them in would also pin them to one machine's stdlib.
python-work/staging/torture/
python-work/staging/torture-parse-gap/
.certify-report.txt
.certify-out/
.jedi-gaps.json
python-work/staging/torture-pep695/
.golden-out/
.pep695-out/
.select-out/
.chain-out/
.tp-out/

# Transient analyzer output. Every gate writes one and none of it is a source
# artifact — regenerated on each run, never read across runs.
.*-out/
.certify-report.txt
.jedi-gaps.json
# Agent coordination is process, not product.
.agent-coordination/
# Large corpora live outside the repo and are regenerated from the pinned
# interpreter by torture-corpus.ts / vendor-corpus.ts.
/tmp/py-corpus/

# generated python gate corpora and scratch output
src/test/python-gates/xpkg-corpus/
**/__pycache__/
*-out/

# A0-owned Python oracle harness and its corpora. Kept on disk so the gates
# still run locally, kept out of the repo because they are 3.7M of generated
# and vendored corpus. Mirror: ~/Desktop/axiomcode-python-oracle-handoff
src/test/python-oracle/
src/test/python-tests.ts
src/test-data/python/verified/
src/test-data/python/verified-py312/
src/test-data/python/categories/
src/test-data/python/closed-world/
src/test-data/python/linkage-sample/
src/test-data/python/_holdout/
