// ============================================================================
// Base input relations — HTML and CSS parser IR (the web front end).
//
// GENERATED FROM schema.json BY gen_decls.py — DO NOT HAND-EDIT.
// Re-run `python3 gen_decls.py --check` in CI; drift here is a silent schema break.
//
// CLIENT-ONLY, like Java's XML and YAML tables: no lib_ pair is declared, because a
// dependency's pages and stylesheets are not the project's. An engine that reads these
// copies the .decl lines it needs into its decls_base.dl and maps the CSV in client-ir.map:
//
//     html_<entity>   all-html-<entities>.csv       css_<entity>   all-css-<entities>.csv
//
// COLUMN ORDER IS THE CONTRACT. All columns are `symbol`. New columns append ONLY.
// The last column of every relation is the row's own unique hash.
//
// JOINS AN ENGINE AUTHOR WILL WANT:
//   html_reference.resolvedFilePath (SCRIPT)     = <script front end>'s module file path
//   html_reference.resolvedFilePath (STYLESHEET) = css_stylesheet.filePath
//   html_class_reference.className              = css_selector_part.name where partKind = CLASS
//   html_element.id                             = css_selector_part.name where partKind = ID
//   html_element.tagName                        = css_selector_part.name where partKind = TYPE
//   html_handler_call.calleeName                = a global function of a classic script the page loads
//   css_value_reference.name (VARIABLE)         = css_declaration.property where isCustomProperty
//   css_value_reference.name (KEYFRAMES)        = css_rule.name where atRuleName = keyframes
// ============================================================================

// One HTML file; the root of every HTML key. c5 documentKind says whether the file writes
// <html>/a doctype or is a fragment the algorithm wrapped; c9 templateDialects is a comma
// set of the template families whose markers the text shows.
// (21 columns)
.decl html_document(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol,c17:symbol,c18:symbol,c19:symbol,c20:symbol)

// One element, keyed on its XPath-like c2 path. c4 id and c5 classNames are repeated from the
// attributes because they are what CSS and script references join on. c7 isImplied marks
// an element the HTML algorithm inserted (html, head, body, tbody).
// (19 columns)
.decl html_element(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol,c17:symbol,c18:symbol)

// One attribute; (element, prefix, name) is unique by the algorithm. c3 attributeKind is what
// the attribute does: ID, CLASS, STYLE, EVENT_HANDLER, URL, TEMPLATE_DIRECTIVE, ...
// (11 columns)
.decl html_attribute(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol)

// One token of a class attribute: the row css_selector_part (CLASS) joins on.
// (8 columns)
.decl html_class_reference(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol)

// One URL a page names. c0 referenceKind says what it points at (SCRIPT, STYLESHEET, ANCHOR,
// IMAGE, FORM_ACTION, ...); c2 urlKind what kind of URL it is; c6 resolvedFilePath the file
// on disk when a RELATIVE or ROOT_RELATIVE URL names one, else empty, with c7 isResolved.
// (17 columns)
.decl html_reference(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol)

// One <script>, 1:1 with its element. EXTERNAL rows carry the src and its resolution;
// INLINE rows carry the body's line/column range so a script front end can read it in place.
// (18 columns)
.decl html_script(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol,c17:symbol)

// One call written in an on* attribute, a javascript: URL or a template dialect's event
// directive (c0 handlerSource). The callee is kept as name, receiver and full text;
// resolution is the engine's, as for a JavaScript call site.
// (15 columns)
.decl html_handler_call(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol)

// One expression a template dialect evaluates: a directive's value (c2 directive as written,
// c1 expressionKind what it does, c3 argument the event or property) or a {{ }} interpolation.
// c6 calleeNames and c7 identifiers are read for the JavaScript-shaped dialects (Vue, Alpine,
// Angular); c8 declares are the names a loop or slot introduces.
// (17 columns)
.decl html_template_expression(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol)

// What the HTML grammar could not read (c1 names the error region, missing token, stray end tag
// or duplicate attribute), a handler or style attribute that did not parse, or the overflow count.
// (10 columns)
.decl html_parse_gap(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol)

// One stylesheet: a .css file (keyed on its path) or a <style> element (keyed on the element,
// c7 ownerHtmlElementLinkHash). c6 sourceProvenance labels minified output; never a skip.
// (17 columns)
.decl css_stylesheet(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol)

// A style rule or an at-rule, in the tree as written: c13 parentRuleLinkHash is the enclosing
// block. c2 name is what an at-rule declares (the @keyframes, @layer, @container, @property
// name; a @font-face's font-family), the column a css_value_reference joins on.
// (17 columns)
.decl css_rule(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol)

// One complex selector of a rule's selector list, with its (a,b,c) specificity.
// (16 columns)
.decl css_selector(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol)

// One simple selector, in writing order; c5 combinatorBefore is the combinator written
// before its compound. A functional pseudo-class's arguments are child parts (c8 depth,
// c11 parentPartLinkHash). CLASS/ID/TYPE names join html_class_reference, html_element; a
// namespaced type (svg|rect) is the name rect with value svg|.
// (17 columns)
.decl css_selector_part(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol,c15:symbol,c16:symbol)

// One property: value. Owned by a rule (c10) OR a style attribute (c11), never both.
// (15 columns)
.decl css_declaration(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol,c14:symbol)

// A name a value refers to: VARIABLE (var(--x)), URL, IMPORT, KEYFRAMES, LAYER, CONTAINER,
// FONT_FAMILY. URL and IMPORT carry c3 urlKind and c4 resolvedFilePath; the rest join by c1 name.
// (14 columns)
.decl css_value_reference(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol,c10:symbol,c11:symbol,c12:symbol,c13:symbol)

// A /* */ comment with its text and range.
// (8 columns)
.decl css_comment(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol)

// An error region of the CSS grammar, text CSS has no place for, a preprocessor marker in a .css file, or the overflow count.
// (10 columns)
.decl css_parse_gap(c0:symbol,c1:symbol,c2:symbol,c3:symbol,c4:symbol,c5:symbol,c6:symbol,c7:symbol,c8:symbol,c9:symbol)
