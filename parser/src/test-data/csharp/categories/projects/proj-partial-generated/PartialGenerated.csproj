<!-- The SOURCE-GENERATOR SHAPE: a partial type with exactly ONE part on disk.
     76.5% of the 897 partial identities measured in the C# corpus look like
     this, and the other part exists only after a build.

     The three generators used here ship IN THE SDK and need no PackageReference,
     so this project is hermetic: System.Text.RegularExpressions.Generator
     ([GeneratedRegex]), LibraryImportGenerator ([LibraryImport]) and
     System.Text.Json.SourceGeneration ([JsonSerializable]). Each writes the
     other half of a `partial` declared here.

     EmitCompilerGeneratedFiles is deliberately OFF: the generated halves must
     NOT appear on disk, because the whole point of the fixture is that the
     parser sees one part and Roslyn sees two. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.PartialGenerated</AssemblyName>
    <RootNamespace>Fixtures.PartialGenerated</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
  </PropertyGroup>
</Project>
