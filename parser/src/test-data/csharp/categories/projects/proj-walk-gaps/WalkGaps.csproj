<!-- Every expression-walk gap cs-corpus found in sweep 1, one file per finding,
     each with a CONTROL on the same construct.

     These compile. They are not broken source: the parser walks past them, and
     the point of a control on the same line is that "the walk is incomplete"
     cannot be confused with "the construct does not parse".

     Named in .agent-coordination/csharp/findings-corpus.jsonl as CS-CORPUS-2,
     3, 5, 6, 7 and 8. When a finding is fixed, the file here stops being a
     demonstration and starts being regression cover, and that is the only
     reason it is checked in rather than left in a scratchpad. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <CsFixtureRole>walk-gap</CsFixtureRole>
    <CsFixtureCategory>walk-gaps</CsFixtureCategory>
    <CsFixtureJavaCounterpart>none</CsFixtureJavaCounterpart>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.WalkGaps</AssemblyName>
    <RootNamespace>Fixtures.WalkGaps</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS0693;CS0108;CS0067;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
  </PropertyGroup>
</Project>
