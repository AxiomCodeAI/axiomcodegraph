<!-- TOP-LEVEL STATEMENTS (C# 9): a file with NO TYPE AND NO METHOD that still
     has to produce a module row and an owner for its statements.

     The compiler synthesises `internal static class Program { private static
     void Main(string[] args) { ... } }` around Program.cs. Neither the class
     nor the method appears in any source file, and `args` is a parameter with
     no declaration site. Exactly one file per project may do this, and it must
     be an Exe. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Exe</OutputType>
    <AssemblyName>Fixtures.TopLevel</AssemblyName>
    <RootNamespace>Fixtures.TopLevel</RootNamespace>
  </PropertyGroup>
</Project>
