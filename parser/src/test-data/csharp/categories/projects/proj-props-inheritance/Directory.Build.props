<!-- THE GOVERNING CONFIGURATION IS NOT ONE FILE.
     BUILDING-A-PARSER.md §9: read the GOVERNING config PER FILE, never one
     config per run. In MSBuild the governing configuration for app/App.csproj
     is this file, imported automatically because it sits in an ancestor
     directory, PLUS the .csproj, PLUS the SDK defaults — and the .csproj wins
     where they disagree.

     Here that matters three ways:
       * Nullable is set to `enable` HERE and appears nowhere in the .csproj.
       * ImplicitUsings is set to `enable` HERE and OVERRIDDEN to `disable` in
         the .csproj, so a parser that reads only the props file gets the wrong
         answer and a parser that reads only the .csproj gets the wrong answer
         about Nullable.
       * DefineConstants is APPENDED to in the .csproj rather than replaced,
         so the effective value is the concatenation of both files. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>FROM_PROPS</DefineConstants>
  </PropertyGroup>
</Project>
