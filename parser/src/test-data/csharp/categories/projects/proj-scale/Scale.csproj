<!-- Extraction-time SCALE fixtures. Not what a file contains; how long it
     takes. Each file here is generated by a script in tools/csharp/ and says
     so on its first line. A gate over this project asserts a time bound the
     previous commit met, never a row count. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <CsFixtureRole>scale</CsFixtureRole>
    <CsFixtureCategory>scale</CsFixtureCategory>
    <CsFixtureJavaCounterpart>none</CsFixtureJavaCounterpart>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.Scale</AssemblyName>
    <RootNamespace>Fixtures.Scale</RootNamespace>
  </PropertyGroup>
</Project>
