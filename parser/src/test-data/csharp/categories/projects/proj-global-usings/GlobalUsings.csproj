<!-- `global using` — a directive in ONE file that applies to EVERY file in the
     compilation. ImplicitUsings is DISABLED here so that the only global
     directives in this compilation are the ones written in GlobalUsings.cs;
     the SDK-injected kind is the sibling project ../proj-implicit-usings/. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.GlobalUsings</AssemblyName>
    <RootNamespace>Fixtures.GlobalUsings</RootNamespace>
  </PropertyGroup>
</Project>
