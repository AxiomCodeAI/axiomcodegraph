<!-- HELD CONSTRUCTS — C# 13. SEE ./NOT-VERIFIABLE-HERE BEFORE BUILDING.

     THIS PROJECT DOES NOT BUILD IN THIS CHECKOUT, and not because the source
     is wrong. SDK 8.0.401 refuses the language version outright:

        CSC : error CS1617: Invalid option '13' for /langversion

     The hazard this exists to name: the oracle's pinned
     Microsoft.CodeAnalysis.CSharp 4.12.0 ACCEPTS LangVersion 13, and the NuGet
     package version is decoupled from the installed SDK. So the adjudicator can
     run AHEAD OF THE TOOLCHAIN — it can bless facts for a program this
     environment cannot compile, and a golden frozen that way becomes the spec
     for code nobody can build. That is the same failure mode as a hand-written
     expectation, arrived at from the other direction.

     Ruling: C# 12 is the floor for everything that must compile. These four
     constructs are authored here, labelled, excluded from compile-status gates,
     and off-limits to the oracle for blessing. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Machine-readable exclusion signal. Readable with
         `dotnet msbuild -getProperty:CsFixtureVerifiable` without invoking
         csc, so a gate can query it without tripping CS1617. -->
    <!-- cannot be determined here: the toolchain refuses the language version -->
    <CsFixtureCompiles>unknown</CsFixtureCompiles>
    <CsFixtureVerifiable>false</CsFixtureVerifiable>
    <CsFixtureBlockedBy>SDK 8.0.401 rejects LangVersion 13 (CS1617)</CsFixtureBlockedBy>
    <CsFixtureNeedsSdk>9.0 or any SDK shipping Roslyn 4.12+</CsFixtureNeedsSdk>

    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.LangVersion13</AssemblyName>
    <RootNamespace>Fixtures.LangVersion13</RootNamespace>
  </PropertyGroup>
</Project>
