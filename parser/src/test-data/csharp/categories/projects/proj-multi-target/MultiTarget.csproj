<!-- MULTI-TARGETING: ONE SOURCE FILE, TWO COMPILATIONS, TWO DIFFERENT MEMBER
     SETS. This is decision two of BUILDING-CSHARP.md in its live form, and the
     schema ruled OPTION 3: one emission per target framework, with
     targetFramework and defineConstantsKey in cs_module's primary key.

     `dotnet build` compiles Api.cs TWICE here:

       net8.0          NET;NET8_0;NETCOREAPP + NET5_0_OR_GREATER ...
                       NET8_0_OR_GREATER + MODERN
       netstandard2.0  NETSTANDARD;NETSTANDARD2_0 + NETSTANDARD1_x_OR_GREATER
                       ... NETSTANDARD2_0_OR_GREATER + LEGACY

     tree-sitter parses BOTH branches of every #if. Roslyn parses ONE, chosen
     by whichever TargetFramework the build is on. So the parser and the oracle
     are not looking at the same program unless the framework is part of the
     module identity — which is the ruling this project exists to test.

     The ONLY value here that is authored rather than implied is `MODERN` /
     `LEGACY`, set by the Condition below. Everything else the SDK derives.
     Verified against the csc command line, not against
     `dotnet msbuild -getProperty:DefineConstants`, which omits the
     _OR_GREATER symbols entirely (they are added during BUILD). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.MultiTarget</AssemblyName>
    <RootNamespace>Fixtures.MultiTarget</RootNamespace>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1998</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);MODERN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <DefineConstants>$(DefineConstants);LEGACY</DefineConstants>
  </PropertyGroup>
</Project>
