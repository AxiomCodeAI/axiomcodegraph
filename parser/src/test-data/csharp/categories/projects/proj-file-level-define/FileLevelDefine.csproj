<!-- CS-CORPUS-25: a `#define` at the top of a file is not honoured by the
     parser's `#if` evaluation. Roslyn honours it; the parser reports every region
     guarded by the symbol as inactive and the `#else`/`!SYMBOL` regions as active.
     One file per form. A CONTROL file has no `#define` and tests the negation.
     Measured at cs-impl@f42baba. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <CsFixtureRole>walk-gap</CsFixtureRole>
    <CsFixtureCategory>preprocessor</CsFixtureCategory>
    <CsFixtureJavaCounterpart>none</CsFixtureJavaCounterpart>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.FileLevelDefine</AssemblyName>
    <RootNamespace>Fixtures.FileLevelDefine</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
