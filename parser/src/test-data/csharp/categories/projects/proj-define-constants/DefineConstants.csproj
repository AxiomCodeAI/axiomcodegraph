<!-- AUTHORED DefineConstants, single target framework.
     The multi-targeting-library shape (corpus strata multitarget-A and -B):
     HAVE_* and FEATURE_* symbols that
     exist only because someone typed them, are derivable from NO framework
     string, and change which declarations exist.

     Effective /define for this project, from the csc command line:
       TRACE;HAVE_ASYNC;HAVE_SPANS;FEATURE_DIAGNOSTICS;DEBUG;NET;NET8_0;
       NETCOREAPP;NET5_0_OR_GREATER ... NETCOREAPP3_1_OR_GREATER

     Note FEATURE_SERIALIZATION and HAVE_REFLECTION_EMIT are deliberately NOT
     defined: their guarded declarations must appear in no emission. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);HAVE_ASYNC;HAVE_SPANS;FEATURE_DIAGNOSTICS</DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.DefineConstants</AssemblyName>
    <RootNamespace>Fixtures.DefineConstants</RootNamespace>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1998</NoWarn>
  </PropertyGroup>
</Project>
