<!-- THE 32,767-CHARACTER LIMIT.

     tree-sitter's default parse path throws above 32,767 characters — measured
     by cs-oracle: largest direct parse 32,712, first failure 32,783, and the
     failure MODE is a throw rather than a silent truncation. 8.51% of the
     measured corpus (656 of 7,705 files) is over the limit, and `CSharpParser`
     must port the callback-based read from `src/parsers/java/java-parser.ts`
     verbatim to get past it.

     That workaround is load-bearing and, until this project existed, untested:
     on Python, three of five stdlib packages failed to parse without the
     equivalent. An untested load-bearing path is the thing.

     `Diagnostics.cs` is deliberately over the limit, in the shape large real C#
     actually takes — a generated-looking resource/diagnostic catalogue, which is
     what the string tables of a runtime, a compiler and an ORM all are. Its exact
     size and the construct straddling the boundary
     are recorded in ../MANIFEST.md. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.LargeFile</AssemblyName>
    <RootNamespace>Fixtures.LargeFile</RootNamespace>
  </PropertyGroup>
</Project>
