<!-- PROJECT-LEVEL <Nullable>enable</Nullable>, OVERRIDDEN BY A FILE.
     The nullable context is per-file AND per-region AND defaulted by the
     .csproj — three levels, and the innermost wins. This project sets the
     default to `enable`; Overrides.cs turns it off for its whole body and
     Mixed.cs flips it three times mid-file.

     Nullable diagnostics are deliberately NOT suppressed here. The warnings
     this project emits ARE the fixture: they are how the oracle can tell which
     context was in force at each line. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.NullableEnable</AssemblyName>
    <RootNamespace>Fixtures.NullableEnable</RootNamespace>
  </PropertyGroup>
</Project>
