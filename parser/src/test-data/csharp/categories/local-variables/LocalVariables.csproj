<!-- Governing configuration for categories/local-variables/. Promoted from
     staging/ported/, where ONE project governed twelve categories at once.
     Each category is now self-governing: the tuple that decides what these
     bytes MEAN is this file plus the SDK defaults for net8.0, and nothing two
     directories up. Every value is byte-for-byte staging's Ported.csproj;
     a difference here would silently change every row below it. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <CsFixtureCategory>local-variables</CsFixtureCategory>
    <CsFixtureJavaCounterpart>src/test-data/java/local-variables</CsFixtureJavaCounterpart>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.Ported.LocalVariables</AssemblyName>
    <RootNamespace>Fixtures.Ported</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS0693;CS0108;CS0067</NoWarn>
  </PropertyGroup>
</Project>
