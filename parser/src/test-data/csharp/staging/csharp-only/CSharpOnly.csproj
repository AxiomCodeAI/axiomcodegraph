<!-- Governing configuration for csharp-only/ (half two). Nullable is ENABLED
     here so that `string?`, `!` and `??=` mean what they say; the fixtures that
     exist to change the nullable context mid-file live in their own projects
     (../proj-nullable-project-enable, ../proj-nullable-project-disable). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.CSharpOnly</AssemblyName>
    <RootNamespace>Fixtures.CSharpOnly</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS0693;CS0108;CS0067;CS0282;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8622;CS8625</NoWarn>
  </PropertyGroup>
</Project>
