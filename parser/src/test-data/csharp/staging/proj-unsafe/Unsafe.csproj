<!-- UNSAFE CODE. Needs <AllowUnsafeBlocks>true</AllowUnsafeBlocks>, which is a
     PROJECT property: the identical source in any other project here is a
     compile error (CS0227). One more case of the same bytes meaning different
     things under a different governing configuration. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.Unsafe</AssemblyName>
    <RootNamespace>Fixtures.Unsafe</RootNamespace>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS8500</NoWarn>
  </PropertyGroup>
</Project>
