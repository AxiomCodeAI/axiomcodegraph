<!-- THE 88-PART MAXIMUM, from the corpus measurement in schema §2.1
     (a generated compiled-model type in a large ORM — corpus stratum linq-heavy-A — 88 parts).

     This project reproduces that shape exactly: ONE type identity,
     `Fixtures.Partial88.CompiledModel`, declared across 88 files, plus a
     72-part identity for the second-largest bucket and the smaller buckets
     around them. Nothing else is in this project, so a count taken over it is
     unambiguous.

     The point is not size. It is that `declarationGroupKey` is deliberately
     NON-UNIQUE, that the engine derives an ordinal by sorting the group on
     (filePath, startLine, startColumn), and that 88 rows sharing a group key is
     CORRECT OUTPUT rather than a duplicate-row defect. Section 2 of
     BUILDING-A-PARSER.md: duplicate keys do not collide, they DOUBLE, and this
     is the fixture that tells the two apart. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.Partial88</AssemblyName>
    <RootNamespace>Fixtures.Partial88</RootNamespace>
  </PropertyGroup>
</Project>
