<!-- THE OTHER HALF OF THE PAIR: project default <Nullable>disable</Nullable>.
     Inherits.cs here is BYTE-IDENTICAL to
     ../proj-nullable-project-enable/Inherits.cs and produces different
     diagnostics, different annotations and therefore different facts. Same
     bytes, different governing configuration — which is exactly why the
     manifest declares the configuration for every fixture. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.NullableDisable</AssemblyName>
    <RootNamespace>Fixtures.NullableDisable</RootNamespace>
  </PropertyGroup>
</Project>
