<!-- Inherits ../Directory.Build.props. Overrides ImplicitUsings, appends to
     DefineConstants, and says nothing at all about Nullable or LangVersion.

     Effective governing configuration for App.cs, which is the tuple the
     manifest must record and which appears in NEITHER file alone:
        TargetFramework  = net8.0        (from props)
        LangVersion      = 12            (from props)
        Nullable         = enable        (from props)
        ImplicitUsings   = disable       (from THIS file, overriding props)
        DefineConstants  = FROM_PROPS;FROM_CSPROJ   (concatenated) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);FROM_CSPROJ</DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.PropsInheritance</AssemblyName>
    <RootNamespace>Fixtures.PropsInheritance</RootNamespace>
  </PropertyGroup>
</Project>
