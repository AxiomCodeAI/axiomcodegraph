<!-- Governing configuration for every fixture under ported/. Declared here and
     restated per fixture in ../MANIFEST.md. Self-contained on purpose: no
     Directory.Build.props ancestor, so the governing config for these files is
     exactly this file plus the SDK defaults for net8.0. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.Ported</AssemblyName>
    <RootNamespace>Fixtures.Ported</RootNamespace>
    <EnableDefaultItems>true</EnableDefaultItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS0693;CS0108;CS0067</NoWarn>
  </PropertyGroup>
</Project>
