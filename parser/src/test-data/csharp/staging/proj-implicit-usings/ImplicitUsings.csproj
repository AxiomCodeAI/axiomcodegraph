<!-- IMPLICIT USINGS — the import edge with NO SYNTAX ANYWHERE.
     <ImplicitUsings>enable</ImplicitUsings> makes the SDK inject a generated
     `<MSBuildProjectName>.GlobalUsings.g.cs` (verified: the name follows the
     PROJECT file, not the assembly name) containing, for a net8.0 library:

         global using global::System;
         global using global::System.Collections.Generic;
         global using global::System.IO;
         global using global::System.Linq;
         global using global::System.Net.Http;
         global using global::System.Threading;
         global using global::System.Threading.Tasks;

     Not one of those seven appears in any file this parser will walk, because
     the generated file lives in obj/ and this project's obj/ is redirected out
     of the source tree. The schema emits them as cs_using rows with
     usingKind = IMPLICIT, startLine = 0 and originFile = '' (§2.6), which means
     the import relation has rows no file-walking extractor can produce.

     Program.cs below compiles with ZERO using directives in the whole project.

     Note the list is a property of the SDK AND of the TargetFramework: a
     net8.0 *library* gets those seven; net8.0 *Web* adds six more; a
     netstandard2.0 project gets none because ImplicitUsings does not apply.
     So the row set is a function of the governing configuration, not of the
     source. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- a successful build is the expected outcome -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.ImplicitUsings</AssemblyName>
    <RootNamespace>Fixtures.ImplicitUsings</RootNamespace>
  </PropertyGroup>
</Project>
