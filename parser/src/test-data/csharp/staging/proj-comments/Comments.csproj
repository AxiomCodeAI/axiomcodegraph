<!-- COMMENTS AND XML DOCUMENTATION.
     A gap I found auditing my own coverage against the schema's relation list:
     `cs_comment` (15 columns) and the `comment-extractor.ts` row in
     BUILDING-CSHARP.md's port table had no dedicated fixture anywhere.

     Its own project for one reason: GenerateDocumentationFile is TRUE here and
     false everywhere else. With it on, the compiler PARSES the XML inside
     `///` comments and reports CS1570/CS1572/CS1573/CS1574 when it is wrong —
     so the deliberately-malformed doc comments in `MalformedDocumentation.cs`
     produce diagnostics instead of passing silently, and those diagnostics are
     the fixture, exactly as in the two nullable projects.

     CS1591 ("missing XML comment for publicly visible type or member") is
     suppressed: requiring a doc comment on every member would make the
     UNdocumented case impossible to write, and an undocumented public member
     beside a documented one is precisely what the extractor has to tell apart. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- a successful build is the expected outcome; the doc-comment WARNINGS
         are deliberate and listed in ../MANIFEST.md -->
    <CsFixtureCompiles>true</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.Comments</AssemblyName>
    <RootNamespace>Fixtures.Comments</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0169;CS0649;CS0067</NoWarn>
  </PropertyGroup>
</Project>
