<!-- THIS PROJECT DOES NOT COMPILE, AND THAT IS THE FIXTURE.
     A fixture that does not compile is legitimate: the parser must still emit
     for it, because real checkouts contain files that do not build. What the
     corpus agent needs is to know WHICH failures are expected, so each file
     below states its exact error codes and the reason Roslyn reports them.

     Every failure here is a SEMANTIC one — the syntax is well-formed in every
     case, so tree-sitter parses all of it cleanly and Roslyn returns
     CandidateSymbols with a CandidateReason rather than nothing. That is the
     distinction the oracle exploits: OverloadResolutionFailure, Inaccessible,
     NotAnAttributeType and Ambiguous are answers, not silence.

     The one exception is SyntaxErrors.cs, which is malformed on purpose so the
     cs_parse_gap relation has something to be measured against. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every fixture project answers this, so a compile-status gate reads a
         VALUE and never an empty string. Absence of a match is not absence of
         the thing; the one `false` is ../proj-langversion-13/. -->
    <!-- FAILS BY DESIGN; the expected error inventory is in ../MANIFEST.md section 7 -->
    <CsFixtureCompiles>false</CsFixtureCompiles>
    <CsFixtureVerifiable>true</CsFixtureVerifiable>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants></DefineConstants>
    <OutputType>Library</OutputType>
    <AssemblyName>Fixtures.NonCompiling</AssemblyName>
    <RootNamespace>Fixtures.NonCompiling</RootNamespace>
  </PropertyGroup>
</Project>
