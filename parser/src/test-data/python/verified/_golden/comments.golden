kind=BLOCK_COMMENT_RUN	text=# Same rule, one level down: a method is a function scope nested # directly under the class's *enclosing* scope (module here), not # under the class body. `label` is unresolved in the method and # falls through to global/builtin lookup, not the class attribute.	startLine=44	startColumn=8	endLine=47	endColumn=74	ownerHash=PY_METHOD_a86c44fd87550eb3aef8b5ebfaaeec46	commentIndex=5	ownerKind=MODULE	pyModuleLinkHash=PY_MODULE_7c5670e72548f0c21d5e8710e5a91903	typeCommentPayload=	isDocstring=false	serviceVersionLinkHash=SERVICE_VERSION_00000000000000000000000000000000	pyCommentUniqueHash=PY_COMMENT_b4b027a42adc70d345275a15e2393dbf
