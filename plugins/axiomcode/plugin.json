{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "axiomcode",
  "version": "0.1.0",
  "description": "Ask your repository how its code connects: who calls this, what breaks if I change it, which tests an edit reaches, how A reaches B. Answers come from a resolved call graph and are verified against it; nothing is guessed.",
  "author": {
    "name": "AxiomCode",
    "url": "https://github.com/AxiomCodeAI/axiom-code-graph"
  },
  "homepage": "https://github.com/AxiomCodeAI/axiom-code-graph",
  "repository": "https://github.com/AxiomCodeAI/axiom-code-graph",
  "license": "FSL-1.1-Apache-2.0",
  "keywords": [
    "call graph",
    "callers",
    "change impact",
    "test impact",
    "code navigation",
    "refactoring",
    "java",
    "typescript",
    "python",
    "javascript"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "AxiomCode",
        "shortDescription": "Ask your repository how its code connects",
        "developerName": "AxiomCode",
        "category": "Developer Tools",
        "capabilities": [
          "Skills",
          "MCP tools"
        ],
        "websiteURL": "https://github.com/AxiomCodeAI/axiom-code-graph"
      }
    }
  }
}
