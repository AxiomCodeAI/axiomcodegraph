#!/bin/bash
# axiomcode — the one entry point. Every capability is a subcommand here; a new skill is a new subcommand, never a new tool.
#
#   axiomcode index [<repo>] [--lang java|typescript|python|javascript] [--src <subdir>] [--library <root>[,<root>…]]
#       the pipeline: parser → engine → .axiomcode/out/graph.sqlite (+ index). <repo> defaults to the current directory.
#   axiomcode context "<the task, in your own words>" [<repo>] [--in <path>[,<path>…]]… [--budget N] [--source]
#       THE FRONT DOOR: the files and callables a task touches, from the problem statement — when there is no name
#       to ask about yet. Deterministic: task terms scored against the graph's vocabulary by inverse document
#       frequency, tests demoted, the closure walked from the best seed per term and ranked by nearest hop.
#       --in is repeatable and takes a list, and several are COMBINED, not intersected, so a change that
#       spans two roots is answerable in one call.
#       Ends by saying what it could not see. Every other verb needs a name you already have; this one does not.
#   axiomcode graph [<repo>] [--out <folder | page.html>] [same flags]
#       the graph as one page. Runs the pipeline only when the repo has no up-to-date graph (~1 s otherwise). <repo>
#       defaults to the current directory; the page goes to <repo>/.axiomcode/graph/graph.html, or to --out: a folder
#       gets <folder>/<repo>.html, a .html path is used as given. The page embeds the sources, so a node opens its code.
#   axiomcode path <from> <to> [<repo>] [--every | --paths N] [--all] [--limit N] [--in <path fragment>]
#       the shortest chain of calls from A to B per reached target, and with --every all the routes; through what?
#       '*' as one endpoint: path '*' X = everything that can reach X, with the entry points among them; path X '*' = everything X reaches. Endpoints exactly as written in the code: Owner.method,
#       method (free function or any owner), Type (all its methods), file.ts:123, file.py. Datalog over the graph; every
#       printed hop re-checked against graph.sqlite. `axiomcode path --selftest <lang>` replays the engine's expected edges.
#   axiomcode impact <target> [<target>…] [<repo>] [--tests] [--depth N] [--in <path>] [--limit N] [--json] [--kind k]
#       what has to be looked at again when a declaration changes: a method, a field / constant / enum member, a type, a
#       parameter (Owner.m(p)), a type parameter (Type<T>), a local (Owner.m:v), Type.<init> / Type.<clinit>. Prints what
#       must change with it (overrides, subtypes), what directly touches it with WHY and how sure ([resolved] / [in scope] /
#       [by name] / [text]), the transitive callers by hop with the entry points and tests, and the unresolved-site bound.
#   axiomcode changed [<repo>] [<file>…] [--range a..b | --staged] [--impact] [--json]
#       which declarations an edit changed and HOW (signature: params added / removed / retyped, return type; field: its type,
#       name, initializer; type header; body only; removed; added) — the working tree against the commit the graph was built
#       from, or two commits — each with the target `impact` takes; --impact runs impact on all of them as one change set.
#   axiomcode test-impact [<repo>] [--range <a>..<b> | --staged] [--in <path>] [--limit N] [--json] [--why]
#       which tests actually have to run for this edit: the test files that reach any changed declaration, with the
#       chain, so a selection can be checked rather than trusted. Conservative by design — a test reached only
#       through an edge the graph does not encode (reflection, a service loader) will NOT appear.
#   axiomcode install [<repo>] [--remove] [--print]
#       write the preference into the repository's CLAUDE.md as one marked block: for a question about how code connects,
#       prefer this over grep/Glob. States a preference, blocks nothing; re-running replaces, --remove takes it out.
#
# --lang picks the language when the repo mixes several (auto-detection counts files, so a TypeScript project with many
# .js test scripts is taken for JavaScript); --src limits the analysed tree (e.g. src); --library names dependency roots.
H="$(cd "$(dirname "$0")" && pwd)"
cmd="$1"; shift || true
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --lang) export AXIOMCODE_LANG="$2"; shift 2 ;;
    --src) export AXIOMCODE_SRC="$2"; shift 2 ;;
    --library) export AXIOMCODE_LIBRARY="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
case "$cmd" in
  index|build) exec bash "$H/axiomcode-build" ${ARGS[@]+"${ARGS[@]}"} ;;
  context) exec python3 "$H/axiomcode-context" ${ARGS[@]+"${ARGS[@]}"} ;;
  path)   exec python3 "$H/axiomcode-path" ${ARGS[@]+"${ARGS[@]}"} ;;
  impact) exec python3 "$H/axiomcode-impact" ${ARGS[@]+"${ARGS[@]}"} ;;
  changed) exec python3 "$H/axiomcode-changed" ${ARGS[@]+"${ARGS[@]}"} ;;
  test-impact|tests) exec python3 "$H/axiomcode-test-impact" ${ARGS[@]+"${ARGS[@]}"} ;;
  graph)  exec python3 "$H/axiomcode-graph" build ${ARGS[@]+"${ARGS[@]}"} ;;
  install) exec python3 "$H/axiomcode-install" ${ARGS[@]+"${ARGS[@]}"} ;;
  # the leading comment block IS the help: printed from line 2 to the first non-comment line, never a line
  # range. A hardcoded range is what let this document 6 verbs while the case below dispatched 8 (#1034).
  ""|-h|--help|help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0" ;;
  *) echo "axiomcode: unknown subcommand '$cmd' — the entry point has: index, context, graph, path, impact, changed, test-impact, install" >&2; exit 2 ;;
esac
