// impact.dl — what has to be looked at again when a declaration changes. Every judgement is a rule here; the Python
// side only produces facts (from graph.sqlite and, for the few text-level facts, from the source) and prints.
//
// Facts exported once per graph (impact-*.facts, next to the path finder's edge.facts):
//   edge(a, b, t)                     a calls b (the path finder's facts: resolved client edges, dispatch, defines)
//   named(n, m)                       a client callable m declared with simple name n
//   calls(c, m, tier, f, l)           a resolved call site in c to client method m, at f:l
//   unresolved(c, n, kind, f, l)      an unresolved site in c written n (kind: new | method), at f:l
//   member(T, s, n, k)                symbol s named n of kind k (method, constructor, field, const, enum_member …) declared in type T
//   owner(c, T)                       callable c is declared in type T
//   typ(T, n, k)                      type T has simple name n and kind k (class | interface | enum | record)
//   extends(S, T)                     S extends / implements T (transitively, the engine's type_ancestors)
//   nested(N, T)                      N is declared inside T
//   decorated(s, d)                   symbol s carries decoration d (simple name)
//   override(base, o)                 o overrides base
//   ref(c, n, rk, ek, f, l)           a reference to name n inside callable c: rk the reference kind (bare | qualified),
//                                     ek the parser's entity kind (FIELD | LOCAL | TYPE | …), at f:l
//   qualifier(f, l, n, Q)             on line f:l the name n is written qualified as Q.n
//   typeref(c, n, ctx, f, l)          a type reference to n in context ctx (field type, method param …) inside c, at f:l
//   typeref_file(f, n, ctx)           the same when the parser gives no line (Java): the file only
//   type_alias(t)                     t is a TypeScript type alias: a reference on its own lines is held by it, not the module
//   jsx_props(tag, n)                 an IntrinsicElements member: the attributes of <tag> are checked against type n
//   jsx_tag(c, tag, f, l)             an intrinsic element <tag …> rendered inside c, at f:l
//   discriminant(t, k, v)             type t declares property k typed as the one string literal v
//   keyed_literal(c, k, v, f, l)      an object literal inside c writes the property k: 'v', at f:l
//   type_in_file(T, f)                type T is declared in file f
//   literal(c, v, f, l)               a string literal v inside c
//   field(F, T, n, f, l)              field F named n declared in type T at f:l
//   accessor(F, n, rw)                the bean accessor name for field F (getX / setX / isX / x) and whether it reads or writes
//   faccess(C, F, acc, tier, f, l)    a field access the ENGINE resolved: callable C touches field F at f:l,
//                                     acc read|write|readwrite, tier as in call_edges
//   gen_table(d, what)                what decoration d generates: get | set | is | ctor | builder | fluent | with
//   base_name(t, n)                   type t is declared with a supertype WRITTEN n — the base may be a library type the
//                                     graph never resolved (the Python validation library's BaseModel), which is exactly the case `extends` misses
//   test_method(m) / fixture(m)       a test; a callable a test framework runs before the tests of its type
//   kind(s, k)                        the symbol's kind (method | constructor | module | class | …)
// Facts written per query:
//   target(q, kind, s, x)             the change: kind ∈ method | field | type | param | typeparam | var | clinit; s the symbol; x a name
//   textuse(c, n, f, l)               the name n found in the source of c (comments and strings stripped) — for Java type
//                                     references without a line, type parameters, and parameters
//   importuse(c, n, f, l)             c uses member n imported by name from the target type (import static)
//   inside_target(q, c)               c lies within the target type's own span (its members, nested types) — the change, not a dependent

.decl edge(a:symbol, b:symbol, t:symbol)                          .input edge
.decl named(n:symbol, m:symbol)                                   .input named
.decl calls(c:symbol, m:symbol, tier:symbol, f:symbol, l:number)  .input calls
.decl handoff_at(c:symbol, m:symbol, f:symbol, l:number)          .input handoff_at
.decl unresolved(c:symbol, n:symbol, k:symbol, f:symbol, l:number) .input unresolved
.decl named_site(c:symbol, n:symbol, k:symbol, f:symbol, l:number) .input named_site
// a `new T()` of a type with no written constructor (C#): no constructor to call, so no `calls` row, but the engine knows the type (#1473)
.decl implicit_new(c:symbol, t:symbol, f:symbol, l:number) .input implicit_new
.decl member(t:symbol, s:symbol, n:symbol, k:symbol)              .input member
.decl owner(c:symbol, t:symbol)                                   .input owner
.decl typ(t:symbol, n:symbol, k:symbol)                           .input typ
.decl extends(s:symbol, t:symbol)                                 .input extends
.decl nested(n:symbol, t:symbol)                                  .input nested
.decl decorated(s:symbol, d:symbol)                               .input decorated
.decl override(b:symbol, o:symbol)                                .input override
.decl ref(c:symbol, n:symbol, rk:symbol, ek:symbol, f:symbol, l:number) .input ref
.decl qualifier(f:symbol, l:number, n:symbol, q:symbol)           .input qualifier
.decl typeref(c:symbol, n:symbol, ctx:symbol, f:symbol, l:number) .input typeref
.decl typeref_file(f:symbol, n:symbol, ctx:symbol)                .input typeref_file
.decl type_alias(t:symbol)                                         .input type_alias
.decl jsx_props(tag:symbol, n:symbol)                              .input jsx_props
.decl jsx_tag(c:symbol, tag:symbol, f:symbol, l:number)            .input jsx_tag
.decl discriminant(t:symbol, k:symbol, v:symbol)                   .input discriminant
.decl keyed_literal(c:symbol, k:symbol, v:symbol, f:symbol, l:number) .input keyed_literal
.decl type_in_file(t:symbol, f:symbol)                            .input type_in_file
.decl literal(c:symbol, v:symbol, f:symbol, l:number)             .input literal
.decl dec_literal(c:symbol, d:symbol, v:symbol, f:symbol, l:number) .input dec_literal
//   reg_key_fact(m, kind, key)        m is registered under `key` — a decoration's argument, a route registration,
//                                     a value handed to a framework: the conventions live in scripts/ax_registration.py
//   route_alias(written, registered)  two spellings of one path: /orders/o-1/price and /orders/{order_id}/price
.decl reg_key_fact(m:symbol, d:symbol, k:symbol)                  .input reg_key_fact
//   key_cap(n)                        how many declarations one key may register before the set is refused
.decl key_cap(n:number)                                           .input key_cap
//   key_use_cap(n)                    and how many callables may WRITE one before it stops identifying anything
.decl key_use_cap(n:number)                                       .input key_use_cap
.decl route_alias(w:symbol, r:symbol)                             .input route_alias
//   decorated_name(m, w)              the name m denotes what its decorator returned: calling m runs w
.decl decorated_name(m:symbol, w:symbol)                          .input decorated_name
.decl reexport(c:symbol, n:symbol, f:symbol, l:number)            .input reexport
.decl reexport_from(f:symbol, l:number, src:symbol)               .input reexport_from
.decl field(fl:symbol, t:symbol, n:symbol, f:symbol, l:number)    .input field
// field_holder(fl, h): fl is a key of an OBJECT named h, not a member of a type (`TOPICS` of `TOPICS.CREATED`)
.decl field_holder(fl:symbol, h:symbol)                           .input field_holder
.decl accessor(fl:symbol, n:symbol, rw:symbol)                    .input accessor
.decl faccess(c:symbol, fl:symbol, acc:symbol, tier:symbol, f:symbol, l:number) .input faccess
.decl gen_table(d:symbol, what:symbol)                            .input gen_table
.decl base_name(t:symbol, n:symbol)                               .input base_name
//   throws_(m, e) / catches(m, e)     a callable declares / catches the checked exception e (read from its own text: Java
//                                     records a throws clause with no line, and #760 mislabels switch arms)
//   switch_over(m, t, arms)           callable m switches over the enum t, with `arms` of its constants named
.decl throws_(m:symbol, e:symbol)                                 .input throws_
.decl catches(m:symbol, e:symbol)                                 .input catches
.decl switch_over(m:symbol, t:symbol, arms:symbol)                .input switch_over
.decl test_method(m:symbol)                                       .input test_method
.decl fixture(m:symbol)                                           .input fixture
//   takes_param(m, n)                 callable m declares a parameter called n
//   fixture_scope(fx, n, p)           fixture fx is named n and serves every file under the path prefix p
//   file_scope(f, p)                  file f lies under prefix p (itself and every ancestor directory)
//   autouse_fixture(fx)               fx runs before every test in its scope, named by nothing
.decl takes_param(m:symbol, n:symbol)                             .input takes_param
.decl fixture_scope(fx:symbol, n:symbol, p:symbol)                .input fixture_scope
.decl file_scope(f:symbol, p:symbol)                              .input file_scope
.decl autouse_fixture(fx:symbol)                                  .input autouse_fixture
//   runs_before(m, fx)                a C# set-up the runner runs for tests outside its type: an NUnit [SetUpFixture]'s
//                                     [OneTimeSetUp] for its namespace, MSTest's assembly-wide initializers for the project
.decl runs_before(m:symbol, fx:symbol)                            .input runs_before
//   injects(m, fx)                    the language engine resolved m's request to fixture fx (Python: the runner's own
//                                     visibility, the decorator's `name=`, star imports and `pytest_plugins`)
//   injected_fixture(fx)              fx is injected by name and runs only for what requests it: not every test of its file
.decl injects(m:symbol, fx:symbol)                                .input injects
.decl injected_fixture(fx:symbol)                                 .input injected_fixture
//   usefixtures_scope(p, n)           a usefixtures marker no declaration carries: a module's `pytestmark` (p is that
//                                     file) or the ini option (p is the directory holding the ini file)
.decl usefixtures_scope(p:symbol, n:symbol)                       .input usefixtures_scope
//   cs_data_source(m, tn, n)          C# test m's [MemberData] / [TestCaseSource] / [DynamicData] names member n of type
//                                     tn ("" = the test's own class and its bases)
//   cs_data_type(m, tn)               C# test m's [ClassData(typeof(tn))] / [TestCaseSource(typeof(tn))]
//   cs_fixture_type(t, xn)            xUnit builds type xn before each test of class t (IClassFixture<xn>, or a
//                                     collection whose definition is ICollectionFixture<xn>)
.decl cs_data_source(m:symbol, tn:symbol, n:symbol)               .input cs_data_source
.decl cs_data_type(m:symbol, tn:symbol)                           .input cs_data_type
.decl cs_fixture_type(t:symbol, xn:symbol)                        .input cs_fixture_type
.decl kind(s:symbol, k:symbol)                                    .input kind
.decl decl_file(s:symbol, f:symbol)                               .input decl_file
.decl lex_parent(inner:symbol, outer:symbol)                       .input lex_parent
.decl flag(n:symbol)                                              .input flag
.decl file_dir(f:symbol, d:symbol)                                .input file_dir
.decl field_type(fl:symbol, n:symbol)                             .input field_type
.decl target(q:symbol, k:symbol, s:symbol, x:symbol)              .input target
.decl textuse(c:symbol, n:symbol, f:symbol, l:number)             .input textuse
.decl sigtype(c:symbol, t:symbol, ctx:symbol, d:number)          .input sigtype
.decl persist_field(m:symbol, fl:symbol, how:symbol)             .input persist_field
.decl importuse(c:symbol, n:symbol, f:symbol, l:number)           .input importuse
.decl inside_target(q:symbol, c:symbol)                           .input inside_target
//   config(key, m, why)               a configuration key the engine bound to a method (@Value, @ConfigurationProperties, a .yml/.properties key)
//   config_key_known(key)             every key the engine's configuration extension saw — an unknown key is said to be unknown, never guessed
//   bean(name, t, kind)               a type registered as a bean (a stereotype, an @Bean factory)
//   bean_factory(m, t)                the METHOD an @Bean factory is declared on, and the type it produces
//   injected(t, into, kind)           a value of type t is handed to `into` by the container, not by a call the graph can see
//   registers(t, by, kind)            the bean of type t exists because an annotation on the type `by` names it
//                                     (@EnableConfigurationProperties({T.class}), a mapper or properties package scan)
.decl config_site(k:symbol, c:symbol, d:symbol, f:symbol, l:number) .input config_site
//   nonsource(n, f, l)                the name n written in a file the index does NOT read as source
//   qual_name(s, n)                   a qualified spelling of symbol s, for a binding written in full
.decl nonsource(n:symbol, f:symbol, l:number)                     .input nonsource
.decl qual_name(s:symbol, n:symbol)                               .input qual_name
.decl config(k:symbol, m:symbol, why:symbol)                      .input config
//   cs_config_literal(k, c, cert, f, l) a C# string literal inside c spelling the configuration key k (lowercased `A:B`);
//                                     cert is `by name` where the line reads IConfiguration, `text` elsewhere (#1443)
.decl cs_config_literal(k:symbol, c:symbol, cert:symbol, f:symbol, l:number) .input cs_config_literal
.decl config_key_known(k:symbol)                                  .input config_key_known
.decl bean(n:symbol, t:symbol, kind:symbol)                       .input bean
.decl bean_factory(m:symbol, t:symbol)                            .input bean_factory
.decl injected(t:symbol, into:symbol, kind:symbol)                .input injected
.decl registers(t:symbol, by:symbol, kind:symbol)                .input registers

// ── vocabulary ─────────────────────────────────────────────────────────────────────────────────────────────────
.decl local_kind(k:symbol)
local_kind("LOCAL_VARIABLE"). local_kind("PARAMETER"). local_kind("LAMBDA_PARAMETER"). local_kind("VARIABLE"). local_kind("PARAM").
.decl member_kind(k:symbol)
member_kind("FIELD"). member_kind("PROPERTY"). member_kind("ATTRIBUTE"). member_kind("METHOD"). member_kind("FUNCTION").
.decl ctor_kind(k:symbol)
ctor_kind("new"). ctor_kind("anon_new"). ctor_kind("CONSTRUCTOR_CALL").
// the parser tells a field reference from a type reference and from a call: a field rule must not take the other two
.decl type_or_call_kind(k:symbol)
type_or_call_kind("TYPE"). type_or_call_kind("METHOD"). type_or_call_kind("FUNCTION"). type_or_call_kind("CONSTRUCTOR"). type_or_call_kind("METHOD_CALL"). type_or_call_kind("METHOD_REFERENCE").
// a qualifier that names the enclosing instance is not another type: this.x / self.x is the enclosing type's own x
.decl self_qualifier(q:symbol)
self_qualifier("this"). self_qualifier("self"). self_qualifier("cls"). self_qualifier("super").

// ── derived structure ──────────────────────────────────────────────────────────────────────────────────────────
// scope(T, S): a member of T is visible unqualified inside S — S is T, a subtype, or a type nested in one of those
.decl scope(t:symbol, s:symbol)
scope(t, t) :- typ(t, _, _).
scope(t, s) :- scope(t, u), extends(s, u).
scope(t, s) :- scope(t, u), nested(s, u).
// inside(x, T): x is declared within T's span — a member, or a member of a nested type
.decl inside(x:symbol, t:symbol)
inside(x, t) :- owner(x, t).
inside(n, t) :- nested(n, t).
inside(x, t) :- nested(n, t), inside(x, n).
// declares(T, n): T or a type it extends declares a member named n
.decl declares(t:symbol, n:symbol)
declares(t, n) :- member(t, _, n, _).
declares(t, n) :- extends(t, u), member(u, _, n, _).
declares(t, n) :- nested(x, t), typ(x, n, _).                     // a nested type of that name is a member too
// what a type's decorations generate
.decl gen(t:symbol, what:symbol)
gen(t, w) :- decorated(t, d), gen_table(d, w).
gen(t, w) :- extends(t, u), decorated(u, d), gen_table(d, w).     // a base class that generates, generates for its subtypes
gen(t, w) :- field(fl, t, _, _, _), decorated(fl, d), gen_table(d, w).   // a decoration on the field itself
// a generator that is a BASE CLASS, not a decoration: `class User(BaseModel)` declares its members by inheritance, and
// the base is usually a library type the graph never resolved, so `extends` cannot see it — the written name can (#750)
gen(t, w) :- base_name(t, n), gen_table(n, w).
// a project's own decorator that wraps a generator (`def frozen(cls): return dataclass(frozen=True)(cls)`): the alias is
// recognised by what its body calls, so a house decorator, an aliased import or a decorator factory is no longer invisible
.decl gen_alias(d:symbol, w:symbol)
gen_alias(d, w) :- named(d, m), ref(m, g, _, _, _, _), gen_table(g, w), d != g.
gen(t, w) :- decorated(t, d), gen_alias(d, w).
gen(t, w) :- field(fl, t, _, _, _), decorated(fl, d), gen_alias(d, w).
// the same alias shape, for a base class built by a FACTORY rather than named directly:
// `Base = declarative_base()` then `class Customer(Base)`. The written base name is `Base`, which
// discriminates nothing -- any project may have a class called Base -- so it cannot go in the convention
// table. What discriminates is that THIS Base's own source calls a generator, which is exactly what
// gen_alias already asks of a decorator. Without it a declarative model's generated __init__ is invisible
// and a retype of one of its columns reports no construction site at all.
gen(t, w) :- base_name(t, n), gen_alias(n, w).
gen_source(t, n, "a base class built by a generator") :- base_name(t, n), gen_alias(n, _), !gen_table(n, _).
// which entries fired for THIS query, so the answer can say which convention it assumed rather than leave it implicit
.decl gen_source(t:symbol, d:symbol, why:symbol)
gen_source(t, d, "a decoration on the type") :- decorated(t, d), gen_table(d, _).
gen_source(t, d, "a project-local decorator wrapping one") :- decorated(t, d), gen_alias(d, _), !gen_table(d, _).
gen_source(t, n, "a base class") :- base_name(t, n), gen_table(n, _).
gen_source(t, d, "a decoration on a field") :- field(fl, t, _, _, _), decorated(fl, d), gen_table(d, _).
.decl gen_fired(q:symbol, d:symbol, why:symbol)
gen_fired(q, d, why) :- target(q, "type", t, _), gen_source(t, d, why).
gen_fired(q, d, why) :- target(q, "clinit", t, _), gen_source(t, d, why).
gen_fired(q, d, why) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen_source(t, d, why).
gen_fired(q, d, why) :- target(q, "method", m, _), owner(m, t), gen_source(t, d, why).
.output gen_fired
gen(t, "fluent_read") :- typ(t, _, "record").                    // a record accessor reads; only a builder / wither writes
gen(t, "ctor") :- typ(t, _, "record").
// holds(H, T): type H has a field whose type is T — a value of T is produced whenever an H is
.decl holds(h:symbol, t:symbol)
holds(h, t) :- typ(t, n, _), typeref(c, n, "FIELD_TYPE", _, _), owner(c, h).
// the type written on the field's own line: the holder is the type that declares the field, not every type in the file
holds(h, t) :- field(fl, h, _, _, _), field_type(fl, n), typ(t, n, _), h != t.
// the file-scoped fallback, only where no field declaration in that file could be read (the parser gives no line)
.decl file_field_typed(f:symbol)
file_field_typed(f) :- field(fl, _, _, f, _), field_type(fl, _).
holds(h, t) :- typ(t, n, _), typeref_file(f, n, "FIELD_TYPE"), type_in_file(h, f), h != t, !file_field_typed(f).

// ── must change with it: a contract the engine resolved ──────────────────────────────────────────────────────
.decl contract(q:symbol, c:symbol, why:symbol)
contract(q, o, "overrides it") :- target(q, "method", m, _), override(m, o), !target(q, _, o, _).
contract(q, b, "it overrides this") :- target(q, "method", m, _), override(b, m), !target(q, _, b, _).
// a language whose engine emits no override rows still has the types: a subtype (or supertype) declaring the same
// member name is bound by the same contract — said as a name match, not as a resolved override
// A DISPATCH BASE THE ENGINE RECORDS NO OVERRIDE ROW FOR (#1011). `edge(b, m, "dispatch")` says a call typed to b
// may run m, which is why the closure walks candidate -> base: everything calling the base depends on the
// candidate. But the base declaration is a WAYPOINT, not something the change breaks — an interface method has no
// body — and in Java it is already kept out of `reached` by being a contract member through its override row. A
// structurally typed language has no such row (TypeScript: 91 dispatch pairs on one library, not one of them in
// `overrides`), so the base landed in `reached` instead, and the hook's fast path counted it too: 1166 against the
// rules' 1165 on a Java bundle, the over-claiming direction.
//
// Making it a contract is what the override case already does: a contract member is a seed, a seed is at depth 0,
// and the printer keeps only depth > 0 — so it leaves `reached` without a filter anywhere, stays traversable, and
// the reader is told the thing that is actually true, which is that the declaration implements this.
.decl implements_pair(b:symbol, m:symbol)                          .input implements_pair
contract(q, b, "it implements this — the engine records a dispatch candidate here and no override row") :-
    target(q, "method", m, _), implements_pair(b, m), !value_pair(b, m), !override(b, m), !override(m, b), !target(q, _, b, _).
// …and the other direction, asked of the BASE. Java's override row puts an implementation under "overrides it";
// a structurally typed language has no such row, so an interface method's own implementations were missing from
// its answer entirely: nothing calls them through it (the dispatch edge runs candidate -> base) and no contract
// named them, though a change to the interface method's signature breaks every one of them.
contract(q, m, "implements it — the engine records a dispatch candidate here and no override row") :-
    target(q, "method", b, _), implements_pair(b, m), !value_pair(b, m), !override(b, m), !override(m, b), !target(q, _, m, _).
// A FUNCTION STORED IN A FIELD (#1206). `value_pair(b, m)`: m flows into a field whose declared type is the
// function type b — `this.getPath = options.getPath ?? getPath`, `fetch: T = (req) => …`. A call through the field
// is typed to b, so its caller is a DIRECT user of m: without this row the answer said "directly touches it:
// nothing" and "the change is local" about a function the whole request path runs. `one of a set`, because the
// field may hold another function at that call (the ternary's other arm, a caller-supplied option).
.decl value_pair(b:symbol, m:symbol)                               .input value_pair
contract(q, b, "it is held by a field, variable or parameter of this function type — a call through that holder runs it") :-
    target(q, "method", m, _), value_pair(b, m), !target(q, _, b, _).
// ONLY WHERE THE CALLER HAS NO ROW ALREADY. An annotated `const f: T = …` is often ALSO bound to its initializer by the
// resolver, so the same caller arrived twice — "calls it" and "calls it through a field that holds it" — which is
// noise, not a second fact.
.decl calls_target_directly(q:symbol, c:symbol)
calls_target_directly(q, c) :- target(q, "method", m, _), calls(c, m, _, _, _).
direct(q, c, "uses", "calls it through a field, variable or parameter that holds it", "one of a set", f, l) :-
    target(q, "method", m, _), value_pair(b, m), calls(c, b, _, f, l), !inside_target(q, c), !calls_target_directly(q, c).
// Where the engine names the holder a call goes through (`value_call`, Java), that is the caller; the pair's base is
// the functional interface's method, which every holder of the type shares, and `calls` never carries it (it is not
// client code), so the rule above stays silent there rather than crediting every `.apply` caller.
.decl value_call(c:symbol, m:symbol)                               .input value_call
direct(q, c, "uses", "calls it through a field, variable or parameter that holds it", "one of a set", "", 0) :-
    target(q, "method", m, _), value_call(c, m), !inside_target(q, c), !calls_target_directly(q, c).
contract(q, o, "declares the same member in a subtype (a name match: this graph has no override table)") :- flag("no_overrides"),
    target(q, "method", m, _), owner(m, t), member(t, m, n, _), extends(s, t), member(s, o, n, _), o != m.
contract(q, o, "declares the same member in a supertype (a name match: this graph has no override table)") :- flag("no_overrides"),
    target(q, "method", m, _), owner(m, t), member(t, m, n, _), extends(t, u), member(u, o, n, _), o != m.
contract(q, o, "overrides the method — same parameter list") :- target(q, "param", m, _), override(m, o), !target(q, _, o, _).
contract(q, b, "the method overrides this — same parameter list") :- target(q, "param", m, _), override(b, m).
contract(q, s, "extends / implements it") :- target(q, "type", t, _), extends(s, t).
contract(q, s, "extends / implements it") :- target(q, "typeparam", t, _), typ(t, _, _), extends(s, t).
contract(q, s, "extends / implements it") :- target(q, "clinit", t, _), extends(s, t).
.output contract

// ── direct(q, c, role, why, cert, f, l): c's text uses the target. role: writes | reads | uses ─────────────────
.decl direct(q:symbol, c:symbol, role:symbol, why:symbol, cert:symbol, f:symbol, l:number)

// a CONFIGURATION KEY: the methods the container binds it into — no call reaches them, so nothing else would find these
direct(q, m, "reads", cat("reads this configuration key (", why, ")"), "resolved", "", 0) :- target(q, "config", k, _), config(k, m, why).
// the binding site: the line that ties the key to the code, and the one that must be edited with it
direct(q, c, "reads", "reads this configuration key by its string (the C# engine has no configuration facts: joined on the key as written)", cert, f, l) :- target(q, "config", k, _), cs_config_literal(k, c, cert, f, l).
direct(q, c, "produces", cat("BINDS the key here, at the @", dn, " placeholder — this is the line a rename must change"), "resolved", f, l) :- target(q, "config", k, _), config_site(k, c, dn, f, l).

// a type the container INJECTS: its consumers receive it without a call the graph can see
// ── a hop across a process (#1108) ────────────────────────────────────────────────────────────────
// remote(From, To, Transport, Destination, Confidence) — a queue, a route, a gRPC stub to the handler
// it serves. No call site expresses it, so no call rule above can see it, and a handler's impact
// reported nothing outside its own type while its callers sat in the table unread.
//
// It is a DEPENDENT and not a call: the reason says which transport carried it and over what key, so a
// reader can tell an in-process invocation from a message that may never arrive. Certainty is the
// engine's own confidence for that pairing rather than "resolved", because the two ends were joined by
// a destination, not by a resolved target.
.decl remote(f:symbol, t:symbol, tr:symbol, dest:symbol, conf:symbol)                  .input remote
direct(q, c, "uses", cat("calls it across a process boundary (", cat(tr, cat(") at ", cat(dest, cat(" [", cat(conf, "]")))))), "remote", "", 0)
    :- target(q, "method", m, _), remote(c, m, tr, dest, conf), c != m.
// and the other direction: changing the sender changes what the handler receives
direct(q, c, "uses", cat("serves what this sends across a process boundary (", cat(tr, cat(") at ", cat(dest, cat(" [", cat(conf, "]")))))), "remote", "", 0)
    :- target(q, "method", m, _), remote(m, c, tr, dest, conf), c != m.

// ── a hop a framework makes inside one process (#1509) ──────────────────────────────────────────────
// framework(From, To, Mechanism, Detail, Confidence) is the engine's framework_edge: a task enqueued with
// .delay() and the task body, a signal sent and its @receiver, a route table and its view, a Depends()
// default and its provider, a test and the fixture it names. Both ends are client code and no call site
// joins them, so every rule above is silent: `impact` on a receiver said the change was local while the
// publisher sat one row away.
//
// ONE DIRECTION ONLY. The end that hands over (the publisher, the producer, the handler declaring the
// dependency) depends on the end the framework runs. The reverse is not a dependency for every mechanism,
// a provider does not depend on the handler asking for it, so it is claimed for none.
// Certainty is `framework`, never `resolved`: the reason carries the mechanism, what joined the two ends and
// the engine's own confidence (`registered`, or `by_name` for a fixture), so a reader can tell the hop from
// an invocation. A direct row only, not a seed of the closure. (`remote` is walked by the closure, as the fw_edge
// tier `remote` below, from the sender to the handler only.)
.decl framework(f:symbol, t:symbol, mech:symbol, detail:symbol, conf:symbol)             .input framework
direct(q, c, "uses", cat("framework-mediated, not a call: ", cat(mech, cat(" via ", cat(detail, cat(" [", cat(conf, "]")))))), "framework", "", 0)
    :- target(q, "method", m, _), framework(c, m, mech, detail, conf), c != m.

direct(q, c, "uses", cat("receives it by dependency injection (", kind, ") — the container hands it over, no call site"), "resolved", "", 0) :- target(q, "type", t, _), injected(t, c, kind), !inside_target(q, c).
direct(q, c, "uses", cat("receives it by dependency injection (", kind, ") — the container hands it over, no call site"), "resolved", "", 0) :- target(q, "clinit", t, _), injected(t, c, kind).
// a method that DEFINES a bean (@Bean): whoever is injected with the type it returns. Keyed on `bean_factory`,
// which names the METHOD. Keying on `bean(_, owner(m), _)` instead only says the method's OWNER is a bean, so
// it fired for every method of every injected @Service and never for a factory whose @Configuration is not injected.
direct(q, c, "uses", cat("is injected with the bean this defines (", kind, ")"), "resolved", "", 0) :- target(q, "method", m, _), bean_factory(m, bt), injected(bt, c, kind), c != m.
// a TYPE that another class registers as a bean: that class, which a rename, a move or a delete of the type breaks.
// Without it the registering annotation was one [by name] row among the text matches, and a type registered only
// that way read as a class nothing depends on.
direct(q, c, "uses", cat("registers it as a bean (", kind, "): the container creates it, no call site"), "resolved", "", 0) :- target(q, "type", t, _), registers(t, c, kind), !inside_target(q, c).
// a TYPE that DEFINES beans (a @Configuration class, an auto-configuration): whoever is injected with a bean one of its
// @Bean methods defines. The factory methods are inside the target, so the method rule above never runs for them
// and a change to the class said nothing resolved depended on it.
direct(q, c, "uses", cat("is injected with a bean this class defines (", kind, ")"), "resolved", "", 0) :- target(q, "type", _, _), inside_target(q, m), bean_factory(m, bt), injected(bt, c, kind), !inside_target(q, c).

// a METHOD: its callers, and the unresolved sites written with its name
// A RESOLVED call at a route registration says what the code does and not what it means: on JavaScript the engine
// already resolves `app.get('/pads', listPads)` to an edge, so the answer said "routes.<module> calls it" and the
// reader never learned that the thing they are changing is GET /pads. Same row, the route's wording, same certainty
// — the edge is the engine's, only the sentence comes from the registration.
.decl route_site(f:symbol, l:number)
route_site(f, l) :- registration(_, f, l, "route", _, _).

// HOW SURE A CALL ROW IS COMES FROM THE TIER, AND THE TIER VOCABULARY IS PER LANGUAGE. These two rules
// used to read `t != "multi_inferred"` and hardcode "resolved", which is a binary test standing in for
// an eleven-value vocabulary: every other tier became the strongest claim this tool makes. Surveyed
// over 226 graphs that was 13,189 `callback_registered`, 696 `event_dispatch`, 953 `ambient_terminal`
// and 116 `fan_capped` edges printed as "[resolved] … — calls it". A hand-off is the engine recording
// that the callable was passed as a VALUE; a capped fan-out exists because the candidate set was too
// large to enumerate, so what is here is a sample of it. Neither is a resolved call.
//
// `cert_tier` is written from ONE table (scripts/ax_edges.py, DIRECT_CERT / DIRECT_WHY) and the SQL
// fast path reads the same one, so the rules and the fast path cannot disagree about a tier — which
// is how the two copies of the binary test drifted apart from the rest of the vocabulary to begin with.
.decl cert_tier(tier:symbol, cert:symbol, why:symbol)             .input cert_tier
direct(q, c, "uses", why, cert, f, l) :- target(q, "method", m, _), calls(c, m, t, f, l), t != "multi_inferred", t != "stub", cert_tier(t, cert, why), !bean_call(q, c, m), !route_site(f, l), !via_site(c, m, f, l).
// A CALL WRITTEN AGAINST A BASE THIS DECLARATION IS OVERRIDE-EQUIVALENT TO (#1542). The service-layer shape: a controller
// holds an interface-typed field and calls through it. Before this the caller of an implementation showed only under
// "reaches those" (the dispatch hop), and a caller the engine had NARROWED to the implementation (an injected field whose
// bean it resolved) was missing from the interface method altogether, so `impact` there said the change was local.
// The rows are graph_sql.via_base_rows, read by the SQL port too: for the base itself, a multi_inferred edge is the
// call the code names ("calls it", resolved); for each override the engine kept at that site, "calls it (via the
// interface)", resolved only when nothing else can run there; for a narrowed call, the base when the receiver read at
// the call is a field declared with the base's type. An override the engine left out of a site's set gets no row, so a
// caller whose receiver resolves to a sibling implementation does not become a caller of this one. `via_site` is the
// plain row each one replaces, so a caller is not listed twice for one call.
.decl via_base(c:symbol, m:symbol, why:symbol, cert:symbol, f:symbol, l:number, e:symbol)   .input via_base
.decl via_site(c:symbol, m:symbol, f:symbol, l:number)                            .input via_site
direct(q, c, "uses", why, cert, f, l) :- target(q, "method", m, _), via_base(c, m, why, cert, f, l, _), !is_target_decl(q, c).
// A call written inside a mock's stub or verification (`when(repo.find(1))`, `mock.Setup(r => r.Find(1))`): the exporter
// gives it the tier "stub" (ax_edges.stub_sites). It names the method, so a rename or a new parameter breaks it, and it
// runs nothing: the receiver is a mock. Its own row, whatever else the caller does; it is not an edge of the closure.
direct(q, c, "uses", why, cert, f, l) :- target(q, "method", m, _), calls(c, m, "stub", f, l), cert_tier("stub", cert, why).
// a registration names the row: the edge is the engine's, the sentence is the registration's, and the
// certainty stays the tier's — a route handed over as a value is still handed over as a value.
direct(q, c, "uses", why, cert, f, l) :- target(q, "method", m, _), calls(c, m, t, f, l), t != "multi_inferred", t != "stub", cert_tier(t, cert, _), !bean_call(q, c, m), registration(_, f, l, "route", _, why).
// A call INTO a method of a container-managed bean. Whether the container's proxy is on the path decides whether a
// behavioural annotation added to the method (a transaction, a cache, an async dispatch, a retry, an authorization
// check) reaches this caller at all: a call from inside the bean goes through `this` and never through the proxy.
// This is a per-framework convention stated as such, and it fires only where the graph actually found a container.
.decl bean_call(q:symbol, c:symbol, m:symbol)
// Not for an event either: the event system invokes a listener on the container's bean, so the proxy IS on that
// path, and "an instance it obtained itself" would be false (#1391). It keeps its tier's own row above.
bean_call(q, c, m) :- target(q, "method", m, _), owner(m, ot), bean(_, ot, _), calls(c, m, t, _, _), t != "multi_inferred", t != "event_dispatch", t != "stub".
// the type that the container hands the bean to: a field injection names the type, a constructor or setter names the method
.decl receives_bean(t:symbol, into:symbol)
receives_bean(t, into) :- injected(t, into, _), typ(into, _, _).
receives_bean(t, into) :- injected(t, x, _), owner(x, into).
// …and a point the engine WIRED to this bean, whatever type it declares: an `@Autowired Store store` given the JdbcStore
// bean receives it through the container, and keyed on the declared type alone its caller "obtained it itself" (#1384)
.decl injected_bean(t:symbol, into:symbol)                                        .input injected_bean
receives_bean(t, into) :- injected_bean(t, into), typ(into, _, _).
receives_bean(t, into) :- injected_bean(t, x), owner(x, into).
direct(q, c, "uses", "calls it from inside the same bean — through this, not through the container proxy, so an added proxied annotation does NOT apply to this caller", "resolved", f, l) :-
    bean_call(q, c, m), owner(m, ot), owner(c, ot), calls(c, m, t, f, l), t != "stub".
direct(q, c, "uses", "calls it on the injected bean — the container proxy is on the path, so an added proxied annotation applies here", "resolved", f, l) :-
    bean_call(q, c, m), owner(m, ot), owner(c, cot), cot != ot, receives_bean(ot, cot), calls(c, m, t, f, l), t != "stub".
direct(q, c, "uses", "calls it on an instance it obtained itself, not from the container — no proxy on the path, so an added proxied annotation does not apply here", "resolved", f, l) :-
    bean_call(q, c, m), owner(m, ot), owner(c, cot), cot != ot, !receives_bean(ot, cot), calls(c, m, t, f, l), t != "stub".
direct(q, c, "uses", "calls it", "one of a set", f, l) :- target(q, "method", m, _), calls(c, m, "multi_inferred", f, l), !via_site(c, m, f, l).
// `!is_target_decl`: `this.rows.find(...)` inside `OrdersService.find` is the ARRAY's find, and with the receiver
// untyped it matched the target by name — printing the declaration as a reader of itself. Worse, that row made the
// change its own [by name] dependent, so `weak_seed` held for it and the whole answer said "12 of those 12 are
// reached ONLY through a dependent that is not an exact edge": everything downstream looked untrustworthy because of
// one self-match. A recursive call needs no row either — the body is what is changing.
direct(q, c, "uses", "calls a method of this name (receiver not typed)", "by name", f, l) :- target(q, "method", m, _), named(n, m), unresolved(c, n, k, f, l), !ctor_kind(k), k != "stub", !is_target_decl(q, c).
direct(q, c, "uses", "stubs a method of this name on a mock (receiver not typed): the real method does not run there", "by name", f, l) :- target(q, "method", m, _), named(n, m), unresolved(c, n, "stub", f, l), !is_target_decl(q, c).

// ── a method handed over as a VALUE, never called where it is named ──────────────────────────────────────────
// `app.get('/orders/:id', getOrder)`, `useEffect(load)`, `items.map(format)`, `handlers = {"x": handle_x}`: the
// declaration is named, and the call happens inside a library, or later, or never. There is no call site for it, so
// EVERY method-target rule above misses it and the answer used to be "the declaration is used only where it is
// declared" — for a live HTTP handler, with `--delete` then reporting no dependent at any certainty. What the graph
// does hold is the parser's own reference row, whose entity kind says the identifier binds to a method.
// The two guards are what keep it from doubling an ordinary call: a language that emits a reference row for the
// callee of `foo()` as well (Python does) is excluded by the call site at that same file and line, resolved or not.
// the entity kinds a parser gives an identifier that BINDS TO A CALLABLE. IMPORT_BINDING is here because a handler is
// usually imported from the module that declares it — `import { listOrders }` then `app.get('/orders', listOrders)`,
// where the reference at the registration is recorded as the import binding, not as a method. An import binding is
// recorded at the USE, not at the import statement, so this does not turn every import line into a dependent.
.decl callable_ek(k:symbol)
callable_ek("METHOD"). callable_ek("FUNCTION"). callable_ek("IMPORT_BINDING").
// (decl, file, line, kind, key, why): what a site hands a declaration to. `decl` is the declaration handed over,
// empty when the name does not identify exactly one callable; `key` is the string the framework dispatches on — a
// route path, verbatim — and is what a test that drives the app through the framework's client is joined to. The
// join is not in this file yet; the column is here so the two halves of this work agree on one relation, not two.
.decl registration(decl:symbol, f:symbol, l:number, kind:symbol, key:symbol, why:symbol) .input registration
.decl valueref(q:symbol, c:symbol, f:symbol, l:number)
.decl registered(q:symbol, c:symbol, why:symbol, f:symbol, l:number)
valueref(q, c, f, l) :- target(q, "method", m, _), named(n, m), ref(c, n, _, ek, f, l), callable_ek(ek),
    !calls(c, m, _, f, l), !unresolved(c, n, _, f, l), !is_target_decl(q, c), !calls_same_named(c, n, f, l).
// A RESOLVED CALL TO ANOTHER DECLARATION OF THE NAME is not a reference to this one. Two same-named functions in
// different files: the site that calls the OTHER one was reported as naming THIS one as a value, so each function's
// answer carried the other's callers, as leads and then as a seed of the walk.
.decl calls_same_named(c:symbol, n:symbol, f:symbol, l:number)
calls_same_named(c, n, f, l) :- calls(c, m2, _, f, l), named(n, m2).
// There is NO second leg keyed on the site alone, and the reason is measured rather than assumed. A JavaScript
// graph's refs carry the ACCESS MODE (IDENTIFIER|READ, PROPERTY_ACCESS|WRITE) and no entity kind, so the rule above
// matches nothing there and a site-evidence version was written to cover it: a bare reference, not the receiver of
// a call on the line, at a line that registers something. On a 124-file Express application, over 30 sampled
// targets, it produced eleven rows and ALL ELEVEN were wrong — seven were a parameter named `callback` inside
// `forEach(function (callback) {…})`, four were `settle` being CALLED inside the span of a `.then(…)` it sits in.
// Without an entity kind there is nothing to tell a parameter or a local from a reference to the declaration, and
// a name match at a call line is not evidence. So JavaScript gets the route wording on the edge the engine already
// resolved (see `route_site` above) and no name-matched rows at all.
registered(q, c, why, f, l) :- valueref(q, c, f, l), registration(_, f, l, _, _, why).
direct(q, c, "uses", "names it as a value — passed, stored or registered, and called somewhere the graph cannot see", "by name", f, l) :-
    valueref(q, c, f, l), !registered(q, c, _, f, l).
// and when the site says what will do the calling, the answer says that instead: a route registration, an event
// subscription, a lifecycle hook. `registration` is written by the exporter's convention table, never guessed here.
direct(q, c, "uses", why, "by name", f, l) :- valueref(q, c, f, l), registered(q, c, why, f, l).

// a FIELD: references by name, judged by where they are and how they are written
.decl fref(q:symbol, c:symbol, rk:symbol, f:symbol, l:number)
fref(q, c, rk, f, l) :- target(q, "field", fl, _), field(fl, _, n, ff, fll), ref(c, n, rk, ek, f, l), !local_kind(ek), !type_or_call_kind(ek), (f != ff ; l != fll),
    (!fa_line(q, f, l) ; ek = "OBJECT_PROPERTY_KEY"), (ek != "OBJECT_PROPERTY_KEY" ; !key_decl_at(n, f, l)).
// the key that DECLARES another object's same-named key (`QUEUES = { CREATED: … }`) is that declaration, not a use of this one
.decl key_decl_at(n:symbol, f:symbol, l:number)
key_decl_at(n, f, l) :- field_holder(fl, _), field(fl, _, n, f, l).
// an enum member is written like a type, so the parser labels the genuine reference TYPE: keep those, but only in a
// file that can see the enum — its own directory, or a file that names the enum type somewhere
.decl enum_member_target(q:symbol, fl:symbol)
enum_member_target(q, fl) :- target(q, "field", fl, _), member(_, fl, _, "enum_member").
fref(q, c, rk, f, l) :- enum_member_target(q, fl), field(fl, t, n, ff, fll), ref(c, n, rk, "TYPE", f, l), (f != ff ; l != fll),
    file_dir(f, d), type_in_file(t, tf), file_dir(tf, d).
fref(q, c, rk, f, l) :- enum_member_target(q, fl), field(fl, t, n, ff, fll), ref(c, n, rk, "TYPE", f, l), (f != ff ; l != fll),
    typ(t, tn, _), typeref_file(f, tn, _).
fref(q, c, rk, f, l) :- enum_member_target(q, fl), field(fl, t, n, ff, fll), ref(c, n, rk, "TYPE", f, l), (f != ff ; l != fll),
    typ(t, tn, _), typeref(_, tn, _, f, _).
.decl frole(rk:symbol, role:symbol, why:symbol)
frole("qualified", "uses", "writes/reads it"). frole("bare", "reads", "reads it").

// A CONST THAT HOLDS A WRAPPED HANDLER is registered where it is handed to a route, not read there.
// `const listAdmins = catchAsync(async (req, res) => …)` then `router.get('/admins', listAdmins)`: the declaration is
// a const, not a method, so the method-target route wording (`route_site` above) never applied and the answer said
// only "[by name] … reads it" at the registration. Two conditions, both required, both read by ax_registration:
//   - `route_arg(c, f, l, n)`: the name is written IN A HANDLER POSITION of a route call `c` makes — a top-level
//     argument or an element of an array argument, bare or at the end of a member chain. Not the receiver
//     (`router.get`), not inside an options object (`{ schema: { 200: TaskSchema } }`), not an argument of a nested
//     call (`validate(bodySchema)`), and not inside an inline handler, whose reads are the handler's.
//   - `callable_const(ff, fll)`: the const HOLDS A FUNCTION — a function, a reference to a declared one, or a call that
//     returns one (a callee the engine says returns a function, or a wrapper handed a function). A schema, an options
//     object, `express.Router()` (a router mounted with `app.use('/p', router)` is a mount) or a module never does.
// Then:
//   - registered: the function the const holds is known — the wrapper's returned function (`init_wrapper`,
//     `returns_fn`) or the function it aliases (`init_alias`) — and the route line hands THAT function over
//     (`handoff_at`). A hand-off of some other function on the same line (`.post(protect, admin, h)`) is not evidence.
//   - by name: otherwise (a library wrapper says nothing about what it returns). The route's wording, the name's rung.
.decl route_arg(c:symbol, f:symbol, l:number, n:symbol)           .input route_arg
.decl callable_const(f:symbol, l:number)                          .input callable_const
.decl init_wrapper(f:symbol, l:number, w:symbol)                  .input init_wrapper
.decl init_alias(f:symbol, l:number, n:symbol)                    .input init_alias
.decl returns_fn(w:symbol, m:symbol)                              .input returns_fn
.decl const_holds(ff:symbol, fll:number, m:symbol)
const_holds(ff, fll, m) :- init_wrapper(ff, fll, w), returns_fn(w, m).
const_holds(ff, fll, m) :- init_alias(ff, fll, n), named(n, m).
.decl const_handed(q:symbol, c:symbol, f:symbol, l:number, ff:symbol, fll:number)
const_handed(q, c, f, l, ff, fll) :- target(q, "field", fl, _), field(fl, _, n, ff, fll), callable_const(ff, fll),
    fref(q, c, _, f, l), route_site(f, l), route_arg(c, f, l, n).
.decl const_route_edge(q:symbol, c:symbol, m:symbol, f:symbol, l:number)
const_route_edge(q, c, m, f, l) :- const_handed(q, c, f, l, ff, fll), const_holds(ff, fll, m), handoff_at(c, m, f, l).
.decl const_route(q:symbol, c:symbol, cert:symbol, f:symbol, l:number)
const_route(q, c, cert, f, l) :- const_route_edge(q, c, _, f, l), cert_tier("callback_registered", cert, _).
direct(q, c, "uses", why, cert, f, l) :- const_route(q, c, cert, f, l), registration(_, f, l, "route", _, why).
// the row claims the hand-off edge on that line, so `verified:` looks it up like any registered row
direct_edge(q, c, m) :- const_route_edge(q, c, m, _, _).
.decl const_route_byname(q:symbol, c:symbol, f:symbol, l:number)
const_route_byname(q, c, f, l) :- const_handed(q, c, f, l, _, _), !const_route(q, c, _, f, l).
direct(q, c, "uses", why, "by name", f, l) :- const_route_byname(q, c, f, l), registration(_, f, l, "route", _, why).
.decl const_routed(q:symbol, c:symbol, f:symbol, l:number)
const_routed(q, c, f, l) :- const_route(q, c, _, f, l).
const_routed(q, c, f, l) :- const_route_byname(q, c, f, l).

// A field access the ENGINE resolved. The site is bound to THIS declaration, so it is not a name
// match against every field of that name, and its direction is known. Sites the engine could not
// bind (tier ambiguous_unknown) are left to the name rules below, which is where they belong.
.decl fa_bound(c:symbol, fl:symbol, acc:symbol, f:symbol, l:number)
fa_bound(c, fl, acc, f, l) :- faccess(c, fl, acc, tier, f, l), tier != "ambiguous_unknown".
direct(q, c, "produces", "writes it", "resolved", f, l) :- target(q, "field", fl, _), fa_bound(c, fl, "write", f, l).
direct(q, c, "produces", "writes it", "resolved", f, l) :- target(q, "field", fl, _), fa_bound(c, fl, "readwrite", f, l).
direct(q, c, "uses", "reads it", "resolved", f, l)      :- target(q, "field", fl, _), fa_bound(c, fl, "read", f, l).
direct(q, c, "uses", "reads it", "resolved", f, l)      :- target(q, "field", fl, _), fa_bound(c, fl, "readwrite", f, l).
// a caller the engine bound — to this field, or to a DIFFERENT field of the same name. Either way its
// name matches say nothing further: the first is already reported above with its direction, and the
// second touches another declaration entirely and was previously printed as touching this one.
// A LINE the engine bound, to this field or to another field of the same name: a name match on that line says nothing
// more, whichever callable the line is attributed to. fa_known works per caller, and a lambda written on the same line
// as the access (`m.GetOrAdd(T.Culture + k, x => ...)`) is a different callable, so its name match on T.Culture came
// back as a second, [in scope] reader that reads nothing (#1445).
// An object literal's KEY on that line is not the access the engine bound, and no field_access row ever covers one:
// `const meta: EventMeta = { eventId: options.eventId }` binds `options.eventId` to PublishOptions.eventId, and the key
// `eventId` is EventMeta's. fref keeps a ref of entity kind OBJECT_PROPERTY_KEY (TypeScript) past fa_line.
.decl fa_line(q:symbol, f:symbol, l:number)
fa_line(q, f, l) :- target(q, "field", fl, _), fa_bound(_, fl, _, f, l).
fa_line(q, f, l) :- target(q, "field", fl, _), field(fl, _, n, _, _), fa_bound(_, fl2, _, f, l), fl2 != fl, field(fl2, _, n, _, _).
.decl fa_known(q:symbol, c:symbol)
fa_known(q, c) :- target(q, "field", fl, _), fa_bound(c, fl, _, _, _).
fa_known(q, c) :- target(q, "field", fl, _), field(fl, _, n, _, _), fa_bound(c, fl2, _, _, _), fl2 != fl, field(fl2, _, n, _, _).
// in scope: inside the owner, a subtype, or a nested type — or the type node itself (a field initializer)
direct(q, c, role, why, "in scope", f, l) :- fref(q, c, rk, f, l), frole(rk, role, why), target(q, "field", fl, _), field(fl, t, _, _, _), owner(c, s), scope(t, s), !fa_known(q, c), !const_routed(q, c, f, l).
direct(q, c, role, why, "in scope", f, l) :- fref(q, c, rk, f, l), frole(rk, role, why), target(q, "field", fl, _), field(fl, t, _, _, _), scope(t, c), !fa_known(q, c), !const_routed(q, c, f, l).
// qualified elsewhere: the qualifier written on the line decides — the owner's own name confirms, another type's name excludes
direct(q, c, "uses", "writes/reads it", "in scope", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), typ(t, tn, _),
    owner(c, s), !scope(t, s), qualifier(f, l, n, tn), !fa_known(q, c), !const_routed(q, c, f, l).
direct(q, c, "uses", "writes/reads it", "by name", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), typ(t, tn, _),
    owner(c, s), !scope(t, s), !declares(s, n), qualifier(f, l, n, qn), qn != tn, !typ(_, qn, _), !self_qualifier(qn), !holds_key(qn, n), !field_holder(fl, _), !fa_known(q, c), !const_routed(q, c, f, l).
direct(q, c, "uses", "writes/reads it", "by name", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _),
    owner(c, s), !scope(t, s), !declares(s, n), !qualifier(f, l, n, _), !fa_known(q, c), !const_routed(q, c, f, l).
// THE SAME, IN A CALLABLE THAT HAS NO OWNER TYPE. Every rule above starts at `owner(c, s)`, which in Java and
// TypeScript is always there — and in Python and JavaScript a module-level function has no owner at all, so a
// qualified read of a field from one was matched by no rule and vanished from the answer. `price_order` reading
// `settings.order_limit` in the file next door was not listed, at any certainty; the field looked as if only its
// own class touched it. The qualifier decides here exactly as it does above: the owner's own name confirms,
// another TYPE's name excludes, and a variable (which is what a Python qualifier usually is) is `by name`.
direct(q, c, "uses", "writes/reads it", "in scope", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), typ(t, tn, _),
    !owner(c, _), !scope(t, c), qualifier(f, l, n, tn), !fa_known(q, c), !const_routed(q, c, f, l).
direct(q, c, "uses", "writes/reads it", "by name", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), typ(t, tn, _),
    !owner(c, _), !scope(t, c), qualifier(f, l, n, qn), qn != tn, !typ(_, qn, _), !self_qualifier(qn), !holds_key(qn, n), !field_holder(fl, _), !fa_known(q, c), !const_routed(q, c, f, l).
// A KEY OF A MODULE-LEVEL OBJECT, read behind the object's own name: `TOPICS.CREATED` reads TOPICS's key wherever it is
// written, as `Order.TAX` reads Order's constant. The object is one value, read by its own name, so behind any OTHER
// name (`QUEUES.CREATED`, `upstreams.workspaces`) it is another object's member, and the by-name rules above leave it
// out (field_holder); a field of a TYPE read behind an object that holds a key of that name is left out too (holds_key)
.decl holds_key(h:symbol, n:symbol)
holds_key(h, n) :- field_holder(fl, h), field(fl, _, n, _, _).
// TypeScript records the member of `TOPICS.CREATED` as a BARE name, so the qualifier decides for a bare reference too.
// A bare name with no such qualifier is never an object's key -- a key is only ever read behind its object -- so the
// bare rules below leave object keys out: `workspaces.close()` is a variable, not OFFSETS.workspaces
direct(q, c, "uses", "writes/reads it", "in scope", f, l) :- fref(q, c, _, f, l), target(q, "field", fl, _), field(fl, t, n, _, _), field_holder(fl, h),
    !scope(t, c), qualifier(f, l, n, h), !fa_known(q, c), !const_routed(q, c, f, l).
direct(q, c, "uses", "writes/reads it", "by name", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _),
    !owner(c, _), !scope(t, c), !qualifier(f, l, n, _), !fa_known(q, c), !const_routed(q, c, f, l).
// bare elsewhere: only when the enclosing type has no member of that name itself
direct(q, c, "reads", "reads it", "by name", f, l) :- fref(q, c, "bare", f, l), target(q, "field", fl, _), field(fl, t, n, _, _),
    owner(c, s), !scope(t, s), !declares(s, n), !const_routed(q, c, f, l), !field_holder(fl, _).
direct(q, c, "reads", "reads it", "by name", f, l) :- fref(q, c, "bare", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), !owner(c, _), !scope(t, c), !const_routed(q, c, f, l), !shadowed_in(fl, n, f),
    !field_holder(fl, _).
// a bare name in a file that declares ANOTHER field of that name is that file's own: `const listAdmins = ['root']` in
// one module and a wrapped handler of the same name in another are two declarations, and each answer carried the
// other's readers. A function of that name declared in the file is its own the same way: `module.exports = { createUser }`
// in a service that declares `const createUser = async (body) => …` is not a reader of the controller's wrapped handler
.decl shadowed_in(fl:symbol, n:symbol, f:symbol)
shadowed_in(fl, n, f) :- target(_, "field", fl, _), field(fl, _, n, _, _), field(fl2, _, n, f, _), fl2 != fl.
shadowed_in(fl, n, f) :- target(_, "field", fl, _), field(fl, _, n, ff, _), named(n, m), decl_file(m, f), f != ff.
// a declared accessor is the field's door. The door is a CALL, so it carries the call's tier like every other
// call-derived rule here: a site the engine could not narrow to one declaration is `one of a set`, not `resolved`.
// Binding the tier as a wildcard and hardcoding "resolved" made the accessor door the one place in this file that
// claimed certainty the bundle does not record -- on a single-module library, 10 of 57 sampled accessor rows stood
// on a call whose only tier was multi_inferred. The row itself is right either way (the caller does reach the field
// through that accessor), so nothing is dropped; only the certainty stops being overstated.
// A GENERATED one-argument member named like the field is its builder or fluent SETTER (`email(v)` on the synthesized
// builder, `label(v)` under @Accessors(fluent = true)), so the fluent name's read door must not claim it: the engine
// resolves these calls now (#1405, #1406), and each would otherwise be listed as a read.
.decl gen_setter(a:symbol)
gen_setter(a) :- member(_, a, _, _), match("generated:.*/1", a).
direct(q, c, "reads", cat("reads it through ", an, "()"), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, "read"), member(t, a, an, _), !gen_setter(a), calls(c, a, ti, f, l), ti != "multi_inferred".
direct(q, c, "reads", cat("reads it through ", an, "()"), "one of a set", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, "read"), member(t, a, an, _), !gen_setter(a), calls(c, a, "multi_inferred", f, l).
direct(q, c, "writes", cat("writes it through ", an, "()"), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, "write"), member(t, a, an, _), calls(c, a, ti, f, l), ti != "multi_inferred".
direct(q, c, "writes", cat("writes it through ", an, "()"), "one of a set", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, "write"), member(t, a, an, _), calls(c, a, "multi_inferred", f, l).
// a GENERATED accessor: the unresolved sites written with its name (the decoration says it exists)
direct(q, c, "reads", cat("calls the generated getter ", an, "() — receiver not typed"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen(t, "get"), accessor(fl, an, "read"), named_site(c, an, k, f, l), !ctor_kind(k).
direct(q, c, "writes", cat("calls the generated setter ", an, "() — receiver not typed"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen(t, "set"), accessor(fl, an, "write"), named_site(c, an, k, f, l), !ctor_kind(k).
// the builder / fluent setter the ENGINE resolved: the call is on this type's own builder chain or receiver (#1409)
direct(q, c, "writes", cat("sets it through the generated builder / fluent ", n, "()"), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, w), (w = "builder" ; w = "fluent"), member(t, a, n, _), gen_setter(a), calls(c, a, ti, f, l), ti != "multi_inferred".
direct(q, c, "writes", cat("sets it through the generated builder / fluent ", n, "()"), "one of a set", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, w), (w = "builder" ; w = "fluent"), member(t, a, n, _), gen_setter(a), calls(c, a, "multi_inferred", f, l).
// ...and a same-named call it did NOT resolve. While the engine resolves none of them (a library type, an older engine) it
// is the only lead and stays a writer. Once it resolves one, the setter is modelled, and a same-named call left
// unresolved is on some other chain (`UserView.newBuilder().email(e)`): a lead, not a writer (#1409).
.decl gen_modelled(t:symbol, n:symbol)
gen_modelled(t, n) :- member(t, a, n, _), gen_setter(a).
direct(q, c, "writes", cat("sets it through the generated builder / fluent ", n, "()"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, w), (w = "builder" ; w = "fluent"), !gen_modelled(t, n), named_site(c, n, k, f, l), !ctor_kind(k).
direct(q, c, "uses", cat("calls a same-named ", n, "() that the engine did not place on this type's builder or accessors"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, w), (w = "builder" ; w = "fluent"), gen_modelled(t, n), named_site(c, n, k, f, l), !ctor_kind(k).
direct(q, c, "reads", cat("reads it through the generated accessor ", n, "()"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, "fluent_read"), named_site(c, n, k, f, l), !ctor_kind(k).
direct(q, c, "writes", "passes it to the generated constructor", "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen(t, "ctor"), typ(t, tn, _), named_site(c, tn, k, f, l).
// a string literal equal to its name: a serialized name, a map key, a request parameter
direct(q, c, "uses", "names it in a string literal (serialization? a map key? a request key?)", "text", f, l) :- target(q, "field", fl, _), field(fl, _, n, _, _), literal(c, n, f, l).
// where values of the owning type are PRODUCED: every constructor of the owner, its deserialization (a class literal handed
// somewhere), and the same for every type that holds one — a new shape of the field has to be produced there
.decl produces(q:symbol, c:symbol, why:symbol, cert:symbol, f:symbol, l:number)
produces(q, c, cat("constructs ", tn), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), member(t, k, _, "constructor"), calls(c, k, _, f, l).
produces(q, c, cat("constructs ", tn, " (unresolved site)"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), unresolved(c, tn, k, f, l), ctor_kind(k), !gen(t, "ctor").
produces(q, c, cat("reflects on ", tn, ".class — deserialization or a framework produces it here"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), ref(c, tn, _, "CLASS_LITERAL", f, l).
produces(q, c, cat("constructs ", hn, ", which holds ", tn), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), holds(h, t), typ(h, hn, _), member(h, k, _, "constructor"), calls(c, k, _, f, l).
produces(q, c, cat("constructs ", hn, ", which holds ", tn, " (unresolved site)"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), holds(h, t), typ(h, hn, _), unresolved(c, hn, k, f, l), ctor_kind(k).
produces(q, c, cat("reflects on ", hn, ".class, which holds ", tn, " — deserialization produces the value here"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), holds(h, t), typ(h, hn, _), ref(c, hn, _, "CLASS_LITERAL", f, l).
direct(q, c, "produces", why, cert, f, l) :- produces(q, c, why, cert, f, l), !inside_target(q, c).
.output produces

// a TYPE: callers of its members, its instantiations, references to its name, generated accessors, imported members
.decl tmember(q:symbol, m:symbol, n:symbol, k:symbol)
tmember(q, m, n, k) :- target(q, "type", t, _), member(t, m, n, k).
direct(q, c, "produces", "instantiates it", "resolved", f, l) :- tmember(q, m, _, "constructor"), calls(c, m, _, f, l), !inside_target(q, c).
direct(q, c, "produces", "instantiates it", "resolved", f, l) :- target(q, "type", t, _), implicit_new(c, t, f, l), !inside_target(q, c).
direct(q, c, "uses", cat("calls ", n), "resolved", f, l) :- tmember(q, m, n, k), k != "constructor", calls(c, m, t, f, l), t != "multi_inferred", !inside_target(q, c).
direct(q, c, "uses", cat("calls ", n), "one of a set", f, l) :- tmember(q, m, n, k), k != "constructor", calls(c, m, "multi_inferred", f, l), !inside_target(q, c).
direct(q, c, "produces", "instantiates it (unresolved site)", "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), unresolved(c, n, k, f, l), ctor_kind(k), !inside_target(q, c).
direct(q, c, "produces", "reflects on its .class — deserialization or a framework produces it here", "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), ref(c, n, _, "CLASS_LITERAL", f, l), !inside_target(q, c).
direct(q, c, "uses", "references it", "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), ref(c, n, _, ek, f, l), ek != "CLASS_LITERAL", !local_kind(ek), !member_kind(ek), !inside_target(q, c).
direct(q, c, "uses", cat("names it (", ctx, ")"), "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), typeref(c, n, ctx, f, l), !inside_target(q, c), !typeref_other(q, c, f, l).
// A NAME THE ENGINE ALREADY TIED TO ANOTHER TYPE OF THAT NAME IS THAT TYPE'S. `new App.Entities.Basket()` builds the
// entity; the type_ref row keeps only the simple name `Basket`, so read by name it was also a use of a view component
// `Basket` in another namespace, and --delete on the component said NOT SAFE for a by-name row that constructs the
// entity. Where the same caller, at the same line, constructs another type of the name (a resolved constructor call, or
// an implicit `new T()`, #1473) and not the target, the name at that line is that other type's.
.decl typeref_own_new(q:symbol, c:symbol, f:symbol, l:number)
typeref_own_new(q, c, f, l) :- target(q, "type", t, _), implicit_new(c, t, f, l).
typeref_own_new(q, c, f, l) :- target(q, "type", t, _), member(t, k, _, "constructor"), calls(c, k, _, f, l).
.decl typeref_other(q:symbol, c:symbol, f:symbol, l:number)
typeref_other(q, c, f, l) :- target(q, "type", t, _), typ(t, n, _), typ(t2, n, _), t2 != t, implicit_new(c, t2, f, l), !typeref_own_new(q, c, f, l).
typeref_other(q, c, f, l) :- target(q, "type", t, _), typ(t, n, _), typ(t2, n, _), t2 != t, member(t2, k, _, "constructor"), calls(c, k, _, f, l), !typeref_own_new(q, c, f, l).
// the ALIAS HOP (#784): a type alias whose right-hand side names the target, directly or through another such alias,
// and everything that names the alias. `function finalize(s: DraftState)` breaks when MapState changes and never writes MapState.
.decl alias_over(q:symbol, a:symbol)
alias_over(q, a) :- target(q, "type", t, _), typ(t, n, _), typeref(a, n, _, _, _), type_alias(a), !inside_target(q, a).
alias_over(q, a) :- alias_over(q, b), typ(b, n, _), typeref(a, n, _, _, _), type_alias(a), !inside_target(q, a).
direct(q, c, "uses", cat("names ", an, ", a type alias over it (", ctx, ")"), "by name", f, l) :- alias_over(q, a), typ(a, an, _), typeref(c, an, ctx, f, l), c != a, !inside_target(q, c).
// an INTRINSIC ELEMENT whose attributes are checked against it (#784): `<h1 class="x">` never writes FormElementProps
direct(q, c, "uses", cat("renders <", tag, ">, whose attributes are checked against it"), "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), jsx_props(tag, n), jsx_tag(c, tag, f, l), !inside_target(q, c).
direct(q, c, "uses", cat("renders <", tag, ">, whose attributes are checked against ", sn, ", which extends it"), "by name", f, l) :- target(q, "type", t, _), extends(s, t), typ(s, sn, _), jsx_props(tag, sn), jsx_tag(c, tag, f, l), !inside_target(q, c).
// an OBJECT LITERAL that carries its discriminant (#784): `freeze({ kind: 'LiteralNode', fragments })` is checked against
// LiteralNode and never writes the name, so an added required property breaks it
direct(q, c, "produces", cat("builds an object literal with the tag ", k, ": '", v, "'"), "by name", f, l) :- target(q, "type", t, _), discriminant(t, k, v), keyed_literal(c, k, v, f, l), !inside_target(q, c).
direct(q, c, "produces", cat("builds an object literal with the tag ", k, ": '", v, "' of ", sn, ", which extends it"), "by name", f, l) :- target(q, "type", t, _), extends(s, t), typ(s, sn, _), discriminant(s, k, v), keyed_literal(c, k, v, f, l), !inside_target(q, c).
// a persistence query that names the property (#1461, #1462): a derived repository method name, @Query / named-query
// text, or a whole-entity select that loads it. No call or reference connects them; the rename fails when it is parsed.
.decl persist_words(how:symbol, w:symbol)
persist_words("direct", "its persistence query names the property: a rename breaks the query when it is parsed, not the compile").
persist_words("nested", "its persistence query reads it through an association path").
persist_words("projection", "its persistence query selects the whole entity, which loads this column").
direct(q, m, "reads", w, "resolved", "", 0) :- target(q, "field", fl, _), persist_field(m, fl, how), persist_words(how, w), !inside_target(q, m).
// A MAPPER STATEMENT'S PARAMETER PROPERTY: `#{it.quantity}` in the statement a mapper method's namespace and id
// bind, where the path's root is typed by that method's parameters (axiomcode-impact mapper_params). MyBatis reads the
// property by name when the statement runs, so a rename breaks the statement and not the compile. The row is the
// method, at the marker's line in the XML.
.decl mapper_param(m:symbol, fl:symbol, e:symbol, f:symbol, l:number) .input mapper_param
direct(q, m, "reads", cat("its mapper statement binds it as a parameter property (#{", e, "})"), "resolved", f, l) :- target(q, "field", fl, _), mapper_param(m, fl, e, f, l), !inside_target(q, m).
// A VALUE HANDED TO A REFLECTIVE PROPERTY COPY (`BeanUtil.copyProperties(item, ItemView.class)`): the copy reads the
// field by name, so a rename drops the value and nothing fails. The copy INTO the type is the producer rule above
// (`reflects on T.class`); this is the value going out. The argument is typed by its declaration's written type
// (axiomcode-impact bean_copies), so it is `by name`.
.decl bean_copy(c:symbol, fl:symbol, tn:symbol, n:symbol, f:symbol, l:number) .input bean_copy
direct(q, c, "uses", cat("hands a value of ", tn, " to ", n, "(), which copies its properties by name through reflection: a rename or a retype drops the value silently"), "by name", f, l) :- target(q, "field", fl, _), bean_copy(c, fl, tn, n, f, l), !inside_target(q, c).
// a signature the engine RESOLVED to the type (#1422): a parameter, a return, or a type argument of either. Java's
// type_refs carry no line, so no typeref row held these, and the textuse grep below labelled each one `text`
.decl sig_words(ctx:symbol, w:symbol)
sig_words("METHOD_PARAM", "a parameter"). sig_words("METHOD_RETURN", "the return type").
.decl sig_resolved(q:symbol, c:symbol)
sig_resolved(q, c) :- target(q, "type", t, _), sigtype(c, t, _, _), !inside_target(q, c).
// a signature typeref already names at its line (the rule above, by name with a site) gets no second, lineless row
.decl sig_at_line(q:symbol, c:symbol, ctx:symbol)
sig_at_line(q, c, ctx) :- target(q, "type", t, _), typ(t, n, _), typeref(c, n, ctx, _, _), sig_words(ctx, _).
direct(q, c, "uses", cat("names it in its signature (", w, ")"), "resolved", "", 0) :- target(q, "type", t, _), sigtype(c, t, ctx, 0), sig_words(ctx, w), !inside_target(q, c), !sig_at_line(q, c, ctx).
direct(q, c, "uses", cat("names it in its signature (a type argument of ", w, ")"), "resolved", "", 0) :- target(q, "type", t, _), sigtype(c, t, ctx, d), d > 0, sig_words(ctx, w), !inside_target(q, c), !sig_at_line(q, c, ctx).
direct(q, c, "uses", "names it (a signature or a declaration)", "text", f, l) :- target(q, "type", t, _), typ(t, n, _), textuse(c, n, f, l), !inside_target(q, c), !sig_resolved(q, c).
direct(q, c, "uses", cat("uses ", n, ", imported from it"), "by name", f, l) :- target(q, "type", _, _), importuse(c, n, f, l), !inside_target(q, c).
direct(q, c, "reads", cat("calls the generated getter ", an, "()"), "by name", f, l) :- target(q, "type", t, _), gen(t, "get"), field(fl, t, _, _, _), accessor(fl, an, "read"), unresolved(c, an, k, f, l), !ctor_kind(k), !inside_target(q, c).
direct(q, c, "writes", cat("calls the generated setter ", an, "()"), "by name", f, l) :- target(q, "type", t, _), gen(t, "set"), field(fl, t, _, _, _), accessor(fl, an, "write"), unresolved(c, an, k, f, l), !ctor_kind(k), !inside_target(q, c).

// static initialization: whoever first touches the type
direct(q, c, role, cat(why, " — first use runs the static initializer"), cert, f, l) :- target(q, "clinit", t, _), target(qq, "type", t, _), qq = cat(q, ":type"), direct(qq, c, role, why, cert, f, l).

// a PARAMETER: the method itself, its callers, (the overrides are the contract)
direct(q, m, "uses", "declares it", "resolved", "", 0) :- target(q, "param", m, _).
direct(q, c, "uses", "passes an argument for it", "resolved", f, l) :- target(q, "param", m, _), calls(c, m, _, f, l).
direct(q, c, "uses", "calls a method of this name (receiver not typed) — its argument list must match", "by name", f, l) :- target(q, "param", m, _), named(n, m), unresolved(c, n, k, f, l), !ctor_kind(k).

// a TYPE PARAMETER of a type: every callable inside the type that spells it; of a method: the method. A bound reaches the uses of Type<…> too
direct(q, c, "uses", cat("uses ", x, " in its body or signature"), "text", f, l) :- target(q, "typeparam", _, x), textuse(c, x, f, l).
direct(q, c, "uses", cat(why, " — the argument must satisfy ", x), cert, f, l) :- target(q, "typeparam", t, x), typ(t, _, _), target(qq, "type", t, _), qq = cat(q, ":type"), direct(qq, c, "uses", why, cert, f, l), (cert = "text" ; cert = "by name").
direct(q, c, "produces", cat(why, " — the argument must satisfy ", x), cert, f, l) :- target(q, "typeparam", t, x), typ(t, _, _), target(qq, "type", t, _), qq = cat(q, ":type"), direct(qq, c, "produces", why, cert, f, l).
direct(q, c, "uses", cat("calls it — its arguments must satisfy ", x), "resolved", f, l) :- target(q, "typeparam", m, x), !typ(m, _, _), calls(c, m, _, f, l).

// a LOCAL: the method, and a closure inside it that captures the name
direct(q, m, "uses", "declares it", "resolved", "", 0) :- target(q, "var", m, _).
direct(q, c, "uses", "captures it (defined inside the method)", "resolved", f, l) :- target(q, "var", m, x), edge(m, c, "defines"), ref(c, x, _, ek, f, l), local_kind(ek).
.output direct


// ── declared alongside it: the sibling members of the target's own type, and the other types declared in the same file.
//    The weakest certainty there is — no call, no reference, no contract binds them; only "a fix that touches one of these
//    very often touches the other". Excluded from `seed` below, or the closure would pull in the whole file's upstream.
.decl alongside(q:symbol, c:symbol, why:symbol)
.decl target_owner(q:symbol, t:symbol)
target_owner(q, t) :- target(q, "method", m, _), owner(m, t).
target_owner(q, t) :- target(q, "param", m, _), owner(m, t).
target_owner(q, t) :- target(q, "var", m, _), owner(m, t).
target_owner(q, t) :- target(q, "field", fl, _), field(fl, t, _, _, _).
target_owner(q, t) :- target(q, "type", t, _).
target_owner(q, t) :- target(q, "clinit", t, _).
target_owner(q, t) :- target(q, "newconst", t, _).
.decl is_target_decl(q:symbol, c:symbol)                          // the declaration(s) the query is ABOUT — never "alongside" itself
is_target_decl(q, c) :- target(q, "method", c, _).
is_target_decl(q, c) :- target(q, "param", c, _).
is_target_decl(q, c) :- target(q, "var", c, _).
is_target_decl(q, c) :- target(q, "clinit", _, c).
is_target_decl(q, c) :- target(q, "typeparam", c, _).
.decl callable_member(t:symbol, c:symbol)
callable_member(t, c) :- member(t, c, _, k), k != "field", k != "const", k != "enum_member", k != "variable".
// a sibling that touches the same state as the target is the one worth reading first (#762: "restrict it to the members
// that share a field with the target"), so it is told apart from the rest rather than ranked by chance
.decl target_field(q:symbol, n:symbol)
target_field(q, n) :- is_target_decl(q, m), ref(m, n, _, ek, _, _), !local_kind(ek), target_owner(q, t), member(t, _, n, k), (k = "field" ; k = "const").
target_field(q, n) :- target(q, "field", fl, _), field(fl, _, n, _, _).
.decl shares_field(q:symbol, c:symbol, n:symbol)
// a same-named LOCAL is not this field — the field layer rules that out and this leg must rule it out too, or a sibling
// is credited with using state it never touches (#762)
shares_field(q, c, n) :- target_field(q, n), ref(c, n, _, ek, _, _), !local_kind(ek), target_owner(q, t), callable_member(t, c).
alongside(q, c, cat("a sibling of the same type, using the same field ", n)) :- shares_field(q, c, n), !inside_target(q, c), !is_target_decl(q, c).
alongside(q, c, "a sibling of the same type") :- target_owner(q, t), callable_member(t, c), !inside_target(q, c), !is_target_decl(q, c), !shares_field(q, c, _).
alongside(q, c, "declared in the same file") :- target_owner(q, t), type_in_file(t, f), type_in_file(t2, f), t2 != t, callable_member(t2, c), !inside_target(q, c), !is_target_decl(q, c).
direct(q, c, "uses", why, "alongside", "", 0) :- alongside(q, c, why).


// ── an ANNOTATION as the target: the declarations carrying it, and (through the seeds) everything that reaches them.
//    Half of the Java commits that touch Java change one (#758); what the framework DOES with it is not in the graph.
direct(q, c, "uses", "carries this decoration", "resolved", "", 0) :- target(q, "decoration", c, _).

// ── a CONSTANT THAT DOES NOT EXIST YET (`Enum.<new>`): the impact is every switch over that enum, plus the enum's own
//    members. The question cannot be asked of a declaration, because the declaration is what the edit will add.
direct(q, c, "uses", cat("switches over it (", arms, " of its constants named) — a new constant needs an arm here"), "resolved", "", 0) :- target(q, "newconst", t, _), switch_over(c, t, arms).
direct(q, c, "uses", "a member of the enum", "alongside", "", 0) :- target(q, "newconst", t, _), callable_member(t, c).
// the same switches are worth naming when the target IS an existing constant or the enum itself
direct(q, c, "uses", cat("switches over the enum (", arms, " of its constants named)"), "resolved", "", 0) :- target(q, "type", t, _), typ(t, _, "enum"), switch_over(c, t, arms), !inside_target(q, c).
direct(q, c, "uses", cat("switches over the enum (", arms, " of its constants named)"), "resolved", "", 0) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, _, "enum"), switch_over(c, t, arms), !inside_target(q, c).

// ── a THROWS clause is a contract: adding a checked exception reaches every caller. Which of them already handle one is
//    the difference between "look at it" and "it will not compile".
.decl caller_handles(q:symbol, c:symbol, e:symbol)
caller_handles(q, c, e) :- target(q, "method", m, _), throws_(m, e), calls(c, m, _, _, _), throws_(c, e).
caller_handles(q, c, e) :- target(q, "method", m, _), throws_(m, e), calls(c, m, _, _, _), catches(c, e).
.decl caller_unhandled(q:symbol, c:symbol, e:symbol)
caller_unhandled(q, c, e) :- target(q, "method", m, _), throws_(m, e), calls(c, m, _, _, _), !caller_handles(q, c, e).
.output caller_handles
.output caller_unhandled
.decl target_throws(q:symbol, e:symbol)
target_throws(q, e) :- target(q, "method", m, _), throws_(m, e).
.output target_throws

// ── seeds: where the change lands. A callable: itself. A declaration: every callable whose text uses it ────────
.decl seed_of(q:symbol, m:symbol)                                 // the seeds proper — what `alongside` must never be, nor feed
.decl seed(q:symbol, m:symbol)
seed_of(q, m) :- target(q, "method", m, _).
seed_of(q, m) :- target(q, "param", m, _).
// a local is not the method: seeding the method would answer a signature change. Only the closures declared inside
// it carry the value out, and they are already direct rows
seed_of(q, c) :- target(q, "var", m, _), edge(m, c, "defines").
seed_of(q, m) :- target(q, "clinit", _, m).
seed_of(q, m) :- target(q, "decoration", m, _).
seed_of(q, t) :- target(q, "newconst", t, _).
seed_of(q, c) :- target(q, "newconst", t, _), switch_over(c, t, _).
seed_of(q, m) :- target(q, "config", k, _), config(k, m, _).
seed_of(q, c) :- target(q, "config", k, _), cs_config_literal(k, c, _, _, _).
seed_of(q, t) :- target(q, "field", fl, _), field(fl, t, _, _, _).
seed_of(q, m) :- target(q, "type", t, _), member(t, m, _, _), kind(m, k), (k = "method" ; k = "constructor" ; k = "function" ; k = "module").
seed_of(q, t) :- target(q, "type", t, _).
seed_of(q, t) :- target(q, "typeparam", t, _).
seed_of(q, c) :- target(q, k, _, _), k != "method", k != "param", k != "var", direct(q, c, _, _, cert, _, _), cert != "alongside".
seed_of(q, c) :- target(q, "typeparam", t, _), typ(t, _, _), direct(q, c, _, _, cert, _, _), cert != "alongside".
seed_of(q, c) :- contract(q, c, _).
seed(q, m) :- seed_of(q, m).
.output seed

// every resolved direct row names the declaration its edge lands on, so `verified:` can check THAT pair — not
// merely that the caller calls something
.decl direct_edge(q:symbol, c:symbol, callee:symbol)
direct_edge(q, c, m) :- target(q, "method", m, _), calls(c, m, _, _, _).
// a via_base row claims the engine's edge at its site: the base's, or the override the call was narrowed to (#1542)
direct_edge(q, c, e) :- target(q, "method", m, _), via_base(c, m, _, _, _, _, e), !is_target_decl(q, c).
direct_edge(q, c, a) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, _), member(t, a, an, _), calls(c, a, _, _, _).
direct_edge(q, c, k) :- target(q, "field", fl, _), field(fl, t, _, _, _), member(t, k, _, "constructor"), calls(c, k, _, _, _).
direct_edge(q, c, k) :- target(q, "field", fl, _), field(fl, t, _, _, _), holds(h, t), member(h, k, _, "constructor"), calls(c, k, _, _, _).
direct_edge(q, c, m) :- tmember(q, m, _, _), calls(c, m, _, _, _).
// an instantiation of a type that writes no constructor lands on the type itself: the engine's ctor_implicit_type row (#1473)
direct_edge(q, c, t) :- target(q, "type", t, _), implicit_new(c, t, _, _).
direct_edge(q, c, m) :- target(q, "param", m, _), calls(c, m, _, _, _).
direct_edge(q, c, m) :- target(q, "typeparam", m, _), calls(c, m, _, _, _).
.output direct_edge

// ── a barrel that re-exports the declaration: the line must change with a rename, and it is in no other table ──
direct(q, c, "uses", "re-exports it (a barrel: this line must change with a rename)", "text", f, l) :- target(q, "method", m, _), named(n, m), reexport(c, n, f, l).
direct(q, c, "uses", "re-exports it (a barrel: this line must change with a rename)", "text", f, l) :- target(q, "field", fl, _), field(fl, _, n, _, _), reexport(c, n, f, l).
direct(q, c, "uses", "re-exports it (a barrel: this line must change with a rename)", "text", f, l) :- target(q, "type", t, _), typ(t, n, _), reexport(c, n, f, l).
// `export *` only from the module it is declared in: the line's own source file, or a file a further `export *` of
// that one reaches. Every `export *` in the repository used to qualify, whatever it pointed at.
.decl star_reach(f:symbol, l:number, df:symbol)
star_reach(f, l, s) :- reexport_from(f, l, s).
star_reach(f, l, d) :- star_reach(f, l, s), reexport_from(s, _, d).
direct(q, c, "uses", "re-exports the whole module it is declared in (export * — a rename changes what this file exports)", "text", f, l) :- target(q, "method", m, _), decl_file(m, df), reexport(c, "*", f, l), star_reach(f, l, df), f != df.

// ── a STRING target: a topic, a queue, a route, a bean qualifier — a name in a namespace that is not the code's ──
direct(q, c, "uses", "names it in a string literal", "text", f, l) :- target(q, "string", _, v), literal(c, v, f, l).
direct(q, c, "uses", cat("binds to it through @", d), "text", f, l) :- target(q, "string", _, v), dec_literal(c, d, v, f, l).
seed_of(q, c) :- target(q, "string", _, _), direct(q, c, _, _, cert, _, _), cert != "alongside".

// ── the transitive layer: everything that can reach a seed through resolved calls, shortest hop count ──────────
// A call site written with the target's simple name that the engine could not resolve (the receiver was not typed —
// a nested type reached through `import static Outer.Inner`, a dynamic receiver) MAY be a call to the target. It is
// not a resolved edge, so it is kept out of seed / direct and enters only here, marked, so the answer can say so.
.decl seed_byname(q:symbol, c:symbol)
seed_byname(q, c) :- target(q, "method", m, _), named(n, m), unresolved(c, n, k, _, _), k != "stub", !seed(q, c).
// and a declaration handed over as a VALUE — `Depends(get_settings)`, `add_task(send_receipt, id)`, an element of
// a pipeline list. `valueref` already produces the DIRECT row for these ("names it as a value — passed, stored or
// registered"), and the closure stopped there: the answer named the callable that hands it over and then said the
// closure could not start, so the test that drives that callable was never reached. A value handed to a framework
// is the whole shape this skill exists for, and the row was being printed and then dropped one line later.
// It enters as a by-name seed, not a seed proper, so the rung stays `by name`: the guards on `valueref` make it a
// stronger claim than a bare name match, and it is still a name match.
seed_byname(q, c) :- valueref(q, c, _, _), !seed(q, c).
// NOT narrowed to "a value the framework CONSUMES", though that is the natural next thought and it was measured:
// seeding only where a call happens on the same line loses four of the five true pairs on the service subject and
// removes NONE of the cost on the CLI one, whose false pairs come from a single hub name whose value references sit
// on call lines anyway. A structural predicate cuts noise that shares a SHAPE; this noise shares a TARGET.
// And a warning for whoever writes the next same-line predicate: `conf=Depends(provider)` in a signature has TWO
// owners. The default argument is evaluated at module scope, so the `calls` fact carries the MODULE as caller while
// the value reference belongs to the function — a same-line join on the caller misses it entirely, and it reads as
// a missing fact rather than as a scoping difference.
.output seed_byname
.decl up(q:symbol, m:symbol, d:number)
up(q, m, 0) :- seed(q, m).
up(q, c, 1) :- seed_byname(q, c).
up(q, a, d+1) :- up(q, b, d), edge(a, b, _), d < 40.
up(q, a, d+1) :- up(q, b, d), fw_edge(a, b, _), d < 40.
.decl reach(q:symbol, m:symbol, d:number)
reach(q, m, d) :- up(q, m, d), d = min x : up(q, m, x).
// the chain read-back: a is one hop further from the change than b, through edge a → b
.decl parent_up(q:symbol, a:symbol, b:symbol, t:symbol)
parent_up(q, a, b, t) :- reach(q, a, d), d > 0, reach(q, b, d1), d1 = d - 1, edge(a, b, t).
parent_up(q, a, b, t) :- reach(q, a, d), d > 0, reach(q, b, d1), d1 = d - 1, fw_edge(a, b, t).
// The import hop is taken from a MODULE BODY, and only when that module body is reached by edges which actually
// RUN. `up` walks `defines` as well, which is right for it — a change to an inner function does concern the
// function that declares it — but `defines` is not execution: `audited` DEFINES `wrapper` and returns it, and
// nothing in `wrapper` runs while the module is being imported, so breaking it cannot break the import. Taking
// this hop off `up` named every test in every importing file for the wrapper of every decorator applied at module
// level. The case suite caught that; the measurement did not, because no target on the measured subjects had the
// shape — which is the whole argument for keeping cases beside a corpus.
.decl up_running(q:symbol, m:symbol, d:number)
up_running(q, m, 0) :- seed(q, m).
up_running(q, a, d+1) :- up_running(q, b, d), edge(a, b, "known_edge"), d < 40.
.decl import_hop(q:symbol, a:symbol, b:symbol)
import_hop(q, a, mod) :- up_running(q, mod, _), kind(mod, "module"), decl_file(mod, g), imports_file(f, g),
                         decl_file(a, f), kind(a, "module"), a != mod.
up(q, a, d+1) :- up_running(q, b, d), import_hop(q, a, b), d < 40.
parent_up(q, a, b, "at import") :- reach(q, a, d), d > 0, reach(q, b, d1), d1 = d - 1, import_hop(q, a, b).
.output reach
.output parent_up

// the same closure from the seeds that are an exact edge only: what is reached ONLY through a [by name] / [text] /
// [one of a set] dependent is everything outside it, and the answer says how much of itself rests on those
.decl seed_sure(q:symbol, m:symbol)
seed_sure(q, m) :- seed(q, m), !weak_seed(q, m).
.decl weak_seed(q:symbol, m:symbol)
// a seed proper is the change itself (the target, its overrides, the members of a target type): its certainty is not
// in question, whatever a text-level rule also said about it, so it never makes the closure below it look weak
weak_seed(q, c) :- direct(q, c, _, _, cert, _, _), (cert = "by name" ; cert = "text" ; cert = "one of a set"), !strong_direct(q, c), !seed_of(q, c).
.decl strong_direct(q:symbol, c:symbol)
strong_direct(q, c) :- direct(q, c, _, _, "resolved", _, _).
strong_direct(q, c) :- direct(q, c, _, _, "in scope", _, _).
.decl up_sure(q:symbol, m:symbol, d:number)
up_sure(q, m, 0) :- seed_sure(q, m).
up_sure(q, a, d+1) :- up_sure(q, b, d), edge(a, b, _), d < 40.
.decl reach_sure(q:symbol, m:symbol)
reach_sure(q, m) :- up_sure(q, m, _).
.output reach_sure

// ── a REGISTRATION KEY: the hop a framework makes and no call site records ────────────────────────────────────
// A route handler, a signal receiver, a CLI command and a table entry are all the same shape: the declaration is
// registered under a STRING, and whoever wants it writes that string rather than its name. `@router.post("/orders")`
// and `client.post("/orders")`; `@receiver("order_created")` and `emit("order_created", …)`; `@cli.command("price")`
// and `invoke(cli, ["price", "4"])`; `@exporter("csv")` and `export(order, "csv")`. The graph has both ends — the
// key is in the decoration and in the body — and nothing joined them, so every test that drives the app through
// its framework reached nothing, which is most of what a test suite does to a service.
//
// It is NOT an edge the engine resolved and is never reported as one: a literal can be a same-valued other thing.
// It enters the closure marked `by key`, the weakest hop there is after `by name`, and the answer says so.
.decl reg_key(m:symbol, d:symbol, k:symbol)
reg_key(m, d, k) :- reg_key_fact(m, d, k).
// A KEY THAT IDENTIFIES MANY DECLARATIONS IDENTIFIES NONE. `@app.route("/")` inside a test is written by every
// test file that needs an app, so on the Python web framework's own suite the key "/" registers 236 declarations and is written by
// 200 more: the join is a complete graph between them and says nothing. This is the engine's own `fan_capped`
// judgement one layer up — over the cap the SET IS REFUSED rather than emitted, and the answer says how many.
.decl reg_key_fan(k:symbol, n:number)
reg_key_fan(k, n) :- reg_key(_, _, k), n = count : { reg_key(_, _, k) }.
// and the same on the OTHER side, for the same reason. On the JVM parser the keys that survive the registration cap are
// `p`, `b`, `table`, `em` — HTML tag names, written by 356 callables and "registered" by two, because a
// decoration argument is not always a registration (`@ValueSource(strings = {"p"})` is test DATA). A key written
// everywhere identifies nothing either, whichever side the fan is on, and this needs no catalogue of which
// decorations register and which do not.
// A HANDLER TABLE'S KEY (kind "table": `{ [TOPICS.CREATED]: onCreated }`, ax_registration.table_registrations) is a
// message type. Its writers are the services that publish it AND the tests that publish it to drive the consumer, and a
// suite that exercises one event type from ten tests has not made the type identify nothing: only the PRODUCTION
// writers count against the cap. And a handler registered under the key that writes it again (to log it, to pass it
// on) consumes that type; it is not a producer of it.
//   test_code(c)                      c is declared in a test file
.decl test_code(c:symbol)                                         .input test_code
.decl table_key(k:symbol)
table_key(k) :- reg_key(_, "table", k).
.decl key_written(c:symbol, k:symbol)
key_written(c, k) :- literal(c, k, _, _), !table_key(k).
key_written(c, k) :- literal(c, k, _, _), table_key(k), !test_code(c), !reg_key(c, "table", k).
.decl key_use_fan(k:symbol, n:number)
key_use_fan(k, n) :- key_written(_, k), n = count : { key_written(_, k) }.
.decl key_capped(k:symbol)
key_capped(k) :- reg_key_fan(k, n), key_cap(c), n > c.
key_capped(k) :- key_use_fan(k, n), key_use_cap(c), n > c.
.output key_capped
// THE HTTP METHOD, where both sides name one (ax_registration.route_verbs / literal_verbs): a test that POSTs "/orders"
// drives the handler that answers POST, not the one beside it that answers GET. A side that names none joins as before.
// The writer cap is counted per registration over the writers whose method fits it, so a path five tests write, one
// verb each, is not refused on behalf of a handler only two of them can reach; a key with no verb anywhere counts
// exactly as before.
//   reg_verb(b, k, v)                 route k registered by b answers the HTTP method v
//   lit_verb(a, k, v)                 a writes the path k as the argument of a request call for the method v
.decl reg_verb(b:symbol, k:symbol, v:symbol)                      .input reg_verb
.decl lit_verb(a:symbol, k:symbol, v:symbol)                      .input lit_verb
.decl key_join(a:symbol, b:symbol, k:symbol, w:symbol)
key_join(a, b, k, k) :- literal(a, k, _, _), reg_key(b, _, k), a != b, !reg_key(a, "table", k).
// the same, where the two spellings of the path differ: /orders/o-1/price written, /orders/{order_id}/price registered
key_join(a, b, r, w) :- literal(a, w, _, _), route_alias(w, r), reg_key(b, _, r), a != b.
.decl verb_fits(a:symbol, b:symbol, k:symbol, w:symbol)
verb_fits(a, b, k, w) :- key_join(a, b, k, w), !reg_verb(b, k, _).
verb_fits(a, b, k, w) :- key_join(a, b, k, w), !lit_verb(a, w, _).
verb_fits(a, b, k, w) :- key_join(a, b, k, w), lit_verb(a, w, v), reg_verb(b, k, v).
.decl reg_capped(k:symbol)
reg_capped(k) :- reg_key_fan(k, n), key_cap(c), n > c.
// the writers of the key as registered (an alias spelling is not counted, as before). A helper relation, not
// `count : { verb_fits(_, b, k, k) }`: Soufflé 2.5 counts an aggregate atom with a repeated variable as 1.
.decl exact_fit(a:symbol, b:symbol, k:symbol)
exact_fit(a, b, k) :- verb_fits(a, b, k, k), !table_key(k).
exact_fit(a, b, k) :- verb_fits(a, b, k, k), table_key(k), !test_code(a).
.decl use_fan_for(b:symbol, k:symbol, n:number)
use_fan_for(b, k, n) :- reg_key(b, _, k), n = count : { exact_fit(_, b, k) }.
.decl fw_edge(a:symbol, b:symbol, how:symbol)
fw_edge(a, b, "by key") :- verb_fits(a, b, k, _), !reg_capped(k), use_fan_for(b, k, n), key_use_cap(c), n <= c.
// and the other direction for a HANDLER TABLE, as for `remote`: what a publisher writes is what the handler registered
// under its type receives, so a change to the publisher's payload is a change to the handler's input. A direct row
// only, never a seed: whoever else reaches the handler does not thereby depend on this publisher.
direct(q, c, "uses", cat("handles what this publishes: registered in a handler table under \"", cat(k, "\" — whatever dispatches the table by that key calls it, no call does")), "by key", "", 0)
    :- target(q, "method", m, _), fw_edge(m, c, "by key"), verb_fits(m, c, k, _), table_key(k), c != m.
// a decorator that REBINDS THE NAME: `@audited def summarise` leaves `summarise` denoting the wrapper, so every
// caller written with that name runs the wrapper. This one is the engine's own resolution, not a name match.
fw_edge(a, b, "decorator") :- calls(a, m, _, _, _), decorated_name(m, b), a != b.
// A TEST THAT RUNS A SCRIPT AS A CHILD PROCESS, BY ITS PATH. `execFileSync(node, [path.join(__dirname, '..', 'bin',
// 'cli.js')])`, `subprocess.run([sys.executable, SCRIPT])`: the script's module body runs in another process, and no
// call site or import records it — so everything the script reaches looked untested. The path written in the test is
// joined to the file this graph indexed (ax_spawn.py), only at a call that starts a process: reading the same path is
// not running it. A key, not a call, so it is its own rung, and a file of another language is in no graph of this one.
.decl spawns_fact(a:symbol, b:symbol)                             .input spawns_fact
fw_edge(a, b, "spawns") :- spawns_fact(a, b), a != b.
// a decorator the project DECLARES ITSELF: `@exporter("csv") def export_csv` means export_csv is whatever exporter
// returned, so a change to the decorator changes what every declaration it wraps does. Nothing links the two but the
// `@` line: the decorator has no call site, and the registry it writes into is read by a key, not by a name. The
// decoration is a simple NAME, so the edge is drawn only when that name denotes exactly one declaration in the repo,
// or the one it denotes is declared in the same file. `@property`, `@pytest.fixture`, `@Override` resolve to nothing
// here and draw no edge, which is the silence this guard is for.
.decl dec_decl(d:symbol, w:symbol)
dec_decl(d, w) :- decorated(_, d), named(d, w), 1 = count : { named(d, _) }.
dec_decl(d, w) :- decorated(s, d), named(d, w), decl_file(s, f), decl_file(w, f).
fw_edge(a, b, "decorator by name") :- decorated(a, d), dec_decl(d, b), a != b.
// A CLIENT ACROSS A PROCESS: the sender depends on the handler it reaches (#1293). `remote` above makes the client a
// DIRECT row; walked only there, a test that drives the client never reached a change to the handler, so
// test-impact stopped at the route while impact named the client one line up. Walked here as its own tier, the
// test route carries the `remote` rung, so it is never read as a call chain. One direction only: a handler does
// not depend on who sends to it.
fw_edge(a, b, "remote") :- remote(a, b, _, _, _), a != b.
// A SERVLET FILTER A TEST'S CONTEXT HOLDS. A filter handed to HttpSecurity in a configuration the test class loads
// (@Import, @ContextConfiguration, a whole-application @SpringBootTest), or a filter that is a component of the
// application, runs on every request the test sends, and no call site says so (ax_registration.filter_links). Only
// the test methods that send a request get the hop; its own rung, `registered`, never a call chain.
.decl filter_run(a:symbol, b:symbol, how:symbol)                  .input filter_run
fw_edge(a, b, "filter") :- filter_run(a, b, _), a != b.
// and the filter's own answer names who runs it, worded as a framework hop (the `framework` rule above)
direct(q, c, "uses", cat("framework-mediated, not a call: servlet_filter via ", cat(how, " [registered]")), "framework", "", 0)
    :- target(q, "method", m, _), filter_run(c, m, how), c != m.
// THE PROTOCOL MEMBERS OF A TYPE YOU CONSTRUCT. `with Audit(...) as a`, `for line in audit`, `a == b`, `len(x)`,
// `x[k]` — each runs a method, and none of them writes its name, so `__enter__`, `__iter__`, `__eq__` and their
// siblings have no call site at all and a test that drives them looks unrelated. The one thing the graph does see
// is the CONSTRUCTION: you do not make a context manager without entering it, or a comparable value without
// comparing it, so whoever constructs the type is the one who runs its protocol.
// `__init__` is excluded because a construction already IS an edge to it — adding it here would say the same thing
// twice, which is the shape that made an override count as both contract and reached.
.decl protocol_member(t:symbol, m:symbol)
protocol_member(t, m) :- member(t, m, n, _), match("__.*__", n), n != "__init__".
.decl constructs(c:symbol, t:symbol)
constructs(c, t) :- member(t, i, "__init__", _), edge(c, i, _), c != i.
// The hop is taken only where the CHANGE ITSELF is a protocol member, not wherever one turns up in the closure.
// As a global edge it was logically fine and empirically noisy: any closure that happened to contain a protocol
// member pulled in every constructor of that type and, through them, their tests. Measured across three subjects
// that cost 115 false pairs for 46 true ones. Narrowed to the seed it keeps what it was written for — a
// declaration with NO call site by design, whose callers are whoever built the object — and drops the rest.
.decl protocol_hop(q:symbol, c:symbol, m:symbol)
protocol_hop(q, c, m) :- seed(q, m), protocol_member(t, m), constructs(c, t), c != m.
up(q, c, 1) :- protocol_hop(q, c, _).
parent_up(q, a, b, "protocol") :- reach(q, a, d), d > 0, reach(q, b, d1), d1 = d - 1, protocol_hop(q, a, b).
// WHAT RUNS AT IMPORT. `settings = Settings()` at the top level of a module is executed by the import statement,
// so breaking Settings.__init__ breaks importing that module, and with it every module that imports it and every
// test in those files. The graph records the module body's call to the constructor and records nothing at all about
// imports, so the chain stops at the module that owns the object and the tests seven files away look unrelated.
//
// An import is not a call and the parser gives no import edge, so what a file imports is read from its own text
// (`imports()` in axiomcode-impact, per language). Only a target that resolves to a file IN THIS REPOSITORY is
// kept: a stdlib or third-party import names no file here and is dropped rather than guessed.
.decl imports_fact(f:symbol, g:symbol)                            .input imports_fact
// ASKED FOR, NOT PRECOMPUTED (#1033). `import_hop` only ever reads the files that import a module the change
// reaches, so the closure is walked backwards from those files and nowhere else. The whole-project closure this
// replaces was the same for every question and quadratic to build (imports_file joined to itself): on a
// 3.6k-file TypeScript graph it was 1.2M rows and 27 s of a 38 s solve, the flat floor under every `impact`.
.decl import_goal(g:symbol)
import_goal(g) :- up_running(_, mod, _), kind(mod, "module"), decl_file(mod, g).
.decl imports_file(f:symbol, g:symbol)
imports_file(f, g) :- import_goal(g), imports_fact(f, g).
// and transitively: a test file imports the module that imports the settings object. The chain is what makes
// the rule worth anything — the file that breaks is almost never the file the test names. Linear in the chain:
// any path of imports from f to g with f != g yields the pair, the same set the self-join derived.
imports_file(f, g) :- imports_fact(f, h), imports_file(h, g), f != g.
.output fw_edge

// ── tests: a test's own body reaches the change, or a fixture its framework runs before it does ───────────────
.decl test_hit(q:symbol, m:symbol, d:number, via:symbol)
test_hit(q, m, d, "") :- reach(q, m, d), test_method(m).
test_hit(q, m, d, fx) :- reach(q, fx, d), fixture(fx), !injected_fixture(fx), owner(fx, t), scope(t, s), member(s, m, _, _), test_method(m).
test_hit(q, m, d, fx) :- reach(q, fx, d), fixture(fx), typ(fx, _, _), member(fx, m, _, _), test_method(m).
// a test file is imported as a whole: a class body or a fixture at its top level runs before every test in it — pytest
// injects a fixture by parameter name and a the Python validation library model class is built at import, and neither is a call edge
// An OWNED fixture is already carried, scoped to its type, by the rule above. Only a fixture that
// belongs to no type -- a conftest.py fixture, a module-level setup -- has the file as its scope; a
// constructor is a fixture too, and file-keyed it carried a sibling @Nested class's tests.
// A fixture injected BY NAME is not one of these: it runs for the tests that request it (uses_fixture below), and a
// module-level `@pytest.fixture` credited to every test in its file counted tests that never ran it (#1527).
test_hit(q, m, d, c) :- reach(q, c, d), decl_file(c, f), decl_file(m, f), test_method(m), !test_method(c), (kind(c, "module") ; (fixture(c), !owner(c, _), !injected_fixture(c))).
// a CLASS body runs before the tests that class declares, and before those of a type nested in it or deriving from
// it -- which is what scope/2 already ranges over. Keyed on the file instead, one Java source file is one unit, so a
// reached @Nested class carried every test of its SIBLING classes too.
test_hit(q, m, d, c) :- reach(q, c, d), kind(c, "class"), scope(c, s), member(s, m, _, _), test_method(m), !test_method(c).
// and a helper declared in a test file: a callable in that file that is not itself a test is written for the tests
// beside it (a builder, a describe callback, a fixture arrow), so what it reaches, those tests reach
// Scoped to the type the helper belongs to (and what that type encloses or is extended by), not to the file: a
// JUnit file holds several @Nested classes, and a helper private to one of them is not written for a sibling's
// tests. A helper that belongs to no type -- a module-level function, an arrow beside the describe block -- has no
// scope narrower than the file, and keeps it.
// ...except a callable written INSIDE a test method (a C# or Java lambda, a local function): it belongs to that test,
// not to its type. Owned by the class, a `mock.Setup(s => ...)` or `Func<int> f = () => ...` in one test carried its
// callees to every test of the class as [fixture], and the test holding it lost its own route (#1556).
// Java (#1416) and C# (#1499) test-class members are scoped by their own rules below, not by their class.
test_hit(q, m, d, c) :- reach(q, c, d), owner(c, t), scope(t, s), member(s, m, _, _), test_method(m), !test_method(c), !injected_fixture(c), !in_test_body(c), decl_file(c, f), is_test_file(f), !java_decl(c), !cs_decl(c).
.decl in_test_body(c:symbol)
in_test_body(c) :- lex_in(m, c), test_method(m), !test_method(c).
test_hit(q, m, d, c) :- reach(q, c, d), owner(c, _), in_test_body(c), lex_in(m, c), test_method(m).
// JAVA: A HELPER METHOD OF A TEST CLASS IS NOT A FIXTURE (#1416). JUnit runs a @BeforeEach / @BeforeAll / @Before /
// @BeforeClass method, a JUnit 3 setUp, a constructor or an initializer before the tests of its class, and those are
// `fixture` and carried by the fixture rule above; a teardown runs after each of them (java_teardown below). Anything else the class declares runs only when something calls it,
// and every Java call is a recorded edge: a test that calls the helper reaches the change through it on its own route
// (`usesHelper -> one -> parse`), and a fixture that calls it carries it as a fixture. Crediting the helper to every
// test of the class listed tests that never call it, as `[fixture]`, and kept the calling test's own resolved route
// out of the answer because the one-hop carrier route was nearer. A helper nothing calls credits no test at all.
// What is left is a callable no call site names that a test body still runs: a lambda or an anonymous class written
// inside the test, invoked through its functional interface. It serves the test that encloses it, and no sibling:
// the in_test_body rule just above carries it (#1556), for Java as for every language.
.decl java_decl(c:symbol)
java_decl(c) :- decl_file(c, f), match(".*[.]java", f).
// A TEARDOWN runs for every test of its class as a setUp does, after the body instead of before it: @AfterEach,
// @AfterAll, @After, @AfterClass (and TestNG's @AfterMethod and kin), and a JUnit 3 tearDown. A change it reaches
// fails every one of those tests, so it is carried like a fixture. graph_sql's FIXTURE_DECOR already makes these
// `fixture` (#1417); this rule is the Java backstop for a teardown that table misses, since the helper rule above no
// longer carries a Java method that is not a fixture.
.decl java_teardown(c:symbol)
java_teardown(c) :- java_decl(c), decorated(c, n), match("After.*", n), owner(c, _), !test_method(c).
java_teardown(c) :- java_decl(c), member(_, c, "tearDown", _), owner(c, _), !test_method(c).
test_hit(q, m, d, c) :- reach(q, c, d), java_teardown(c), !fixture(c), owner(c, t), scope(t, s), member(s, m, _, _), test_method(m).
// C#: A MEMBER OF A TEST CLASS SERVES THE TESTS THE RUNNER OR A CALL LINKS IT TO, NOT EVERY TEST OF THE CLASS (#1499).
// xUnit, NUnit and MSTest run a test class's constructor and its set-up and tear-down members (the fixture rule
// above), its IDisposable / IAsyncLifetime members (cs_lifecycle below), the data source a test's attribute names
// (uses_fixture), and a callable written inside the test (in_test_body above). Any other member runs when something
// calls it, and C# calls are recorded edges, so a test that calls a helper reaches the change through it on its own
// route. Crediting a helper to every test of its class listed tests that never call it, as [fixture]: a [MemberData]
// source on the test's own class was credited to every test of the class, not to the one that names it. A member
// nothing calls or names credits no test.
.decl cs_decl(c:symbol)
cs_decl(c) :- decl_file(c, f), match(".*[.]cs", f).
// the members an xUnit runner calls around every test of their class by the interface the class implements, which no
// decoration marks: IAsyncLifetime's InitializeAsync / DisposeAsync and IDisposable.Dispose. A change one of them
// reaches fails each of those tests. The decorated set-up and tear-down members are `fixture` already.
.decl cs_lifecycle(c:symbol)
cs_lifecycle(c) :- cs_decl(c), owner(c, t), !test_method(c), member(t, c, n, _), (n = "InitializeAsync" ; n = "DisposeAsync" ; n = "Dispose").
test_hit(q, m, d, c) :- reach(q, c, d), cs_lifecycle(c), !fixture(c), owner(c, t), scope(t, s), member(s, m, _, _), test_method(m).
// xUnit builds a class fixture (IClassFixture<X>) or a collection fixture (ICollectionFixture<X>, joined through the
// collection's name) before the tests of each class that names it, and disposes it after: X's constructors and
// lifecycle members run for those tests, though X declares no test and no call site names it (#1498). So does a
// member of X that nothing in the graph calls: an override the framework base calls (a WebApplicationFactory's
// CreateHost / ConfigureWebHost, which builds the application every such test talks to). A member of X that a test
// calls on the injected instance is carried by that call instead. A fixture type no test class names reaches no test.
.decl cs_fixture_member(c:symbol, x:symbol)
cs_fixture_member(c, x) :- cs_decl(c), owner(c, x), kind(c, "constructor").
cs_fixture_member(c, x) :- cs_decl(c), owner(c, x), member(x, c, n, _), (n = "InitializeAsync" ; n = "DisposeAsync" ; n = "Dispose").
cs_fixture_member(c, x) :- cs_decl(c), owner(c, x), member(x, c, _, _), !cs_called(c).
.decl cs_called(c:symbol)
cs_called(c) :- edge(a, c, t), t != "defines", a != c.
test_hit(q, m, d, c) :- reach(q, c, d), cs_fixture_member(c, x), typ(x, xn, _), cs_fixture_type(t, xn), cs_decl(t), scope(t, s), member(s, m, _, _), test_method(m).
// A helper no type owns is scoped by the innermost declaration that lexically encloses it: a
// `describe` callback holds its own helpers and its own tests, not a sibling block's; a module holds
// its file, which is the file rule kept where it was right. TypeScript has no other scope to use --
// every arrow in a file is ownerless and they all carry the same qualified name.
// A callable that ENCLOSES tests is a block -- a `describe` callback, a module body. It runs when the
// block is evaluated, so it serves the tests inside IT, and a sibling block's tests are not inside it.
test_hit(q, m, d, c) :- reach(q, c, d), !owner(c, _), lex_in(c, m), test_method(m), !test_method(c), decl_file(c, f), is_test_file(f).
// A callable that encloses no test is a helper. It serves the tests declared in the same scope it is
// -- the block that can see it -- and not the whole file.
// Where the graph KNOWS who calls the helper, that is better than its declaring scope. A helper at a
// test file's module level is visible to every test in the file but is usually called from only some
// of the blocks; crediting the file reports tests that never reach it. Use the innermost
// test-bearing block each caller sits in, and fall back to the declaring scope when no caller is
// recorded -- which is the case the helper rule exists for.
.decl tblock(b:symbol, x:symbol)
tblock(b, x) :- lex_in(b, x), encloses_test(b).
.decl tighter(b:symbol, x:symbol)
tighter(b, x) :- tblock(b, x), tblock(b2, x), lex_in(b, b2).
.decl helper_block_test(c:symbol, m:symbol)
// the caller is itself a test: that test reaches it, and nothing else follows
helper_block_test(c, m) :- calls(m, c, _, _, _), test_method(m).
// the caller is a block that bears tests -- a `describe` callback whose BODY makes the call, which is
// how a test file builds a fixture once for the block. Its own tests reach it, a sibling's do not.
helper_block_test(c, m) :- calls(x, c, _, _, _), encloses_test(x), lex_in(x, m), test_method(m).
// otherwise the innermost test-bearing block the caller sits in
helper_block_test(c, m) :- calls(x, c, _, _, _), !encloses_test(x), !test_method(x), tblock(b, x), !tighter(b, x), lex_in(b, m), test_method(m).
.decl helper_has_block(c:symbol)
helper_has_block(c) :- helper_block_test(c, _).
test_hit(q, m, d, c) :- reach(q, c, d), !owner(c, _), !encloses_test(c), helper_has_block(c), helper_block_test(c, m), !test_method(c), !injected_fixture(c), decl_file(c, f), is_test_file(f).
test_hit(q, m, d, c) :- reach(q, c, d), !owner(c, _), !encloses_test(c), !helper_has_block(c), lex_parent(c, p), lex_in(p, m), test_method(m), !test_method(c), !injected_fixture(c), decl_file(c, f), is_test_file(f).
// nothing recorded a span for it, so the file is still the only scope known
test_hit(q, m, d, c) :- reach(q, c, d), !owner(c, _), !lex_parent(c, _), !encloses_test(c), decl_file(c, f), decl_file(m, f), test_method(m), !test_method(c), !injected_fixture(c), is_test_file(f).
.decl encloses_test(c:symbol)
encloses_test(c) :- lex_in(c, m), test_method(m).
.decl lex_in(outer:symbol, inner:symbol)
lex_in(o, i) :- lex_parent(i, o).
lex_in(o, i) :- lex_parent(i, x), lex_in(o, x).
.decl is_test_file(f:symbol)
is_test_file(f) :- test_method(m), decl_file(m, f).
// ── a fixture a framework INJECTS, which no call site records ────────────────────────────────────────────────
// pytest matches a test's PARAMETER NAME against the fixtures visible from the test's file: those declared beside it,
// and those in a `conftest.py` of any ancestor directory. A marker can name one instead (`@pytest.mark.usefixtures`),
// and an `autouse=True` fixture runs before every test in its scope without being named anywhere at all. None of the
// three is a call, so what a fixture reaches was reported as reaching no test.
.decl uses_fixture(m:symbol, fx:symbol)
// A fixture that a CLASS declares is visible to that class's tests, and to those of a class deriving
// from it -- not to a sibling class that happens to declare a fixture of the same name. fixture_scope
// carries a path prefix, which is the right scope for conftest.py and for a module-level fixture and
// too wide for this one: three sibling classes each declaring `mw` had every `mw` test credited to
// all three.
uses_fixture(m, fx) :- takes_param(m, n), fixture_scope(fx, n, p), decl_file(m, f), file_scope(f, p), m != fx,
                       (test_method(m) ; fixture(m)), owner(fx, t), owner(m, u), scope(t, u).
uses_fixture(m, fx) :- takes_param(m, n), fixture_scope(fx, n, p), decl_file(m, f), file_scope(f, p), m != fx,
                       (test_method(m) ; fixture(m)), !owner(fx, _).
// Where the language engine resolved the request, its edge is the answer (the name join above is then not fed for
// that language). A fixture a class declares stays scoped to that class's tests, as above.
uses_fixture(m, fx) :- injects(m, fx), !owner(fx, _).
uses_fixture(m, fx) :- injects(m, fx), owner(fx, t), owner(m, u), scope(t, u).
uses_fixture(m, fx) :- dec_literal(m, "usefixtures", n, _, _), fixture_scope(fx, n, p), decl_file(m, f), file_scope(f, p), m != fx.
// The marker on a CLASS is recorded on the type, and applies to every test the class holds, and to those of a class
// nested in it or deriving from it (scope/2). Joined to the declaration it decorates only, it reached no test (#1528).
uses_fixture(m, fx) :- dec_literal(t, "usefixtures", n, _, _), typ(t, _, _), scope(t, s), member(s, m, _, _), test_method(m),
                       fixture_scope(fx, n, p), decl_file(m, f), file_scope(f, p), m != fx.
// A module's `pytestmark` and the ini `usefixtures` option apply the marker to every test under their path (#1528).
uses_fixture(m, fx) :- usefixtures_scope(p, n), decl_file(m, f), file_scope(f, p), test_method(m),
                       fixture_scope(fx, n, q), file_scope(f, q), m != fx.
uses_fixture(m, fx) :- runs_before(m, fx), test_method(m).
uses_fixture(m, fx) :- autouse_fixture(fx), fixture_scope(fx, _, p), decl_file(m, f), file_scope(f, p), test_method(m), m != fx.
// JUnit 5's `@MethodSource("prices")` names the factory that supplies a parameterized test's arguments, and JUnit calls
// it before that test, for that test only: no call site records it (#1416, #1424). The factory is looked up in the
// test's class and the classes it extends or is nested in; without a value it is the factory named like the test.
// The `Other#factory` form names a method of another class and is not read here.
uses_fixture(m, fx) :- dec_literal(m, "MethodSource", n, _, _), test_method(m), java_decl(m), owner(m, u), scope(t, u), member(t, fx, n, _), fx != m, !test_method(fx).
uses_fixture(m, fx) :- decorated(m, "MethodSource"), !dec_literal(m, "MethodSource", _, _, _), test_method(m), java_decl(m), member(_, m, n, _),
                       owner(m, u), scope(t, u), member(t, fx, n, _), fx != m, !test_method(fx).
// A C# data attribute names the member that supplies a parameterized test's rows, and the runner calls it for that
// test only (#1499): [MemberData(nameof(Rows))] in the test's class or a class it extends or is nested in, and
// [MemberData(nameof(Cases.Rows), MemberType = typeof(Cases))] (NUnit's [TestCaseSource(typeof(C), nameof(X))] and
// MSTest's [DynamicData(nameof(X), typeof(C))] alike) in the type it names. [ClassData(typeof(C))] builds C and
// enumerates it: every callable C declares serves that test.
uses_fixture(m, fx) :- cs_data_source(m, "", n), test_method(m), owner(m, u), scope(t, u), member(t, fx, n, _), fx != m, !test_method(fx).
uses_fixture(m, fx) :- cs_data_source(m, tn, n), tn != "", test_method(m), typ(t, tn, _), cs_decl(t), member(t, fx, n, _), fx != m, !test_method(fx).
uses_fixture(m, c) :- cs_data_type(m, tn), test_method(m), typ(t, tn, _), cs_decl(t), owner(c, t), c != m, !test_method(c).
// a fixture may request another fixture, and then both run before the test
uses_fixture(m, g) :- uses_fixture(m, fx), uses_fixture(fx, g), m != g.
test_hit(q, m, d, fx) :- reach(q, fx, d), uses_fixture(m, fx), test_method(m).

// a class that extends a test class runs that class's tests as its own — the subclass declares nothing, and a
// change reaching the base's test breaks the subclass's run of it too (the JVM parser's java11 HttpClient*Test)
.decl inherited_test(q:symbol, s:symbol, m:symbol, d:number)
inherited_test(q, s, m, d) :- test_hit(q, m, d, _), owner(m, t), extends(s, t), typ(s, _, _), s != t.
.output inherited_test
.decl test_near(q:symbol, m:symbol, d:number)
test_near(q, m, d) :- test_hit(q, m, d, _), d = min x : test_hit(q, m, x, _).
.output test_near
.output test_hit

// ── a test that only STUBS the change: named, and never counted as running it ─────────────────────────────────
// `when(repo.find(1))`, `verify(repo).save(x)`, `mock.Setup(r => r.Find(1))` name a method the closure reaches and run
// none of it. The tier "stub" keeps them out of `edge`, so they are not routes; this says which tests hold one, so a
// signature change still finds them. The callable that writes the stub (a test, a lambda in it, a setUp, a helper the
// setUp calls) is walked up through the same edges as the closure, and a test is found from it by the same three
// shapes a route ends in: the test itself, a fixture that runs before the tests of its type, a helper of that type.
.decl stub_at(q:symbol, x:symbol)
stub_at(q, x) :- reach(q, c, _), calls(x, c, "stub", _, _).
// A stub site the engine could not resolve (a Moq lambda whose parameter it did not type) is only a NAME: it leaves
// seed_byname, so it is no route, and it is not listed here either, since the same name is often another type's method.
.decl stub_near(q:symbol, a:symbol)
stub_near(q, x) :- stub_at(q, x).
stub_near(q, o) :- stub_at(q, x), lex_in(o, x).
stub_near(q, a) :- stub_near(q, b), edge(a, b, _).
.decl test_stub(q:symbol, m:symbol)
test_stub(q, m) :- stub_near(q, m), test_method(m).
test_stub(q, m) :- stub_near(q, fx), fixture(fx), !test_method(fx), owner(fx, t), scope(t, s), member(s, m, _, _), test_method(m).
test_stub(q, m) :- stub_near(q, c), !test_method(c), !fixture(c), !in_test_body(c), owner(c, t), scope(t, s), member(s, m, _, _), test_method(m), decl_file(c, f), is_test_file(f), !java_decl(c), !cs_decl(c).
// a Java helper holding the stub is walked up to its callers by the edge rule, and a lambda in a test body reaches its
// test through stub_near's lex_in step (#1416, #1556); a teardown is credited to every test of its class
test_stub(q, m) :- stub_near(q, c), java_teardown(c), !fixture(c), owner(c, t), scope(t, s), member(s, m, _, _), test_method(m).
// C#: a stub written in a helper or a lambda is walked up to the test that calls or holds it by the rules above; only a
// lifecycle member is credited to every test of its class, as the test_hit rules do (#1556)
test_stub(q, m) :- stub_near(q, c), cs_lifecycle(c), !fixture(c), owner(c, t), scope(t, s), member(s, m, _, _), test_method(m).
.output test_stub

// ── bound from outside the source ──────────────────────────────────────────────────────────────────────────────
// A name written in a file the index does not read as source: an XML mapper, a META-INF/services file, a
// properties or yaml file, a build script, a spec. The binding is made by name at run time, so the compiler is
// silent and a rename breaks it. There is no callable to attribute it to, so it is its own answer.
.decl extbind(q:symbol, f:symbol, l:number, n:symbol, how:symbol)
extbind(q, f, l, n, "names the type") :- target(q, "type", t, _), typ(t, n, _), nonsource(n, f, l).
// "…in full" is a SECOND row about the same site, and it says nothing when the qualified spelling IS the plain name:
// a free function's `qual_name` is its own name, so one mention of `apply` in a workflow file was reported twice —
// three times for a name that is both a field and a method — and the count line said "3 site(s)" for one site. The
// row is only informative when the two spellings differ.
extbind(q, f, l, n, "names the type in full") :- target(q, "type", t, _), qual_name(t, n), nonsource(n, f, l), typ(t, tn, _), n != tn.
extbind(q, f, l, n, "names the method") :- target(q, "method", m, _), named(n, m), nonsource(n, f, l).
extbind(q, f, l, n, "names the method in full") :- target(q, "method", m, _), qual_name(m, n), nonsource(n, f, l), named(pn, m), n != pn.
extbind(q, f, l, n, "names the field") :- target(q, "field", fl, _), field(fl, _, n, _, _), nonsource(n, f, l).
extbind(q, f, l, n, "defines or overrides the key") :- target(q, "config", k, _), nonsource(n, f, l), n = k.
.output extbind
