// impact.dl — what has to be looked at again when a declaration changes. Every judgement is a rule here; the Python
// side only produces facts (from graph.sqlite and, for the few text-level facts, from the source) and prints.
//
// Facts exported once per graph (impact-*.facts, next to the path finder's edge.facts):
//   edge(a, b, t)                     a calls b (the path finder's facts: resolved client edges, dispatch, defines)
//   named(n, m)                       a client callable m declared with simple name n
//   calls(c, m, tier, f, l)           a resolved call site in c to client method m, at f:l
//   unresolved(c, n, kind, f, l)      an unresolved site in c written n (kind: new | method), at f:l
//   member(T, s, n, k)                symbol s named n of kind k (method, constructor, field, const, enum_member …) declared in type T
//   owner(c, T)                       callable c is declared in type T
//   typ(T, n, k)                      type T has simple name n and kind k (class | interface | enum | record)
//   extends(S, T)                     S extends / implements T (transitively, the engine's type_ancestors)
//   nested(N, T)                      N is declared inside T
//   decorated(s, d)                   symbol s carries decoration d (simple name)
//   override(base, o)                 o overrides base
//   ref(c, n, rk, ek, f, l)           a reference to name n inside callable c: rk the reference kind (bare | qualified),
//                                     ek the parser's entity kind (FIELD | LOCAL | TYPE | …), at f:l
//   qualifier(f, l, n, Q)             on line f:l the name n is written qualified as Q.n
//   typeref(c, n, ctx, f, l)          a type reference to n in context ctx (field type, method param …) inside c, at f:l
//   typeref_file(f, n, ctx)           the same when the parser gives no line (Java): the file only
//   type_in_file(T, f)                type T is declared in file f
//   literal(c, v, f, l)               a string literal v inside c
//   field(F, T, n, f, l)              field F named n declared in type T at f:l
//   accessor(F, n, rw)                the bean accessor name for field F (getX / setX / isX / x) and whether it reads or writes
//   gen_table(d, what)                what decoration d generates: get | set | is | ctor | builder | fluent | with
//   base_name(t, n)                   type t is declared with a supertype WRITTEN n — the base may be a library type the
//                                     graph never resolved (pydantic's BaseModel), which is exactly the case `extends` misses
//   test_method(m) / fixture(m)       a test; a callable a test framework runs before the tests of its type
//   kind(s, k)                        the symbol's kind (method | constructor | module | class | …)
// Facts written per query:
//   target(q, kind, s, x)             the change: kind ∈ method | field | type | param | typeparam | var | clinit; s the symbol; x a name
//   textuse(c, n, f, l)               the name n found in the source of c (comments and strings stripped) — for Java type
//                                     references without a line, type parameters, and parameters
//   importuse(c, n, f, l)             c uses member n imported by name from the target type (import static)
//   inside_target(q, c)               c lies within the target type's own span (its members, nested types) — the change, not a dependent

.decl edge(a:symbol, b:symbol, t:symbol)                          .input edge
.decl named(n:symbol, m:symbol)                                   .input named
.decl calls(c:symbol, m:symbol, tier:symbol, f:symbol, l:number)  .input calls
.decl unresolved(c:symbol, n:symbol, k:symbol, f:symbol, l:number) .input unresolved
.decl named_site(c:symbol, n:symbol, k:symbol, f:symbol, l:number) .input named_site
.decl member(t:symbol, s:symbol, n:symbol, k:symbol)              .input member
.decl owner(c:symbol, t:symbol)                                   .input owner
.decl typ(t:symbol, n:symbol, k:symbol)                           .input typ
.decl extends(s:symbol, t:symbol)                                 .input extends
.decl nested(n:symbol, t:symbol)                                  .input nested
.decl decorated(s:symbol, d:symbol)                               .input decorated
.decl override(b:symbol, o:symbol)                                .input override
.decl ref(c:symbol, n:symbol, rk:symbol, ek:symbol, f:symbol, l:number) .input ref
.decl qualifier(f:symbol, l:number, n:symbol, q:symbol)           .input qualifier
.decl typeref(c:symbol, n:symbol, ctx:symbol, f:symbol, l:number) .input typeref
.decl typeref_file(f:symbol, n:symbol, ctx:symbol)                .input typeref_file
.decl type_in_file(t:symbol, f:symbol)                            .input type_in_file
.decl literal(c:symbol, v:symbol, f:symbol, l:number)             .input literal
.decl dec_literal(c:symbol, d:symbol, v:symbol, f:symbol, l:number) .input dec_literal
.decl reexport(c:symbol, n:symbol, f:symbol, l:number)            .input reexport
.decl field(fl:symbol, t:symbol, n:symbol, f:symbol, l:number)    .input field
.decl accessor(fl:symbol, n:symbol, rw:symbol)                    .input accessor
.decl gen_table(d:symbol, what:symbol)                            .input gen_table
.decl base_name(t:symbol, n:symbol)                               .input base_name
//   throws_(m, e) / catches(m, e)     a callable declares / catches the checked exception e (read from its own text: Java
//                                     records a throws clause with no line, and #760 mislabels switch arms)
//   switch_over(m, t, arms)           callable m switches over the enum t, with `arms` of its constants named
.decl throws_(m:symbol, e:symbol)                                 .input throws_
.decl catches(m:symbol, e:symbol)                                 .input catches
.decl switch_over(m:symbol, t:symbol, arms:symbol)                .input switch_over
.decl test_method(m:symbol)                                       .input test_method
.decl fixture(m:symbol)                                           .input fixture
.decl kind(s:symbol, k:symbol)                                    .input kind
.decl decl_file(s:symbol, f:symbol)                               .input decl_file
.decl flag(n:symbol)                                              .input flag
.decl file_dir(f:symbol, d:symbol)                                .input file_dir
.decl field_type(fl:symbol, n:symbol)                             .input field_type
.decl target(q:symbol, k:symbol, s:symbol, x:symbol)              .input target
.decl textuse(c:symbol, n:symbol, f:symbol, l:number)             .input textuse
.decl importuse(c:symbol, n:symbol, f:symbol, l:number)           .input importuse
.decl inside_target(q:symbol, c:symbol)                           .input inside_target
//   config(key, m, why)               a configuration key the engine bound to a method (@Value, @ConfigurationProperties, a .yml/.properties key)
//   config_key_known(key)             every key the engine's configuration extension saw — an unknown key is said to be unknown, never guessed
//   bean(name, t, kind)               a type registered as a bean (a stereotype, an @Bean factory)
//   injected(t, into, kind)           a value of type t is handed to `into` by the container, not by a call the graph can see
.decl config_site(k:symbol, c:symbol, d:symbol, f:symbol, l:number) .input config_site
//   nonsource(n, f, l)                the name n written in a file the index does NOT read as source
//   qual_name(s, n)                   a qualified spelling of symbol s, for a binding written in full
.decl nonsource(n:symbol, f:symbol, l:number)                     .input nonsource
.decl qual_name(s:symbol, n:symbol)                               .input qual_name
.decl config(k:symbol, m:symbol, why:symbol)                      .input config
.decl config_key_known(k:symbol)                                  .input config_key_known
.decl bean(n:symbol, t:symbol, kind:symbol)                       .input bean
.decl injected(t:symbol, into:symbol, kind:symbol)                .input injected

// ── vocabulary ─────────────────────────────────────────────────────────────────────────────────────────────────
.decl local_kind(k:symbol)
local_kind("LOCAL_VARIABLE"). local_kind("PARAMETER"). local_kind("LAMBDA_PARAMETER"). local_kind("VARIABLE"). local_kind("PARAM").
.decl member_kind(k:symbol)
member_kind("FIELD"). member_kind("PROPERTY"). member_kind("ATTRIBUTE"). member_kind("METHOD"). member_kind("FUNCTION").
.decl ctor_kind(k:symbol)
ctor_kind("new"). ctor_kind("anon_new"). ctor_kind("CONSTRUCTOR_CALL").
// the parser tells a field reference from a type reference and from a call: a field rule must not take the other two
.decl type_or_call_kind(k:symbol)
type_or_call_kind("TYPE"). type_or_call_kind("METHOD"). type_or_call_kind("FUNCTION"). type_or_call_kind("CONSTRUCTOR"). type_or_call_kind("METHOD_CALL"). type_or_call_kind("METHOD_REFERENCE").
// a qualifier that names the enclosing instance is not another type: this.x / self.x is the enclosing type's own x
.decl self_qualifier(q:symbol)
self_qualifier("this"). self_qualifier("self"). self_qualifier("cls"). self_qualifier("super").

// ── derived structure ──────────────────────────────────────────────────────────────────────────────────────────
// scope(T, S): a member of T is visible unqualified inside S — S is T, a subtype, or a type nested in one of those
.decl scope(t:symbol, s:symbol)
scope(t, t) :- typ(t, _, _).
scope(t, s) :- scope(t, u), extends(s, u).
scope(t, s) :- scope(t, u), nested(s, u).
// inside(x, T): x is declared within T's span — a member, or a member of a nested type
.decl inside(x:symbol, t:symbol)
inside(x, t) :- owner(x, t).
inside(n, t) :- nested(n, t).
inside(x, t) :- nested(n, t), inside(x, n).
// declares(T, n): T or a type it extends declares a member named n
.decl declares(t:symbol, n:symbol)
declares(t, n) :- member(t, _, n, _).
declares(t, n) :- extends(t, u), member(u, _, n, _).
declares(t, n) :- nested(x, t), typ(x, n, _).                     // a nested type of that name is a member too
// what a type's decorations generate
.decl gen(t:symbol, what:symbol)
gen(t, w) :- decorated(t, d), gen_table(d, w).
gen(t, w) :- extends(t, u), decorated(u, d), gen_table(d, w).     // a base class that generates, generates for its subtypes
gen(t, w) :- field(fl, t, _, _, _), decorated(fl, d), gen_table(d, w).   // a decoration on the field itself
// a generator that is a BASE CLASS, not a decoration: `class User(BaseModel)` declares its members by inheritance, and
// the base is usually a library type the graph never resolved, so `extends` cannot see it — the written name can (#750)
gen(t, w) :- base_name(t, n), gen_table(n, w).
// a project's own decorator that wraps a generator (`def frozen(cls): return dataclass(frozen=True)(cls)`): the alias is
// recognised by what its body calls, so a house decorator, an aliased import or a decorator factory is no longer invisible
.decl gen_alias(d:symbol, w:symbol)
gen_alias(d, w) :- named(d, m), ref(m, g, _, _, _, _), gen_table(g, w), d != g.
gen(t, w) :- decorated(t, d), gen_alias(d, w).
gen(t, w) :- field(fl, t, _, _, _), decorated(fl, d), gen_alias(d, w).
// which entries fired for THIS query, so the answer can say which convention it assumed rather than leave it implicit
.decl gen_source(t:symbol, d:symbol, why:symbol)
gen_source(t, d, "a decoration on the type") :- decorated(t, d), gen_table(d, _).
gen_source(t, d, "a project-local decorator wrapping one") :- decorated(t, d), gen_alias(d, _), !gen_table(d, _).
gen_source(t, n, "a base class") :- base_name(t, n), gen_table(n, _).
gen_source(t, d, "a decoration on a field") :- field(fl, t, _, _, _), decorated(fl, d), gen_table(d, _).
.decl gen_fired(q:symbol, d:symbol, why:symbol)
gen_fired(q, d, why) :- target(q, "type", t, _), gen_source(t, d, why).
gen_fired(q, d, why) :- target(q, "clinit", t, _), gen_source(t, d, why).
gen_fired(q, d, why) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen_source(t, d, why).
gen_fired(q, d, why) :- target(q, "method", m, _), owner(m, t), gen_source(t, d, why).
.output gen_fired
gen(t, "fluent_read") :- typ(t, _, "record").                    // a record accessor reads; only a builder / wither writes
gen(t, "ctor") :- typ(t, _, "record").
// holds(H, T): type H has a field whose type is T — a value of T is produced whenever an H is
.decl holds(h:symbol, t:symbol)
holds(h, t) :- typ(t, n, _), typeref(c, n, "FIELD_TYPE", _, _), owner(c, h).
// the type written on the field's own line: the holder is the type that declares the field, not every type in the file
holds(h, t) :- field(fl, h, _, _, _), field_type(fl, n), typ(t, n, _), h != t.
// the file-scoped fallback, only where no field declaration in that file could be read (the parser gives no line)
.decl file_field_typed(f:symbol)
file_field_typed(f) :- field(fl, _, _, f, _), field_type(fl, _).
holds(h, t) :- typ(t, n, _), typeref_file(f, n, "FIELD_TYPE"), type_in_file(h, f), h != t, !file_field_typed(f).

// ── must change with it: a contract the engine resolved ──────────────────────────────────────────────────────
.decl contract(q:symbol, c:symbol, why:symbol)
contract(q, o, "overrides it") :- target(q, "method", m, _), override(m, o), !target(q, _, o, _).
contract(q, b, "it overrides this") :- target(q, "method", m, _), override(b, m), !target(q, _, b, _).
// a language whose engine emits no override rows still has the types: a subtype (or supertype) declaring the same
// member name is bound by the same contract — said as a name match, not as a resolved override
contract(q, o, "declares the same member in a subtype (a name match: this graph has no override table)") :- flag("no_overrides"),
    target(q, "method", m, _), owner(m, t), member(t, m, n, _), extends(s, t), member(s, o, n, _), o != m.
contract(q, o, "declares the same member in a supertype (a name match: this graph has no override table)") :- flag("no_overrides"),
    target(q, "method", m, _), owner(m, t), member(t, m, n, _), extends(t, u), member(u, o, n, _), o != m.
contract(q, o, "overrides the method — same parameter list") :- target(q, "param", m, _), override(m, o), !target(q, _, o, _).
contract(q, b, "the method overrides this — same parameter list") :- target(q, "param", m, _), override(b, m).
contract(q, s, "extends / implements it") :- target(q, "type", t, _), extends(s, t).
contract(q, s, "extends / implements it") :- target(q, "typeparam", t, _), typ(t, _, _), extends(s, t).
contract(q, s, "extends / implements it") :- target(q, "clinit", t, _), extends(s, t).
.output contract

// ── direct(q, c, role, why, cert, f, l): c's text uses the target. role: writes | reads | uses ─────────────────
.decl direct(q:symbol, c:symbol, role:symbol, why:symbol, cert:symbol, f:symbol, l:number)

// a CONFIGURATION KEY: the methods the container binds it into — no call reaches them, so nothing else would find these
direct(q, m, "reads", cat("reads this configuration key (", why, ")"), "resolved", "", 0) :- target(q, "config", k, _), config(k, m, why).
// the binding site: the line that ties the key to the code, and the one that must be edited with it
direct(q, c, "produces", cat("BINDS the key here, at the @", dn, " placeholder — this is the line a rename must change"), "resolved", f, l) :- target(q, "config", k, _), config_site(k, c, dn, f, l).

// a type the container INJECTS: its consumers receive it without a call the graph can see
direct(q, c, "uses", cat("receives it by dependency injection (", kind, ") — the container hands it over, no call site"), "resolved", "", 0) :- target(q, "type", t, _), injected(t, c, kind), !inside_target(q, c).
direct(q, c, "uses", cat("receives it by dependency injection (", kind, ") — the container hands it over, no call site"), "resolved", "", 0) :- target(q, "clinit", t, _), injected(t, c, kind).
// a method that DEFINES a bean (@Bean): whoever is injected with the type it returns
direct(q, c, "uses", cat("is injected with the bean this defines (", kind, ")"), "resolved", "", 0) :- target(q, "method", m, _), owner(m, ot), bean(_, ot, _), injected(ot, c, kind), c != m.

// a METHOD: its callers, and the unresolved sites written with its name
direct(q, c, "uses", "calls it", "resolved", f, l) :- target(q, "method", m, _), calls(c, m, t, f, l), t != "multi_inferred", !bean_call(q, c, m).
// A call INTO a method of a container-managed bean. Whether the container's proxy is on the path decides whether a
// behavioural annotation added to the method (a transaction, a cache, an async dispatch, a retry, an authorization
// check) reaches this caller at all: a call from inside the bean goes through `this` and never through the proxy.
// This is a per-framework convention stated as such, and it fires only where the graph actually found a container.
.decl bean_call(q:symbol, c:symbol, m:symbol)
bean_call(q, c, m) :- target(q, "method", m, _), owner(m, ot), bean(_, ot, _), calls(c, m, t, _, _), t != "multi_inferred".
// the type that the container hands the bean to: a field injection names the type, a constructor or setter names the method
.decl receives_bean(t:symbol, into:symbol)
receives_bean(t, into) :- injected(t, into, _), typ(into, _, _).
receives_bean(t, into) :- injected(t, x, _), owner(x, into).
direct(q, c, "uses", "calls it from inside the same bean — through this, not through the container proxy, so an added proxied annotation does NOT apply to this caller", "resolved", f, l) :-
    bean_call(q, c, m), owner(m, ot), owner(c, ot), calls(c, m, _, f, l).
direct(q, c, "uses", "calls it on the injected bean — the container proxy is on the path, so an added proxied annotation applies here", "resolved", f, l) :-
    bean_call(q, c, m), owner(m, ot), owner(c, cot), cot != ot, receives_bean(ot, cot), calls(c, m, _, f, l).
direct(q, c, "uses", "calls it on an instance it obtained itself, not from the container — no proxy on the path, so an added proxied annotation does not apply here", "resolved", f, l) :-
    bean_call(q, c, m), owner(m, ot), owner(c, cot), cot != ot, !receives_bean(ot, cot), calls(c, m, _, f, l).
direct(q, c, "uses", "calls it", "one of a set", f, l) :- target(q, "method", m, _), calls(c, m, "multi_inferred", f, l).
direct(q, c, "uses", "calls a method of this name (receiver not typed)", "by name", f, l) :- target(q, "method", m, _), named(n, m), unresolved(c, n, k, f, l), !ctor_kind(k).

// a FIELD: references by name, judged by where they are and how they are written
.decl fref(q:symbol, c:symbol, rk:symbol, f:symbol, l:number)
fref(q, c, rk, f, l) :- target(q, "field", fl, _), field(fl, _, n, ff, fll), ref(c, n, rk, ek, f, l), !local_kind(ek), !type_or_call_kind(ek), (f != ff ; l != fll).
// an enum member is written like a type, so the parser labels the genuine reference TYPE: keep those, but only in a
// file that can see the enum — its own directory, or a file that names the enum type somewhere
.decl enum_member_target(q:symbol, fl:symbol)
enum_member_target(q, fl) :- target(q, "field", fl, _), member(_, fl, _, "enum_member").
fref(q, c, rk, f, l) :- enum_member_target(q, fl), field(fl, t, n, ff, fll), ref(c, n, rk, "TYPE", f, l), (f != ff ; l != fll),
    file_dir(f, d), type_in_file(t, tf), file_dir(tf, d).
fref(q, c, rk, f, l) :- enum_member_target(q, fl), field(fl, t, n, ff, fll), ref(c, n, rk, "TYPE", f, l), (f != ff ; l != fll),
    typ(t, tn, _), typeref_file(f, tn, _).
fref(q, c, rk, f, l) :- enum_member_target(q, fl), field(fl, t, n, ff, fll), ref(c, n, rk, "TYPE", f, l), (f != ff ; l != fll),
    typ(t, tn, _), typeref(_, tn, _, f, _).
.decl frole(rk:symbol, role:symbol, why:symbol)
frole("qualified", "uses", "writes/reads it"). frole("bare", "reads", "reads it").
// in scope: inside the owner, a subtype, or a nested type — or the type node itself (a field initializer)
direct(q, c, role, why, "in scope", f, l) :- fref(q, c, rk, f, l), frole(rk, role, why), target(q, "field", fl, _), field(fl, t, _, _, _), owner(c, s), scope(t, s).
direct(q, c, role, why, "in scope", f, l) :- fref(q, c, rk, f, l), frole(rk, role, why), target(q, "field", fl, _), field(fl, t, _, _, _), scope(t, c).
// qualified elsewhere: the qualifier written on the line decides — the owner's own name confirms, another type's name excludes
direct(q, c, "uses", "writes/reads it", "in scope", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), typ(t, tn, _),
    owner(c, s), !scope(t, s), qualifier(f, l, n, tn).
direct(q, c, "uses", "writes/reads it", "by name", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _), typ(t, tn, _),
    owner(c, s), !scope(t, s), !declares(s, n), qualifier(f, l, n, qn), qn != tn, !typ(_, qn, _), !self_qualifier(qn).
direct(q, c, "uses", "writes/reads it", "by name", f, l) :- fref(q, c, "qualified", f, l), target(q, "field", fl, _), field(fl, t, n, _, _),
    owner(c, s), !scope(t, s), !declares(s, n), !qualifier(f, l, n, _).
// bare elsewhere: only when the enclosing type has no member of that name itself
direct(q, c, "reads", "reads it", "by name", f, l) :- fref(q, c, "bare", f, l), target(q, "field", fl, _), field(fl, t, n, _, _),
    owner(c, s), !scope(t, s), !declares(s, n).
direct(q, c, "reads", "reads it", "by name", f, l) :- fref(q, c, "bare", f, l), target(q, "field", fl, _), field(fl, t, _, _, _), !owner(c, _), !scope(t, c).
// a declared accessor is the field's door
direct(q, c, "reads", cat("reads it through ", an, "()"), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, "read"), member(t, a, an, _), calls(c, a, _, f, l).
direct(q, c, "writes", cat("writes it through ", an, "()"), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, "write"), member(t, a, an, _), calls(c, a, _, f, l).
// a GENERATED accessor: the unresolved sites written with its name (the decoration says it exists)
direct(q, c, "reads", cat("calls the generated getter ", an, "() — receiver not typed"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen(t, "get"), accessor(fl, an, "read"), named_site(c, an, k, f, l), !ctor_kind(k).
direct(q, c, "writes", cat("calls the generated setter ", an, "() — receiver not typed"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen(t, "set"), accessor(fl, an, "write"), named_site(c, an, k, f, l), !ctor_kind(k).
direct(q, c, "writes", cat("sets it through the generated builder / fluent ", n, "()"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, w), (w = "builder" ; w = "fluent"), named_site(c, n, k, f, l), !ctor_kind(k).
direct(q, c, "reads", cat("reads it through the generated accessor ", n, "()"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, n, _, _), gen(t, "fluent_read"), named_site(c, n, k, f, l), !ctor_kind(k).
direct(q, c, "writes", "passes it to the generated constructor", "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), gen(t, "ctor"), typ(t, tn, _), named_site(c, tn, k, f, l).
// a string literal equal to its name: a serialized name, a map key, a request parameter
direct(q, c, "uses", "names it in a string literal (serialization? a map key? a request key?)", "text", f, l) :- target(q, "field", fl, _), field(fl, _, n, _, _), literal(c, n, f, l).
// where values of the owning type are PRODUCED: every constructor of the owner, its deserialization (a class literal handed
// somewhere), and the same for every type that holds one — a new shape of the field has to be produced there
.decl produces(q:symbol, c:symbol, why:symbol, cert:symbol, f:symbol, l:number)
produces(q, c, cat("constructs ", tn), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), member(t, k, _, "constructor"), calls(c, k, _, f, l).
produces(q, c, cat("constructs ", tn, " (unresolved site)"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), unresolved(c, tn, k, f, l), ctor_kind(k), !gen(t, "ctor").
produces(q, c, cat("reflects on ", tn, ".class — deserialization or a framework produces it here"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), ref(c, tn, _, "CLASS_LITERAL", f, l).
produces(q, c, cat("constructs ", hn, ", which holds ", tn), "resolved", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), holds(h, t), typ(h, hn, _), member(h, k, _, "constructor"), calls(c, k, _, f, l).
produces(q, c, cat("constructs ", hn, ", which holds ", tn, " (unresolved site)"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), holds(h, t), typ(h, hn, _), unresolved(c, hn, k, f, l), ctor_kind(k).
produces(q, c, cat("reflects on ", hn, ".class, which holds ", tn, " — deserialization produces the value here"), "by name", f, l) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, tn, _), holds(h, t), typ(h, hn, _), ref(c, hn, _, "CLASS_LITERAL", f, l).
direct(q, c, "produces", why, cert, f, l) :- produces(q, c, why, cert, f, l), !inside_target(q, c).
.output produces

// a TYPE: callers of its members, its instantiations, references to its name, generated accessors, imported members
.decl tmember(q:symbol, m:symbol, n:symbol, k:symbol)
tmember(q, m, n, k) :- target(q, "type", t, _), member(t, m, n, k).
direct(q, c, "produces", "instantiates it", "resolved", f, l) :- tmember(q, m, _, "constructor"), calls(c, m, _, f, l), !inside_target(q, c).
direct(q, c, "uses", cat("calls ", n), "resolved", f, l) :- tmember(q, m, n, k), k != "constructor", calls(c, m, t, f, l), t != "multi_inferred", !inside_target(q, c).
direct(q, c, "uses", cat("calls ", n), "one of a set", f, l) :- tmember(q, m, n, k), k != "constructor", calls(c, m, "multi_inferred", f, l), !inside_target(q, c).
direct(q, c, "produces", "instantiates it (unresolved site)", "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), unresolved(c, n, k, f, l), ctor_kind(k), !inside_target(q, c).
direct(q, c, "produces", "reflects on its .class — deserialization or a framework produces it here", "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), ref(c, n, _, "CLASS_LITERAL", f, l), !inside_target(q, c).
direct(q, c, "uses", "references it", "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), ref(c, n, _, ek, f, l), ek != "CLASS_LITERAL", !local_kind(ek), !member_kind(ek), !inside_target(q, c).
direct(q, c, "uses", cat("names it (", ctx, ")"), "by name", f, l) :- target(q, "type", t, _), typ(t, n, _), typeref(c, n, ctx, f, l), !inside_target(q, c).
direct(q, c, "uses", "names it (a signature or a declaration)", "text", f, l) :- target(q, "type", t, _), typ(t, n, _), textuse(c, n, f, l), !inside_target(q, c).
direct(q, c, "uses", cat("uses ", n, ", imported from it"), "by name", f, l) :- target(q, "type", _, _), importuse(c, n, f, l), !inside_target(q, c).
direct(q, c, "reads", cat("calls the generated getter ", an, "()"), "by name", f, l) :- target(q, "type", t, _), gen(t, "get"), field(fl, t, _, _, _), accessor(fl, an, "read"), unresolved(c, an, k, f, l), !ctor_kind(k), !inside_target(q, c).
direct(q, c, "writes", cat("calls the generated setter ", an, "()"), "by name", f, l) :- target(q, "type", t, _), gen(t, "set"), field(fl, t, _, _, _), accessor(fl, an, "write"), unresolved(c, an, k, f, l), !ctor_kind(k), !inside_target(q, c).

// static initialization: whoever first touches the type
direct(q, c, role, cat(why, " — first use runs the static initializer"), cert, f, l) :- target(q, "clinit", t, _), target(qq, "type", t, _), qq = cat(q, ":type"), direct(qq, c, role, why, cert, f, l).

// a PARAMETER: the method itself, its callers, (the overrides are the contract)
direct(q, m, "uses", "declares it", "resolved", "", 0) :- target(q, "param", m, _).
direct(q, c, "uses", "passes an argument for it", "resolved", f, l) :- target(q, "param", m, _), calls(c, m, _, f, l).
direct(q, c, "uses", "calls a method of this name (receiver not typed) — its argument list must match", "by name", f, l) :- target(q, "param", m, _), named(n, m), unresolved(c, n, k, f, l), !ctor_kind(k).

// a TYPE PARAMETER of a type: every callable inside the type that spells it; of a method: the method. A bound reaches the uses of Type<…> too
direct(q, c, "uses", cat("uses ", x, " in its body or signature"), "text", f, l) :- target(q, "typeparam", _, x), textuse(c, x, f, l).
direct(q, c, "uses", cat(why, " — the argument must satisfy ", x), cert, f, l) :- target(q, "typeparam", t, x), typ(t, _, _), target(qq, "type", t, _), qq = cat(q, ":type"), direct(qq, c, "uses", why, cert, f, l), (cert = "text" ; cert = "by name").
direct(q, c, "produces", cat(why, " — the argument must satisfy ", x), cert, f, l) :- target(q, "typeparam", t, x), typ(t, _, _), target(qq, "type", t, _), qq = cat(q, ":type"), direct(qq, c, "produces", why, cert, f, l).
direct(q, c, "uses", cat("calls it — its arguments must satisfy ", x), "resolved", f, l) :- target(q, "typeparam", m, x), !typ(m, _, _), calls(c, m, _, f, l).

// a LOCAL: the method, and a closure inside it that captures the name
direct(q, m, "uses", "declares it", "resolved", "", 0) :- target(q, "var", m, _).
direct(q, c, "uses", "captures it (defined inside the method)", "resolved", f, l) :- target(q, "var", m, x), edge(m, c, "defines"), ref(c, x, _, ek, f, l), local_kind(ek).
.output direct


// ── declared alongside it: the sibling members of the target's own type, and the other types declared in the same file.
//    The weakest certainty there is — no call, no reference, no contract binds them; only "a fix that touches one of these
//    very often touches the other". Excluded from `seed` below, or the closure would pull in the whole file's upstream.
.decl alongside(q:symbol, c:symbol, why:symbol)
.decl target_owner(q:symbol, t:symbol)
target_owner(q, t) :- target(q, "method", m, _), owner(m, t).
target_owner(q, t) :- target(q, "param", m, _), owner(m, t).
target_owner(q, t) :- target(q, "var", m, _), owner(m, t).
target_owner(q, t) :- target(q, "field", fl, _), field(fl, t, _, _, _).
target_owner(q, t) :- target(q, "type", t, _).
target_owner(q, t) :- target(q, "clinit", t, _).
target_owner(q, t) :- target(q, "newconst", t, _).
.decl is_target_decl(q:symbol, c:symbol)                          // the declaration(s) the query is ABOUT — never "alongside" itself
is_target_decl(q, c) :- target(q, "method", c, _).
is_target_decl(q, c) :- target(q, "param", c, _).
is_target_decl(q, c) :- target(q, "var", c, _).
is_target_decl(q, c) :- target(q, "clinit", _, c).
is_target_decl(q, c) :- target(q, "typeparam", c, _).
.decl callable_member(t:symbol, c:symbol)
callable_member(t, c) :- member(t, c, _, k), k != "field", k != "const", k != "enum_member", k != "variable".
// a sibling that touches the same state as the target is the one worth reading first (#762: "restrict it to the members
// that share a field with the target"), so it is told apart from the rest rather than ranked by chance
.decl target_field(q:symbol, n:symbol)
target_field(q, n) :- is_target_decl(q, m), ref(m, n, _, _, _, _), target_owner(q, t), member(t, _, n, k), (k = "field" ; k = "const").
target_field(q, n) :- target(q, "field", fl, _), field(fl, _, n, _, _).
.decl shares_field(q:symbol, c:symbol, n:symbol)
shares_field(q, c, n) :- target_field(q, n), ref(c, n, _, _, _, _), target_owner(q, t), callable_member(t, c).
alongside(q, c, cat("a sibling of the same type, using the same field ", n)) :- shares_field(q, c, n), !inside_target(q, c), !is_target_decl(q, c).
alongside(q, c, "a sibling of the same type") :- target_owner(q, t), callable_member(t, c), !inside_target(q, c), !is_target_decl(q, c), !shares_field(q, c, _).
alongside(q, c, "declared in the same file") :- target_owner(q, t), type_in_file(t, f), type_in_file(t2, f), t2 != t, callable_member(t2, c), !inside_target(q, c), !is_target_decl(q, c).
direct(q, c, "uses", why, "alongside", "", 0) :- alongside(q, c, why).


// ── an ANNOTATION as the target: the declarations carrying it, and (through the seeds) everything that reaches them.
//    Half of the Java commits that touch Java change one (#758); what the framework DOES with it is not in the graph.
direct(q, c, "uses", "carries this decoration", "resolved", "", 0) :- target(q, "decoration", c, _).

// ── a CONSTANT THAT DOES NOT EXIST YET (`Enum.<new>`): the impact is every switch over that enum, plus the enum's own
//    members. The question cannot be asked of a declaration, because the declaration is what the edit will add.
direct(q, c, "uses", cat("switches over it (", arms, " of its constants named) — a new constant needs an arm here"), "resolved", "", 0) :- target(q, "newconst", t, _), switch_over(c, t, arms).
direct(q, c, "uses", "a member of the enum", "alongside", "", 0) :- target(q, "newconst", t, _), callable_member(t, c).
// the same switches are worth naming when the target IS an existing constant or the enum itself
direct(q, c, "uses", cat("switches over the enum (", arms, " of its constants named)"), "resolved", "", 0) :- target(q, "type", t, _), typ(t, _, "enum"), switch_over(c, t, arms), !inside_target(q, c).
direct(q, c, "uses", cat("switches over the enum (", arms, " of its constants named)"), "resolved", "", 0) :- target(q, "field", fl, _), field(fl, t, _, _, _), typ(t, _, "enum"), switch_over(c, t, arms), !inside_target(q, c).

// ── a THROWS clause is a contract: adding a checked exception reaches every caller. Which of them already handle one is
//    the difference between "look at it" and "it will not compile".
.decl caller_handles(q:symbol, c:symbol, e:symbol)
caller_handles(q, c, e) :- target(q, "method", m, _), throws_(m, e), calls(c, m, _, _, _), throws_(c, e).
caller_handles(q, c, e) :- target(q, "method", m, _), throws_(m, e), calls(c, m, _, _, _), catches(c, e).
.decl caller_unhandled(q:symbol, c:symbol, e:symbol)
caller_unhandled(q, c, e) :- target(q, "method", m, _), throws_(m, e), calls(c, m, _, _, _), !caller_handles(q, c, e).
.output caller_handles
.output caller_unhandled
.decl target_throws(q:symbol, e:symbol)
target_throws(q, e) :- target(q, "method", m, _), throws_(m, e).
.output target_throws

// ── seeds: where the change lands. A callable: itself. A declaration: every callable whose text uses it ────────
.decl seed_of(q:symbol, m:symbol)                                 // the seeds proper — what `alongside` must never be, nor feed
.decl seed(q:symbol, m:symbol)
seed_of(q, m) :- target(q, "method", m, _).
seed_of(q, m) :- target(q, "param", m, _).
// a local is not the method: seeding the method would answer a signature change. Only the closures declared inside
// it carry the value out, and they are already direct rows
seed_of(q, c) :- target(q, "var", m, _), edge(m, c, "defines").
seed_of(q, m) :- target(q, "clinit", _, m).
seed_of(q, m) :- target(q, "decoration", m, _).
seed_of(q, t) :- target(q, "newconst", t, _).
seed_of(q, c) :- target(q, "newconst", t, _), switch_over(c, t, _).
seed_of(q, m) :- target(q, "config", k, _), config(k, m, _).
seed_of(q, t) :- target(q, "field", fl, _), field(fl, t, _, _, _).
seed_of(q, m) :- target(q, "type", t, _), member(t, m, _, _), kind(m, k), (k = "method" ; k = "constructor" ; k = "function" ; k = "module").
seed_of(q, t) :- target(q, "type", t, _).
seed_of(q, t) :- target(q, "typeparam", t, _).
seed_of(q, c) :- target(q, k, _, _), k != "method", k != "param", k != "var", direct(q, c, _, _, cert, _, _), cert != "alongside".
seed_of(q, c) :- target(q, "typeparam", t, _), typ(t, _, _), direct(q, c, _, _, cert, _, _), cert != "alongside".
seed_of(q, c) :- contract(q, c, _).
seed(q, m) :- seed_of(q, m).
.output seed

// every resolved direct row names the declaration its edge lands on, so `verified:` can check THAT pair — not
// merely that the caller calls something
.decl direct_edge(q:symbol, c:symbol, callee:symbol)
direct_edge(q, c, m) :- target(q, "method", m, _), calls(c, m, _, _, _).
direct_edge(q, c, a) :- target(q, "field", fl, _), field(fl, t, _, _, _), accessor(fl, an, _), member(t, a, an, _), calls(c, a, _, _, _).
direct_edge(q, c, k) :- target(q, "field", fl, _), field(fl, t, _, _, _), member(t, k, _, "constructor"), calls(c, k, _, _, _).
direct_edge(q, c, k) :- target(q, "field", fl, _), field(fl, t, _, _, _), holds(h, t), member(h, k, _, "constructor"), calls(c, k, _, _, _).
direct_edge(q, c, m) :- tmember(q, m, _, _), calls(c, m, _, _, _).
direct_edge(q, c, m) :- target(q, "param", m, _), calls(c, m, _, _, _).
direct_edge(q, c, m) :- target(q, "typeparam", m, _), calls(c, m, _, _, _).
.output direct_edge

// ── a barrel that re-exports the declaration: the line must change with a rename, and it is in no other table ──
direct(q, c, "uses", "re-exports it (a barrel: this line must change with a rename)", "text", f, l) :- target(q, "method", m, _), named(n, m), reexport(c, n, f, l).
direct(q, c, "uses", "re-exports it (a barrel: this line must change with a rename)", "text", f, l) :- target(q, "field", fl, _), field(fl, _, n, _, _), reexport(c, n, f, l).
direct(q, c, "uses", "re-exports it (a barrel: this line must change with a rename)", "text", f, l) :- target(q, "type", t, _), typ(t, n, _), reexport(c, n, f, l).
direct(q, c, "uses", "re-exports the whole module it is declared in (export * — a rename changes what this file exports)", "text", f, l) :- target(q, "method", m, _), decl_file(m, df), reexport(c, "*", f, l), f != df.

// ── a STRING target: a topic, a queue, a route, a bean qualifier — a name in a namespace that is not the code's ──
direct(q, c, "uses", "names it in a string literal", "text", f, l) :- target(q, "string", _, v), literal(c, v, f, l).
direct(q, c, "uses", cat("binds to it through @", d), "text", f, l) :- target(q, "string", _, v), dec_literal(c, d, v, f, l).
seed_of(q, c) :- target(q, "string", _, _), direct(q, c, _, _, cert, _, _), cert != "alongside".

// ── the transitive layer: everything that can reach a seed through resolved calls, shortest hop count ──────────
// A call site written with the target's simple name that the engine could not resolve (the receiver was not typed —
// a nested type reached through `import static Outer.Inner`, a dynamic receiver) MAY be a call to the target. It is
// not a resolved edge, so it is kept out of seed / direct and enters only here, marked, so the answer can say so.
.decl seed_byname(q:symbol, c:symbol)
seed_byname(q, c) :- target(q, "method", m, _), named(n, m), unresolved(c, n, _, _, _), !seed(q, c).
.output seed_byname
.decl up(q:symbol, m:symbol, d:number)
up(q, m, 0) :- seed(q, m).
up(q, c, 1) :- seed_byname(q, c).
up(q, a, d+1) :- up(q, b, d), edge(a, b, _), d < 40.
.decl reach(q:symbol, m:symbol, d:number)
reach(q, m, d) :- up(q, m, d), d = min x : up(q, m, x).
// the chain read-back: a is one hop further from the change than b, through edge a → b
.decl parent_up(q:symbol, a:symbol, b:symbol, t:symbol)
parent_up(q, a, b, t) :- reach(q, a, d), d > 0, reach(q, b, d1), d1 = d - 1, edge(a, b, t).
.output reach
.output parent_up

// the same closure from the seeds that are an exact edge only: what is reached ONLY through a [by name] / [text] /
// [one of a set] dependent is everything outside it, and the answer says how much of itself rests on those
.decl seed_sure(q:symbol, m:symbol)
seed_sure(q, m) :- seed(q, m), !weak_seed(q, m).
.decl weak_seed(q:symbol, m:symbol)
weak_seed(q, c) :- direct(q, c, _, _, cert, _, _), (cert = "by name" ; cert = "text" ; cert = "one of a set"), !strong_direct(q, c).
.decl strong_direct(q:symbol, c:symbol)
strong_direct(q, c) :- direct(q, c, _, _, "resolved", _, _).
strong_direct(q, c) :- direct(q, c, _, _, "in scope", _, _).
.decl up_sure(q:symbol, m:symbol, d:number)
up_sure(q, m, 0) :- seed_sure(q, m).
up_sure(q, a, d+1) :- up_sure(q, b, d), edge(a, b, _), d < 40.
.decl reach_sure(q:symbol, m:symbol)
reach_sure(q, m) :- up_sure(q, m, _).
.output reach_sure

// ── tests: a test's own body reaches the change, or a fixture its framework runs before it does ───────────────
.decl test_hit(q:symbol, m:symbol, d:number, via:symbol)
test_hit(q, m, d, "") :- reach(q, m, d), test_method(m).
test_hit(q, m, d, fx) :- reach(q, fx, d), fixture(fx), owner(fx, t), scope(t, s), member(s, m, _, _), test_method(m).
test_hit(q, m, d, fx) :- reach(q, fx, d), fixture(fx), typ(fx, _, _), member(fx, m, _, _), test_method(m).
// a test file is imported as a whole: a class body or a fixture at its top level runs before every test in it — pytest
// injects a fixture by parameter name and a pydantic model class is built at import, and neither is a call edge
test_hit(q, m, d, c) :- reach(q, c, d), decl_file(c, f), decl_file(m, f), test_method(m), !test_method(c), (kind(c, "class") ; kind(c, "module") ; fixture(c)).
// and a helper declared in a test file: a callable in that file that is not itself a test is written for the tests
// beside it (a builder, a describe callback, a fixture arrow), so what it reaches, those tests reach
test_hit(q, m, d, c) :- reach(q, c, d), decl_file(c, f), decl_file(m, f), test_method(m), !test_method(c), is_test_file(f).
.decl is_test_file(f:symbol)
is_test_file(f) :- test_method(m), decl_file(m, f).
// a class that extends a test class runs that class's tests as its own — the subclass declares nothing, and a
// change reaching the base's test breaks the subclass's run of it too (jsoup's java11 HttpClient*Test)
.decl inherited_test(q:symbol, s:symbol, m:symbol, d:number)
inherited_test(q, s, m, d) :- test_hit(q, m, d, _), owner(m, t), extends(s, t), typ(s, _, _), s != t.
.output inherited_test
.decl test_near(q:symbol, m:symbol, d:number)
test_near(q, m, d) :- test_hit(q, m, d, _), d = min x : test_hit(q, m, x, _).
.output test_near
.output test_hit

// ── bound from outside the source ──────────────────────────────────────────────────────────────────────────────
// A name written in a file the index does not read as source: an XML mapper, a META-INF/services file, a
// properties or yaml file, a build script, a spec. The binding is made by name at run time, so the compiler is
// silent and a rename breaks it. There is no callable to attribute it to, so it is its own answer.
.decl extbind(q:symbol, f:symbol, l:number, n:symbol, how:symbol)
extbind(q, f, l, n, "names the type") :- target(q, "type", t, _), typ(t, n, _), nonsource(n, f, l).
extbind(q, f, l, n, "names the type in full") :- target(q, "type", t, _), qual_name(t, n), nonsource(n, f, l).
extbind(q, f, l, n, "names the method") :- target(q, "method", m, _), named(n, m), nonsource(n, f, l).
extbind(q, f, l, n, "names the method in full") :- target(q, "method", m, _), qual_name(m, n), nonsource(n, f, l).
extbind(q, f, l, n, "names the field") :- target(q, "field", fl, _), field(fl, _, n, _, _), nonsource(n, f, l).
extbind(q, f, l, n, "defines or overrides the key") :- target(q, "config", k, _), nonsource(n, f, l), n = k.
.output extbind
