#!/usr/bin/env python3
"""axiomcode changed [<repo>] [<file>…] [--range <a>..<b> | --staged] [--old <text-file> --new <text-file> --file <path>] [--impact] [--json]
   which declarations an edit changed, and HOW — then (--impact) what that reaches.

The graph describes the tree as it was when it was built (the build stamps the commit). An edit is read against that version:
by default the working tree against the graph's commit (falling back to HEAD), `--range a..b` two commits, `--staged` the
index, or `--old/--new/--file` two texts of one file (what a hook has). Each changed line is mapped onto the declarations
the graph knows at that line, and the change is classified — the same way in every language, from the text:

    signature   a method's header changed: parameters added / removed / renamed / retyped, the return type, type parameters
    body        only lines inside a method's body changed
    field       a field's declared type, name or initializer changed
    type        a type's header changed (its name, what it extends or implements, its type parameters)
    removed     a declaration the new text no longer has
    added       lines the old text did not have, outside any changed declaration (a new method, a new field): nothing
                depends on them yet, so they are listed, not analysed

The output is one line per changed declaration with the target `axiomcode impact` takes for it; `--impact` runs impact on all
of them as one change set (the union) and prints its answer. A method whose only change is its body is a `method` target; a
signature change with one parameter changed is `Owner.m(param)`; a field is `Owner.field`; a type header is `Type`.
"""
import difflib, importlib.util, json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
_spec = importlib.util.spec_from_loader('axpath', importlib.machinery.SourceFileLoader('axpath', os.path.join(HERE, 'axiomcode-path')))
P = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(P)
G, die = P.G, P.die

def sh(*a, cwd=None):
    r = subprocess.run(a, capture_output=True, text=True, cwd=cwd); return r.stdout if r.returncode == 0 else None

def strip_code(t):
    """the text with comments and string literals blanked, same length and line breaks — a brace in a string is not a brace"""
    out = []; i = 0; n = len(t)
    while i < n:
        c = t[i]
        if t.startswith('/*', i): j = t.find('*/', i + 2); j = n if j < 0 else j + 2
        elif t.startswith('//', i) or c == '#': j = t.find('\n', i); j = n if j < 0 else j
        elif c in '"\'`':
            q = t[i:i + 3] if t[i:i + 3] in ('"""', "\'\'\'") else c; j = i + len(q)
            while j < n and not t.startswith(q, j):
                if t[j] == '\\': j += 1
                if t[j] == '\n' and len(q) == 1 and c != '`': break
                j += 1
            j = min(n, j + len(q))
        else: out.append(c); i += 1; continue
        out.append(''.join('\n' if ch == '\n' else ' ' for ch in t[i:j])); i = j
    return ''.join(out)

class Changed:
    def __init__(self, repo):
        self.g = G(repo); self.repo = self.g.repo
        st = os.path.join(self.repo, '.axiomcode', 'out', 'stamp')
        self.built_at = open(st).read().split('-')[0] if os.path.exists(st) else None            # the commit the graph describes
        self.spans = {}                                                                           # file -> [(line, end, id, kind)]
        for r in self.g.sym.values():
            if r.get('file') and r.get('line'): self.spans.setdefault(r['file'], []).append((r['line'], r['end_line'] or r['line'], r['id'], r['kind'], r['display'], r['name']))
        for r in self.g.q("SELECT rowid, display, name, kind, file, line, end_line, owner FROM symbols WHERE method_id IS NULL AND type_id IS NULL AND kind IN ('field','const','enum_member','variable')"):
            if r['file'] and r['line']: self.spans.setdefault(r['file'], []).append((r['line'], r['end_line'] or r['line'], f"f:{r['rowid']}", r['kind'], r['display'], r['name']))
        for v in self.spans.values(): v.sort()
    def rel(self, f):
        f = os.path.realpath(f) if os.path.exists(f) else f
        r = os.path.relpath(f, self.repo) if os.path.isabs(f) else f
        return r
    # ── the two texts of a file ────────────────────────────────────────────────────────────────────────────────
    def texts(self, rel, mode, rng):
        if mode == 'range':
            a, b = rng.split('..'); return sh('git', 'show', f'{a}:{rel}', cwd=self.repo) or '', sh('git', 'show', f'{b}:{rel}', cwd=self.repo) or ''
        base = self.built_at if self.built_at and self.built_at != 'nogit' and sh('git', 'cat-file', '-e', self.built_at, cwd=self.repo) is not None else 'HEAD'
        old = sh('git', 'show', f'{base}:{rel}', cwd=self.repo) or ''
        if mode == 'staged': new = sh('git', 'show', f':{rel}', cwd=self.repo) or ''
        else:
            try: new = open(os.path.join(self.repo, rel), errors='replace').read()
            except OSError: new = ''
        return old, new
    def files(self, mode, rng, given):
        if given: return [self.rel(f) for f in given]
        if mode == 'range': out = sh('git', 'diff', '--name-only', rng, cwd=self.repo)
        elif mode == 'staged': out = sh('git', 'diff', '--name-only', '--cached', cwd=self.repo)
        else:
            base = self.built_at if self.built_at and self.built_at != 'nogit' else 'HEAD'
            out = sh('git', 'diff', '--name-only', base, cwd=self.repo)
            if out is None: out = sh('git', 'diff', '--name-only', 'HEAD', cwd=self.repo)
        return [l for l in (out or '').split('\n') if re.search(r'\.(java|ts|tsx|js|mjs|cjs|py)$', l)]

    # ── the text-level structure of a declaration ─────────────────────────────────────────────────────────────
    @staticmethod
    def header_end(L, start):
        """the last line of a header starting at `start`: up to the first line holding `{`, ending with `;`, or (Python) `:`.
        Read on stripped text: a route template, a cache key or an authorization expression inside an annotation holds a
        brace, and taking that for the end of the header classified an annotation edit as body-only, its exact inverse"""
        for i in range(start - 1, min(len(L), start + 15)):
            t = strip_code(L[i])
            if '{' in t or t.rstrip().endswith(';') or (t.rstrip().endswith(':') and not t.strip().startswith(('case', 'default'))): return i + 1
        return start
    @staticmethod
    def params(header):
        m = re.search(r'\(([^()]*(?:\([^()]*\)[^()]*)*)\)', header)
        if not m: return []
        out = []; depth = 0; cur = ''
        for ch in m.group(1):
            depth += ch in '<[('; depth -= ch in '>])'
            if ch == ',' and depth == 0: out.append(cur); cur = ''
            else: cur += ch
        if cur.strip(): out.append(cur)
        res = []
        for p in out:
            p = re.sub(r'=.*$', '', p).strip(); p = re.sub(r'@\w+(\([^)]*\))?\s*', '', p)
            if not p: continue
            if ':' in p: name, typ = p.split(':', 1)[0].strip(), p.split(':', 1)[1].strip()          # TS / Python: name: Type
            else:
                toks = re.findall(r'[A-Za-z_$][\w$]*', p); name = toks[-1] if toks else p; typ = p[:p.rfind(name)].strip() if toks else ''
            res.append((name.lstrip('*.'), re.sub(r'\s+', ' ', typ)))
        return res
    @staticmethod
    def field_parts(line):
        """(declared type, name) of a field line, in either spelling: `Type name = …;` or `name: Type = …`"""
        t = re.sub(r'\s*(//.*|/\*.*?\*/\s*|#.*)$', '', line).strip()
        m = re.match(r'^(?:(?:public|private|protected|static|final|volatile|transient|readonly|export|const|let|var|declare|abstract|override)\s+)*([A-Za-z_$][\w$<>\[\],.? ]*?)\s+([A-Za-z_$][\w$]*)\s*(=|;|$)', t)
        if m and not m.group(1).strip() in ('return', 'new', 'else', 'throw'): return re.sub(r'\s+', ' ', m.group(1).strip()), m.group(2)
        m = re.match(r'^(?:(?:public|private|protected|static|readonly|export|const|let|var|declare|abstract|override)\s+)*([A-Za-z_$][\w$]*)\s*[?!]?\s*:\s*([^=;]+?)\s*(=|;|$)', t)
        if m: return re.sub(r'\s+', ' ', m.group(2).strip()), m.group(1)
        m = re.match(r'^(?:self\.)?([A-Za-z_$][\w$]*)\s*=', t)
        if m: return '', m.group(1)
        return '', ''

    # ── one file: the declarations touched and how ────────────────────────────────────────────────────────────
    def file_changes(self, rel, old, new):
        OL, NL = old.split('\n'), new.split('\n')
        sm = difflib.SequenceMatcher(None, OL, NL, autojunk=False)
        old_changed = set(); new_of = {}; added = []; removed_lines = set(); replaced = []
        # a blank line, a comment line, a brace on its own: not a change to a declaration
        TRIPLE = ('"' * 3, "'" * 3)
        noise = lambda t: not t.strip() or t.strip().startswith(('//', '*', '/*', '#') + TRIPLE) or t.strip() in ('{', '}', '};', ')', ');')
        for tag, i1, i2, j1, j2 in sm.get_opcodes():
            if tag == 'equal':
                for k in range(i2 - i1): new_of[i1 + k + 1] = j1 + k + 1
            elif tag == 'replace':
                old_changed |= {i + 1 for i in range(i1, i2) if not noise(OL[i])} or ({i1 + 1} if any(not noise(NL[j]) for j in range(j1, j2)) else set())
                new_of.update({i1 + 1: j1 + 1}); replaced.append((i1, j1 + 1, j2))                      # the new side may declare something new too
            elif tag == 'delete':
                got = {i + 1 for i in range(i1, i2) if not noise(OL[i])}; old_changed |= got; removed_lines |= got
            elif tag == 'insert':
                if any(not noise(NL[j]) for j in range(j1, j2)): added.append((i1, j1 + 1, j2))               # after old line i1, new lines j1+1..j2
        decls = self.spans.get(rel, [])
        if not decls and not old.strip() and new.strip():                                                # a new file: its declarations, all added
            decls = []; added = [(0, 1, len(NL))]; old_changed = set(); removed_lines = set(); new_of = {}; replaced = []
        elif not decls: return [], [(rel, 'no declarations known here (not in the graph, or a different file spelling)', None)]
        hits = {}
        def narrowest(ln, kinds=None):
            best = None
            for a, b, i, k, d, n in decls:
                if a <= ln <= b and (kinds is None or k in kinds) and (best is None or (b - a) < (best[1] - best[0])): best = (a, b, i, k, d, n)
            return best
        def decl_after(ln, L):
            """the declaration whose header starts within 3 lines after ln (an annotation / decorator line belongs to it)"""
            for a, b, i, k, d, n in decls:
                if ln < a <= ln + 3 and all(not L[x - 1].strip() or L[x - 1].strip().startswith('@') for x in range(ln + 1, a)): return (a, b, i, k, d, n)
            return None
        decorated = {}
        for ln in sorted(old_changed):
            if OL[ln - 1].strip().startswith('@') and not narrowest(ln, {'method', 'function', 'constructor', 'module'}):
                dd = decl_after(ln, OL)
                if dd: decorated.setdefault(dd, []).append(OL[ln - 1].strip().split('(')[0])
        for after, j1, j2 in list(added):
            if all(NL[j - 1].strip().startswith('@') or not NL[j - 1].strip() for j in range(j1, j2 + 1)):
                dd = decl_after(after, OL)
                if dd: decorated.setdefault(dd, []).extend(NL[j - 1].strip().split('(')[0] for j in range(j1, j2 + 1) if NL[j - 1].strip()); added.remove((after, j1, j2))
        for ln in sorted(old_changed):
            if OL[ln - 1].strip().startswith('@') and any(ln in range(1, dd[0]) for dd in decorated): continue
            f = next(((a, b, i, k, d, n) for a, b, i, k, d, n in decls if a == ln and k in ('field', 'const', 'enum_member', 'variable')), None)
            m = narrowest(ln, {'method', 'function', 'constructor', 'module'})
            t = narrowest(ln, {'class', 'interface', 'enum', 'type', 'namespace'})
            key = None
            if f: key = ('field', f)
            elif m and m[0] <= ln <= self.header_end(OL, m[0]): key = ('signature', m)
            elif m: key = ('body', m)
            elif t and t[0] <= ln <= self.header_end(OL, t[0]): key = ('type', t)
            elif t: key = ('inside', t)                                                                 # between members: a field the graph did not record, a comment
            if key: hits.setdefault(key, set()).add(ln)
        nd = [0] * (len(NL) + 2)
        for ii, text in enumerate(strip_code(new).split('\n'), 1): nd[ii] = nd[ii - 1] + text.count('{') - text.count('}')
        ndepth_ok = lambda j: nd[j - 1] <= 2
        out = []
        KIND = lambda k: 'field' if k in ('field', 'const', 'enum_member', 'variable') else 'type' if k in ('class', 'interface', 'enum', 'type', 'namespace') else 'method'
        for (a, b, i, k, d, n), decs in decorated.items():
            key = ('field' if k in ('field', 'const', 'enum_member', 'variable') else 'type' if k in ('class', 'interface', 'enum', 'type', 'namespace') else 'signature', (a, b, i, k, d, n))
            hits.setdefault(key, set()); hits[key].add(-1)                                                # -1: the decoration line, outside the header
        for (kind, (a, b, i, k, d, n)), lines in hits.items():
            decs = decorated.get((a, b, i, k, d, n))
            entry = dict(kind=kind, symbol=d, id=i, file=rel, line=a, end=b, old_lines=sorted(x for x in lines if x > 0), target_kind=('param' if kind == 'signature' else KIND(k)))
            span_lines = [x for x in range(a, b + 1) if not noise(OL[x - 1])]
            gone = a in removed_lines and span_lines and sum(1 for x in span_lines if x in removed_lines) >= 0.6 * len(span_lines) and \
                   not any(re.search(rf'\b{re.escape(n)}\s*\(', NL[j - 1]) and ndepth_ok(j) for j in range(max(1, (new_of.get(a) or a) - 3), min(len(NL), (new_of.get(a) or a) + 3) + 1))
            if gone: entry['kind'] = 'removed'; entry['target'] = self.target(kind, d, k, n); out.append(entry); continue
            if kind == 'signature':
                oh = ' '.join(x.strip() for x in OL[a - 1:self.header_end(OL, a)])
                na = new_of.get(a) or (new_of.get(max((x for x in new_of if x < a), default=0), 0) + 1)
                nh = ''
                if na and na <= len(NL):
                    # the new header: from the mapped line, the first line holding the name, to its end
                    for s in range(max(1, na - 2), min(len(NL), na + 6) + 1):
                        if re.search(rf'\b{re.escape(n)}\b', NL[s - 1]): nh = ' '.join(x.strip() for x in NL[s - 1:self.header_end(NL, s)]); break
                # the header may start on an annotation line: its arguments are not a parameter list, and its text is
                # not a return type. Read the signature from the first line that is not a decoration
                sig = lambda h: re.sub(r'^\s*(@\w[\w.]*\s*(\([^)]*\))?\s*)+', '', h).strip()
                oh_s, nh_s = sig(oh), sig(nh)
                op, np_ = self.params(oh_s), self.params(nh_s) if nh_s else []
                on, nn = [x for x, _ in op], [x for x, _ in np_]
                detail = []
                if nh and not re.search(rf'\b{re.escape(n)}\b', nh): detail.append('renamed')
                for x in on:
                    if x not in nn: detail.append(f'-{x}')
                for x in nn:
                    if x not in on: detail.append(f'+{x}')
                for (x, t1), (y, t2) in zip(op, np_):
                    if x == y and t1 != t2 and t1 and t2: detail.append(f'{x}: {t1} → {t2}')
                pre_o = re.sub(r'\(.*$', '', oh_s); pre_n = re.sub(r'\(.*$', '', nh_s) if nh_s else ''
                if nh and pre_o.split() != pre_n.split():
                    ro = [w for w in pre_o.split() if w != n]; rn = [w for w in pre_n.split() if w != n]
                    if ro != rn: detail.append('return type / modifiers: ' + ' '.join(ro) + ' → ' + ' '.join(rn))
                if not detail and nh and re.sub(r'\s', '', oh) != re.sub(r'\s', '', nh): detail.append('header text changed (annotations / throws / generics)')
                if detail and not decs and re.sub(r'\s', '', oh_s) == re.sub(r'\s', '', nh_s) and nh_s: detail = ['decoration changed above the signature (the signature itself is unchanged)']
                if not detail and not nh: detail.append('header changed (the new header could not be located — renamed?)')
                if decs: detail.append('decoration changed: ' + ', '.join(dict.fromkeys(decs)) + ' — what the framework does with it (a proxy, a transaction, a cache, a route) is NOT in the graph; only the code that names it is')
                if not detail: entry['kind'] = 'body'                                                  # whitespace or a comment in the header
                entry['detail'] = ', '.join(detail); entry['old_header'] = oh; entry['new_header'] = nh
                changed_params = [x for x, _ in op if any(dd.startswith(f'{x}:') or dd == f'-{x}' for dd in detail)]
                entry['target'] = (f"{d}({changed_params[0]})" if len(changed_params) == 1 and entry['kind'] == 'signature' else d)
                entry['target_kind'] = 'param' if '(' in entry['target'] else 'method'
            elif kind == 'field':
                ot, on_ = self.field_parts(OL[a - 1]); na = new_of.get(a)
                nline = ''
                for s in range(max(1, (na or a) - 2), min(len(NL), (na or a) + 3) + 1):
                    if re.search(rf'\b{re.escape(n)}\b', NL[s - 1]): nline = NL[s - 1]; break
                nt, nn_ = self.field_parts(nline) if nline else ('', '')
                if not nline: detail = 'removed or renamed'
                elif ot and nt and ot != nt: detail = f'type {ot} → {nt}'
                elif nn_ and nn_ != n: detail = f'renamed → {nn_}'
                else: detail = 'initializer / modifiers changed'
                if decs: detail += '; decoration changed: ' + ', '.join(dict.fromkeys(decs)) + ' — the framework behaviour it turns on is NOT in the graph'
                entry['detail'] = detail; entry['target'] = d
            elif kind == 'type':
                entry['detail'] = 'header changed (name, extends / implements, type parameters)' + ('; decoration changed: ' + ', '.join(dict.fromkeys(decs)) + ' — the framework behaviour it turns on is NOT in the graph' if decs else ''); entry['target'] = d
            elif kind == 'body': entry['target'] = d
            else: entry['target'] = None
            out.append(entry)
        adds = []
        ndepth = [0] * (len(NL) + 2)                                                                     # brace depth at the START of each new line
        for i, text in enumerate(strip_code(new).split('\n'), 1): ndepth[i] = ndepth[i - 1] + text.count('{') - text.count('}')
        for after, j1, j2 in added + [(a, b, c) for a, b, c in replaced]:
            is_add = (after, j1, j2) in added
            owner = narrowest(after, {'method', 'function', 'constructor', 'module'}) if after else None
            # a blank line between two declarations belongs to neither: an insertion anchored there used to be charged
            # to the preceding one, so the whole answer could be about a declaration whose text did not change
            if is_add and owner and owner[0] <= after < owner[1] and after <= len(OL) and not noise(OL[after - 1]):   # strictly inside a callable's body: that callable changed
                if not any(e['id'] == owner[2] for e in out):
                    out.append(dict(kind='body', symbol=owner[4], id=owner[2], file=rel, line=owner[0], end=owner[1], old_lines=[after], target=owner[4], target_kind='method'))
                # and the inserted lines may still declare something at the type's level (a method extracted from this body)
            t = narrowest(after, {'class', 'interface', 'enum', 'type', 'namespace'}) if after else None
            # a declaration the new text introduces: named from its header, owner = the type around the insertion point
            names = []; hdrs = {}
            # the type's body level in the NEW text: brace depth just after its header (indentation for Python); a declaration
            # the insertion introduces sits exactly there — a local inside a new method's body sits deeper
            py = rel.endswith('.py'); tline = new_of.get(t[0]) if t else None
            if t and not tline:                                                                       # the type's header line moved: find it in the new text by name
                tline = next((j for j in range(1, len(NL) + 1) if re.search(rf'\b(class|interface|enum|record|trait|struct)\s+{re.escape(t[5])}\b', NL[j - 1])), None)
            if tline: body_depth = ndepth[self.header_end(NL, tline)] if not py else len(NL[tline - 1]) - len(NL[tline - 1].lstrip()) + 4
            else: body_depth = 0
            for j in range(j1, j2 + 1):
                text = NL[j - 1]; st = re.sub(r'\s*(//.*|/\*.*?\*/\s*)$', '', text).strip()
                st = re.sub(r'^(@[\w.]+(\([^)]*\))?\s+)+(?=\w)', '', st)                                # `@Override public …` on one line
                here = (ndepth[j - 1] if not py else len(text) - len(text.lstrip()))
                if here != body_depth or not st or st.startswith(('//', '*', '/*', '@', '#', 'return', 'if', 'for', 'while', 'switch', 'else', 'throw', 'new ', 'case', 'try', 'catch')): continue
                tm = re.match(r'^(?:(?:public|private|protected|static|final|abstract|sealed)\s+)*(class|interface|enum|record|@interface)\s+([A-Za-z_$][\w$]*)', st)
                if tm: names.append((tm.group(2), tm.group(1).lstrip('@') + ' (with its members)')); hdrs[tm.group(2)] = st; continue
                m = re.match(r'^(?:def|function|async function)\s+([A-Za-z_$][\w$]*)\s*\(', st) or \
                    re.match(r'^(?:[\w<>\[\],.?$ ]+\s+)?([A-Za-z_$][\w$]*)\s*\([^;=]*\)\s*(?:throws[\w.,\s]+)?\s*(\{|;|$)', st) or \
                    re.match(r'^(?:[\w<>\[\],.?$ ]+\s+)?([A-Za-z_$][\w$]*)\s*\([^;={]*$', st)
                if m and not re.match(r'^(if|for|while|switch|catch|synchronized|return|new|super|this|else)$', m.group(1)) and '=' not in st.split('(')[0]:
                    names.append((m.group(1), 'method')); hdrs[m.group(1)] = ' '.join(x.strip() for x in NL[j - 1:self.header_end(NL, j)]); continue
                ty, nm = self.field_parts(st)
                if nm and ty and st.endswith(';') and '(' not in st.split('=')[0]: names.append((nm, 'field'))
            # a declaration the old file already has — same owner, same name, same arity — is not new (an added OVERLOAD is)
            def types_of(hdr):
                """the parameter types of a header, as simple names: `List<String> xs, int n` → [List, int]; a signature without names too"""
                out = []
                for name, typ in self.params(hdr):
                    tt = typ or name                                                                  # a signature spells types only
                    out.append(re.sub(r'<.*', '', tt.split('.')[-1]).replace('...', '[]').strip())
                return out
            def old_has(nm, hdr):
                ht = types_of(hdr) if '(' in hdr else None
                for a, b, i, k, d, n in decls:
                    if n != nm or (t and not d.startswith(t[4] + '.') and d != t[4] + '.' + nm and k not in ('class', 'interface', 'enum')): continue
                    if ht is not None and k in ('field', 'const', 'enum_member', 'variable'): continue     # a field of that name is not this method
                    if ht is None or k in ('class', 'interface', 'enum', 'field', 'const', 'enum_member'): return True
                    sig = self.g.sym.get(i, {}).get('signature') or ''
                    if not sig or '(' not in sig: return True
                    if types_of(sig) == ht:
                        # the graph drops a varargs marker, so `get(String...)` is stored as `get(String)` and a genuinely
                        # new `get(String)` used to match it and read as unchanged, which printed "no change" on a file
                        # git reports as changed. Compare the declaration's own text before believing the signature key
                        old_hdr = ' '.join(x.strip() for x in OL[a - 1:self.header_end(OL, a)])
                        if ('...' in old_hdr) != ('...' in hdr): continue
                        return True
                return False
            for nm, k in names:
                if old_has(nm, hdrs.get(nm, '')): continue
                # an added method whose name already exists on this owner is an OVERLOAD: the compiler may rebind
                # existing call sites of that name to it, and a call site records no argument types, so which of them
                # rebind cannot be decided here. Never claim nothing depends on it
                sib = []
                if k in ('method', 'function', 'constructor') and t:
                    for i, sy in self.g.sym.items():
                        if sy.get('method_id') and sy['name'] == nm and (sy['owner'] or '') == t[4]:
                            sib += [r[0] for r in self.g.q("SELECT DISTINCT s.display FROM call_edges e JOIN symbols s ON s.id = e.caller_id WHERE e.callee_method_id = ?", sy['method_id'])]
                note = f'new {k}'
                if sib: note += f"; an overload: {len(set(sib))} existing call site(s) of {(t[4] + '.') if t else ''}{nm} may rebind to it (a call site records no argument types, so which of them is NOT decidable here): " + ', '.join(sorted(set(sib))[:4]) + (' …' if len(set(sib)) > 4 else '')
                out.append(dict(kind='added', symbol=(t[4] + '.' if t else '') + nm, id=None, file=rel, line=j1, end=j2, old_lines=[], detail=note,
                                target=((t[4] + '.' if t else '') + nm) if sib else None))
                if 'members' in k:                                                                        # the new type's own declarations, one level deeper — its whole body in the new text
                    hj = next((j for j in range(j1, j2 + 1) if re.search(rf'\b{re.escape(nm)}\b', NL[j - 1])), j1); j = hj + 1
                    while j <= len(NL) and (ndepth[j - 1] > body_depth if not py else (not NL[j - 1].strip() or len(NL[j - 1]) - len(NL[j - 1].lstrip()) > body_depth)):
                        st2 = re.sub(r'^(@[\w.]+(\([^)]*\))?\s+)+(?=\w)', '', re.sub(r'\s*(//.*|/\*.*?\*/\s*)$', '', NL[j - 1]).strip()); here2 = (ndepth[j - 1] if not py else len(NL[j - 1]) - len(NL[j - 1].lstrip())); j += 1
                        if here2 != body_depth + (1 if not py else 4) or not st2 or st2.startswith(('//', '*', '/*', '@', '#', '}', '{')): continue
                        mm = re.match(r'^(?:[\w<>\[\],.?$ ]+\s+)?([A-Za-z_$][\w$]*)\s*\([^;={]*', st2) or re.match(r'^(?:def|function)\s+([A-Za-z_$][\w$]*)\s*\(', st2)
                        if mm and mm.group(1) not in ('if', 'for', 'while', 'switch', 'catch', 'return', 'new', 'super', 'this'): out.append(dict(kind='added', symbol=f"{(t[4] + '.' if t else '')}{nm}.{mm.group(1)}", id=None, file=rel, line=j - 1, end=j - 1, old_lines=[], detail='new method', target=None)); continue
                        ty2, nm2 = self.field_parts(st2)
                        if nm2 and ty2 and st2.endswith(';') and '(' not in st2.split('=')[0]: out.append(dict(kind='added', symbol=f"{(t[4] + '.' if t else '')}{nm}.{nm2}", id=None, file=rel, line=j - 1, end=j - 1, old_lines=[], detail='new field', target=None))
            if not names and is_add: adds.append((rel, f"{j2 - j1 + 1} new line(s) at {rel}:{j1}" + (f" inside {t[4]}" if t else ''), None))
        # A DECLARATION WHOSE SIGNATURE CHANGED IS NOT A NEW ONE. `added` is decided by whether the OLD text has a
        # header that matches, so editing the header itself — `def f(a)` to `def f(a, *, cap=0)`, or `def` to
        # `async def` — fails that test and the same declaration was reported twice: once as `signature`, and once as
        # `added` carrying the line "no declaration of that name existed before", which the graph itself contradicts.
        # An added OVERLOAD keeps its row: the old declaration is untouched there, so no signature row names it.
        sigged = {(e['file'], e['symbol']) for e in out if e['kind'] in ('signature', 'field', 'type')}
        out = [e for e in out if not (e['kind'] == 'added' and (e['file'], e['symbol']) in sigged)]
        return out, adds
    @staticmethod
    def target(kind, d, k, n):
        return d

def main(argv):
    a = list(argv); mode = 'worktree'; rng = None; want_impact = '--impact' in a; as_json = '--json' in a
    a = [x for x in a if x not in ('--impact', '--json')]
    old_f = new_f = one = None
    for flag in ('--range', '--old', '--new', '--file'):
        if flag in a:
            i = a.index(flag); v = a[i + 1]; del a[i:i + 2]
            if flag == '--range': mode, rng = 'range', v
            elif flag == '--old': old_f = v
            elif flag == '--new': new_f = v
            else: one = v
    if '--staged' in a: mode = 'staged'; a.remove('--staged')
    repo = '.'
    if a and os.path.isdir(a[0]): repo = a.pop(0)
    C = Changed(repo)
    results = []; notes = []
    if old_f or new_f:
        if not one: die("--old/--new need --file <path in the repo>")
        rel = C.rel(one); old = open(old_f, errors='replace').read() if old_f else ''; new = open(new_f, errors='replace').read() if new_f else ''
        r, n = C.file_changes(rel, old, new); results += r; notes += n
    else:
        files = C.files(mode, rng, a)
        # the graph describes ONE commit. For a range whose newer side is that commit, the declarations are read on the new
        # text and the classification runs with the two texts swapped, then its direction is turned around
        flipped = False
        if mode == 'range' and C.built_at and rng:
            b = rng.split('..')[1]; hb = sh('git', 'rev-parse', b, cwd=C.repo)
            flipped = bool(hb) and hb.strip().startswith(C.built_at[:10]) is False and hb.strip() == C.built_at
            if hb and not flipped and hb.strip()[:10] == C.built_at[:10]: flipped = True
        for rel in files:
            old, new = C.texts(rel, mode, rng)
            if old == new: continue
            if flipped:
                r, n = C.file_changes(rel, new, old)
                for e in r:
                    if e['kind'] == 'removed': e['kind'] = 'added (declaration)'; e['target'] = None
                    if e.get('detail'):
                        e['detail'] = ' → '.join(reversed(e['detail'].split(' → '))) if ' → ' in e['detail'] and ':' not in e['detail'] else re.sub(r'(\w+): (.+?) → (.+?)(,|$)', r'\1: \3 → \2\4', e['detail'])
                        e['detail'] = re.sub(r'(^|, )([+-])(\w+)', lambda m: m.group(1) + ('-' if m.group(2) == '+' else '+') + m.group(3), e['detail'])
                    e['old_header'], e['new_header'] = e.get('new_header'), e.get('old_header')
                results += r; notes += [(f, x.replace('new line(s)', 'line(s) gone'), z) for f, x, z in n]
            else:
                r, n = C.file_changes(rel, old, new); results += r; notes += n
        if flipped: notes.append(('', f"the graph is built at the newer commit {C.built_at[:10]}: declarations are the new text's; a declaration the range removed is not in it", None))
    if as_json: print(json.dumps({'built_at': C.built_at, 'changed': results, 'notes': [x[1] for x in notes]}, indent=1)); return 0
    if not results and not notes: print("no change to a declaration the graph knows" + (f" (working tree against {C.built_at[:10]})" if C.built_at and mode == 'worktree' else '')); return 0
    print(f"changed declarations ({len(results)})" + (f" — against the graph's commit {C.built_at[:10]}" if C.built_at and mode == 'worktree' else (f" — {rng}" if rng else '')) + ":")
    for e in results:
        print(f"  {e['kind']:<10} {e['symbol']}   {e['file']}:{e['line']}" + (f"   — {e['detail']}" if e.get('detail') else '') + (f"   → impact {e['target']}" if e.get('target') else ('   (no declaration of that name existed before, so nothing in the old tree names it)' if e['kind'] == 'added' else '')))
    for _, n, _ in notes: print(f"  {'added':<10} {n}")
    groups = {}
    for e in results:
        if e.get('target') and e['kind'] != 'added':
            k = 'method' if e.get('target_kind') == 'param' and '(' not in e['target'] else e.get('target_kind', 'method')
            groups.setdefault('' if '(' in e['target'] else k, []).append(e['target'])
    if want_impact and groups:
        for k, ts in groups.items():                                                                    # one impact run per kind (a field named like a method needs to be told apart)
            print(); sys.stdout.flush()
            subprocess.run([sys.executable, os.path.join(HERE, 'axiomcode-impact'), *dict.fromkeys(ts), C.repo] + (['--kind', k] if k else []))
    return 0

if __name__ == '__main__':
    if sys.argv[1:] and sys.argv[1] in ('-h', '--help'): print(__doc__); sys.exit(0)
    sys.exit(main(sys.argv[1:]))
