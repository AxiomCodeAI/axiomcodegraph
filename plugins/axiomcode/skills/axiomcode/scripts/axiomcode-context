#!/usr/bin/env python3
"""axiomcode context "<the task, in your own words>" [<repo>] [--in <path>[,<path>…]]… [--budget N] [--source] [--explain | --no-explain] [--from <name>]… [--page N|all] [--page-budget N] [--json]

A task that asks HOW something works ("how does X …", "explain …", "what happens when …", or --explain) also gets
the call flow: the spine of the mechanism in the order the calls are written, each step with its edge's certainty,
the line that makes the call, and the calls in its body the graph could not resolve. --from <name> starts the flow
there instead of at the entry the task's words choose.

THE FRONT DOOR — the context an agent needs before it can ask anything precise. Every other verb needs a name you already have — a method, a type, a file:line. That is
the wrong first question on an unfamiliar repository, and it is measurably where an agent gives up: in a
recorded run the agent asked once, the word resolved to nothing it could use, and it never touched the
graph again.

This takes the problem statement instead. It is deterministic — no model, no embedding index, no network:

  1. the task text is split into content terms (stopwords dropped, camelCase and snake_case split), so
     "Vapor: onUnmounted never fires on app.unmount()" gives vapor · unmounted · app · unmount
  2. every symbol is scored against those terms — exact name, prefix, substring, then the file path — each
     weighted by INVERSE DOCUMENT FREQUENCY over the graph's own vocabulary, so a rare word like
     `onUnmounted` outweighs a common one like `component`
  3. a TEST or BENCHMARK declaration is demoted, not dropped. Asked "where is serialization handled", a
     purely lexical ranker will answer `SerializationBenchmark` — the name matches perfectly and the file
     is worthless. Demoting it costs nothing when the real answer exists and saves the query when it does not
  4. the best seed per term is kept, so a multi-concept task gets several entry points rather than one
  5. the closure is walked from those seeds and the answer is ranked by NEAREST HOP, then by how many of
     the task's terms the file matches — not by how many methods the file happens to contain
  6. the output is BUDGETED here rather than left for the reader to truncate arbitrarily

It ends by saying what it could NOT see, because a partial list that reads as complete is what turns a
5-file change into a 1-file patch.
"""
import importlib.machinery, importlib.util, math, os, re, sys, collections

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import ax_edges, ax_text
from ax_contract import (subtokens, TESTY, SPLIT, CAMEL, require_scope, sole_scope, best_scope, budgeted, BOUND,
                         scope_spec, under_scope, scope_sql,
                         dirs_with_counts, drop_ancestors, offer, task_text, task_terms, winnow, headline, is_synthetic, code_terms,
                         stem)
_spec = importlib.util.spec_from_loader('axpath', importlib.machinery.SourceFileLoader('axpath', os.path.join(HERE, 'axiomcode-path')))
P = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(P)
G, die = P.G, P.die

# How many declarations to name under each file. Swept over 31 real commits: 1 gives 18% function recall at
# 987 tokens per correct answer, 2 gives 24% at 790, 3 gives 27% at 748 but takes precision from 4% to 2%.
# Two is the knee — most of the recall, and the answer stays an answer rather than a listing.
DECLS_PER_FILE = 2

SOURCE_LINES = 12          # with --source, how much of each declaration to print before eliding

EXACT, PREFIX, SUBSTR, PATH = 1000.0, 100.0, 1.0, 0.5
# A path token is a near-exact signal, not a weak one: a monorepo puts the answer's PACKAGE in the path and
# nowhere else. "Vapor: onUnmounted never fires" names the package, and four of that task's five files live
# under runtime-vapor/ while the same basenames also exist under runtime-core/ — without weighting the path
# the ranker cannot tell the two apart and picks whichever has more methods.
PATH_TOKEN = 60.0
TEST_PENALTY = 0.05          # demoted by 20x, never dropped: sometimes the test IS where the answer lives
COMMON_PATH = 0.25           # a word in more than a quarter of the file paths earns no path bonus


def score_symbols(g, terms, use_path=True):
    """{symbol id: (score, matched terms)} — the lexical tier, IDF-weighted.

    IDF is computed over the graph's OWN vocabulary rather than a general corpus: in a rendering library
    `component` is in half the names and carries almost nothing, while `unmounted` is in three and carries
    the query. Without it every common word drags the ranking toward the biggest files.
    """
    df = collections.Counter()
    names = {}
    for sid, s in g.sym.items():
        toks = set(subtokens(s.get('name') or '') + subtokens(s.get('display') or ''))
        names[sid] = toks
        for t in toks: df[t] += 1
    N = max(len(names), 1)
    idf = {t: math.log(1 + N / (1 + df.get(t, 0))) for t in terms}

    scored = {}
    for sid, s in g.sym.items():
        nm = (s.get('name') or '').lower()
        disp = (s.get('display') or '').lower()
        path = (s.get('file') or '').lower()
        toks = names[sid]
        ptoks = set(subtokens(s.get('file') or ''))
        total, matched = 0.0, []
        for t in terms:
            w = idf.get(t, 1.0)
            if nm == t or t in toks and nm == t: total += EXACT * w; matched.append(t)
            elif nm.startswith(t) or any(x.startswith(t) for x in toks):
                # A prefix match is only as good as how much of the token it covers. Flat-weighting it let
                # the 3-letter term `app` (from "when the app is unmounted") score full prefix weight against
                # applyDirectivesToElement, appendVnodeHook and applyDynamicModel — none of them related to the
                # question. Scaled by coverage, `app`->`apply` is worth 0.6 of a prefix hit and
                # `unmount`->`unmounted` 0.78, which is the ordering a reader would expect.
                best = max([len(t) / len(x) for x in toks if x.startswith(t)] +
                           ([len(t) / len(nm)] if nm.startswith(t) and nm else []), default=0.0)
                total += PREFIX * w * min(best, 1.0); matched.append(t)
            elif any(t.startswith(x) and len(x) >= 4 for x in toks):
                # The TERM can be the longer one: prose says "unmounted"/"unmounting" where the code declares
                # `unmount`. Only checking symbol-starts-with-term misses every inflected form, which is most
                # of how a bug report refers to an action. Scored like a prefix match, scaled the same way.
                best = max((len(x) / len(t) for x in toks if t.startswith(x) and len(x) >= 4), default=0.0)
                total += PREFIX * w * min(best, 1.0); matched.append(t)
            elif len(t) >= 5 and any(len(x) >= 4 and stem(x) == stem(t) for x in toks):
                # the same word inflected the other way: `validation` for `validator`, `ordered` for `orders` (#1493)
                total += PREFIX * w * 0.8; matched.append(t)
            elif t in nm or t in disp: total += SUBSTR * w; matched.append(t)
            elif not use_path: continue
            elif t in ptoks: total += PATH_TOKEN * w; matched.append(t)      # the package, spelled out
            elif t in path: total += PATH * w; matched.append(t)
        if not total: continue
        # coverage: a symbol matching three of the task's words beats one matching the same word thrice
        total *= (1 + len(set(matched)) / max(len(terms), 1))
        if s.get('is_test') or TESTY.search(s.get('file') or ''): total *= TEST_PENALTY
        scored[sid] = (total, sorted(set(matched)))
    return scored


def landing(g, scored):
    """({file: its best symbol score}, {file: the task terms its symbols match}) — where the task's words land, per file"""
    best, words = collections.defaultdict(float), collections.defaultdict(set)
    for sid, (sc, matched) in scored.items():
        f = (g.sym.get(sid) or {}).get('file')
        if not f: continue
        best[f] = max(best[f], sc); words[f].update(matched)
    return best, words


def flow_words(g, ids, landed, depth=4):
    """{id: the task terms that land in a file its flow reaches} — resolved calls only, to the depth a flow is shown"""
    _best, words = landed
    out = collections.defaultdict(set)
    for r in g.q("SELECT DISTINCT caller_id c, callee_method_id m FROM call_edges WHERE callee_method_id IS NOT NULL"):
        if r['m'] != r['c']: out[r['c']].add(r['m'])
    res = {}
    for x in ids:
        seen, front = {x}, [x]
        for _d in range(depth):
            front = [y for f in front for y in out.get(f, ()) if y not in seen and not seen.add(y)]
        res[x] = set().union(*(words.get((g.sym.get(y) or {}).get('file'), ()) for y in seen))
    return res


def from_starts(g, ids, landed, scopes=()):
    """The declarations a `--from <name>` starts the flow at, of the `ids` that name resolves to.

    A common name (main, run, init, handler) is declared in every tool, fixture and test of a repository: starting at
    all of them printed a page of unrelated flows, the one the task was about somewhere in it or cut off. A scope the
    caller gave is knowledge and keeps only what is under it — none under it is none. Without one, the task's own
    words choose: the declarations whose FLOW reaches the files those words land in, most words first. Only the file a
    declaration sits in was not enough: `tools/pkg/cli.py main` and `tools/gen/make.py main` both matched "tool" by
    their path, while only the first calls into the code the task named. When the words land in no flow, every
    declaration stays.
    """
    if scopes:
        ids = [x for x in ids if any(under_scope(g.sym[x].get('file'), scope_spec(sc, g.repo)) for sc in scopes)]
    if len(ids) < 2: return ids
    reach = flow_words(g, ids, landed)
    hit = sorted((x for x in ids if reach[x]), key=lambda x: (-len(reach[x]), bool(g.sym[x].get('is_test'))))
    # a word as common as the name lands a little everywhere: keep the flows that reach more than half the best's words
    return [x for x in hit if 2 * len(reach[x]) > len(reach[hit[0]])] if hit else ids


# How many of a directory's best symbols count toward its score. Swept over the same 18 tasks: 1 scores
# 44% (one lucky symbol decides a package), 2 or 3 score 55%, 5 and 8 both score 61%, 15 drops to 55% and
# 50 to 50% -- by then the score is drifting back toward "how much does this directory contain".
DIR_EVIDENCE = 5


def scope_terms(g, task):
    """The words that choose a PLACE — the headline's, not the whole report's. See ax_contract.headline."""
    h = headline(task_text(task))
    return winnow(g, task_terms(h), strong=code_terms(h))


def rank_dirs(g, terms, depth=3, topk=DIR_EVIDENCE):
    """Which directories the task's words actually LAND in — the menu a scope-less call is offered.

    Two things this deliberately does not do. It does not score a directory by how many symbols it holds:
    the umbrella directory of a monorepo holds every package inside it and would always win, which is a
    fact about the layout and not about the question. And it scores symbols with the PATH CONTRIBUTION OFF,
    because using the path to choose the path is circular — every symbol under `packages/vue` matches the
    term `vue` by virtue of living there, so the package a repository is named after was ranked top by any
    issue that merely stated its version, while the packages holding the answer were not marked at all.

    What is left is name evidence: the sum of the best `topk` symbol scores under the directory. A few
    symbols that are really about the task beat many that are faintly about it.
    """
    terms = winnow(g, terms)
    scored = score_symbols(g, terms, use_path=False)
    per = collections.defaultdict(list)
    hits = collections.defaultdict(collections.Counter)
    counts = dirs_with_counts(g, depth)
    for sid, (sc, matched) in scored.items():
        f = (g.sym.get(sid, {}).get('file') or '')
        parts = [x for x in f.split('/') if x and not x.startswith('<')]
        for d in range(1, min(len(parts), depth)):
            key = '/'.join(parts[:d])
            per[key].append(sc)
            for t in matched: hits[key][t] += sc
    ranked = []
    for d, n in counts.items():
        top = sorted(per.get(d, ()), reverse=True)[:topk]
        # the mark names the words that EARNED the rank, heaviest first — sorting them alphabetically
        # printed the three least informative terms the directory happened to contain
        best = [t for t, _w in hits.get(d, collections.Counter()).most_common(3)]
        ranked.append((d, n, sum(top), best))
    # score first; on a tie the DEEPER path wins, because it is the more specific instruction
    ranked.sort(key=lambda r: (-r[2], -r[0].count('/'), r[0]))
    return ranked


def pick_seeds(g, scored, terms, want, named=(), prefer=frozenset()):
    """The entry points, in four passes, each only filling what the one before left:

      1. what the question NAMES: a declaration it spells out (`IRouter.RouteAsync`), a route it quotes
         (`GET /api/widgets`). Those are not guesses from words; they are the subject.
      2. the symbols that match SEVERAL of the task's terms at once, best first, each taken only when it covers a term
         no earlier seed covered, plus up to FLOW_FAN siblings matching the same terms (the implementations of one
         interface method). "Who calls IRouter.RouteAsync in the library code" is ONE subject, and a seed per word gave
         `code`, `tests` and `call` a seed each while an implementation of the subject was crowded out (#1455).
      3. the best symbol for each term still uncovered, as before, so a task naming unrelated concepts still enters the
         graph at each of them;
      4. the best overall.

    Equal scores are common: `findByCode` on a mapper, a repository, a service and a query class all match the same
    two words the same way. A tie used to fall to the graph's symbol ids, which are hashes that change with the
    directory a project is indexed in, so the same question on the same code picked a different four of nine from one
    copy to the next. A tie now goes first to `prefer` (a declaration bound by a text file of the kind the question
    asks about: the mapper method whose XML holds the SQL, when the question asks which SQL runs), then to the one
    whose own name holds more of the matched words, then to one a reader can go to (below), then to its name and place,
    which do not move.

    Name order alone is not neutral: `"node:sqlite".StatementSync.run` (a typing), `<lambda>` and `AllMethodExamples`
    (test data) sort before `TsLocalResolver.run`, so a tie went to what has no code to read. Before the name, a tie
    goes to source over test code, then to a declaration with a body over a typing (`.d.ts`) or an anonymous one.
    """
    seeds, seen, covered = [], set(), set()
    def take(sid, why, sc):
        if sid in seen or len(seeds) >= want: return False
        seen.add(sid); seeds.append((sid, why, sc)); covered.update(scored.get(sid, (0, []))[1]); return True
    for sid, why in named:
        take(sid, why, scored.get(sid, (0, []))[0])
    # the task's words in the declaration's OWN name beat the same words reached through its owner or its path:
    # `OrderCreatedEvent` says more about "where is an order created" than `Order.getCreatedAt` does
    own = lambda sid: sum(t in ((g.sym.get(sid) or {}).get('name') or '').lower() for t in scored.get(sid, (0, []))[1])
    def readable(sid):
        sy = g.sym.get(sid) or {}
        f, nm = sy.get('file') or '', sy.get('name') or ''
        anonymous = nm.startswith(('<', '"', "'")) and nm != '<constructor>'      # a constructor has a body to read
        return (bool(sy.get('is_test') or TESTY.search(f)), f.endswith('.d.ts') or anonymous)
    tie = lambda sid: (sid not in prefer, -own(sid)) + readable(sid) + (g.disp(sid) or '', g.loc(sid) or '', sid)
    ranked = sorted(scored.items(), key=lambda kv: (-kv[1][0],) + tie(kv[0]))
    floor = 0.05 * ranked[0][1][0] if ranked else 0
    multi = [(sid, sc, m) for sid, (sc, m) in ranked if len(m) >= 2 and sc >= floor]
    multi.sort(key=lambda r: (-len(r[2]), -r[1]) + tie(r[0]))
    for i, (sid, sc, m) in enumerate(multi):
        if len(seeds) >= want: break
        if not set(m) - covered: continue
        take(sid, "matches '" + "' + '".join(m) + "'", sc)
        sib = 0
        for sid2, sc2, m2 in multi[i + 1:]:
            if sib >= FLOW_FAN: break
            if m2 == m and sc2 >= 0.5 * sc and take(sid2, "matches '" + "' + '".join(m2) + "'", sc2): sib += 1
    best = {}
    for sid, (sc, matched) in ranked:
        for t in matched:
            cur = best.get(t)
            if cur is None or sc > cur[0]: best[t] = (sc, sid)
    for t in terms:
        if t in best and t not in covered: take(best[t][1], f"matches '{t}'", best[t][0])
    for sid, (sc, _m) in ranked:
        if len(seeds) >= want: break
        take(sid, '', sc)
    return seeds[:want]


# ── what the question NAMES, rather than the words it uses ──────────────────────────────────────────────────────────
QUALIFIED = re.compile(r'(?<![\w$.-])([A-Za-z_$][\w$]*(?:(?:\.|::|#)[A-Za-z_$][\w$]*)+)')
IDENT_SHAPE = re.compile(r'^(?:[a-z]+[A-Z]\w*|[A-Z][a-z0-9]+[A-Z]\w*|[A-Z]{2,}[a-z]\w*|[A-Za-z]\w*_\w+)$')
NAMED_FAN = 6          # a name declared in more places than this is a word, not a subject


def named_declarations(g, text):
    """[(symbol id, why)] for every declaration the question spells out exactly: a qualified name (`IRouter.RouteAsync`,
    `demo.order.OrderMapper`, `Foo::bar`) or an identifier-shaped word (`RouteAsync`, `loadByNumber`, `find_order`).
    Plain English words never qualify, however many names contain them: that is what the scored terms are for."""
    want = []
    for m in QUALIFIED.finditer(text or ''):
        want.append(re.sub(r'::|#', '.', m.group(1)).rstrip('.'))
    for raw in re.split(r'[^\w$]+', text or ''):
        if raw and IDENT_SHAPE.match(raw): want.append(raw)
    if not want: return []
    by_disp, by_name, by_qual = (collections.defaultdict(list) for _ in range(3))
    for sid, s in g.sym.items():
        if (s.get('file') or '').startswith('<') or is_synthetic(s.get('name')): continue
        if s.get('display'): by_disp[s['display']].append(sid)
        if s.get('name'): by_name[s['name']].append(sid)
        if s.get('qualified_name'): by_qual[s['qualified_name']].append(sid)
    out, seen = [], set()
    for w in dict.fromkeys(want):
        hits = by_disp.get(w) or by_qual.get(w) or []
        if not hits and '.' in w:
            # `order.OrderMapper.findByNumber`: the longest dotted suffix that is somebody's display name
            parts = w.split('.')
            for k in range(1, len(parts) - 1):
                hits = by_disp.get('.'.join(parts[k:])) or []
                if hits: break
        if not hits and '.' not in w: hits = by_name.get(w, [])
        if not hits or len(hits) > NAMED_FAN: continue
        hits = sorted(hits, key=lambda i: (bool(g.sym[i].get('is_test')), g.sym[i].get('file') or '', g.sym[i].get('line') or 0))
        for sid in hits:
            if sid not in seen: seen.add(sid); out.append((sid, f"named in the task ({w})"))
    return out


ROUTE = re.compile(r'(?<![\w.])(/?[A-Za-z0-9_{}:*-]+(?:/[A-Za-z0-9_{}:*.-]+)+/?|/[A-Za-z0-9_{}:-]{2,}/?)(?![\w/])')
FILE_EXT = re.compile(r'\.[A-Za-z0-9]{1,6}$')


def _route_parts(r):
    r = (r or '').strip().strip('"\'`').lower()
    r = re.sub(r'^[a-z]+://[^/]+', '', r).split('?')[0]
    # a parameter in any spelling a route table uses: `{id}`, `:id`, `*`, and `<int:pk>` (a Python route converter)
    return [('*' if (p.startswith('{') or p.startswith(':') or p.startswith('<') or p == '*') else p) for p in r.strip('/').split('/') if p]


def _route_eq(a, b):
    return len(a) == len(b) and all(x == y or '*' in (x, y) for x, y in zip(a, b))


def route_seeds(g, text):
    """[(symbol id, why)] for a route the question quotes (`GET /api/widgets`, `/orders/{id}`), at the declaration the
    graph records as serving it: a remote-edge row, a route attribute or annotation, or the innermost callable around
    the literal that registers it (`app.MapGet("api/widgets", ...)`). Seeding by identifier alone dropped the route's
    words when no declaration happened to be named after them, and the handler was never reached (#1494)."""
    asked = []
    for m in ROUTE.finditer(text or ''):
        tok = m.group(1)
        if FILE_EXT.search(tok.rstrip('/')) and not tok.startswith('/'): continue      # a file path, not a route
        parts = _route_parts(tok)
        if parts and parts not in asked: asked.append(parts)
    if not asked: return []
    hits = []                                   # (symbol id, route as written)
    def serve(mid, route):
        if mid in g.sym: hits.append((mid, route))
    # the path a url_dispatch edge says its view is served at: the engine composed it through every include() that
    # mounts the table, so it is the one source that names the handler of `/api/v1/status/` when no line spells it
    tables = set()                              # route files whose every literal path the engine already composed
    if g.has('ext_framework_edge') and g.has('symbols'):
        for r in g.q("""SELECT s.id AS sid, e.c3 AS path, t.file AS tf FROM ext_framework_edge e
                        JOIN symbols s ON s.method_id = e.c1 JOIN symbols t ON t.method_id = e.c0
                        WHERE e.c2 = 'url_dispatch' AND e.c3 LIKE '/%'"""):
            tables.add(r['tf'])
            if any(_route_eq(_route_parts(r['path']), a) for a in asked): serve(r['sid'], r['path'])
    # a route the engine answered is not searched again as text: the literal scan below is the fallback for a route
    # no edge carries, and on an answered one it only adds the table's module and every literal that spells a suffix
    asked = [a for a in asked if not any(_route_eq(_route_parts(r), a) for _s, r in hits)]
    for tbl in ('ext_remote_unserved', 'ext_remote_unsent') if asked else ():
        if g.has(tbl):
            for r in g.q(f"SELECT c0, c2 FROM {tbl}"):
                if any(_route_eq(_route_parts(r['c2']), a) for a in asked): serve(r['c0'], r['c2'])
    # literals: a route string in a decoration (@GetMapping("/x")) or in the call that registers it (MapGet("x", ...)).
    # A class-level prefix (@RequestMapping("/api") over @GetMapping("/widgets")) is met by accepting a suffix match
    # when the rest of the asked route is itself a literal in the same file.
    lits = []
    if asked and g.has('decorations'):
        for r in g.q("SELECT owner_id, text, file, line FROM decorations WHERE text LIKE '%/%' OR text LIKE '%\"%'"):
            for v in re.findall(r'"([^"]*)"', r['text'] or ''): lits.append((v, r['file'], r['line'], r['owner_id']))
    if asked and g.has('literals'):
        for r in g.q("SELECT value, file, line FROM literals WHERE value LIKE '%/%' OR length(value) < 40"):
            lits.append(((r['value'] or '').strip('"'), r['file'], r['line'], None))
    by_file = collections.defaultdict(set)
    for v, f, _l, _o in lits: by_file[f].add(tuple(_route_parts(v)))
    spans = collections.defaultdict(list)
    for sid, s in g.sym.items():
        if s.get('method_id') and s.get('line') and not (s.get('file') or '').startswith('<'):
            spans[s['file']].append((s['line'], s.get('end_line') or s['line'], sid))
    for v, f, l, owner in lits:
        # a pattern in a route table the engine read is one segment of a longer served path, not the path itself:
        # `path("status/", ...)` under `include()` at `api/v1/` is not served at `/status/`
        if f in tables: continue
        vp = _route_parts(v)
        if not vp or ('/' not in v and not owner): continue       # a bare word in a string is not a route
        ok = any(_route_eq(vp, a) for a in asked) or any(
            len(a) > len(vp) and _route_eq(vp, a[len(a) - len(vp):]) and tuple(a[:len(a) - len(vp)]) in by_file[f] for a in asked)
        if not ok: continue
        if owner and owner in g.sym: serve(owner, v); continue
        inner = sorted((e - b, sid) for b, e, sid in spans.get(f, ()) if b <= (l or 0) <= e)
        # A TEST REQUESTS A ROUTE, IT DOES NOT SERVE ONE. `self.client.get("/api/v1/status/")` puts the literal inside
        # a test method, and labelling that method "serves the route" sent a reader to the caller instead of the view.
        if inner and not g.sym[inner[0][1]].get('is_test') and not TESTY.search(f or ''): serve(inner[0][1], v)
    out, seen = [], set()
    for sid, route in hits:
        if sid not in seen: seen.add(sid); out.append((sid, f"serves the route {route.strip()}"))
    return out[:NAMED_FAN]


# ── what the question names that no graph here can see (#1571, #1603) ─────────────────────────────────────────────
# A question about `run-rules.sh`, a Soufflé `.dl` file or the Python hooks of a TypeScript repository was answered
# from whatever the rest of its words matched, and nothing said the file it was about is outside every graph. The
# reader then trusted an answer about the wrong code. Saying so first costs one line and sends it straight to the file.
LANG_EXT = {'python': ('.py', '.pyi'), 'java': ('.java',), 'csharp': ('.cs',), 'typescript': ('.ts', '.tsx', '.mts', '.cts'),
            'javascript': ('.js', '.jsx', '.mjs', '.cjs'), 'kotlin': ('.kt', '.kts'), 'golang': ('.go',), 'rust': ('.rs',),
            'ruby': ('.rb',), 'scala': ('.scala',), 'php': ('.php',), 'shell': ('.sh', '.bash'), 'datalog': ('.dl',),
            'swift': ('.swift',), 'cpp': ('.cpp', '.cc', '.hpp', '.h'), 'sql': ('.sql',)}
LANG_WORD = {'python': 'python', 'java': 'java', 'csharp': 'csharp', 'typescript': 'typescript', 'javascript': 'javascript',
             'kotlin': 'kotlin', 'golang': 'golang', 'rust': 'rust', 'ruby': 'ruby', 'scala': 'scala', 'php': 'php',
             'bash': 'shell', 'shell': 'shell', 'datalog': 'datalog', 'souffle': 'datalog', 'swift': 'swift'}
ENGINE_LANGS = {'python', 'java', 'csharp', 'typescript', 'javascript'}
COVERS = {'typescript': {'typescript', 'javascript'}}           # the TypeScript front end reads JavaScript too
EXT_LANG = {e: l for l, es in LANG_EXT.items() for e in es}
FILE_TOKEN = re.compile(r'(?<![\w/.$-])((?:[\w.-]+/)*[\w$-][\w.$-]*\.([a-z][a-z0-9]{0,5}))(?![\w/(])')
DIR_TOKEN = re.compile(r'(?<![\w/.-])((?:[\w.-]+/)+[\w.-]+)/?(?![\w(])')
TEXT_EXT = {'xml', 'properties', 'yml', 'yaml', 'json', 'sql', 'toml', 'ini', 'cfg', 'conf', 'env', 'html', 'htm', 'ftl', 'vm',
            'mustache', 'hbs', 'jinja', 'j2', 'tmpl', 'gradle', 'sh', 'bash', 'dl', 'proto', 'graphql', 'gql', 'md', 'txt'}
WALK_CAP = 60000


def _walk(repo):
    """every file under the repository, relative, pruned the way the refresher prunes -- read once per call"""
    import ax_fresh
    out = []
    for root, dirs, files in os.walk(repo):
        dirs[:] = [d for d in dirs if d not in ax_fresh.PRUNE_ALL and not d.startswith('.')]
        rel = os.path.relpath(root, repo).replace(os.sep, '/')
        for fn in files:
            out.append(fn if rel == '.' else rel + '/' + fn)
        if len(out) > WALK_CAP: break
    return out


def graph_langs(g):
    """{language: graph dir or ''} for every graph of this repository, and the language THIS process reads"""
    import ax_langs
    main = ax_langs.main_language(g.repo)
    langs = {(l or main): d for l, d in ax_langs.graphs(g.repo)}
    return langs, (os.environ.get('AXIOMCODE_GRAPH_LANG') or main)


def indexed_files(g, langs):
    """every file some graph of this repository holds"""
    import sqlite3
    held = {(sy.get('file') or '') for sy in g.all_sym.values()}
    for l, d in langs.items():
        if not d: continue
        try:
            con = sqlite3.connect(f"file:{os.path.join(d, 'out', 'graph.sqlite')}?mode=ro", uri=True)
            held |= {r[0] for r in con.execute("SELECT DISTINCT file FROM symbols")}
            con.close()
        except Exception: pass
    return {f for f in held if f and not f.startswith('<')}


def named_languages(text):
    """the languages a question names: a word (`python`, `C#`) or an extension (`.py files`, `*.cs`)"""
    out = []
    low = (text or '').lower()
    for w in re.findall(r'[a-z#+]+', low):
        l = LANG_WORD.get('csharp' if w in ('c#', 'csharp') else w)
        if l and l not in out: out.append(l)
    for e in re.findall(r'(?<![\w/-])\*?(\.[a-z]{1,5})\s+(?:files?|scripts?|modules?|sources?)\b', low):
        l = EXT_LANG.get(e)
        if l and l not in out: out.append(l)
    return out


def unseen(g, text, scopes=()):
    """-> (lines to print first, {language named that has a graph}, [text-only directories among scopes])"""
    langs, mine = graph_langs(g)
    covered = {x for l in langs for x in COVERS.get(l, {l})}
    asked_langs = named_languages(text)
    with_graph = {l for l in asked_langs if l in covered}
    files_tok = [(m.group(1), m.group(2)) for m in FILE_TOKEN.finditer(text or '')]
    files_tok = [(t, e) for t, e in files_tok if ('/' in t or '-' in t or '_' in t or '.' + e in EXT_LANG or e in TEXT_EXT)
                 and not re.fullmatch(r'[\d.]+', t)]
    dirs_tok = [m.group(1) for m in DIR_TOKEN.finditer(text or '') if not FILE_EXT.search(m.group(1))]
    need_walk = files_tok or dirs_tok or scopes or [l for l in asked_langs if l not in covered]
    lines, text_dirs = [], []
    if not need_walk: return lines, with_graph, text_dirs, langs, mine
    tree = _walk(g.repo)
    held = indexed_files(g, langs)
    def why(path):
        l = EXT_LANG.get(os.path.splitext(path)[1].lower())
        if l and l in covered: return f"not in the {l} graph"
        if l: return f"{l} has no graph here"
        return "not source any graph here reads"
    seen = set()
    for tok, _e in files_tok:
        t = tok.lstrip('./')
        found = [f for f in tree if f == t or f.endswith('/' + t)]
        if not found or any(f in held for f in found): continue
        for f in found[:3]:
            if f in seen: continue
            seen.add(f); lines.append(f"not indexed: {f} ({why(f)}) -- this answer cannot see it; grep it directly")
        if len(found) > 3: lines.append(f"    … and {len(found) - 3} more file(s) named {t}")
    for d in list(dict.fromkeys(list(dirs_tok) + list(scopes))):
        d = d.strip('/').lstrip('./')
        if not d or d in seen or not os.path.isdir(os.path.join(g.repo, d)): continue
        under = [f for f in tree if f.startswith(d + '/')]
        if not under or any(f in held for f in under): continue
        seen.add(d); text_dirs.append(d)
        kinds = collections.Counter(os.path.splitext(f)[1].lower() or '(none)' for f in under).most_common(3)
        lines.append(f"not indexed: {d}/ ({len(under)} file(s): {', '.join(k for k, _n in kinds)}; not source any graph here reads)"
                     f" -- this answer cannot see it; grep it directly")
    for l in asked_langs:
        if l in covered: continue
        fs = [f for f in tree if os.path.splitext(f)[1].lower() in LANG_EXT.get(l, ())]
        if not fs: continue
        hint = f"; `axiomcode index --lang {l}` builds one" if l in ENGINE_LANGS else ""
        lines.append(f"not indexed: {len(fs)} {'/'.join(LANG_EXT[l])} file(s) (e.g. {', '.join(sorted(fs, key=lambda f: (f.count('/'), f))[:3])}; "
                     f"{l} has no graph here{hint}) -- this answer cannot see them; grep them directly")
    return lines, with_graph, text_dirs, langs, mine


# ── the text files bound to what the answer found (#1382) ─────────────────────────────────────────────────────────
# `impact` has long listed a mapper XML, a properties file or a template that names a method; `context` never looked,
# so "which SQL runs when an order is loaded" answered with the Java interface and not the file holding the SQL.
NONSOURCE_ASK = re.compile(r'\b(sql|quer(y|ies)|statements?|mapper|mappings?|xml|ya?ml|propert(y|ies)|config(uration|ured)?|'
                           r'settings?|templates?|views?|html|json|migrations?|schema|scripts?|toml|ini|env|bindings?)\b', re.I)
BINDINGS_SHOWN = 6
REMOTE_SHOWN = 8           # cross-process hops listed beside "where the work is" (#1293)
_NS = {}


def nonsource(g):
    """the non-source scan impact uses, cached per graph (ax_nonsource.py), with impact's own rules for what is source"""
    if 'ns' not in _NS:
        import ax_nonsource
        spec = importlib.util.spec_from_loader('aximpact', importlib.machinery.SourceFileLoader('aximpact', os.path.join(HERE, 'axiomcode-impact')))
        I = importlib.util.module_from_spec(spec); spec.loader.exec_module(I)
        held = {sy['file'] for sy in g.sym.values() if sy.get('file')}
        _NS['ns'] = ax_nonsource.NonSource(g.repo, g.facts, held, I.Impact.SKIP_DIR, I.Impact.SOURCE_EXT | I.Impact.PROSE_EXT)
    return _NS['ns']


def text_term_hits(g, dirs, terms, cap=200):
    """[(file, first line, [terms])] -- files under `dirs` whose text uses the task's words, most words first"""
    pats = {t: re.compile(r'(?i)(?<![a-z0-9])' + re.escape(t)) for t in terms if len(t) >= 3}
    out = []
    for d in dirs:
        for root, _ds, fs in os.walk(os.path.join(g.repo, d)):
            for fn in fs:
                rel = os.path.relpath(os.path.join(root, fn), g.repo).replace(os.sep, '/')
                ln = source_lines(g.repo, rel)
                got, first = [], 0
                for t, pt in pats.items():
                    k = next((i for i, x in enumerate(ln, 1) if pt.search(x)), 0)
                    if k: got.append(t); first = min(first or k, k)
                if got: out.append((rel, first, got))
                if len(out) >= cap: break
    return sorted(out, key=lambda r: (-len(r[2]), r[0]))


ASK_EXT = [(re.compile(r'\b(sql|quer(y|ies)|statements?|mapper|mappings?|migrations?|schema)\b', re.I), ('.xml', '.sql')),
           (re.compile(r'\b(config(uration|ured)?|propert(y|ies)|settings?|ya?ml|toml|ini|env)\b', re.I),
            ('.properties', '.yml', '.yaml', '.toml', '.ini', '.conf', '.cfg', '.env')),
           (re.compile(r'\b(templates?|views?|html)\b', re.I), ('.html', '.htm', '.ftl', '.vm', '.mustache', '.hbs', '.jinja', '.j2', '.tmpl')),
           (re.compile(r'\bxml\b', re.I), ('.xml',)), (re.compile(r'\bjson\b', re.I), ('.json',))]


def asked_exts(text):
    """the file kinds a question asks about: SQL lives in mapper XML or .sql, configuration in properties or YAML"""
    return tuple(e for rx, es in ASK_EXT if rx.search(text or '') for e in es)


def text_bindings(g, sids, under=(), want_ext=()):
    """[(file, line, declaration, name written there)] -- a non-source file that writes the name of one of `sids`
    as a whole word. A mapper XML with a namespace binds only the type that namespace names (a statement id repeated
    in another mapper's XML is not this method's SQL)."""
    want = collections.defaultdict(set)          # name -> {sid}
    decl_count = collections.Counter(sy.get('name') for sy in g.sym.values() if not (sy.get('file') or '').startswith('<'))
    for sid in sids:
        sy = g.sym.get(sid) or {}
        nm = sy.get('name') or ''
        if len(nm) < 4 or nm.startswith('<') or nm in CONTAINER: continue
        want[nm].add(sid)
    # a name declared in many places (`selectByPrimaryKey` on every generated mapper) is kept only where a mapper's
    # namespace proves which declaration it binds; anywhere else it says nothing about THIS one
    common = {nm for nm in want if decl_count[nm] > GAP_DECLS}
    if not want: return []
    try: hits = nonsource(g).hits(list(want))
    except Exception: return []
    ns_of = {}
    out, seen = [], set()
    prose = getattr(nonsource(g), 'prose', set())     # a common word written as a word is not a binding (ax_nonsource.py)
    for nm, f, line in hits:
        if (nm, f, line) in prose: continue
        if under and not any(f.startswith(d.rstrip('/') + '/') for d in under): continue
        if f.endswith('.xml'):
            if f not in ns_of:
                ln = source_lines(g.repo, f)
                m = re.search(r'\bnamespace\s*=\s*"([^"]+)"', '\n'.join(ln[:40]))
                ns_of[f] = m.group(1) if m else None
            ns = ns_of[f]
            owner = lambda x: ((g.sym.get(x) or {}).get('display') or '').rsplit('.', 1)[0].split('.')[-1]
            cands = [x for x in sorted(want[nm]) if not ns or ns == owner(x) or ns.endswith('.' + owner(x))]
            if not cands: continue
            if nm in common and not ns: continue
        elif nm in common: continue
        else: cands = sorted(want[nm])
        key = (f, nm)
        if key in seen: continue
        seen.add(key)
        sid = cands[0]
        # first the files that PROVE the binding (a mapper whose namespace is the declaring type), then the kind of file
        # the question asks about, then the rest; a JSON fixture that happens to spell the name is last, not first
        rank = (0 if f.endswith('.xml') and ns_of.get(f) else 1, 0 if f.endswith(tuple(want_ext) or ('\0',)) else 1, f, line)
        out.append((rank, (f, line, g.disp(sid), nm)))
    return [r for _k, r in sorted(out)]


def asked_bound(g, scored, text, under=(), cap=300):
    """{symbol id} among the multi-term matches that a text file of the kind the question asks about binds by name.
    Empty unless the question asks about such a file (SQL, configuration, a template): only then is the tree walked,
    and only then does it break a tie between equally scored entry points (pick_seeds)."""
    kinds = asked_exts(text)
    if not kinds or not NONSOURCE_ASK.search(text or ''): return frozenset()
    cands = sorted((sid for sid, (_sc, m) in scored.items() if len(m) >= 2), key=lambda s: -scored[s][0])[:cap]
    by_disp = collections.defaultdict(set)
    for sid in cands: by_disp[g.disp(sid)].add(sid)
    return frozenset(sid for f, _l, d, _n in text_bindings(g, cands, under=under, want_ext=kinds)
                     if f.endswith(kinds) for sid in by_disp.get(d, ()))


_SRC = {}
def source_lines(repo, f):
    """The file's lines, read once. The graph stores repo-relative paths; a run may be started anywhere."""
    if f not in _SRC:
        path = f if os.path.isabs(f) else os.path.join(repo, f)
        try: _SRC[f] = open(path, errors='ignore').read().splitlines()
        except Exception: _SRC[f] = []
    return _SRC[f]


def neighbourhood(g, seed_ids, cap=3):
    """{symbol id: nearest hop} out to `cap` hops, both directions. Callers matter as much as callees for
    "where is this handled" — the thing you are looking for is often what CALLS the name you recognised."""
    adj = collections.defaultdict(set)
    for a, b, _t in g.edges():
        adj[a].add(b); adj[b].add(a)
    depth = {s: 0 for s in seed_ids}
    frontier = list(seed_ids)
    for d in range(1, cap + 1):
        nxt = []
        for x in frontier:
            for y in adj.get(x, ()):
                if y not in depth: depth[y] = d; nxt.append(y)
        frontier = nxt
        if not frontier: break
    return depth


# ── EXPLAIN: "how does X work" wants the flow, not a ranked list of places ────────────────────────────────────────
# Asked how a mechanism works, an agent handed the ranked files and "read this one first" read that one and stopped:
# measured on two architecture questions, the run with the graph named 9 and 11.5 of the key steps where the run
# without it named 13.5 and 15.5, at a higher cost, because every hop the graph did not print it did not follow.
# Change impact wants the most certain breakage first; an explanation wants the SPINE, in the order it runs, with
# the places the graph could not follow marked so the reader reads through them instead of stopping at them.
EXPLAIN = re.compile(r"^\s*(how\b|explain\b|walk (me )?through\b|what happens\b|describe how\b|trace\b)|\bhow (does|do|is|are)\b.*\b(work|happen|run|flow|handled?)\b", re.I)
FLOW_DEPTH, FLOW_STEPS, FLOW_ROOTS = 4, 32, 2


def explain_intent(task):
    return bool(EXPLAIN.search(task_text(task).strip().split('\n')[0]))


# A library call is marked as where the flow LEAVES the graph only when its name says it hands work on: sending,
# publishing, dispatching, persisting, executing, calling out. `length()` or `toString()` in a leaf is not an exit, and
# marking every library call would bury the few that are.
EXIT_WORDS = frozenset('send publish emit dispatch post put patch execute invoke persist save merge enqueue submit produce '
                       'exchange schedule notify fire raise request broadcast forward redirect call apply handle process'.split())


def DISPATCH(name):
    toks = subtokens(name)
    return bool(toks) and (toks[0] in EXIT_WORDS or any(t in ('send', 'publish', 'emit', 'dispatch', 'persist', 'enqueue')
                                                        for t in toks) or (toks[-1] == 'async' and len(toks) > 1))


PY_DOC = re.compile(r'^[rbuRBU]?("""|\'\'\')')


def bodiless(g, x):
    """True when the declaration has no code to follow: an interface or abstract member, a signature. Read from the
    source span, the same for every language: no `{` and no `=>` after the signature, or a Python body that is only
    `...`, `pass` or `raise NotImplementedError` (after a docstring)."""
    sy = g.sym.get(x) or {}
    f, a = sy.get('file') or '', sy.get('line')
    nm = sy.get('name') or ''
    if not f or f.startswith('<') or not a or not sy.get('method_id') or not nm or nm.startswith('<'): return False
    b = sy.get('end_line') or a
    body = source_lines(g.repo, f)[a - 1:b]
    if not body: return False
    # the span can start on the line that opens the enclosing type (`interface ISender { Task Send(object r); }`), so
    # only what follows the member's own name counts
    k = body[0].find(nm + '(') if nm + '(' in body[0] else body[0].find(nm)
    if k > 0: body = [body[0][k:]] + body[1:]
    if f.endswith(('.py', '.pyi')):
        rest = [l.strip() for l in body[1:] if l.strip() and not l.strip().startswith('#')]
        if rest and PY_DOC.match(rest[0]):
            q = PY_DOC.match(rest[0]).group(1)
            if rest[0].count(q) >= 2: rest = rest[1:]
            else:
                k = next((i for i, l in enumerate(rest[1:], 1) if q in l), len(rest) - 1)
                rest = rest[k + 1:]
        return bool(rest) and all(l in ('...', 'pass') or l.startswith('raise NotImplementedError') for l in rest)
    text = re.sub(r'//[^\n]*|/\*.*?\*/', '', '\n'.join(body), flags=re.S)
    return '{' not in text and '=>' not in text and text.rstrip().rstrip('}').rstrip().endswith(';')


FLOW_FAN = 3               # a `one of a set` site with more candidates than this is not a step of anything
GAP_DECLS = 8              # an unresolved name declared in more places than this says nothing about which
CONTAINER = frozenset('items keys values get pop popitem append extend add update remove discard insert clear copy '
                      'setdefault sort reverse index count split rsplit join strip lstrip rstrip lower upper replace format '
                      'startswith endswith encode decode read write close open push shift unshift slice splice map filter '
                      'reduce forEach concat includes indexOf has set delete then catch finally toString valueOf '
                      'length size isEmpty contains equals hashCode'.split())


def flow(g, roots, depth_cap=FLOW_DEPTH, max_steps=FLOW_STEPS):
    """The call flow from `roots`, in the order the calls are written. Nothing here is ranked or scored.

    Where a flow STARTS is the reader's decision (--from) or the entry points this verb already chose; which of a
    step's callees matter is the reader's too — every callee is listed in call order, and the answer is bounded by
    depth and step count, not by a guess at relevance. Three rules, each about the shape of code rather than any one
    codebase:
      * a `one of a set` site with more than FLOW_FAN candidates is left out: `pair[0]` is matched to every
        `__getitem__` in a codebase, and that is not a step;
      * a call the graph could not resolve is shown on its step (⚠) when its name is declared in the project, so the
        reader continues through it instead of stopping there — except a container method (`items`, `pop`), and a
        name declared in more than GAP_DECLS places;
      * library calls and tests are not steps.
    """
    out = collections.defaultdict(list)            # caller -> [(line, callee, tier, site_file)]
    gaps = collections.defaultdict(list)           # caller -> [(line, name)]
    fan = collections.Counter()
    rows = g.q("""SELECT e.call_site_id sid, e.caller_id c, e.callee_method_id m, e.tier t, coalesce(e.callee_label, s.callee_name) n,
                         s.start_line l, s.file_path f
                  FROM call_edges e LEFT JOIN call_sites s ON s.id = e.call_site_id""")
    for r in rows:
        if r['m']: fan[r['sid']] += 1
    exits = collections.defaultdict(list)          # caller -> [(line, library call name)] that hand the flow to a library
    for r in rows:
        lib = (r['t'] or '').startswith('boundary_lib') or (r['m'] in g.sym and (g.sym[r['m']].get('file') or '') == '<library>')
        if lib:
            nm = (r['n'] or '').split(':')[-1].rsplit('.', 1)[-1] or (g.sym.get(r['m']) or {}).get('name') or ''
            if nm and DISPATCH(nm): exits[r['c']].append((r['l'] or 0, nm, 'library call, target not followed'))
            continue
        if r['m'] and r['m'] in g.sym and r['m'] != r['c']:
            sy = g.sym[r['m']]
            if (sy.get('file') or '').startswith('<') or sy.get('is_test'): continue
            if ax_edges.direct_cert(r['t']) != 'resolved' and fan[r['sid']] > FLOW_FAN: continue
            out[r['c']].append((r['l'] or 0, r['m'], r['t'], r['f']))
        elif not r['m'] and r['t'] == 'ambiguous_unknown' and r['n']:
            gaps[r['c']].append((r['l'] or 0, r['n']))
    # a step that ends on a signature with no body — an interface member implemented by assignment, a function-typed
    # field — runs what the signature HOLDS (#1283). Those are `value` dispatch candidates, which call_edges does not
    # carry, so the flow stopped at the signature while `path` went on through it. The same FLOW_FAN bound applies.
    held = collections.defaultdict(list)
    if g.q("SELECT 1 FROM sqlite_master WHERE name='dispatch_candidates'"):
        for r in g.q("""SELECT DISTINCT base_method_id b, candidate_method_id m FROM dispatch_candidates
                        WHERE basis='value' AND base_method_id<>candidate_method_id"""):
            sy = g.sym.get(r['m'])
            if sy and not (sy.get('file') or '').startswith('<') and not sy.get('is_test'): held[r['b']].append(r['m'])
    for b, ms in held.items():
        if len(ms) <= FLOW_FAN: out[b] += [(0, m, 'value', None) for m in ms]
    for x in out: out[x].sort(key=lambda r: r[0])
    declared = collections.Counter((sy.get('name') or '') for sy in g.sym.values()
                                   if sy.get('method_id') and not (sy.get('file') or '').startswith('<') and not sy.get('is_test'))
    for x in list(gaps):
        # a call the graph could not resolve to a name declared NOWHERE here is a library the index does not hold (a
        # mediator's Send with no package reference): the flow leaves the graph there too
        exits[x] += [(l, n_, 'unresolved, declared nowhere in this graph') for l, n_ in gaps[x] if not declared[n_] and DISPATCH(n_)]
        gaps[x] = sorted({(l, n_) for l, n_ in gaps[x] if 0 < declared[n_] <= GAP_DECLS and n_ not in CONTAINER})

    # WHICH steps are shown is chosen breadth-first: the entry point's own calls are the outline of the mechanism and
    # their callees are detail, so the budget goes to every call of the root before any call of a call. Chosen
    # depth-first, one helper's subtree took the whole budget before the flow reached the root's later calls.
    keep, frontier = set(roots), list(roots)
    for _d in range(depth_cap):
        nxt = []
        for x in frontier:
            for _l, y, _t, _f in out.get(x, ()):
                if y not in keep and len(keep) < max_steps:
                    keep.add(y); nxt.append(y)
        frontier = nxt
        if not frontier or len(keep) >= max_steps: break

    steps, seen = [], {}
    def walk(x, depth, via):
        if len(steps) >= max_steps * 2: return
        if x in seen:
            steps.append((depth, x, via, seen[x])); return
        seen[x] = sum(1 for st in steps if st[3] is None) + 1       # the printed step number
        steps.append((depth, x, via, None))
        if depth >= depth_cap: return
        done = set()
        for l, y, t, f in out.get(x, ()):
            if y in done or y not in keep: continue
            done.add(y)
            walk(y, depth + 1, (l, t, f))
    for r in roots:
        walk(r, 0, None)
    # where the flow LEAVES the graph: a library call that hands the work on (publishEvent, Send, persist, a client
    # stub's *Async), and a step with no body to continue from (an interface or abstract method, a mapper whose SQL is
    # in XML). Unmarked, the flow just ended there, and the reader took the end of the printout for the end of the
    # mechanism; in 75% of recorded sessions the next move was a grep for what came after.
    marks = {}
    for x in {x for _d, x, _v, again in steps if again is None}:
        m = [f"leaves the graph: {nm}() L{l} ({why})" for l, nm, why in sorted(set(exits.get(x, ())))[:2]]
        if not any(y in keep for _l, y, _t, _f in out.get(x, ())) and not gaps.get(x) and bodiless(g, x):
            bound = text_bindings(g, [x], want_ext=('.xml', '.sql'))[:1]      # the best-proven one: a mapper of this type
            m.append("no body in the graph (interface/abstract): the flow cannot continue from here"
                     + ("; bound as text in " + ', '.join(f"{f}:{l}" for f, l, _d, _n in bound) if bound else
                        f"; `impact {g.disp(x)}` lists what implements it"))
        if m: marks[x] = m
    return roots, steps, gaps, marks


# with --source: fewer steps, each with its code, sized to ONE page. The flow is a reading order; split across pages,
# its second half went unread in every measured run that was split (no agent asked for page 2).
FLOW_SOURCE_STEPS, FLOW_SOURCE_LINES, FLOW_SOURCE_CHARS = 16, 8, 3800   # code for the earliest steps until the budget, then names only


def print_flow(g, roots, steps, gaps, chosen, show_source=False, marks=None):
    if not steps: return False
    print("\nhow it runs — the call flow from " + ("where you started it" if chosen else "this task's entry points")
          + ", every callee in the order the calls are written, to depth " + str(FLOW_DEPTH)
          + " (→ resolved call, ⇢ one of a set; ⚠ a call the graph could not resolve — read that body to follow it):")
    if not chosen:
        print("  started at the entry points this task's words matched; if the mechanism begins elsewhere, "
              "`--from <name>` starts the flow there")
    n = 0
    code_left, code_cut = [FLOW_SOURCE_CHARS], [False]
    for depth, x, via, again in steps:
        pad = '  ' * depth
        if again:
            print(f"     {pad}↺ {g.disp(x)} (step {again})"); continue
        if via:
            l, t, f = via
            arrow = '→' if ax_edges.direct_cert(t) == 'resolved' else '⇢'
            src = ''
            if f and l:
                ln = source_lines(g.repo, g.site_file(f))
                src = ln[l - 1].strip()[:70] if 0 < l <= len(ln) else ''
            head, where = f"{pad}{arrow} {g.disp(x)}", (f"called at L{l}: {src}" if src else f"called at L{l}")
            if t == 'value':
                where = "held by the step above: assigned or passed where it is expected, so a call to it runs this"
        else:
            head, where = g.disp(x), "entry point"
        n += 1
        print(f"  {n:2} {head:60.60}  {g.loc(x)}")
        print(f"     {pad}   {where}")
        gs = gaps.get(x, ())[:4]
        if gs:
            print(f"     {pad}   ⚠ unresolved here: " + ', '.join(f"{nm}() L{l}" for l, nm in gs))
        for mk in (marks or {}).get(x, ()):
            print(f"     {pad}   ⚠ {mk}")
        sy = g.sym.get(x) or {}
        if show_source and code_left[0] <= 0 and not code_cut[0]:
            code_cut[0] = True
        if show_source and not code_cut[0] and sy.get('line') and not (sy.get('file') or '').startswith('<'):
            a, b = sy['line'], sy.get('end_line') or sy['line']
            body = source_lines(g.repo, sy['file'])[a - 1:min(b, a + FLOW_SOURCE_LINES - 1)]
            for k, ln in enumerate(body, a):
                row = f"     {pad}   {k:5} | {ln.rstrip()[:100]}"
                code_left[0] -= len(row) + 1
                print(row)
            if b > a + FLOW_SOURCE_LINES - 1:
                print(f"     {pad}   {'':5} | … +{b - a - FLOW_SOURCE_LINES + 1} more line(s) — open {sy['file']}:{a} for the rest")
    if code_cut[0]:
        print("    the later steps are named without their code, to keep this answer to one page; "
              "`--from <step>` shows any of them with its code")
    if sum(1 for st in steps if st[3] is None) >= (FLOW_SOURCE_STEPS if show_source else FLOW_STEPS):
        print(f"    … the flow is cut at {(FLOW_SOURCE_STEPS if show_source else FLOW_STEPS)} steps; `path <step> '*'` continues from any step")
    return True


RESULT = {'task': None, 'repo': None, 'scope': None, 'scope_offered': None, 'terms': [],
          'entry_points': [], 'files': [], 'flow': []}


def main(argv):
    # 12 files by default, not 40. The answer is read by an agent that pays for every line on every later
    # turn: on a 1,071-file answer the bare call printed 40 rows, 16k characters, most of them name-only
    # matches in unrelated modules, and the agent opened a file from the top five. The ranking is the same
    # at any budget -- only the tail is cut, and the footer says how many and how to ask for them.
    budget, seeds_wanted, scopes, args = 12, 6, [], []
    scope_offered = False
    show_source = False
    as_json = False
    explain = None             # None: decided from the task's wording; --explain / --no-explain force it
    starts = []                # --from <name>: where the flow starts, when the caller knows (repeatable)
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--budget' and i + 1 < len(argv): budget = int(argv[i + 1]); i += 2
        elif a == '--seeds' and i + 1 < len(argv): seeds_wanted = int(argv[i + 1]); i += 2
        # --in is REPEATABLE and takes a comma-separated list: a change that spans two roots has to be
        # askable in one call (#1029). They are combined, never intersected.
        elif a == '--in' and i + 1 < len(argv): scopes += [x.strip().replace('\\', '/') for x in argv[i + 1].split(',') if x.strip()]; i += 2   # the index stores '/'; a Windows user may type a backslash
        elif a == '--in-offered': scope_offered = True; i += 1
        elif a == '--source': show_source = True; i += 1
        elif a == '--json': as_json = True; i += 1
        elif a == '--explain': explain = True; i += 1
        elif a == '--from' and i + 1 < len(argv): starts.append(argv[i + 1]); explain = True if explain is None else explain; i += 2
        elif a == '--no-explain': explain = False; i += 1
        elif a in ('-h', '--help'): print(__doc__); return 0
        else: args.append(a); i += 1
    if not args: print(__doc__); return 2
    task = args[0]
    repo = args[1] if len(args) > 1 else '.'
    g = G(repo)
    RESULT['task'], RESULT['repo'] = task, g.repo

    body = task_text(task)
    terms = task_terms(body)
    if not terms: die("nothing to search for in that task description")
    # what the question names that no graph here holds is said FIRST (#1571), and a scope that exists on disk but holds
    # no indexed file is a text scope, not a typo (#1382). Only a scope the index does not know is checked on disk.
    def holds(x):
        cond, params = scope_sql(scope_spec(x, g.repo))
        return g.q(f"SELECT 1 FROM symbols WHERE {cond} LIMIT 1", *params)
    unknown_scopes = [x for x in scopes if not holds(x)]
    notice, named_langs, text_dirs, langs, mine = unseen(g, body, unknown_scopes)
    main_lang = next(iter(langs))
    fan = os.environ.get('AXIOMCODE_FANOUT') == '1' and len(langs) > 1
    if fan and named_langs and not (COVERS.get(mine, {mine}) & named_langs):
        # the question names a language, and this graph is another one: its matches could only be the generic words,
        # printed as a full section per graph (#1603). Status 3 is "nothing to say"; the dispatcher leaves it out.
        return 3
    if fan:
        owner = main_lang if not named_langs or (COVERS.get(main_lang, {main_lang}) & named_langs) else \
            sorted(l for l in langs if COVERS.get(l, {l}) & named_langs)[0]
        if owner != mine: notice = []                       # one graph says it, not every one
    RESULT['not_indexed'] = list(notice)
    for ln in notice: print(ln)
    if notice: print()
    if text_dirs:
        scopes = [x for x in scopes if x.strip('/').lstrip('./') not in text_dirs]
    # AN --in NO GRAPH HOLDS AND NO DIRECTORY IS was refused with a menu, once per language graph, and no answer: the
    # agent then searched by hand. A typo is not a question about nothing; the task is answered at the root (or under
    # the scopes that are real) and the line says what was dropped and what is close. A scope another language's graph
    # holds is left alone: this graph refuses it and that one answers; the line is printed once (ax_langs.py)
    if scopes and not scope_offered:
        gone = [x for x in scopes if x in unknown_scopes and not ax_text.held(g.repo, x)]
        if gone:
            scopes = [x for x in scopes if x not in gone]
            import difflib
            near = difflib.get_close_matches(gone[0], [d for d, _ in dirs_with_counts(g).items()], n=3, cutoff=0.4)
            print(f"{ax_text.SCOPE_GONE}{', '.join(repr(x) for x in gone)} in its path — answering "
                  + (f"under {', '.join(scopes)}" if scopes else "at the repository root") + " instead"
                  + (f" (close: {', '.join(near)})" if near else '') + "\n")
    # the terms the report itself marked as code take the budget first (see winnow)
    terms = winnow(g, terms, strong=code_terms(body))
    scored = score_symbols(g, terms)
    landed = landing(g, scored)
    # --from names where the flow starts, which is also WHERE to look: a graph that declares it (under the caller's
    # --in, when one is given) answers from there even when the task's words land nowhere in it, rather than refusing
    # for want of a scope or a matching word. In a repository in several languages every graph is asked (ax_langs), and
    # one that does not declare the name refuses, so the answer comes from the language that does.
    fixed = [x.strip().replace('\\', '/') for x in scopes] if not scope_offered else []
    from_ids = {sel: [x for x in g.resolve(sel)[1] if x in g.sym] for sel in starts}
    held = {sel: [x for x in ids if not fixed or any(under_scope(g.sym[x].get('file'), scope_spec(sc, g.repo)) for sc in fixed)]
            for sel, ids in from_ids.items()}
    if starts and os.environ.get('AXIOMCODE_FANOUT') and not any(held.values()):
        print(f"nothing named {', '.join(repr(s) for s in starts)} in this graph"
              + (f" under {', '.join(fixed)}" if fixed and any(from_ids.values()) else '') + ".")
        return 2
    have_from = any(held.values())
    # --in: a scope the CALLER supplies is knowledge — a stack frame, the file it just read, the package
    # named in the issue's labels. That is worth more than any amount of inferring the package from prose,
    # so it restricts the seeds outright: everything outside it is dropped BEFORE seeding, and the entry
    # points come from the right package instead of its same-named twin.
    #
    # A scope THIS PROGRAM offered is not knowledge, it is a guess, and it arrives by the same `--in`. Its
    # first entry holds a golden file 60% of the time, and only 58% of real changes fit under any one
    # directory at all, so filtering on a guess discards the answer outright in the cases it gets wrong,
    # and caps recall even when it is right. `--in-offered` marks that provenance, and a scope so marked
    # does not filter. It does not weight either: boosting seeds inside it and penalising files outside
    # it was swept over 57 real commits and was worth at most 0.012 recall@10 against not doing it, which
    # is noise at that sample size. The menu is worth printing for the reader; it is not worth ranking on.
    rank = rank_dirs(g, scope_terms(g, task)) if not scopes else None; flat = False
    if not scopes:
        # One candidate is not a choice: take it and SAY SO, rather than refusing and being handed back
        # the only path there was. This is NOT the offered-scope case above, so it is not marked
        # `--in-offered` and it does filter -- a filter that removes nothing, since a sole row means
        # every indexed file already lives under it. Printed, because an answer silently narrowed to one
        # package reads as an answer about the whole repository.
        sole = sole_scope(g)
        if sole:
            scopes = [sole]
            print(f"scope: {sole} (the only package this graph indexes; --in overrides)\n")
        elif g.sym and not dirs_with_counts(g):
            # every indexed file sits at the root, so the root is the one scope there is, and it narrows nothing.
            # Refusing here offered an empty menu: a correction the reader could not act on (#1345)
            flat = True
            print("scope: the repository root (every indexed file sits there; --in overrides)\n")
        elif rank:
            # Several candidates, and a caller holding an issue and no symbol — which is the caller this
            # verb was written for, and by construction the one who cannot name the scope. Refusing here
            # returned NOTHING while holding the answer: on a conventional two-root Java layout the bare
            # call named 0 gold files on 30 of 30 tasks and the same call with a scope named 0.96 of them,
            # and the two offered roots agreed to within 0.006 recall — so the choice being demanded was
            # not what decided the answer. Take the top row instead and SAY it was taken.
            #
            # It is taken as OFFERED, not as knowledge: rule 2 says a scope this program guessed does not
            # filter, so this cannot discard the answer the way an explicit --in on a wrong package would.
            # What it buys is an answer at all, plus the line naming what was assumed and what else was on
            # the menu, which is the repair instruction the refusal used to be.
            picked = best_scope(rank)
            if picked:
                scope, n = picked
                scopes = [scope]
                scope_offered = True   # a guess by rule 2: it neither filters the answer nor weights it
                menu = ', '.join(r[0] for r in drop_ancestors(list(rank))[:4])
                print(f"where this task's words land: {scope} (of {n} scope(s) this graph offers: {menu}"
                      + ("…" if n > 4 else "") + ")")
                print("  no --in was given, so NOTHING below is narrowed to it — "
                      "pass --in <path> to narrow.\n")
    bad = None if flat or (have_from and not fixed) else require_scope(g, scopes, terms, rank=rank, flag=' --in-offered')
    if bad is not None: return bad

    # a symbol is kept when it is under ANY of the scopes -- the union, because the caller naming two roots
    # is naming a change that spans them, and intersecting those two paths answers nothing (#1029)
    specs = [scope_spec(sc, g.repo) for sc in scopes]
    in_scope = lambda f: any(under_scope(f, sp) for sp in specs)
    if scopes and not scope_offered:
        scored = {sid: v for sid, v in scored.items() if in_scope(g.sym.get(sid, {}).get('file'))}
    # what the question NAMES comes before what its words match: a declaration spelled out, a route quoted
    named = named_declarations(g, body) + route_seeds(g, body)
    if scopes and not scope_offered:
        named = [(sid, why) for sid, why in named if in_scope(g.sym.get(sid, {}).get('file'))]
    if not scored and not named and not have_from:
        # the scope is real (require_scope proved it) but holds nothing matching — offer what is under it,
        # ranked the same way the scope-less menu is: by where the words land, never by how big a directory is
        ranked = rank_dirs(g, scope_terms(g, task))
        inside = [r for r in ranked if any(sc in r[0] or r[0] in sc for sc in scopes)]
        where = ', '.join(f"'{sc}'" for sc in scopes)
        return offer(f"{where} exist(s), but none of these words appear under it: {', '.join(terms[:8])}.",
                     inside or ranked, terms)

    # an entry point is somewhere to START. <module> and <classbody> are the file and the class
    # themselves, and on Python every class has one, so they can be a third of this list while
    # naming nowhere to go.
    scored = {sid: v for sid, v in scored.items() if not is_synthetic(g.sym.get(sid, {}).get('name'))}
    seeds = pick_seeds(g, scored, terms, seeds_wanted, named, prefer=asked_bound(g, scored, body, text_dirs))

    RESULT['terms'] = list(terms)
    RESULT['scope'], RESULT['scope_offered'] = (scopes[0] if scopes else None), bool(scope_offered)
    RESULT['entry_points'] = [{'name': g.disp(sid), 'at': g.loc(sid),
                               'why': (term or 'best overall match')}
                              for sid, term, sc in seeds]
    print(f"task terms: {' · '.join(terms[:10])}" + (f" (+{len(terms)-10})" if len(terms) > 10 else ''))
    if explain is None: explain = explain_intent(task)
    # explaining: the flow below starts at its own roots and IS the answer, so the lexical entry points (a word
    # match per term) and the long file list are what a reader would spend the page on instead of the flow
    if explain: budget = min(budget, 0 if show_source else 5)   # with the code shown, the flow is the whole answer
    if not explain: print(f"\nentry points ({len(seeds)}; what the task names, then what matches most of its terms together, "
                          f"then each term left over — the graph's own words, not a guess):")
    for sid, term, sc in (seeds if not explain else ()):
        why = term or "best overall match"
        print(f"    {g.disp(sid):46.46}  {g.loc(sid):34.34}  {why}")

    if explain:
        roots_ = []
        for sel in starts:
            ids = from_ids[sel]
            picked = from_starts(g, ids, landed, scopes if not scope_offered else ())
            if ids and not picked:
                print(f"--from {sel}: none of its {len(ids)} declaration(s) lies under --in; the flow starts at all of them")
                picked = from_starts(g, ids, landed)
            if len(picked) < len(ids):
                print(f"--from {sel}: {len(ids)} declarations by that name; the flow starts at the {len(picked)} "
                      + ("under --in" if scopes and not scope_offered else "where the task's words land")
                      + f" ({', '.join(g.loc(x) for x in picked[:3])}{'…' if len(picked) > 3 else ''}); --in <path> picks another")
            roots_ += picked
        if starts and os.environ.get('AXIOMCODE_FANOUT'):
            # how many of the task's words land in the files the flow reaches: ax_langs puts the language where they
            # land first, since a common --from name (main, run, init) is declared in every language's graph
            print(f"axiomcode-from-landing: {max((len(w) for w in flow_words(g, roots_, landed).values()), default=0)}",
                  file=sys.stderr)
        if not roots_:
            # no --from: the entry points this verb already chose, the callable ones, first FLOW_ROOTS of them
            roots_ = [s_ for s_, _t, _sc in seeds if (g.sym.get(s_) or {}).get('method_id')][:FLOW_ROOTS]
        roots, steps, gaps, marks = flow(g, roots_, max_steps=FLOW_SOURCE_STEPS if show_source else FLOW_STEPS)
        RESULT['flow'] = [{'step': k + 1, 'depth': d, 'name': g.disp(x), 'at': g.loc(x),
                           'called_at_line': (via[0] if via else None), 'certainty': (ax_edges.direct_cert(via[1]) if via else 'entry'),
                           'repeat_of': again, 'unresolved': [f"{nm} L{l}" for l, nm in gaps.get(x, ())[:4]],
                           'leaves_graph': (marks.get(x, []) if again is None else [])}
                          for k, (d, x, via, again) in enumerate(steps)]
        print_flow(g, roots, steps, gaps, bool(starts), show_source, marks)

    depth = neighbourhood(g, [s for s, _t, _sc in seeds])
    # A file can match the task by NAME and be reachable by no call at all — an enum of flags, a constants
    # module, a config surface. Those have no callers by construction, so a list built only from the call
    # closure drops them however well they match: on one task the file was literally named for the word the
    # issue led with, and it never appeared. They enter here at a nominal hop below the closure's, and the
    # answer says how each file was found so a name match is never mistaken for a call path.
    named_only = {}
    for sid, (sc, matched) in scored.items():
        if sid in depth: continue
        f = (g.sym.get(sid) or {}).get('file') or ''
        if not f or f.startswith('<') or not matched: continue
        if len(matched) >= 2 or sc >= EXACT:          # a strong match, not an incidental substring
            named_only[sid] = len(matched)
    # rank a FILE by its nearest hop, then by how much of the task it matches, then by name for stability
    files = {}
    for sid, d in list(depth.items()) + [(k, 99) for k in named_only]:
        s = g.sym.get(sid)
        if not s or not s.get('file') or s['file'].startswith('<'): continue
        f = s['file']
        hit = len(scored.get(sid, (0, []))[1])
        cur = files.get(f)
        if cur is None or (d, -hit) < (cur[0], -cur[1]): files[f] = (d, max(hit, cur[1] if cur else 0), cur[2] + 1 if cur else 1)
        else: files[f] = (cur[0], max(cur[1], hit), cur[2] + 1)
    # rank = hop, discounted by how much of the task the file matches. Sorting on hop alone pinned a file
    # matching three task words to rank 78 because it sat one band further out.
    # A file's PATH is evidence in its own right, independent of the symbols inside it. The task names the
    # package ("Vapor"), four of the five files that must change live under runtime-vapor/, and the same
    # basenames exist under runtime-core/ — so without scoring the path at the FILE level the ranker keeps
    # choosing the wrong package's twin. Hop still orders, but a file in the named package outranks a
    # nearer one outside it.
    # A word in most of the repository's paths cannot tell one file from another: the project's own name
    # (`excalidraw` in excalidraw-app/ and packages/excalidraw/) matched nearly every path, so asked how Excalidraw
    # renders, the path bonus went to whichever file carried the name -- a debug overlay ranked first.
    all_files = [x for x in {(v or {}).get('file') or '' for v in g.sym.values()} if x and not x.startswith('<')]
    path_df = collections.Counter(t for x in all_files for t in set(subtokens(x)))
    tset = {t for t in terms if path_df.get(t, 0) <= COMMON_PATH * max(len(all_files), 1)}
    def file_rank(item):
        f, (d, hit, n) = item
        ptoks = set(subtokens(f))
        pkg = len(tset & ptoks)
        return (d - 0.8 * hit - 1.6 * pkg, d, f)
    if scopes and not scope_offered: files = {f: v for f, v in files.items() if in_scope(f)}
    order = sorted(files.items(), key=file_rank)
    shown, foot = budgeted([x for x in order if not TESTY.search(x[0])], budget, "file")
    if budget > 0:
        print(f"\nwhere the work is ({len(files)} file(s) within 3 hops of those entry points; "
              f"nearest first, then by how much of the task each matches):")
    else:
        print(f"\n{len(files)} file(s) lie within 3 hops of the entry points; `--budget N` lists them")
    # Name the DECLARATIONS, not only the file. Every symbol here was already scored — that is how the file
    # got its rank — and then discarded, so the answer said "look in this file" where it could have said
    # which functions to look at. Measured over 31 real commits, naming two declarations per file roughly
    # doubled how many of the changed functions the answer contained, for about a 50% larger answer: what was
    # missing had been computed and thrown away. They cost a line each and carry the evidence the rank used.
    best_in_file, span_of = {}, {}
    for sid, (sc, matched) in scored.items():
        sy = g.sym.get(sid) or {}
        f = sy.get('file') or ''
        nm = sy.get('display') or sy.get('name') or ''
        # a <module> node is the file itself, not a declaration in it, and the same name can carry several
        # symbol ids (an overload, a re-declaration) — neither is worth a line of the answer
        if not f or not nm or '<' in nm or not sy.get('method_id'): continue
        cur = best_in_file.setdefault(f, {})
        if nm not in cur or sc > cur[nm][0]:
            cur[nm] = (sc, len(matched), nm)
            if sy.get('line'): span_of[(f, nm)] = (sy['line'], sy.get('end_line') or sy['line'])
    def decls_of(f):
        return [nm for _sc, _m, nm in sorted(best_in_file.get(f, {}).values(), key=lambda x: (-x[0], -x[1], x[2]))[:DECLS_PER_FILE]]
    # `declared_at` beside the names: the line each one starts on, so a site list (ax_grep.py) can point at it
    RESULT['files'] = [{'file': f, 'how': ('name only, no call path' if d == 99 else f'hop {d}'),
                        'symbols': n, 'task_terms_matched': hit, 'declarations': decls_of(f),
                        'declared_at': [f"{f}:{span_of[(f, nm)][0]}" if (f, nm) in span_of else None for nm in decls_of(f)]}
                       for f, (d, hit, n) in shown]
    for f, (d, hit, n) in shown:
        mark = f"  [{hit} task term(s)]" if hit else ""
        how = "name only, no call path" if d == 99 else f"hop {d}"
        print(f"    {how:22} {f}  ({n} symbol(s)){mark}")
        top = sorted(best_in_file.get(f, {}).values(), key=lambda x: (-x[0], -x[1], x[2]))[:DECLS_PER_FILE]
        if top and not show_source:
            print(f"    {'':22}   -> " + ', '.join(nm for _sc, _m, nm in top))
        elif top:
            # --source: print the declaration itself, not a pointer to it. A list of paths makes the caller
            # spend its own turns re-reading what this already located, which is where the context actually
            # goes; the body it needs is a few lines and this has the span already.
            for _sc, _m, nm in top:
                sp = span_of.get((f, nm))
                if not sp: continue
                a, b = sp
                code = source_lines(g.repo, f)[a - 1:min(b, a + SOURCE_LINES)]   # not `body`: that is the question
                if not code: continue
                print(f"    {'':22}   {nm}  ({f}:{a})")
                for k, ln in enumerate(code, a):
                    print(f"    {'':22}   {k:5} | {ln.rstrip()[:110]}")
                if b > a + SOURCE_LINES: print(f"    {'':22}   {'':5} | … +{b - a - SOURCE_LINES} more line(s)")
    if foot and budget > 0: print(foot + ", tests and benchmarks not listed")

    # THE OTHER END OF A ROUTE IS NO CALL HOP AWAY, HOWEVER CLOSE IT IS (#1293). A client and the handler it reaches
    # through an HTTP route, a topic or a gRPC service are joined by ext_remote_edge, which `impact` and `path` read and
    # this did not, so the service on the other side never appeared. Its own tier, with the transport and destination,
    # and never merged into the hops above: it crosses a process and may be asynchronous.
    RESULT['remote'] = []
    if g.has('ext_remote_edge') and depth:
        rows = []
        for r in g.q("SELECT c0, c1, c2, c3, c4 FROM ext_remote_edge"):
            fr, to = r[0], r[1]
            if not fr or not to or fr == to or fr not in g.sym or to not in g.sym: continue
            d = min(depth.get(fr, 99), depth.get(to, 99))
            if d == 99: continue
            near_is_sender = depth.get(fr, 99) <= depth.get(to, 99)
            rows.append((d, g.disp(fr), g.disp(to), fr, to, r[2], r[3], r[4], near_is_sender))
        rows.sort(key=lambda x: (x[0], x[1], x[2], x[6]))
        if scopes and not scope_offered:
            rows = [x for x in rows if in_scope(g.sym[x[3]].get('file')) or in_scope(g.sym[x[4]].get('file'))]
        if rows:
            print(f"\nacross a process boundary ({len(rows)} remote hop(s) from what is above; not calls — joined by the "
                  "destination both ends name):")
            for d, _a, _b, fr, to, tr, dest, conf, near_is_sender in rows[:REMOTE_SHOWN]:
                far = to if near_is_sender else fr
                print(f"    [remote] {tr} {dest}  ({conf})  {g.disp(fr)} → {g.disp(to)}   "
                      f"{'handled in' if near_is_sender else 'sent from'} {g.loc(far)}")
            if len(rows) > REMOTE_SHOWN: print(f"    … +{len(rows) - REMOTE_SHOWN} more")
            RESULT['remote'] = [{'from': g.disp(fr), 'from_at': g.loc(fr), 'to': g.disp(to), 'to_at': g.loc(to),
                                 'transport': tr, 'destination': dest, 'confidence': conf, 'hop': d}
                                for d, _a, _b, fr, to, tr, dest, conf, _n in rows]

    # the text files bound to what was found (#1382): only when the question is about them (SQL, config, a template, a
    # file or directory the graph does not hold), because finding them walks the tree
    RESULT['text_bindings'] = []
    if NONSOURCE_ASK.search(body) or text_dirs:
        # the seeds first, then what they reach that has NO BODY (an interface or mapper method: its behaviour is bound
        # somewhere the source does not hold, which is exactly what a text binding is), then the rest, nearest first
        seed_ids = {s_ for s_, _t, _sc in seeds}
        ring = [x for x, d in depth.items() if d <= 2 and x in g.sym and x not in seed_ids]
        # an interface seed's implementations and what THEY call: the call closure does not cross an override, and
        # "which SQL runs when an order is cancelled" seeds the service interface while the mapper call is in its impl
        if g.has('overrides') and seed_ids:
            ph = ','.join('?' * len(seed_ids))
            impls = {r[0] for r in g.q(f"SELECT overriding_method_id FROM overrides WHERE method_id IN ({ph})", *seed_ids)} - seed_ids
            # nearer through the implementation than through the seeds' own closure counts as nearer: the mapper call
            # in the impl is one hop from it however far the closure walk happened to place it (hop 3 is outside the ring)
            for x, d in neighbourhood(g, [i for i in impls if i in g.sym], cap=1).items():
                if x in seed_ids or x not in g.sym or depth.get(x, d + 2) <= d + 1: continue
                if depth.get(x, 3) > 2: ring.append(x)
                depth[x] = d + 1
        near = list(seed_ids) + sorted(ring, key=lambda x: (not bodiless(g, x), depth[x], g.disp(x) or '', x))[:300]
        kinds = asked_exts(body)
        binds = text_bindings(g, near, under=text_dirs, want_ext=kinds)
        # the question named a kind of file (SQL: mapper XML or .sql): when some binding is of that kind, the others
        # (a Postman collection, a README table that spells the method) are not what was asked
        if kinds and any(f.endswith(kinds) for f, _l, _d, _n in binds):
            binds = [b for b in binds if b[0].endswith(kinds)]
        if binds:
            print("\ntext files that name these declarations (not source: bound by the name written there, not by a call; "
                  "the graph cannot follow into them):")
            for f, l, d, nm in binds[:BINDINGS_SHOWN]:
                print(f"    {f + ':' + str(l):56}  names {nm} ({d})")
            if len(binds) > BINDINGS_SHOWN: print(f"    … +{len(binds) - BINDINGS_SHOWN} more")
            RESULT['text_bindings'] = [{'file': f, 'line': l, 'declaration': d, 'name': nm} for f, l, d, nm in binds]
        elif text_dirs:
            hits = text_term_hits(g, text_dirs, terms)
            if hits:
                print(f"\ntext files under {', '.join(d + '/' for d in text_dirs)} that use the task's words (not source; "
                      "matched by word, not by any declaration):")
                for f, l, ts in hits[:BINDINGS_SHOWN]:
                    print(f"    {f + ':' + str(l):56}  {', '.join(ts)}")
                RESULT['text_bindings'] = [{'file': f, 'line': l, 'terms': ts} for f, l, ts in hits]

    print("\n" + BOUND)
    print("  narrow with `impact <name> --in <path>` or `path '*' <name> --in <path>`.")
    return 0


# A QUOTED STRING IN THE TASK is usually a message, a key or a value the reader saw somewhere ("nothing named X",
# `AXIOMCODE_NO_REFRESH`): the graph holds declarations, not what they print, so its words scored against names and the
# agent then searched for the string by hand. Where it is written is a text search, so it is one, labelled [text] and
# printed after the answer; a quoted name some graph declares is the graph's question and is left to it
QUOTED = re.compile(r'"([^"\n]{4,120})"|(?<![\w])\'([^\'\n]{4,120})\'(?![\w])|`([^`\n]{4,120})`')


def quoted_text(argv):
    skip = {'--budget', '--seeds', '--in', '--from', '--page', '--page-budget'}
    pos, i = [], 0
    while i < len(argv):
        if argv[i] in skip: i += 2; continue
        if not argv[i].startswith('--'): pos.append(argv[i])
        i += 1
    if not pos: return
    task, repo = pos[0], (pos[1] if len(pos) > 1 else '.')
    asked = []
    for m in QUOTED.finditer(task_text(task)):
        s = next(x for x in m.groups() if x is not None).strip()
        if len(s) < 4 or s.startswith('/') or s in asked: continue            # a route: the graph's route seeds answer it
        if ax_text.declared(repo, re.split(r'[.#:$]', re.sub(r'\(.*\)$', '', s))[-1]): continue
        asked.append(s)
    ax_text.emit(repo, asked[:3], why='quoted', rows=4)


def cli(argv):
    """--json: the same answer as one document. The prose is produced by the same code path and carried
    in `prose`, so the machine shape is never LESS than the human one — a second traversal to build it
    would be a second implementation to keep in step."""
    if '--json' not in argv:
        code = main(argv)
        if code in (0, 2): quoted_text(argv)
        sys.exit(code)
    import contextlib, io, json
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf): code = main(argv)
    RESULT['prose'] = buf.getvalue().rstrip('\n').split('\n')
    print(json.dumps(RESULT, indent=2))
    sys.exit(code)


if __name__ == '__main__':
    import ax_pages; ax_pages.install('context')      # pages and a next step (#1202)
    cli(sys.argv[1:])
