#!/usr/bin/env bash
# axiomcode-build [repo-dir] — build the AxiomCode graph for a repository into <repo>/.axiomcode/out/graph.sqlite
# (parser + engine via bin/axiomcode all, tests INCLUDED), then index it for the query frontend (axiomcode-index:
# symbols, refs, literals, comments, nesting, views). Prints how much of the graph is resolved vs unknown.
#   AXIOMCODE_ENGINE  checkout of axiomcodegraph (default: the one this skill lives in)
#   AXIOMCODE_SRC     subtree to analyse (e.g. one module of a monorepo); the graph still lives at <repo>/.axiomcode
#   AXIOMCODE_LANG    restrict to java | typescript | python | javascript | csharp, or a comma list of them, the first being
#                     the main one (default: every language with files; the main one is the language with the most).
#                     A rebuild that names no language keeps the ones an earlier --lang chose (and its --src); pass
#                     --lang again, or AXIOMCODE_REINDEX=1, to choose again
#   AXIOMCODE_LIBRARY comma-separated library roots (source trees or IR) passed as --library; without them, calls into
#                     dependencies are declared unknown rather than guessed
# A repository in several languages gets one graph per language. The main language's is the one it always had,
# .axiomcode/out/graph.sqlite; every other language's is .axiomcode/lang/<lang>/out/graph.sqlite, and the query verbs
# (the `axiomcode` dispatcher) ask each of them. Each graph is one language: no call is followed from one to another.
# Each is published as soon as its own language is solved, the main one first, so a query never waits for another
# language's compile; until the last one is in, .axiomcode/out/building names the languages still to come.
set -euo pipefail
H="$(cd "$(dirname "$0")" && pwd)"
# a repository that is not there is an error, never the working directory, and nothing is built
[ -d "${1:-.}" ] || { echo "axiomcode index: no such directory: $1 (the repository to index). Nothing was built." >&2; exit 2; }
REPO="$(cd "${1:-.}" && pwd)"
# --src IS RELATIVE TO THE REPOSITORY, OR ABSOLUTE AND USED AS GIVEN. An absolute --src was joined onto the repository
# (<repo>//abs/src), a tree that is not there. One inside the repository is kept as its path relative to it, which is
# what the file table, the stamp and the baseline's `git archive` key on; one outside it is analysed where it is.
if [ -n "${AXIOMCODE_SRC:-}" ]; then
  case "$AXIOMCODE_SRC" in
    /*|[A-Za-z]:[\\/]*)
      [ -d "$AXIOMCODE_SRC" ] || { echo "axiomcode index: no such directory: $AXIOMCODE_SRC (--src). Nothing was built." >&2; exit 2; }
      SRC_ABS="$(cd "$AXIOMCODE_SRC" && pwd)"
      case "$SRC_ABS" in "$REPO") AXIOMCODE_SRC=. ;; "$REPO"/*) AXIOMCODE_SRC="${SRC_ABS#"$REPO"/}" ;; *) AXIOMCODE_SRC="$SRC_ABS" ;; esac
      export AXIOMCODE_SRC ;;
  esac
fi
# THE ENGINE IS CHOSEN THE SAME WAY EVERY TIME, AND A BUILD THAT FINDS NONE SAYS WHERE IT LOOKED. The background
# refresh runs this script from a hook, with the hook's PATH, the hook's Node and, installed from a marketplace, from a
# plugin COPIED outside any checkout; an explicit `axiomcode index` runs it from inside the npm package. Each found an
# engine its own way, so on a machine with two Node installs (two npm global roots, and the `axiomcode` on PATH a
# Windows .cmd/.sh shim rather than a symlink into the package) the refresh found none on every edit while the
# explicit index kept working, and the graph went stale. The order, first built engine wins:
#   1. AXIOMCODE_ENGINE, used as given whenever it is an engine (named loudly and skipped when it is not)
#   2. the checkout this script sits in (the walk up from skills/… or plugins/axiomcode/skills/…)
#   3. the engine that built this repository's graph last time (.axiomcode/engine, written by a successful build),
#      so the refresh uses exactly what the explicit index used, whatever PATH it inherits
#   4. an `axiomcode` on PATH: through its symlink (npm on POSIX), or the package beside npm's shim (Windows)
#   5. $(npm root -g)/@axiomcode/code-graph
#   6. an UNBUILT checkout found by the walk, so a developer keeps the "parser not built" advice
# Gemini CLI and Codex install from the repository itself, so the walk from an installed copy can end at an unbuilt
# clone; that is why 2 needs a built engine and 6 exists. python3's sqlite3 module, not the sqlite3 CLI: python3 is a
# stated requirement, the CLI is not, and stock Ubuntu and Git for Windows ship without it.
has_symbols() { python3 -c 'import sqlite3, sys; sys.exit(0 if sqlite3.connect(sys.argv[1]).execute("SELECT 1 FROM sqlite_master WHERE name=?", ("symbols",)).fetchone() else 1)' "$1" 2>/dev/null; }
engine_ok() { [ -x "$1/bin/axiomcode" ] && [ -d "$1/graph" ] && [ -f "$1/package.json" ]; }
engine_built() { engine_ok "$1" && [ -f "$1/parser/dist/index.js" ]; }
# a Windows path from npm (C:\Users\…) in the form this bash tests files with
unixpath() { if [ -n "$1" ] && command -v cygpath >/dev/null 2>&1; then cygpath -u "$1" 2>/dev/null || printf %s "$1"; else printf %s "$1"; fi; }
WALK="$H"; while [ "$WALK" != "/" ] && [ ! -x "$WALK/bin/axiomcode" ]; do WALK="$(dirname "$WALK")"; done
RECORDED="$(cat "$REPO/.axiomcode/engine" 2>/dev/null | tr -d '\r' || true)"; RECORDED="$(unixpath "$RECORDED")"
ENGINE=""; TRIED=()
try_engine() {   # try_engine <how> <dir> [any]: take <dir> when it is a built engine (or any engine, with `any`)
  [ -n "$ENGINE" ] && return 0
  if [ -z "$2" ]; then TRIED+=("$1: not set"); return 0; fi
  if { [ "${3:-}" = any ] && engine_ok "$2"; } || engine_built "$2"; then ENGINE="$2"; ENGINE_HOW="$1"; return 0; fi
  if engine_ok "$2"; then TRIED+=("$1: $2 (an engine checkout, but its parser is not built)")
  else TRIED+=("$1: $2 (no bin/axiomcode, graph/ and package.json there)"); fi
}
if [ -n "${AXIOMCODE_ENGINE:-}" ]; then
  try_engine AXIOMCODE_ENGINE "$(unixpath "$AXIOMCODE_ENGINE")" any
  [ -n "$ENGINE" ] || echo "⚠️  AXIOMCODE_ENGINE=$AXIOMCODE_ENGINE is not an engine checkout; looking elsewhere" >&2
fi
[ "$WALK" != / ] && try_engine "this plugin's checkout" "$WALK" || TRIED+=("this plugin's checkout: none above $H")
[ -n "$RECORDED" ] && try_engine "the engine that built this graph (.axiomcode/engine)" "$RECORDED"
PATHBIN="$(command -v axiomcode 2>/dev/null || true)"
if [ -n "$PATHBIN" ]; then
  l="$PATHBIN"; while [ -L "$l" ]; do t="$(readlink "$l")"; case "$t" in /*) l="$t";; *) l="$(cd "$(dirname "$l")" && pwd)/$t";; esac; done
  try_engine "axiomcode on PATH ($PATHBIN)" "$(dirname "$(dirname "$l")")"
  # npm on Windows writes axiomcode / axiomcode.cmd / axiomcode.ps1 SHIMS into its prefix, beside node_modules
  try_engine "the package beside the axiomcode shim on PATH" "$(dirname "$PATHBIN")/node_modules/@axiomcode/code-graph"
else TRIED+=("axiomcode on PATH: none"); fi
if [ -z "$ENGINE" ]; then                  # npm is slow to start: asked only when nothing before it answered
  NPMROOT="$(unixpath "$(npm root -g 2>/dev/null | tr -d '\r' || true)")"
  [ -n "$NPMROOT" ] && try_engine "npm root -g" "$NPMROOT/@axiomcode/code-graph" || TRIED+=("npm root -g: no npm on PATH")
fi
[ "$WALK" != / ] && try_engine "this plugin's checkout (unbuilt)" "$WALK" any
[ -n "$ENGINE" ] || {
  echo "axiomcode: no engine found — the graph cannot be built or refreshed." >&2
  echo "  The skill queries a graph; the ENGINE builds it, and it ships separately because it carries" >&2
  echo "  native solver binaries. Installed from a marketplace the plugin is copied outside any" >&2
  echo "  checkout, so there is nothing to find above it. Fix with ONE of:" >&2
  echo "    npm i -g @axiomcode/code-graph        (then this resolves it automatically)" >&2
  echo "    AXIOMCODE_ENGINE=/path/to/axiomcodegraph" >&2
  echo "  Looked in, in order:" >&2
  for t in "${TRIED[@]}"; do echo "    - $t" >&2; done
  exit 1; }
AXIOMCODE_ENGINE="$ENGINE"
# THE FIRST LINE NAMES THE ENGINE AND PARSER THIS BUILD USES, AND WHERE THEY CAME FROM (ax_fresh.py which_engine). A
# worktree whose parser/dist linked to a deleted build directory was not "built" above, so its build silently took the
# installed engine and the graph was not the worktree's. A checkout with its own engine sources whose built parts DANGLE
# is refused; one whose parts are simply not built says loudly that another engine is used; an installed engine with no
# checkout of its own says one quiet line. Where it came from goes into the file table and the graph (engine_origin).
WALKED=""; [ "$WALK" != / ] && WALKED="$WALK"
ERC=0; EOUT="$(python3 "$H/ax_fresh.py" which-engine "$REPO" "$ENGINE" "${ENGINE_HOW:-}" "$WALKED" 2>/dev/null)" || ERC=$?
AXIOMCODE_ENGINE_ORIGIN="$(printf '%s\n' "$EOUT" | sed -n 's/^@origin //p')"; export AXIOMCODE_ENGINE_ORIGIN
ENGINE_LINE="$(printf '%s\n' "$EOUT" | sed '/^@origin /d')"
if [ "$ERC" = 3 ]; then printf '%s\n' "$ENGINE_LINE" >&2; exit 1; fi
[ -n "$ENGINE_LINE" ] || ENGINE_LINE="engine: $ENGINE (${ENGINE_HOW:-})"
printf '%s\n' "$ENGINE_LINE"
export AXIOMCODE_BUILT_WITH="${ENGINE_LINE%%$'\n'*}"
# A REBUILD THAT NAMES NO LANGUAGE KEEPS THE LANGUAGES THE INDEX CHOSE. Every rebuild comes here: an explicit `index`,
# the background refresh after an edit or a commit, a query that repairs a broken graph, `graph`. One that named no
# language detected every language in the tree, so on a repository indexed with --lang csharp it solved a few stray
# .ts and .js files too (a JavaScript Souffle compile of up to an hour), left a graph for each that later queries
# answered from, and recorded the detected list as the index's choice, so every refresh after it did the same. When
# the graph here was built with an explicit --lang (lang_auto false in its file table), a request with no language
# keeps that --lang, and the --src with it when none is given; a graph whose languages were detected is detected again.
if [ -z "${AXIOMCODE_LANG:-}" ] && [ -z "${AXIOMCODE_REINDEX:-}" ]; then
  KEPT="$(python3 "$H/ax_fresh.py" chosen "$REPO" 2>/dev/null || true)"
  if [ -n "$KEPT" ]; then
    AXIOMCODE_LANG="${KEPT%%$'\t'*}"; export AXIOMCODE_LANG
    [ -n "${AXIOMCODE_SRC:-}" ] || { AXIOMCODE_SRC="${KEPT#*$'\t'}"; export AXIOMCODE_SRC; }
    [ -n "${AXIOMCODE_BACKGROUND:-}" ] || echo "keeping the languages this graph was indexed with (--lang $AXIOMCODE_LANG${AXIOMCODE_SRC:+ --src $AXIOMCODE_SRC}); pass --lang, or AXIOMCODE_REINDEX=1, to choose again"
  fi
fi
case "${AXIOMCODE_SRC:-}" in /*|[A-Za-z]:[\\/]*) SRC="$AXIOMCODE_SRC" ;; *) SRC="$REPO/${AXIOMCODE_SRC:-}"; SRC="${SRC%/}" ;; esac
[ -d "$SRC" ] || { echo "axiomcode index: no such directory: $SRC (--src ${AXIOMCODE_SRC:-}, under $REPO). Nothing was built." >&2; exit 2; }
# THE FILES OF EACH LANGUAGE, COUNTED AS THE PARSER AND THE REFRESHER SEE THEM: the parser's skip list and git's ignore
# rules (ax_fresh.py count). A `find` with its own shorter skip list counted a generated tree the parser never reads —
# the "typescript 15108 files" of a 431-file project — and could pick a different main language than the last build.
read -r ja ts py js cs <<< "$(python3 "$H/ax_fresh.py" count "$SRC" 2>/dev/null || echo 0 0 0 0 0)"
LANG_ARG="${AXIOMCODE_LANG:-}"
# EVERY LANGUAGE IN THE REPOSITORY IS INDEXED. Only the one with the most files used to be, and the rest were dropped
# without a word: a Python edit in a TypeScript repository touched "no declaration the graph knows". LANG_ARG is the
# main language (its graph is the one every older reader knows); LANGS is all of them, main first.
if [ -z "$LANG_ARG" ]; then
  LANG_ARG=java; best=$ja
  [ "$ts" -gt "$best" ] && { LANG_ARG=typescript; best=$ts; }
  [ "$py" -gt "$best" ] && { LANG_ARG=python; best=$py; }
  [ "$js" -gt "$best" ] && { LANG_ARG=javascript; best=$js; }
  [ "$cs" -gt "$best" ] && { LANG_ARG=csharp; best=$cs; }
  LANGS="$LANG_ARG"
  for l in java:$ja typescript:$ts python:$py javascript:$js csharp:$cs; do
    [ "${l%%:*}" != "$LANG_ARG" ] && [ "${l#*:}" -gt 0 ] && LANGS="$LANGS,${l%%:*}"
  done
  export AXIOMCODE_LANG_AUTO=1           # recorded in the file table: a refresh detects the languages again
else
  LANGS="$LANG_ARG"; LANG_ARG="${LANGS%%,*}"; unset AXIOMCODE_LANG_AUTO
fi
unset AXIOMCODE_GRAPH_LANG               # a build writes every language's graph, never one chosen for a query
OTHER_LANGS=""; [ "$LANGS" != "$LANG_ARG" ] && OTHER_LANGS="${LANGS#*,}"
# THE ORDER THE ENGINE SOLVES IN (#1555): the main language first, then the rest by file count, most first. Each graph is
# published the moment its language is solved, so this is the order they become queryable in. LANGS keeps its own order:
# it is part of the stamp and the file table, and a new order there would rebuild every mixed repository once.
SOLVE="$LANG_ARG"
if [ -n "$OTHER_LANGS" ]; then
  files_of(){ case "$1" in (java) echo "$ja";; (typescript) echo "$ts";; (python) echo "$py";; (javascript) echo "$js";; (csharp) echo "$cs";; (*) echo 0;; esac; }
  for l in $(for o in ${OTHER_LANGS//,/ }; do echo "$(files_of "$o") $o"; done | sort -s -k1,1nr | cut -d' ' -f2); do SOLVE="$SOLVE,$l"; done
fi
OUT="$REPO/.axiomcode/out"; mkdir -p "$OUT"
# ONE BUILD AT A TIME PER REPOSITORY. The background refresher (ax_fresh.py) and an explicit `axiomcode index` both
# write $OUT/$LANG_ARG; two at once clobber each other's graph. The lock is on fd 9, which this shell holds for its
# whole life, so the OS drops it when the build ends however it ends: no stale lock to time out.
exec 9>"$REPO/.axiomcode/build.lock"
if ! python3 "$H/ax_fresh.py" lock 9 --try; then
  [ -n "${AXIOMCODE_BACKGROUND:-}" ] || echo "a graph build is already running for $REPO; waiting for it …"
  python3 "$H/ax_fresh.py" lock 9 || { echo "could not take the build lock ($REPO/.axiomcode/build.lock)"; exit 75; }
fi
python3 "$H/ax_fresh.py" relink "$REPO" --locked || true   # a pointer copied from another checkout is this one's again (#1605)
BUILD_T0=$SECONDS                        # how long a build takes to a usable graph: a query decides from it whether to wait (#1595)
# THE QUERY RULES COMPILE BESIDE THE ENGINE, NOT AFTER THE GRAPH (#1606). They do not depend on the graph, only on this
# plugin's dl/*.dl, and impact.dl alone takes 45-140 s. Started once the graph was published, the compile raced the first
# query, which then paid it (44 s on a C# library). Now it starts here, detached, into the user's cache, where every
# plugin copy with the same rules finds it; a query that still comes first answers with the interpreter meanwhile.
python3 "$H/dl_program.py" --background 2>/dev/null || true
GD="$(cd "$REPO" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[ -n "$GD" ] && mkdir -p "$GD/info" && { grep -qx '.axiomcode' "$GD/info/exclude" 2>/dev/null || echo '.axiomcode' >> "$GD/info/exclude"; } || true
STAMP="$(cd "$REPO" && git rev-parse HEAD 2>/dev/null || echo nogit)-$LANGS-${AXIOMCODE_SRC:-.}-${AXIOMCODE_LIBRARY:-nolib}"
# ASKING FOR LESS IS NOT A CACHE MISS. The stamp includes the library roots, so a bare `index` on a repo whose
# graph was built WITH roots does not match, and the rebuild that follows spends the full build cost to arrive
# at a client-only graph: every call into a dependency ambiguous_unknown, the resolution rate understated,
# strictly worse than the graph it replaced. Measured once at 624 s, by an agent that only wanted to be sure
# the graph was current. So when the existing graph differs from what was asked for ONLY by having libraries
# the request omits, keep it and say so; a caller that means to narrow coverage passes AXIOMCODE_REINDEX=1.
# The library field is a list of PATHS, and paths contain hyphens (`other-lib`), so the stamp cannot be split
# on its last hyphen -- that cuts inside the path and no two stamps ever compare equal. Split on the known
# prefix instead: everything before the library field is fixed-format and built right here.
PREFIX="$(cd "$REPO" && git rev-parse HEAD 2>/dev/null || echo nogit)-$LANGS-${AXIOMCODE_SRC:-.}-"
if [ -z "${AXIOMCODE_LIBRARY:-}" ] && [ -z "${AXIOMCODE_REINDEX:-}" ] && [ -f "$OUT/stamp" ] && [ -f "$OUT/graph.sqlite" ]; then
  PREV="$(cat "$OUT/stamp")"
  if [ "${PREV#"$PREFIX"}" != "$PREV" ] && [ "${PREV#"$PREFIX"}" != nolib ]; then
    echo "graph already built for this commit WITH library roots (${PREV##*-}); keeping it — a bare index would"
    echo "  rebuild it client-only, which resolves less. AXIOMCODE_REINDEX=1 to force, or pass --library to change them."
    STAMP="$PREV"
    # and a rebuild of it, when the tree changed, keeps the roots too: the stamp said them while the build used none
    AXIOMCODE_LIBRARY="${PREV#"$PREFIX"}"; export AXIOMCODE_LIBRARY
  fi
fi
HEAD_SHA="$(cd "$REPO" && git rev-parse HEAD 2>/dev/null || echo nogit)"
OLD_INDEXED="$(cat "$OUT/indexed-tree" 2>/dev/null || true)"; OLD_COMMIT="$(cut -d- -f1 "$OUT/stamp" 2>/dev/null || true)"
# the baseline `changed` diffs against (base-tree). An explicit index moves it to the tree it indexed (#1222); a
# BACKGROUND refresh keeps it, or every edit would drop out of `changed` and `test-impact` a minute after it was made,
# and moves it only when HEAD moved (a commit, a checkout), to the tree of the new HEAD.
KEEP_BASE="${AXIOMCODE_BACKGROUND:-}${AXIOMCODE_KEEP_BASE:-}"   # a refresh, or a repair of a broken graph (ax_contract.ensure_graph)
set_base(){
  [ -n "$GD" ] || return 0
  if [ -n "$KEEP_BASE" ] && [ -f "$OUT/base-tree" ] && [ "$(cat "$OUT/base-commit" 2>/dev/null)" = "$HEAD_SHA" ]; then :
  elif [ -n "$KEEP_BASE" ] && [ ! -f "$OUT/base-tree" ] && [ -n "$OLD_INDEXED" ] && [ "$OLD_COMMIT" = "$HEAD_SHA" ]; then
    echo "$OLD_INDEXED" > "$OUT/base-tree"                    # a graph from before base-tree: its baseline was the tree it indexed
  elif [ -n "$KEEP_BASE" ]; then
    # HEAD MOVED (a commit, a merge, a pull, a checkout): the baseline is the new commit. Kept where it was, every
    # commit's edits would stay "changed" and test-impact would select for all of them, growing with each commit.
    # Not the working tree either: after a pull, the edits still uncommitted are exactly what `changed` must show.
    (cd "$REPO" && git rev-parse 'HEAD^{tree}' 2>/dev/null) > "$OUT/base-tree.new" && mv "$OUT/base-tree.new" "$OUT/base-tree" || rm -f "$OUT/base-tree.new"
  elif [ -n "$1" ]; then
    # an explicit index sets the baseline to the tree it indexed; when that is not HEAD's (edits were uncommitted), the
    # edits are IN the baseline from now on, and `changed` / `test-impact` say when and by what (base-set)
    [ "$(cat "$OUT/base-tree" 2>/dev/null)" = "$1" ] || printf '%s\t%s\n' "$(date +%s)" "${AXIOMCODE_REFRESH_REASON:-axiomcode index}" > "$OUT/base-set"
    echo "$1" > "$OUT/base-tree"
  else rm -f "$OUT/base-tree" "$OUT/base-set"; fi
}
# the commit the baseline follows, written LAST: `changed` waits while it differs from HEAD, so it must not say "moved"
# before the baseline's graph exists (keep_base_graph), or `changed` reads a baseline with no graph for it
commit_base(){ [ -n "$GD" ] && echo "$HEAD_SHA" > "$OUT/base-commit"; return 0; }
# THE BASELINE WITHOUT GIT (a mirror synced without .git, an export): no tree to record, so `changed` reads an edit as a
# file whose hash differs from the table an explicit index wrote (axiomcode-changed, since_index). Kept as base-files.json,
# since every build, a background refresh too, rewrites files.json: read from it, an edit left `changed` a minute after it
# was made. An explicit index moves it; a refresh keeps it; a build with git has a tree and drops it.
set_base_files(){
  if [ -n "$GD" ]; then rm -f "$OUT/base-files.json"
  elif [ -z "$KEEP_BASE" ] || [ ! -f "$OUT/base-files.json" ]; then [ -f "$OUT/files.json" ] && cp "$OUT/files.json" "$OUT/base-files.json"; fi
  return 0
}
# THE BASELINE GRAPH. `changed`, `test-impact` and the change reports ask about an EDIT: which declarations it touched and
# who depended on them before it, a removed method's callers included. After a background refresh the graph no longer
# has the removed method, and its spans are in the new text. So the graph that describes the baseline is kept, moved
# (not copied) to .axiomcode/base when a background refresh replaces it, and those verbs read it (ax_fresh.py
# baseline_graph); it is dropped when the baseline catches up with the graph. Mapping the new graph's spans onto the
# baseline's text by a line diff was tried first: on 7 real commits it changed the answer on 3.
# the baseline graph directory is assembled beside it and swapped in by rename, never emptied in place: `changed` reads
# it while a refresh runs, and found it half there (a graph.sqlite, no tree, or no directory at all)
install_base(){ local B="$REPO/.axiomcode/base"; rm -rf "$B.old"; [ -d "$B" ] && mv "$B" "$B.old"; mv "$B.new" "$B"; rm -rf "$B.old"; BASE_SAVED=1; }
keep_base_graph(){
  local B="$REPO/.axiomcode/base" BT; BT="$(cat "$OUT/base-tree" 2>/dev/null || true)"
  if [ -z "$BT" ] || [ "$BT" = "$INDEXED_TREE" ]; then rm -rf "$B"; return 0; fi
  if [ "$BT" = "$OLD_INDEXED" ] && [ -n "$PREV" ] && [ -f "$PREV/graph.sqlite" ] && [ ! -L "$PREV/graph.sqlite" ]; then
    rm -rf "$B.new"; mkdir -p "$B.new/out"; mv "$PREV/graph.sqlite" "$B.new/out/graph.sqlite"; echo "$BT" > "$B.new/tree"
    # every other language's graph still describes the same tree: it is replaced only after this, so a hard link keeps
    # it for the baseline while the live one stays in place for the queries that arrive meanwhile
    local l; for l in ${OTHER_LANGS//,/ }; do
      [ -f "$LANGDIR/$l/out/graph.sqlite" ] && mkdir -p "$B.new/lang/$l/out" && { ln -f "$LANGDIR/$l/out/graph.sqlite" "$B.new/lang/$l/out/graph.sqlite" 2>/dev/null || cp -p "$LANGDIR/$l/out/graph.sqlite" "$B.new/lang/$l/out/graph.sqlite"; }
    done
    install_base
  elif [ "$(cat "$B/tree" 2>/dev/null)" != "$BT" ]; then build_head_graph "$BT"
  fi
  return 0
}
# the baseline is HEAD and the working tree is not: no graph describes HEAD's text, so one is built from it, exported
# with `git archive` into a scratch directory (the user's checkout and index are never touched). node_modules is not in
# git, and TypeScript resolves types through it, so the repository's own is linked in.
build_head_graph(){
  local T D; T="$(mktemp -d "${TMPDIR:-/tmp}/axiomcode-base.XXXXXX")" || return 0
  if (cd "$REPO" && git archive "$HEAD_SHA" -- ${AXIOMCODE_SRC:+"$AXIOMCODE_SRC"}) | tar -x -C "$T" 2>/dev/null; then
    [ -d "$REPO/node_modules" ] && ln -s "$REPO/node_modules" "$T/node_modules"
    # library roots are given relative to the repository or absolute; from the scratch directory only absolute reach
    local LIBS="" r; if [ -n "${AXIOMCODE_LIBRARY:-}" ]; then
      local IFS=','; for r in $AXIOMCODE_LIBRARY; do case "$r" in /*|[A-Za-z]:*) ;; *) r="$REPO/$r" ;; esac; LIBS="${LIBS:+$LIBS,}$r"; done; unset IFS
    fi
    if env -u AXIOMCODE_BACKGROUND -u AXIOMCODE_KEEP_BASE AXIOMCODE_NO_REFRESH=1 AXIOMCODE_LIBRARY="$LIBS" bash "$H/axiomcode-build" "$T" > "$REPO/.axiomcode/base-build.log" 2>&1; then
      # graph.sqlite is a symlink, or (Windows without the symlink privilege) the copy Git Bash made instead of one
      D="$(readlink "$T/.axiomcode/out/graph.sqlite" 2>/dev/null || true)"; [ -n "$D" ] || D="$T/.axiomcode/out/graph.sqlite"
      case "$D" in /*|[A-Za-z]:*) ;; *) D="$T/.axiomcode/out/$D" ;; esac   # the pointer is relative to its directory
      if [ -f "$D" ]; then
        local NB="$REPO/.axiomcode/base.new"; rm -rf "$NB"; mkdir -p "$NB/out"; mv "$D" "$NB/out/graph.sqlite"
        for D in "$T"/.axiomcode/lang/*/out/graph.sqlite; do          # and every other language's, beside it
          [ -f "$D" ] || continue; local L; L="$(basename "$(dirname "$(dirname "$D")")")"
          mkdir -p "$NB/lang/$L/out"; mv "$D" "$NB/lang/$L/out/graph.sqlite"
        done
        echo "$1" > "$NB/tree"; install_base
      fi
    fi
  fi
  rm -rf "$T"
}
BASE_SAVED=""
LANGDIR="$REPO/.axiomcode/lang"      # one graph directory per language other than the main one: <lang>/out/graph.sqlite
# FRESH IS "THE FILES THE GRAPH WAS BUILT FROM", NOT "A CLEAN GIT STATUS". The file table (ax_fresh.py) records every
# file the parser reads with its hash; when none differs the graph is current whatever git says: a dirty tree whose
# edits are already indexed is not rebuilt, and a tree edited and restored, which git calls clean against a graph built
# from the edit, is. A commit that changed no file moves the stamp, not the graph.
# A GRAPH A QUERY FOUND CORRUPT (ax_fresh.quarantine leaves .axiomcode/out/corrupt) is rebuilt even though no file moved:
# the files still match the table, so without this the build said "up to date" over a graph that could not be read.
if [ -f "$OUT/corrupt" ]; then echo "rebuilding: $(head -1 "$OUT/corrupt")"; fi
# A GRAPH A NEWER AXIOMCODE BUILT is never rebuilt by this older one (ax_fresh.py newer_build): two plugin versions over
# one repository rebuilt each other's graph back and forth. It is kept whatever changed, and every answer says so;
# AXIOMCODE_REINDEX=1 rebuilds it with this one on purpose. A corrupt graph is rebuilt all the same.
if [ -z "${AXIOMCODE_REINDEX:-}" ] && [ ! -f "$OUT/corrupt" ] && [ -f "$OUT/graph.sqlite" ] && NEWER="$(AXIOMCODE_ENGINE="$ENGINE" python3 "$H/ax_fresh.py" newer "$REPO")"; then
  echo "$NEWER"; exit 0
fi
if [ ! -f "$OUT/corrupt" ] && [ -f "$OUT/graph.sqlite" ] && [ -f "$OUT/stamp" ] && [ ! -f "$OUT/partial" ] && AXIOMCODE_ENGINE="$ENGINE" python3 "$H/ax_fresh.py" uptodate "$REPO" "$LANGS" "${AXIOMCODE_SRC:-}" "${STAMP#"$PREFIX"}"; then
  if [ "$(cat "$OUT/stamp")" != "$STAMP" ]; then echo "$STAMP" > "$OUT/stamp"; INDEXED_TREE="$OLD_INDEXED"; set_base "$OLD_INDEXED"; PREV=""; keep_base_graph; commit_base; fi
  set_base_files
  has_symbols "$OUT/graph.sqlite" || python3 "$H/axiomcode-index" "$REPO"
  [ -f "$REPO/.axiomcode/engine" ] || printf '%s\n' "$ENGINE" > "$REPO/.axiomcode/engine" || true
  echo "graph up to date (${LANGS//,/, }) at $OUT/graph.sqlite"; exit 0
fi
if [ ! -f "$OUT/corrupt" ] && [ ! -f "$OUT/files.json" ] && [ -f "$OUT/stamp" ] && [ "$(cat "$OUT/stamp")" = "$STAMP" ] && [ -f "$OUT/graph.sqlite" ] && [ -z "$(cd "$REPO" && git status --porcelain 2>/dev/null | head -1)" ]; then
  has_symbols "$OUT/graph.sqlite" || python3 "$H/axiomcode-index" "$REPO"
  python3 "$H/axiomcode-impact" --warm "$REPO" || true   # export the graph's facts now (~9 s on 1,373 files): the first
# query pays it otherwise, and for the plugin that first query is inside hooks/changes.py's timeout=14, several at once.
python3 "$H/dl_program.py" --no-wait || true   # say whether the query rules are compiled (started at the top); never wait
  # a graph from before the file table: it was built from this clean commit, so the table of the files now IS its table
  AXIOMCODE_BUILT_BY_UNKNOWN=1 python3 "$H/ax_fresh.py" snapshot "$REPO" "$LANGS" "${AXIOMCODE_SRC:-}" > "$OUT/.files.json.new" 2>/dev/null && mv "$OUT/.files.json.new" "$OUT/files.json" || rm -f "$OUT/.files.json.new"
  echo "graph up to date ($LANG_ARG) at $OUT/graph.sqlite"; exit 0; fi
if [ -z "$OTHER_LANGS" ]; then echo "building $LANG_ARG graph for $SRC … (java $ja · typescript $ts · python $py · javascript $js · csharp $cs files)"
else echo "building ${LANGS//,/ + } graphs for $SRC … (java $ja · typescript $ts · python $py · javascript $js · csharp $cs files)"; fi
# THE TREE THE GRAPH IS BUILT FROM (#1222). The graph's spans are line numbers in the working tree as the parser reads
# it, and that tree need not be the commit in the stamp: uncommitted edits are indexed too. `changed` compared the
# working tree against the COMMIT, so after an index with edits every position was off, and a span past the end of the
# committed file crashed it. Recorded here, before the parser reads anything, as a git tree object written through a
# throwaway index: the user's index and checkout are not touched, and .axiomcode is excluded above. Kept only if the
# build succeeds.
# THE FILE TABLE, taken now for the same reason: an edit made while the parser runs must leave the graph stale, so the
# next refresh picks it up. Committed only if the build succeeds. It records what built the graph, the engine above
# and this plugin's rules, so a graph an older axiomcode built is not "up to date" after an update.
AXIOMCODE_ENGINE="$ENGINE" python3 "$H/ax_fresh.py" snapshot "$REPO" "$LANGS" "${AXIOMCODE_SRC:-}" > "$OUT/.files.json.new" 2>/dev/null || rm -f "$OUT/.files.json.new"
INDEXED_TREE=""
if [ -n "$GD" ]; then
  TMPIDX="$(mktemp "${TMPDIR:-/tmp}/axiomcode-index.XXXXXX")"
  INDEXED_TREE="$(cd "$REPO" && GIT_INDEX_FILE="$TMPIDX" git read-tree HEAD 2>/dev/null && GIT_INDEX_FILE="$TMPIDX" git add -A -- . 2>/dev/null && GIT_INDEX_FILE="$TMPIDX" git write-tree 2>/dev/null || true)"
  rm -f "$TMPIDX"
fi
# A REBUILD THAT FAILS MUST NOT COST THE GRAPH THAT IS ALREADY THERE (#1077). The engine wants an
# empty $OUT/$LANG_ARG, but "empty it first" also empties it for the failure path, and the next verb
# then reports no graph at all although the last good one was complete a second earlier. So the old
# graph is MOVED ASIDE, not deleted, and $OUT/graph.sqlite is re-pointed at where it went: until the
# build succeeds every verb keeps answering from it. A graph built for another language is not in the
# way and is left where it is — which is also what $OUT/graph.sqlite still points at.
PREV="$OUT/.previous-$LANG_ARG"
# A FIRST BUILD has no graph for any query to wait for; a rebuild (a refresh, an upgrade that adds a language) has the
# previous one, and a query waits a bounded while for its successor as it always did. $PENDING says which it is.
MODE=refresh; [ -e "$OUT/graph.sqlite" ] || MODE=first
rm -rf "$PREV"
# graph.sqlite NEVER DANGLES (#1305). With a refresher running after every edit, queries arrive mid-build all the time.
# Moving the directory first and re-pointing after left a moment with no graph.sqlite at all, and a verb that finds
# none BUILDS one (ax_contract.ensure_graph) -- a second, full build racing this one. So the live database gets a hard
# link that survives the move, the pointer goes there first, and every re-point is a rename, which is atomic
# (`ln -sfn` unlinks and then links).
# ON WINDOWS A RENAME ONTO A FILE ANOTHER PROCESS HAS OPEN IS REFUSED, and without the symlink privilege Git Bash's `ln -s`
# makes graph.sqlite a copy, which every query holds open while it answers: the swap at the end of a rebuild failed
# under a query, `set -e` ended the build, and the rebuild was lost. Each rename is retried for up to a minute (a query
# is seconds); only then does the build fail, and says why.
swap(){ local i=0; until mv -f "$1" "$2" 2>/dev/null; do i=$((i+1)); [ $i -ge 120 ] && { echo "could not replace $2: another process holds it open" >&2; return 1; }; sleep 0.5; done; }
keep_live(){ ln -f "$1" "$OUT/.live.sqlite" 2>/dev/null || cp -p "$1" "$OUT/.live.sqlite"; }   # a hard link, or a copy where the file system has none
# THE POINTER IS RELATIVE TO ITS DIRECTORY (#1605). An absolute one survived a copy of the repository: the copy answered
# from the original's graph, and once the original moved it rebuilt itself as "interrupted". Made from inside $OUT, so
# Git Bash's copy in place of a link resolves the same relative name.
point(){ local t="${1#"$OUT"/}"; (cd "$OUT" && ln -sfn "$t" .graph.sqlite.new) && swap "$OUT/.graph.sqlite.new" "$OUT/graph.sqlite"; }
real(){ python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null; }
if [ -d "$OUT/$LANG_ARG" ]; then
  if [ -f "$OUT/$LANG_ARG/graph.sqlite" ]; then
    keep_live "$OUT/$LANG_ARG/graph.sqlite" && point "$OUT/.live.sqlite" || { echo "could not keep the graph queries are reading ($OUT/$LANG_ARG); not rebuilding over it" >&2; exit 1; }
  fi
  mv "$OUT/$LANG_ARG" "$PREV"
fi
# the other languages' engine output goes to $OUT/<lang>, which the engine wants empty. Their live graphs are not there
# (they are under .axiomcode/lang), but graph.sqlite may still point there, at a graph from a build whose main language
# was that one: it gets the same hard link first
for l in ${OTHER_LANGS//,/ }; do
  if [ -d "$OUT/$l" ]; then
    if [ "$(real "$OUT/graph.sqlite")" = "$(cd "$OUT/$l" && pwd -P)/graph.sqlite" ]; then
      keep_live "$OUT/$l/graph.sqlite" && point "$OUT/.live.sqlite" || { echo "could not keep the graph queries are reading ($OUT/$l); not rebuilding over it" >&2; exit 1; }
    fi
    rm -rf "$OUT/$l"
  fi
done
# a failed build puts the previous graph back. The live link goes only when graph.sqlite no longer points at it: when this
# build's main language is not the last one's, that link IS the previous graph (its directory is gone), and removing it
# left graph.sqlite dangling — every later query rebuilt from scratch, and the refresher, finding "no graph", stopped
restore(){ rm -rf "$OUT/$LANG_ARG"; if [ -d "$PREV" ]; then mv "$PREV" "$OUT/$LANG_ARG"; [ -f "$OUT/$LANG_ARG/graph.sqlite" ] && point "$OUT/$LANG_ARG/graph.sqlite"; fi
  [ -f "$OUT/.live.sqlite" ] && [ "$(real "$OUT/graph.sqlite")" != "$(real "$OUT/.live.sqlite")" ] && rm -f "$OUT/.live.sqlite"; return 0; }
LIB=(); [ -n "${AXIOMCODE_LIBRARY:-}" ] && LIB=(--library "$AXIOMCODE_LIBRARY")
ENGINE_RC=0
REASON="$(printf %s "${AXIOMCODE_REFRESH_REASON:-axiomcode index}" | tr -d "'")"
# WHEN AND WHY THIS GRAPH WAS BUILT, in the graph itself (index_meta): refreshed_at (UTC), refresh_reason (`axiomcode
# index`, or what the background refresher saw: files changed, HEAD moved, found by an edit, a query or the timer), and
# the tree and commit it describes, and the engine that built it. Written before the swap: a write to the live graph later would change its mtime,
# which keys the impact-facts cache, and cost the next query a re-export.
stamp_meta(){ AXIOMCODE_ENGINE="$ENGINE" python3 - "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$REASON" "$INDEXED_TREE" "$HEAD_SHA" <<'PY' 2>/dev/null || true
import os, sqlite3, sys
db, at, reason, tree, commit = sys.argv[1:6]
# and WHAT BUILT IT: the engine, where it came from (this checkout, AXIOMCODE_ENGINE, installed, or a fallback from a
# checkout whose own parser was not built) and the build's first line, so any later reader can name it
e = os.path.normpath(os.environ['AXIOMCODE_ENGINE']) if os.environ.get('AXIOMCODE_ENGINE') else ''
try:
    import json; ver = json.load(open(os.path.join(e, 'package.json'))).get('version', '?')
except Exception: ver = '?'
eng = [('engine', e), ('engine_version', ver), ('engine_origin', os.environ.get('AXIOMCODE_ENGINE_ORIGIN', '')),
       ('parser', os.path.realpath(os.path.join(e, 'parser', 'dist')) if e else ''),
       ('built_with', os.environ.get('AXIOMCODE_BUILT_WITH', '').lstrip('\u26a0\ufe0f ').strip())]
with sqlite3.connect(db) as c:
    c.execute("DELETE FROM index_meta WHERE key IN ('refreshed_at','refresh_reason','refreshed_tree','refreshed_commit',"
              "'engine','engine_version','engine_origin','parser','built_with')")
    c.executemany("INSERT INTO index_meta VALUES (?,?)", [('refreshed_at', at), ('refresh_reason', reason),
                  ('refreshed_tree', tree), ('refreshed_commit', commit)] + eng)
PY
}
tiers(){ python3 -c 'import sqlite3,sys; c=sqlite3.connect(sys.argv[1]); print(", ".join(f"{t} {n}" for t, n in c.execute("SELECT tier, count(*) FROM call_edges GROUP BY tier ORDER BY 2 DESC")))' "$1"; }
# EACH LANGUAGE'S GRAPH IS PUBLISHED WHEN ITS OWN LANGUAGE IS SOLVED (#1555). The engine solves one language after
# another, and nearly all of each is that language's Souffle compile. Published only when the whole run ended, the main
# language's graph sat finished while three JavaScript files compiled: on a C# web application with a small ClientApp,
# written at 131 s and queryable at 5,304 s, and every query in between waited on the build lock. So the engine runs in
# the background and names each language as it finishes it ($PROGRESS, `all --progress`); the main one is indexed and
# pointed at right then, every other one moved into .axiomcode/lang as it comes. $PENDING lists the languages still
# being solved: ax_fresh.py reads it while this build holds the lock, so a query neither waits for them nor reads the
# graph as stale, and says which languages its answer cannot see yet.
# $PENDING is written when the main graph is published, not before: until then the graph a query reads is the previous
# one, and a rebuild in progress must keep saying so.
PROGRESS="$OUT/.progress"; PENDING="$OUT/building"; rm -f "$PROGRESS" "$PENDING"; : > "$PROGRESS"
unpend(){ grep -v "^$1 " "$PENDING" > "$PENDING.new" 2>/dev/null || true; mv -f "$PENDING.new" "$PENDING"; }
# the engine gets its own process group (set -m), so a build that is stopped stops all of it -- the Souffle compile
# included -- rather than leaving it running under the build lock it inherited
EPID=""
stop_engine(){ if [ -n "$EPID" ] && kill -0 "$EPID" 2>/dev/null; then kill -TERM -- "-$EPID" 2>/dev/null || kill -TERM "$EPID" 2>/dev/null || true; fi; rm -f "$PROGRESS" "$PENDING" "$PENDING.new"; }
trap stop_engine EXIT
# A BUILD STOPPED ONCE ITS MAIN LANGUAGE IS SOLVED PUBLISHES THAT GRAPH FIRST. The solved main graph is most of what the
# build cost; stopped while it was being indexed (a caller's timeout ends the whole process group, the indexer included),
# the build took the indexer's death for a failure, deleted the solved graph and left no graph.sqlite, so the next query
# built everything again, was stopped again, and a repository in several languages rebuilt forever. A signal that
# arrives after the engine names the main language solved, or while it is published, is held until graph.sqlite points
# at it (and the indexer runs in a process group of its own, which a signal to the build's does not reach); the build
# then stops, the other languages unpublished. One that arrives earlier stops the build at once, as it always did.
SIG=""; SIGS=0; PUBLISHING=""; MAIN_DONE=""
on_signal(){ SIGS=$((SIGS + 1)); SIG="$1"
  if [ -z "$MAIN_DONE" ] && { [ -n "$PUBLISHING" ] || grep -q "^$LANG_ARG ok" "$PROGRESS" 2>/dev/null; }; then return 0; fi
  exit "$1"; }
trap 'on_signal 130' INT; trap 'on_signal 143' TERM HUP
# run a command in a process group of its own and wait for it; a held signal interrupts `wait`, not the command
shielded(){ local p rc n; set -m; "$@" & p=$!; set +m
  while :; do n=$SIGS; rc=0; wait "$p" || rc=$?; [ "$SIGS" != "$n" ] && [ "$rc" -gt 128 ] && kill -0 "$p" 2>/dev/null && continue; break; done
  return "$rc"; }
# an engine older than this script has no --progress and refuses an option it does not know: it gets none, and its
# graphs are published together when it ends, as they always were
PROG=(); grep -q -- '--progress' "$ENGINE/bin/axiomcode" 2>/dev/null && PROG=(--progress "$PROGRESS")
set -m
"$ENGINE/bin/axiomcode" all "$SRC" "$OUT" --language "$SOLVE" ${PROG[@]+"${PROG[@]}"} ${LIB[@]+"${LIB[@]}"} < /dev/null > "$REPO/.axiomcode/build.log" 2>&1 &
EPID=$!
set +m
QUEUED=(); READY=(); FAILED=(); DONE=" "; SEEN=0
# THE MAIN LANGUAGE'S GRAPH BECOMES THE GRAPH. Everything a finished build did for it happens here, as soon as it is
# solved: index, stamp, file table, baseline, pointer.
publish_main(){
  PUBLISHING=1
  # the new database: a FILE under $OUT/$LANG_ARG. Matched as `*/$LANG_ARG/*` it was any path with the language's name
  # in it, the repository's own included: a repository at .../python/app matched the graph.sqlite SYMLINK, the link was
  # pointed at itself, the previous graph deleted, and every verb after it reported no graph.
  DB="$(find "$OUT/$LANG_ARG" -type f -name graph.sqlite 2>/dev/null | head -1)"; NOT_OTHER=(); for l in ${OTHER_LANGS//,/ }; do NOT_OTHER+=(-not -path "$OUT/$l/*"); done   # never another language's graph
  [ -n "$DB" ] || DB="$(find "$OUT" -type f -name graph.sqlite -not -path "$PREV/*" ${NOT_OTHER[@]+"${NOT_OTHER[@]}"} | head -1)"
  [ -n "$DB" ] || { restore; echo "build produced no graph.sqlite — the graph that was there is untouched; see $REPO/.axiomcode/build.log"; exit 1; }
  # A QUERY NEVER READS A HALF-BUILT GRAPH. The new database gets its symbols, refs and views BEFORE graph.sqlite points
  # at it; until the pointer moves, every verb (and the hooks) keeps answering from the previous graph. Only then is the
  # old one removed: a reader that opened it keeps the file it opened.
  shielded env AXIOMCODE_INDEX_DB="$DB" python3 "$H/axiomcode-index" "$REPO" || { restore; echo "indexing the new graph failed — the graph that was there is untouched"; exit 1; }
  stamp_meta "$DB"
  echo "$STAMP" > "$OUT/stamp"
  # the engine that built this graph: the next build, the background refresh above all, starts its search there (see the top)
  printf '%s\n' "$ENGINE" > "$REPO/.axiomcode/engine.new" && mv -f "$REPO/.axiomcode/engine.new" "$REPO/.axiomcode/engine" || true
  if [ -n "$INDEXED_TREE" ]; then echo "$INDEXED_TREE" > "$OUT/indexed-tree"; else rm -f "$OUT/indexed-tree"; fi
  set_base "$INDEXED_TREE"
  if [ -n "$OTHER_LANGS" ]; then S="${SOLVE#*,}"; for l in ${S//,/ }; do echo "$l $MODE"; done > "$PENDING"; fi   # before the pointer: the first query may follow at once
  point "$DB" || { restore; exit 1; }; rm -f "$OUT/.live.sqlite"
  if [ -f "$OUT/.files.json.new" ]; then mv "$OUT/.files.json.new" "$OUT/files.json"; else rm -f "$OUT/files.json"; fi
  set_base_files
  # the graph now matches the files: record how long that took, and whether it included compiling the engine's rules (a
  # one-time cost a refresh does not pay, so such a duration predicts nothing). With other languages still to come this
  # is the time to the MAIN graph, which is what a query waits for.
  printf '%s %s\n' "$((SECONDS - BUILD_T0))" "$(grep -q 'compiling souffle program' "$REPO/.axiomcode/build.log" 2>/dev/null && echo 1 || echo 0)" > "$OUT/build-seconds" 2>/dev/null || true
  keep_base_graph
  # a language the repository no longer has (or that --lang left out) must not keep answering from an old graph
  for d in "$LANGDIR"/*/; do
    [ -d "$d" ] || continue; l="$(basename "$d")"
    case ",$OTHER_LANGS," in *",$l,"*) ;; *) rm -rf "$d" "$REPO/.axiomcode/base/lang/$l";; esac
  done
  commit_base
  rm -rf "$PREV"
  rm -f "$OUT/corrupt" "$OUT/$LANG_ARG/graph.sqlite.corrupt"* "$LANGDIR"/*/out/graph.sqlite.corrupt*   # a sound graph replaced what was quarantined
  MAIN_DONE=1; PUBLISHING=""
  # the languages still unsolved are named in $OUT/partial: the graph is not up to date while it is there, so the next
  # build (a refresh the next query starts, or an index) builds them rather than calling the file table current
  if [ -n "$SIG" ]; then
    [ -s "$PENDING" ] && cut -d' ' -f1 "$PENDING" > "$OUT/partial"
    echo "$LANG_ARG graph published at $OUT/graph.sqlite; stopped before the other languages were built"; exit "$SIG"
  fi
  python3 - "$OUT/graph.sqlite" <<'PY'
import sqlite3, sys
rows = sqlite3.connect(sys.argv[1]).execute("SELECT tier, count(*) FROM call_edges GROUP BY tier ORDER BY 2 DESC").fetchall()
w = max([len('tier')] + [len(t) for t, _ in rows])
print(f"{'tier':<{w}}  edges")
for t, n in rows: print(f"{t:<{w}}  {n}")
PY
  python3 "$H/axiomcode-impact" --warm "$REPO" || true   # export the graph's facts now (~9 s on 1,373 files): the first
  # query pays it otherwise, and for the plugin that first query is inside hooks/changes.py's timeout=14, several at once.
  # the query rules: their compile started at the top of the build, detached (a caller's timeout cannot kill it half-way,
  # which cached nothing and repeated on every edit); this only says where it is. A query never waits for it.
  python3 "$H/dl_program.py" --no-wait || true
  [ -n "$BASE_SAVED" ] && AXIOMCODE_GRAPH="$REPO/.axiomcode/base" python3 "$H/axiomcode-impact" --warm "$REPO" >/dev/null 2>&1 || true
  [ -z "$OTHER_LANGS" ] || [ ! -s "$PENDING" ] || echo "$LANG_ARG graph ready at $OUT/graph.sqlite; still building: $(cut -d' ' -f1 "$PENDING" | paste -sd, - | sed 's/,/, /g')"
}
# EVERY OTHER LANGUAGE'S GRAPH, indexed where the engine wrote it and only then moved into place, as the main one is.
# One that did not build is NAMED: its previous graph, if any, keeps answering, and this build says it is behind.
publish_other(){
  local l="$1" LDB="$OUT/$1/graph.sqlite"
  if [ "$2" = ok ] && [ -f "$LDB" ] && AXIOMCODE_INDEX_DB="$LDB" python3 "$H/axiomcode-index" "$REPO"; then
    stamp_meta "$LDB"
    mkdir -p "$LANGDIR/$l/out"; swap "$LDB" "$LANGDIR/$l/out/graph.sqlite" || true   # a rename: atomic
    rmdir "$OUT/$l" 2>/dev/null || true
    READY+=("$l")
    echo "$l: $(tiers "$LANGDIR/$l/out/graph.sqlite")"
    AXIOMCODE_GRAPH="$LANGDIR/$l" python3 "$H/axiomcode-impact" --warm "$REPO" >/dev/null 2>&1 || true
    [ -n "$BASE_SAVED" ] && [ -f "$REPO/.axiomcode/base/lang/$l/out/graph.sqlite" ] && { AXIOMCODE_GRAPH="$REPO/.axiomcode/base/lang/$l" python3 "$H/axiomcode-impact" --warm "$REPO" >/dev/null 2>&1 || true; }
  else FAILED+=("$l"); fi
  DONE="$DONE$l "; unpend "$l"; return 0
}
# one language failing does not cost the others their graphs (the engine solves each on its own): only the MAIN
# language's failure fails the build, and it stops the rest, whose graphs would be dropped with it.
main_failed(){ restore; echo "build failed — the graph that was there is untouched; see $REPO/.axiomcode/build.log"; tail -5 "$REPO/.axiomcode/build.log"; exit 1; }
take(){   # one line of $PROGRESS: <lang> ok|failed [<graph>]
  local l="${1%% *}" st; st="${1#* }"; st="${st%% *}"
  if [ "$l" = "$LANG_ARG" ]; then
    [ "$st" = ok ] || main_failed
    publish_main
    local q; for q in ${QUEUED[@]+"${QUEUED[@]}"}; do publish_other "${q%% *}" "${q#* }"; done; QUEUED=()
  elif [ -n "$MAIN_DONE" ]; then publish_other "$l" "$st"
  else QUEUED+=("$l $st"); fi      # solved before the main one (it never is, but the main graph is published first)
}
drain(){ local n; n="$(wc -l < "$PROGRESS" | tr -d ' ')"; while [ "$SEEN" -lt "$n" ]; do SEEN=$((SEEN + 1)); take "$(sed -n "${SEEN}p" "$PROGRESS")"; done; }
# `running` is sampled BEFORE the drain: a line written just before the engine exited is still read
while :; do
  running=1; kill -0 "$EPID" 2>/dev/null || running=0
  drain
  [ "$running" = 1 ] || break
  sleep 1 || true          # a held signal ends the sleep, not the build
done
ENGINE_RC=0; wait "$EPID" || ENGINE_RC=$?; EPID=""
drain
if [ -z "$MAIN_DONE" ]; then
  # an engine that named nothing (one without --progress, or a run that failed before solving): as before, a failure
  # fails the build unless it was another language's and the main graph is there
  [ "$ENGINE_RC" = 0 ] || { [ -n "$OTHER_LANGS" ] && [ -f "$OUT/$LANG_ARG/graph.sqlite" ]; } || main_failed
  take "$LANG_ARG ok"
fi
# a language the engine never named (the parser found no project of it) did not build, and is named below
for l in ${OTHER_LANGS//,/ }; do
  case "$DONE" in *" $l "*) ;; *) publish_other "$l" ok;; esac
done
rm -f "$PROGRESS" "$PENDING" "$OUT/partial"
if [ ${#FAILED[@]} -gt 0 ]; then
  for l in "${FAILED[@]}"; do
    if [ -f "$LANGDIR/$l/out/graph.sqlite" ]; then echo "⚠️  the $l graph did not build: $l questions are answered from its PREVIOUS graph, which predates this tree; see $REPO/.axiomcode/build.log"
    else echo "⚠️  the $l graph did not build: no query sees this repository's $l code; see $REPO/.axiomcode/build.log"; fi
  done
fi
if [ ${#READY[@]} -gt 0 ]; then
  echo "graph at $OUT/graph.sqlite ($LANG_ARG)$(for l in "${READY[@]}"; do printf ', %s' "$LANGDIR/$l/out/graph.sqlite ($l)"; done)"
else
  echo "graph at $OUT/graph.sqlite"
fi
