// sources restricted to tests and entry points: the two counts a hook shows; transitive callers of everything is all-pairs and is not needed
.decl edge(a:symbol, b:symbol)     .input edge
.decl test(m:symbol)               .input test
.decl entry(m:symbol)              .input entry
.decl src(s:symbol)
src(s) :- test(s).
src(s) :- entry(s).
.decl reach(s:symbol, m:symbol)
reach(s, m) :- src(s), edge(s, m).
reach(s, m) :- reach(s, x), edge(x, m).
.decl tests_reaching(m:symbol, n:number)
tests_reaching(m, n) :- reach(_, m), n = count : { reach(t, m), test(t) }.
.decl entries_reaching(m:symbol, n:number)
entries_reaching(m, n) :- reach(_, m), n = count : { reach(e, m), entry(e) }.
.output tests_reaching
.output entries_reaching
