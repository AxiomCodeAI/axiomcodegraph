{
 "hooks": {
  "PostToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" changes.py",
      "timeout": 25
     }
    ]
   },
   {
    "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" refresh.py",
      "timeout": 5
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "Edit|Write|MultiEdit",
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" changes.py",
      "timeout": 20
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" changes.py",
      "timeout": 25
     }
    ]
   },
   {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" orient.py"
     }
    ]
   },
   {
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" refresh.py",
      "timeout": 5
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" refresh.py",
      "timeout": 5
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.js\" refresh.py",
      "timeout": 5
     }
    ]
   }
  ]
 }
}
