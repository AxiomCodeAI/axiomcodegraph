known_edge	method	probe.Patterns#bare(Node) -> probe.Leaf#render()
known_edge	method	probe.Patterns#bothComponents(Node) -> probe.Leaf#render()
known_edge	method	probe.Patterns#deconstruct(Node) -> probe.Leaf#render()
known_edge	method	probe.Patterns#inSwitch(Node) -> probe.Leaf#render()
known_edge	method	probe.Patterns#inSwitch(Node) -> probe.Other#render()
known_edge	method	probe.Patterns#negated(Node) -> probe.Leaf#render()
known_edge	method	probe.Patterns#nested(Node) -> probe.Leaf#render()
known_edge	record_accessor	probe.Patterns#bothComponents(Node) -> probe.Pair#left()
known_edge	record_accessor	probe.Patterns#bothComponents(Node) -> probe.Pair#right()
known_edge	record_accessor	probe.Patterns#deconstruct(Node) -> probe.Pair#left()
known_edge	record_accessor	probe.Patterns#deconstruct(Node) -> probe.Pair#right()
known_edge	record_accessor	probe.Patterns#inSwitch(Node) -> probe.Pair#left()
known_edge	record_accessor	probe.Patterns#inSwitch(Node) -> probe.Pair#right()
known_edge	record_accessor	probe.Patterns#nested(Node) -> probe.Pair#left()
known_edge	record_accessor	probe.Patterns#nested(Node) -> probe.Pair#right()
