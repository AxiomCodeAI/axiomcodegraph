// ============================================================================
// FRAMEWORK-BEHAVIOR · HTTP ROUTER CHAIN  (what the router does at request time)
//
// config-resolution/http-router-routes.dl says which functions a request runs and in
// what order (middleware_applies). This file adds what follows from running them:
//
//   ctx_key_flow(Setter, Reader, Key)
//       the request context is a keyed store: a function on the chain writes a key
//       (`c.set('user', u)`) and a LATER function on the same chain reads it
//       (`c.get('user')`, `c.var.user`). Neither calls the other; the key ties them.
//
// The context is the FIRST PARAMETER of a function the router calls (a handler or a
// middleware), so `c.get` on anything else (a Map, a cache) is never read here.
// A key that is not a literal or a const is declared, not guessed; a read whose key
// no earlier function on any of its chains sets is declared too: it reads nothing
// the program put there (or something a library middleware did).
// ============================================================================

// the context parameter of a function the router calls
.decl hb_ctx_param(c0:symbol, c1:symbol)
hb_ctx_param(m, p) :- hr_node_fn(_, _, m), param_decl("client", _, "0", _, m, p).
// an expression that is that context
.decl hb_ctx_ref(c0:symbol, c1:symbol)
hb_ctx_ref(e, m) :- hb_ctx_param(m, p), expr_referenced("client", "PARAMETER", p, e).

// `c.set(K, v)` / `c.get(K)`: (function, call, key expression)
.decl hb_set_site(c0:symbol, c1:symbol, c2:symbol)
hb_set_site(m, ce, k) :- call_site("client", "METHOD_CALL", "set", _, r, ce, _), hb_ctx_ref(r, m),
    expr_child("client", ce, "ARGUMENT", "0", k).
.decl hb_get_site(c0:symbol, c1:symbol, c2:symbol)
hb_get_site(m, ce, k) :- call_site("client", "METHOD_CALL", "get", _, r, ce, _), hb_ctx_ref(r, m),
    expr_child("client", ce, "ARGUMENT", "0", k).
rd_demand(k) :- hb_set_site(_, _, k).
rd_demand(k) :- hb_get_site(_, _, k).

// (function, key, site)
.decl hb_set_at(c0:symbol, c1:symbol, c2:symbol)
hb_set_at(m, key, ce) :- hb_set_site(m, ce, k), rd_val(k, key), !contains("{}", key).
.decl hb_get_at(c0:symbol, c1:symbol, c2:symbol)
hb_get_at(m, key, ce) :- hb_get_site(m, ce, k), rd_val(k, key), !contains("{}", key).
// `c.var.K`
hb_get_at(m, key, e) :- property_access_name(e, key), expr_child("client", e, "RECEIVER", _, v),
    property_access_name(v, "var"), expr_child("client", v, "RECEIVER", _, c), hb_ctx_ref(c, m).
.decl hb_set(c0:symbol, c1:symbol)
hb_set(m, key) :- hb_set_at(m, key, _).
.decl hb_get(c0:symbol, c1:symbol)
hb_get(m, key) :- hb_get_at(m, key, _).
// source order of a site inside its function
.decl hb_site(c0:symbol)
hb_site(e) :- hb_set_at(_, _, e).
hb_site(e) :- hb_get_at(_, _, e).
.decl hb_pos(c0:symbol, c1:number, c2:number)
hb_pos(e, to_number(l), to_number(c)) :- hb_site(e),
    ts_expression(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, l, c, _, _, _, _, _, _, _, _, _, _, _, e).
.decl hb_set_before_get(c0:symbol, c1:symbol)
hb_set_before_get(m, key) :- hb_set_at(m, key, s), hb_get_at(m, key, g), hb_pos(s, sl, sc), hb_pos(g, gl, gc),
    (sl < gl ; sl = gl, sc < gc).
framework_undetermined(m, "ctx_key", "dynamic_ctx_key") :- hb_set_site(m, _, k), rd_val(k, key), contains("{}", key).
framework_undetermined(m, "ctx_key", "dynamic_ctx_key") :- hb_get_site(m, _, k), rd_val(k, key), contains("{}", key).

// positions on one chain: (handler, verb, path, function, position); the handler last
.decl hb_chain(c0:symbol, c1:symbol, c2:symbol, c3:symbol, c4:number)
hb_chain(h, vv, p, mw, to_number(pos)) :- middleware_applies(mw, h, vv, p, pos, _).
hb_chain(h, vv, p, h, 100000) :- http_route(h, vv, p, _, _).

// ctx_key_flow(Setter, Reader, Key) — on some route's chain, Setter runs before Reader
// (or is Reader) and writes the context key Reader reads.
ctx_key_flow(s, r, key) :- hb_set(s, key), hb_get(r, key), hb_chain(h, vv, p, s, i), hb_chain(h, vv, p, r, j), i < j.
ctx_key_flow(s, s, key) :- hb_set_before_get(s, key), hb_chain(_, _, _, s, _).

framework_undetermined(r, "ctx_key", "no_setter_on_chain") :- hb_get(r, key), hb_chain(_, _, _, r, _),
    !hb_read_served(r, key).
.decl hb_read_served(c0:symbol, c1:symbol)
hb_read_served(r, key) :- ctx_key_flow(_, r, key).
