// ============================================================================
// CALL-EDGE-GEN · ACCESSOR INVOCATIONS  (a property access that is really a call)
//
// `get url(): string { return this.raw.url }`, read everywhere as `c.req.url`. The
// runtime invokes the getter at the access, and expr-type.dl already pins the exact
// member (property_access_getter feeds expr_type / expr_shape / expr_element_type). But
// the access is not a ts_call_site, so it never reached callee resolution and never
// became an edge: every accessor in a project had zero callers, a reverse closure from
// one found nothing, and breaking the most-read member of a codebase failed 17 test
// files that the graph said could not reach it (#703).
//
// THE MODEL, the one Python already uses for @property: an EDGE without being a SITE.
// The author wrote no call, the parser emits no ts_call_site, and the coverage guard's
// denominator is the parser's list, so these rows are added to the graph and not to
// invocation_site. The kind says which half of the protocol ran:
//   PROPERTY_READ    the getter: any read of the member, including the callee of
//                    `obj.prop()` (the getter runs before the result is called)
//   PROPERTY_WRITE   the setter: the member as the target of an assignment
// A compound assignment (`a.x += 1`) and an update (`a.x++`) read and then write, so
// they carry both. A plain assignment (`a.x = v`) writes only, and a getter-only member
// on its left side is a read that never happens, which is why property_write_only
// gates the read rule.
//
// Tiered by target count like every other edge (call_chain.dl's vocabulary): one
// target is known_edge, a fan across merged declarations or subclass overrides is
// multi_inferred, a library accessor is boundary_lib. The caller is the enclosing
// function of the ACCESS, by expr_enclosing_method, since there is no call site to
// attribute through.
//
// STRATIFICATION: a leaf. Reads property_access_getter (in the expr_type fixpoint) and
// base facts; feeds nothing back. The negation on property_write_only is over base
// facts only.
// ============================================================================

// ── the write positions ─────────────────────────────────────────────────────
// the member is the LEFT_OPERAND of an assignment, or the operand of ++ / --
assignment_kind("ASSIGNMENT_EXPRESSION").
assignment_kind("COMPOUND_ASSIGNMENT").
update_operator("++").
update_operator("--").
property_written(e) :- expr_kind("client", "PROPERTY_ACCESS", "LEFT_OPERAND", e),
    expr_child("client", asg, "LEFT_OPERAND", _, e),
    expr_kind("client", ak, _, asg),
    assignment_kind(ak).
property_written(e) :- expr_kind("client", "PROPERTY_ACCESS", "UNARY_OPERAND", e),
    expr_child("client", u, "UNARY_OPERAND", _, e),
    expr_kind("client", "UNARY_EXPRESSION", _, u),
    expr_operator("client", op, u),
    update_operator(op).
// a plain assignment: the old value is never read
property_write_only(e) :- expr_kind("client", "PROPERTY_ACCESS", "LEFT_OPERAND", e),
    expr_child("client", asg, "LEFT_OPERAND", _, e),
    expr_kind("client", "ASSIGNMENT_EXPRESSION", _, asg).

// ── property_access_setter(AccessExpr, SetterMethod) ────────────────────────
// The setter counterpart of expr-type.dl's property_access_getter: the same member
// lookup on the receiver's type, keyed on methodKind SETTER, at a write position.
property_access_setter(e, m) :- property_written(e),
    property_access_name(e, n),
    expr_child("client", e, "RECEIVER", _, q),
    expr_type(q, _, qt),
    method_in_scope(qt, n, "false", m),
    method_kind(_, "SETTER", _, m).
property_access_setter(e, m) :- property_written(e),
    property_access_name(e, n),
    expr_child("client", e, "RECEIVER", _, q),
    expr_static_type(q, _, qt),
    method_in_scope(qt, n, "true", m),
    method_kind(_, "SETTER", _, m).

// ── accessor_invocation(AccessExpr, Method, Kind) ───────────────────────────
accessor_invocation(e, m, "PROPERTY_READ") :- property_access_getter(e, m),
    !property_write_only(e).
accessor_invocation(e, m, "PROPERTY_WRITE") :- property_access_setter(e, m).

// ── tier, per access and half of the protocol ───────────────────────────────
accessor_target_count(e, k, n) :- accessor_invocation(e, _, k),
    n = count : { accessor_invocation(e, _, k) }.
accessor_class(e, k, "known_edge") :- accessor_target_count(e, k, 1).
accessor_class(e, k, "multi_inferred") :- accessor_target_count(e, k, n), n >= 2.

// ── the edges ───────────────────────────────────────────────────────────────
call_chain_edge(e, caller, "-", m, "client", cls, k) :- accessor_invocation(e, m, k),
    method_prov(m, "client"),
    expr_enclosing_method(e, caller),
    accessor_class(e, k, cls).
call_chain_edge(e, caller, "-", m, "lib", "boundary_lib", k) :- accessor_invocation(e, m, k),
    method_prov(m, "lib"),
    expr_enclosing_method(e, caller).
