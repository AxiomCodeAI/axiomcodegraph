// ============================================================================
// CONFIG-RESOLUTION · ENTRY POINTS  (who calls the code nothing in the client calls)
//
// This phase is the counterpart of java/engine/config-resolution/, where java's
// entry-points.dl and knobs.dl already live. It is the layer that links EXTERNAL
// behaviour — a framework that invokes a handler, a container that wires a bean, a
// config key that names a class — as distinct from resolution/ (what the language
// itself means) and projections/ (pure column views, no joins). This rule joins three
// relations, so it was never a projection.
//
// WHY THIS EXISTS. Python emitted NO entry_point rows at all — the relation was
// declared nowhere and the bundle adapter did not even read entry-point.csv, while
// Java, TypeScript and JavaScript all did. Measured on two live services (a FastAPI
// pair and a Flask pair, both driven through their real frameworks under the CPython
// oracle): ten declarations that demonstrably RUN — four FastAPI route handlers, two
// Depends() providers, two Flask view functions, a Blueprint view and a CLI command —
// each had zero callers and zero entry-point rows. `impact read_item` answered
// "nothing the graph can see" for a live HTTP route. That is the shape #778 reports.
//
// WHY NOT PORT JAVA'S RULE UNCHANGED. decorators.dl projects py_decorator onto the
// shared annotation_on shape precisely so Java's rules port. For the entry-point rule
// it must NOT be ported on the NAME, because the names are not comparable:
//
//     Java    @GetMapping      distinctive, owned by the framework
//     Python  @router.get      the bare name is `get`
//
// `http_entry_ann("get")` would mark every method decorated with anything called `get`
// — a cached property, a descriptor, a local helper — as an HTTP entry point. Matching
// the bare name is how a by-name match fabricates an answer, so the rule matches the
// DOTTED PATH instead: a receiver, then one of the HTTP verbs, and at least one
// argument (a route decorator always carries its path: `@app.route("/x")`,
// `@router.get("/items/{key}")`). A bare `@get` with no receiver is NOT matched.
// ============================================================================

// ── http_route_deco(DottedPath) ─────────────────────────────────────────────
// `<receiver>.<verb>` — app.route, router.get, bp.post, api.websocket. The verb comes
// from the py_http_route_verb catalogue (config-resolution/knobs.dl); the receiver is not
// constrained beyond existing, because the author names it (app, router, bp, api, v1)
// and pinning that list would miss the next spelling.
//
// THREE CONDITIONS, and each one is load-bearing:
//   a receiver and a dot   a bare `@get` is a descriptor or a local helper, not a route.
//   a catalogued verb      matching the bare name would claim every `@x.get`-decorated
//                          method in the codebase.
//   at least one argument  a route decorator always carries its path: @app.route("/x").
// Measured: 8 matches on two web services, all 8 correct, and 0 matches on 3,799
// decorators of a large non-web subject (pytest.mark.parametrize x914, classmethod x556,
// property x182, dataclass, field_validator) — no false positive.
.decl http_route_deco(dp:symbol)
http_route_deco(dp) :- decorator_text("client", dp, _, argc, _), argc != "0",
    py_http_route_verb(v),
    strlen(dp) > strlen(v) + 1,
    substr(dp, strlen(dp) - strlen(v), strlen(v)) = v,
    substr(dp, strlen(dp) - strlen(v) - 1, 1) = ".".

// ── entry points ────────────────────────────────────────────────────────────

// (a) HTTP handlers — Flask/FastAPI/Starlette register the function with the framework
// and the server invokes it on a request. No client call site reaches it, by design.
// ── http_route_path(DecoratorHash) ──────────────────────────────────────────
// A route registration NAMES A URL PATH, and a URL path begins with "/" (RFC 3986 §3.3
// — a path-absolute is the only form a router accepts). Nothing else about the argument
// is assumed: not its position (`@routes.route("GET", "/x")` puts the verb first), not
// its spelling (`{key}`, `<key>`, `:key` are all path parameters), not its length.
//
// THIS CONDITION IS WHY THE VERB LIST IS SAFE. `patch` is an HTTP method AND the name of
// the stdlib's mock entry point, so `mock.patch` satisfies <receiver>.<verb> exactly.
// MEASURED over five real Python projects: the verb test alone matched 245 decorators of
// which 229 were `@mock.patch("pkg.mod.attr")` — 9.5% precision. Requiring a path argument
// keeps all 24 real routes across three frameworks (a route table, a router, a blueprint)
// and drops all 229. A dotted patch target never starts with "/".
.decl http_route_path(deco:symbol)
http_route_path(d) :- annotation_arg("client", _, v, _, _, "false", d, _),
    strlen(v) > 0, substr(v, 0, 1) = "/".

entry_point(m, "http") :- decorator_target("client", _, m, h),
    decorator_text("client", dp, _, _, h), http_route_deco(dp), http_route_path(h).

// Only the HTTP rule is written here. A `__main__` guard and a CLI command are also
// entry points, but neither was MEASURED on a subject yet, and an unmeasured rule is how
// a fabricated edge gets in. They belong in a follow-up with their own numbers.

// ── entry_reachable(Method) ─────────────────────────────────────────────────
// Declared for Python (graph/bundle/languages.ts) and never derived here, so every
// consumer reading it for liveness sees "everything is dead" regardless of how many
// entry points the graph has (#1122). Same two clauses as TypeScript/JavaScript's
// (call-edge-generation/call_chain.dl): root every entry point, then walk client call
// edges. callee != "-" excludes the sentinel call_chain_edge writes for a site that
// resolved to nothing (boundary_lib, ambiguous_unknown, ...) -- those are not a method.
method_call_edge(caller, callee) :- call_chain_edge(_, caller, _, callee, "client", _, _),
    callee != "-".

entry_reachable(m) :- entry_point(m, _).
entry_reachable(callee) :- entry_reachable(caller), method_call_edge(caller, callee).
// (b) gRPC servicer methods — `add_<Svc>Servicer_to_server(MyServicer(), server)` hands the
// object to grpc, which invokes the method on a request. No client call site reaches it, exactly
// as for an HTTP route, and the consequence is worse: a servicer's private helpers are reached
// only THROUGH its rpc methods, so with the rpc methods unrooted the whole server module is dead
// code to the graph. Measured on a subject driven by a RUNNING server (a wrapper records each
// servicer method at invocation): six trigger shapes — unary-unary, unary-stream, stream-unary,
// stream-stream, a second service, and a client with no stub at all — all six ran, and the
// engine linked 0 of 6. #1111.
//
// WHY NOT MATCH THE NAME. `*Servicer` alone would claim any class a codebase happens to call
// `OrderServicer`, and matching `add_*_to_server` call sites would depend on the call resolving,
// which is the thing that is broken. The rule keys on PROVENANCE instead: the base class must be
// declared in a `_pb2_grpc.py` module, which only protoc writes. A hand-written class of that
// name in ordinary source is not matched, and neither is a servicer that subclasses nothing
// generated (duck-typed registration) — that shape is real but unmeasured, and an unmeasured
// rule is how a fabricated edge gets in.
//
// THE SECOND CONDITION IS THE PRECISION GUARD. Only a method the GENERATED BASE ALSO DECLARES is
// an entry point. The base declares exactly the rpc methods of the service, so an override of
// one is rooted and a helper beside it is not: on the subject, `_render` — called by all four
// rpc bodies and by nothing else — correctly stays unrooted and is reached transitively instead.

// ── grpc_servicer_base(TypeHash) ────────────────────────────────────────────
// A generated servicer base: a class whose name ends `Servicer`, declared in a module whose file
// ends `_pb2_grpc.py`. substr offsets are clamped with max(): Souffle inlines a guard written as
// its own relation back into the caller, so an unclamped offset warns once per fact even where
// the guard would have excluded it.
grpc_servicer_base(t) :-
    py_grpc_servicer_suffix(suf),
    py_grpc_generated_module_suffix(msuf),
    type_decl(p, name, _, _, t),
    strlen(name) > strlen(suf),
    substr(name, max(0, strlen(name) - strlen(suf)), strlen(suf)) = suf,
    type_module(p, mod, t),
    module_file(p, path, mod),
    strlen(path) > strlen(msuf),
    substr(path, max(0, strlen(path) - strlen(msuf)), strlen(msuf)) = msuf.

entry_point(m, "grpc") :-
    type_base_resolved("client", sub, _, base),
    grpc_servicer_base(base),
    method_owner("client", sub, m),
    method_decl("client", n, _, _, _, m),
    // a class body is not an rpc: the generated base has a `<classbody>` too, so matching on the
    // name alone rooted `GreeterServicer.<classbody>` and `AdminServicer.<classbody>` as well as
    // the five real rpc methods. The initializer kinds are excluded the way attribute-lookup.dl
    // excludes them.
    method_kind("client", kind, _, m),
    kind != "MODULE_INITIALIZER", kind != "CLASS_INITIALIZER",
    method_owner(_, base, bm),
    method_decl(_, n, _, _, _, bm).
