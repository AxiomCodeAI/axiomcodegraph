// ============================================================================
// RESOLUTION · ANNOTATIONS  (declared types, resolved by NAME and widened by subtyping)
//
// THE MEASUREMENT THAT PUT THIS FILE HERE. The schema's headline is that 68.2% of
// parameters carry no annotation, and the engine was built on that: flow first,
// annotations nowhere. Then a modern typed service went through it —
// `test/python/projects/two-service-fastapi`, 19 files, 206 call sites — and 27 of its 68
// declared unknowns were receivers whose type was WRITTEN DOWN one line above:
//
//     def to_dict(self, obj: Item) -> Payload:        # obj.unit_price() unresolved
//     def subtotal(self, client: InventoryClient):    # client.quote()   unresolved
//     def __init__(self, store: ItemStore):           # self.store.get() unresolved
//
// 107 of that project's 193 parameters are annotated, and EVERY cross-service seam is.
// The 68.2% is a corpus average over projects of mixed vintage; the annotated tail is
// where dependency-injected service code lives, and it was the single largest gap.
//
// ── A DECLARED TYPE IS NOT AN EXACT TYPE ─────────────────────────────────────
// `transport: Transport` says the receiver is a Transport OR ANY SUBCLASS. Reading it as
// exact would resolve `self.transport.send(...)` to the abstract method and miss all
// three implementations — unsound in the one direction that matters. So every declared
// type is widened by `declared_dispatch`: the type itself, plus every subclass the
// program actually CONSTRUCTS (RTA, same bound as self-dispatch). On the measured project
// that turns `Transport.send` into a sound 3-element set and `handlers:
// InventoryHandlers` (no subclasses) into a single known_edge — the width tracks the
// hierarchy rather than the name.
//
// ── RESOLVED BY NAME, NOT BY THE PARSER'S FK ─────────────────────────────────
// `py_type_reference.referencedTypeLinkHash` is populated for every in-repo annotation on
// the measured project, and it is deliberately NOT the primary source: it is run-local,
// so it cannot cross into the library IR. The engine resolves the annotation's base name
// in the annotated declaration's own module — types declared there plus types imported
// there — which is the same mechanism that will work against a library. The FK is kept as
// `annotation_agrees` / `annotation_differs` so the two are comparable.
// ============================================================================

// ── type_name_in_module(Prov, ModuleHash, Name, TypeHash) ────────────────────
// What a bare type name means INSIDE one module: a class declared there, or a class
// imported there at module level. This is the whole of annotation resolution, and it is
// scope-correct rather than global — which is what keeps `Item` in two different modules
// from collapsing into one answer.
type_name_in_module(p, mod, n, t) :- module_member_type(p, mod, n, t).
type_name_in_module(p, mod, n, t) :-
    module_init(p, _, modScope, mod),
    import_scope(p, modScope, mod, i),
    import_decl(p, _, _, n, i),
    import_binding(p, b, i),
    import_binds_type(p, b, t).

// ── type_name_in_module_lib(ClientModuleHash, Name, LibTypeHash) ─────────────
// THE SAME LOOKUP, ACROSS THE BOUNDARY. A client module that imports a LIBRARY class:
// `from tlib import Square` makes the bare name `Square` mean a staged library type
// inside that module, and every annotation in it is entitled to that meaning.
//
// PROVENANCE IS MIXED ON PURPOSE, and this is the Java convention rather than an
// invention: java/engine/resolution/type-resolution.dl writes
//   type_resolves_in_file("client", name, fp, t) :- java_import(...), java_type(...)
//   type_resolves_in_file("lib",    name, fp, t) :- java_import(...), lib_type(...)
// — the import is always client-side and the TAG names where the TYPE came from. The
// two clauses sit next to each other in the layer that owns the semantics. Python had
// only the client half, which is why a parameter annotated with a library class got no
// type at all while the identical annotation on a local class resolved.
//
// A SEPARATE RELATION rather than a "lib"-tagged row in type_name_in_module, because
// every existing consumer joins that relation prov-UNIFORMLY (method and type share
// one variable). Widening it in place would silently let a client module read a
// library module's members. The split keeps the client path exactly as it was, which
// is the no-second-resolution-path requirement.
type_name_in_module_lib(mod, n, t) :-
    module_init("client", _, modScope, mod),
    import_scope("client", modScope, mod, i),
    import_decl("client", _, _, n, i),
    import_binding("client", b, i),
    import_links_lib_type(b, t).

// ── declared_dispatch(Prov, DeclaredType, PossibleRuntimeType) ───────────────
// The declared type itself, plus every CONSTRUCTED subclass. Bounded by RTA, so an
// abstract base with twelve implementations of which two are built fans to three, not
// thirteen. The closed-world assumption is the same one self-dispatch makes and is
// recorded the same way.
declared_dispatch(p, d, d) :- type_decl(p, _, _, _, d).
declared_dispatch(p, d, s) :- type_subclass(p, d, s), type_instantiated_reachable(p, s).

// ── param_declared_type_by_parser / annotation cross-check ───────────────────
// The parser's own answer for the same parameter, via the METHOD_PARAM type reference
// whose owner is this parameter.
param_declared_type_by_parser(p, ph, t) :-
    type_ref_owner(p, ph, "METHOD_PARAM", r),
    type_ref(p, _, "METHOD_PARAM", _, _, r),
    type_ref_resolved(p, t, r).

// ============================================================================
// ANNOTATIONS ARE RESOLVED FROM py_type_reference, AND ONLY FROM THERE (issue #47)
//
// There used to be a second route: the ENTITY columns -- parameterBaseType,
// fieldBaseType, returnTypeName. The first two are the annotation truncated at the first
// `[`, so they keep the quote characters of a PEP 484 string forward reference and leave
// a leading quote unbalanced when the annotation was also subscripted; returnTypeName is
// not truncated at all, so the three were not even the same kind of value.
//
// py_type_reference has none of that. typeName arrives ALREADY UNQUOTED, the kind is
// stated outright (NAME / STRING_FORWARD_REF / OPTIONAL / SUBSCRIPT / UNION_PEP604 ...)
// rather than inferred from punctuation, and a quarter of references carry a resolved FK
// that needs no name matching at all. So: take the FK where the parser has one, otherwise
// look up the CLEAN name.
//
// #47 ASKED FOR THE ENTITY ROUTE TO GO AND IT COULD NOT, UNTIL NOW. One annotation
// spelling reached the engine through the entity columns alone:
//
//     Payload[str] | None      kind=UNKNOWN   no children   typeName EMPTY
//
// A PEP 604 union was decomposed only while every operand was a bare name; give one
// operand a subscript and the whole reference collapsed. Truncating at the first `[` was
// then the only thing that yielded `Payload`, which made the entity route load-bearing
// for that one shape and for the parameter and field positions only -- the return
// position, whose column is untruncated, had no fallback at all and was a declared miss.
//
// AxiomCodeAI/parser#148 fixed it: the union now arrives as UNION_PEP604 with a
// GENERIC_ARGUMENT child per operand, the subscripted operand as a SUBSCRIPT child
// carrying its own resolved FK, in all three positions. So annotation_optional_kind sees
// it, type_ref_element takes the head off the FK, and the entity route has nothing left
// to contribute. Deleted, and f35_generic_union is the guard: all three of its positions
// resolve on this route alone, including the return case that used to be marked miss.
// ============================================================================

field_declared_type_by_parser(p, f, t) :-
    type_ref_owner(p, f, "FIELD", r),
    type_ref(p, _, "FIELD_TYPE", _, _, r),
    type_ref_resolved(p, t, r).

// ── (1) the parser's own resolved link, where it has one ─────────────────────
param_declared_type(p, ph, t)          :- param_declared_type_by_parser(p, ph, t).
method_declared_return_type(p, m, t)   :- method_declared_return_type_by_parser(p, m, t).
field_declared_type(p, f, t)           :- field_declared_type_by_parser(p, f, t).

// ── (2) otherwise the CLEAN name, looked up in the owning module ─────────────
// Same lookup as the entity-table clauses, keyed on the column that does not carry
// quotes. NAME and STRING_FORWARD_REF only: a SUBSCRIPT or a UNION names no single type
// and is served by the element/Optional rules instead.
annotation_single_name_kind("NAME").
annotation_single_name_kind("STRING_FORWARD_REF").

param_declared_type(p, ph, t) :-
    type_ref_owner(p, ph, "METHOD_PARAM", r),
    type_ref(p, k, "METHOD_PARAM", tn, _, r), annotation_single_name_kind(k), tn != "",
    annotation_owner_module(p, ph, "METHOD_PARAM", mod),
    type_name_in_module(p, mod, tn, t).
method_declared_return_type(p, m, t) :-
    type_ref_owner(p, m, "METHOD", r),
    type_ref(p, k, "METHOD_RETURN", tn, _, r), annotation_single_name_kind(k), tn != "",
    method_module(p, mod, m),
    type_name_in_module(p, mod, tn, t).
field_declared_type(p, f, t) :-
    type_ref_owner(p, f, "FIELD", r),
    type_ref(p, k, "FIELD_TYPE", tn, _, r), annotation_single_name_kind(k), tn != "",
    annotation_owner_module(p, f, "FIELD", mod),
    type_name_in_module(p, mod, tn, t).

// ── (3) and the LIB twins, on the same clean name ────────────────────────────
// The client/library boundary needs this as much as the client side does: a quoted
// annotation naming a LIBRARY class was resolved only by the quote-stripping that this
// change removes. f10_forward_refs caught the omission -- the two cases that name a
// library class went MISSED while every client-side case still passed.
param_declared_type_lib(ph, t) :-
    type_ref_owner("client", ph, "METHOD_PARAM", r),
    type_ref("client", k, "METHOD_PARAM", tn, _, r), annotation_single_name_kind(k), tn != "",
    annotation_owner_module("client", ph, "METHOD_PARAM", mod),
    type_name_in_module_lib(mod, tn, t).
method_declared_return_type_lib(m, t) :-
    type_ref_owner("client", m, "METHOD", r),
    type_ref("client", k, "METHOD_RETURN", tn, _, r), annotation_single_name_kind(k), tn != "",
    method_module("client", mod, m),
    type_name_in_module_lib(mod, tn, t).

// ── ELEMENT TYPES — `List[Item]`, `Dict[str, Item]`, `Optional[Item]` ─────────
// The GENERIC_ARGUMENT children of a subscripted annotation. This is what iterating a
// container yields, and without it `for line in self.lines` types nothing — which on the
// measured project cost every `line.subtotal(...)` edge, i.e. the whole order-total chain.
//
// The LAST generic argument is taken for a mapping (`Dict[str, Item]` iterates keys but
// `.values()` yields Item, and indexing yields Item), and it is the only argument for a
// sequence. Both are emitted; a `Dict[str, Item]` therefore contributes `str` and `Item`,
// which over-approximates iteration and is the safe direction.
type_ref_element(p, parentRef, t) :-
    type_ref_nesting(p, parentRef, _, "1", child),
    type_ref(p, _, "GENERIC_ARGUMENT", _, _, child),
    type_ref_resolved(p, t, child).
// The name-based twin, so the mechanism survives a library boundary.
type_ref_element(p, parentRef, t) :-
    type_ref_nesting(p, parentRef, _, "1", child),
    type_ref(p, _, "GENERIC_ARGUMENT", tn, _, child), tn != "",
    type_ref_owner(p, owner, ok, parentRef),
    annotation_owner_module(p, owner, ok, mod),
    type_name_in_module(p, mod, tn, t).

// ── annotation_owner_module(Prov, OwnerHash, OwnerKind, ModuleHash) ──────────
// The module an annotation was written in, whatever kind of declaration owns it.
annotation_owner_module(p, ph, "METHOD_PARAM", mod) :-
    param_decl(p, _, _, _, m, ph), method_module(p, mod, m).
annotation_owner_module(p, m, "METHOD", mod) :- method_module(p, mod, m).
annotation_owner_module(p, f, "FIELD", mod) :- field_decl(p, _, t, _, f), type_module(p, mod, t).

// ── annotation_container_kind(Kind) — a subscript that is a CONTAINER ────────
// `List[Item]` holds Items; `Optional[Item]` IS an Item (or None). Both are subscripted
// annotations with a depth-1 GENERIC_ARGUMENT child, and treating them alike would type a
// list as its element in one direction and an Item as a container in the other. The
// parser distinguishes them: kind SUBSCRIPT vs kind OPTIONAL, plus isOptional.
annotation_container_kind("SUBSCRIPT").
annotation_optional_kind("OPTIONAL").
annotation_optional_kind("UNION_PEP604").

// ── param_element_type(Prov, ParamHash, TypeHash) ────────────────────────────
// The ELEMENT of a container annotation — what iterating or indexing it yields.
param_element_type(p, ph, t) :-
    type_ref_owner(p, ph, "METHOD_PARAM", r),
    type_ref(p, k, "METHOD_PARAM", _, _, r), annotation_container_kind(k),
    type_ref_element(p, r, t).

// ── Optional[X] IS X ─────────────────────────────────────────────────────────
// `def get(self, key) -> Optional[Order]` returns an Order or None, so `order.total(...)`
// on its result is an Order call. Without this the whole checkout chain on the
// two-service project stopped one hop short — and `Optional[X]` is the most common
// subscript in the measured corpus (3,517 occurrences).
param_declared_type(p, ph, t) :-
    type_ref_owner(p, ph, "METHOD_PARAM", r),
    type_ref(p, k, "METHOD_PARAM", _, _, r), annotation_optional_kind(k),
    type_ref_element(p, r, t).
method_declared_return_type(p, m, t) :-
    type_ref_owner(p, m, "METHOD", r),
    type_ref(p, k, "METHOD_RETURN", _, _, r), annotation_optional_kind(k),
    type_ref_element(p, r, t).
field_declared_type(p, f, t) :-
    type_ref_owner(p, f, "FIELD", r),
    type_ref(p, k, "FIELD_TYPE", _, _, r), annotation_optional_kind(k),
    type_ref_element(p, r, t).

// ── PEP 484 STRING ANNOTATIONS: `-> "Factory"` ───────────────────────────────
// An annotation may be a string so a class can name itself, or name something declared
// later. returnTypeName then holds the source text INCLUDING the quotes, which is
// faithful -- the annotation really is a string literal -- so `"Factory"` never matches
// the class `Factory`.
//
// TWO LAYERS SIT ON TOP OF EACH OTHER HERE and untangling them mattered: the IR is CSV,
// so the field also arrives with RFC4180 escaping applied. Reading the file as TSV made
// the value look doubly quoted and led to the wrong conclusion that the quotes were
// purely a serialisation artefact. Staging now reads RFC4180, which strips that layer;
// this strips the remaining one, which is real Python syntax and the engine's to
// interpret.
//
// A quoted union such as `"str | bytes"` simply fails to match a single name, which is
// the right outcome -- only the bare-name form resolves here.
// Quote normalisation used to live here, because the entity-table columns keep the quotes
// of a PEP 484 string forward reference and so the name never matched. Both it and the
// columns that needed it are gone: py_type_reference.typeName arrives unquoted and
// kind=STRING_FORWARD_REF says so outright. f10_forward_refs is the guard that this is a
// simplification and not a regression.


method_declared_return_type_by_parser(p, m, t) :-
    type_ref_owner(p, m, "METHOD", r),
    type_ref(p, _, "METHOD_RETURN", _, _, r),
    type_ref_resolved(p, t, r).

// ── method_declared_return_element(Prov, MethodHash, TypeHash) ───────────────
// `-> List[Item]`.
method_declared_return_element(p, m, t) :-
    type_ref_owner(p, m, "METHOD", r),
    type_ref(p, k, "METHOD_RETURN", _, _, r), annotation_container_kind(k),
    type_ref_element(p, r, t).

// ── field_declared_type / field_declared_element ─────────────────────────────
// `self._items: Dict[str, Item]` — the field annotation and its payload.
field_declared_element(p, f, t) :-
    type_ref_owner(p, f, "FIELD", r),
    type_ref(p, k, "FIELD_TYPE", _, _, r), annotation_container_kind(k),
    type_ref_element(p, r, t).
