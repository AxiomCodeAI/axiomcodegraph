// ============================================================================
// RESOLUTION · VALUE FLOW  (argument -> parameter, return -> caller, function values)
//
// THE SCHEMA SAYS THIS IS THE PRIMARY MECHANISM, and the measurement is why:
// 68.2% of Python parameters carry NO annotation (30,745 of 45,092), so
// declared-type receiver typing — Java's primary mechanism — covers under a third of
// the language. Argument->parameter flow has to carry the rest, which is also why
// py_call_site records keyword names: without argumentKeywordName the 12,000 keyword
// arguments in the corpus could only be linked positionally and would be lost.
//
// FUNCTIONS ARE VALUES, and unlike Java that is ordinary rather than exotic: a `def`
// returning a `def` is what a decorator IS, a function stored on an attribute is not a
// bound method, and a closure over a parameter is 5.3% of functions. So this file tracks
// two kinds of value with equal weight — INSTANCES (expr_type) and CALLABLES
// (expr_denotes_method) — and keeps them separate, because calling through one
// dispatches and calling through the other does not.
//
// ── WHY expr_names_method IS NOT EXTENDED HERE ────────────────────────────────
// expr_names_method is the pure NAME answer and must stay outside the resolution
// fixpoint: type_base_resolved_by_parser negates type_base_resolved_by_engine, which
// reads expr_names_type, so pulling either into the same SCC as expr_call_candidate
// makes that negation cyclic and souffle refuses the whole program. Value flow
// therefore lands in expr_denotes_method / expr_type, both of which are already inside
// the fixpoint and are never negated from within it.
//
// ── THE CLOSED-WORLD ASSUMPTION, STATED ──────────────────────────────────────
// A parameter's type set is the union over the call sites the engine can see. That is
// sound for an application and an over-approximation-in-the-wrong-direction for a
// library whose callers live elsewhere. Same assumption Java's CHA makes; recorded
// per-parameter in param_flow_assumes_closed_world rather than left implicit.
// ============================================================================

// ── call_flow_imprecise(SiteKey) ─────────────────────────────────────────────
// argFlowIsPrecise=false — the site spreads * or **, so positional
// argument->parameter linking is PROVABLY unsound. Every flow rule below excludes it.
// The schema exists to make this a fact rather than a silent wrong answer, and
// 09-args-forwarding is built entirely out of this shape.
call_flow_imprecise(site) :- csite(site, s), call_arg_flow_imprecise("client", s).

// ── call_arg_offset(SiteKey, CalleeMethodHash, Offset) ───────────────────────
// How many parameter slots the receiver consumes before argument 0 lands. Getting this
// wrong shifts EVERY argument by one, which is exactly what @staticmethod and
// @classmethod change (schema §4.3).
//
// All clauses are POSITIVE. The tempting formulation — "offset 1 unless this is an
// unbound Class.method(obj) call" — negates a relation that lives inside this same
// fixpoint, and souffle will not stratify it. Emitting both offsets where the shape is
// genuinely ambiguous over-approximates the flow, which is the safe direction.
// (a) a receiver-taking method reached through an INSTANCE.
call_arg_offset(site, m, 1) :-
    expr_call_candidate(site, m),
    method_kind("client", "INSTANCE_METHOD", _, m),
    call_recv_type(site, _).
// (b) any other method with a receiver parameter (classmethod, dunder, property getter,
//     constructor) — `cls`/`self` is always bound for these.
call_arg_offset(site, m, 1) :-
    expr_call_candidate(site, m),
    method_receiver_shape("client", "true", _, _, m),
    method_kind("client", k, _, m), k != "INSTANCE_METHOD".
// (c) CONSTRUCTION: `T(x)` calls T.__init__(self, x).
call_arg_offset(site, m, 1) :-
    call_constructs_type(site, t), type_constructor("client", t, m).
// (d) no receiver parameter at all — a module function, a nested def, a lambda, a
//     @staticmethod.
call_arg_offset(site, m, 0) :-
    expr_call_candidate(site, m),
    method_receiver_shape("client", "false", _, _, m).
// (e) the UNBOUND form `Class.method(obj, x)`: the receiver is written as the first
//     argument, so nothing is implicit.
call_arg_offset(site, m, 0) :-
    expr_call_candidate(site, m),
    method_kind("client", "INSTANCE_METHOD", _, m),
    call_receiver_object(site, obj),
    expr_type_class_object("client", obj, _).

// ── param_arg_type(ParamHash, TypeHash) — an INSTANCE reaching a parameter ───
// Positional.
param_arg_type(ph, t) :-
    call_arg_offset(site, m, off),
    !call_flow_imprecise(site),
    call_arg(site, posStr, a),
    param_decl("client", _, ppos, _, m, ph),
    to_number(ppos) = to_number(posStr) + off,
    expr_type("client", a, t).
// By KEYWORD. Position-independent, and the only way a keyword argument links at all.
param_arg_type(ph, t) :-
    expr_call_candidate(site, m),
    !call_flow_imprecise(site),
    call_kwarg(site, kw, a), kw != "",
    param_decl("client", kw, _, _, m, ph),
    expr_type("client", a, t).
// Into a CONSTRUCTOR by keyword.
param_arg_type(ph, t) :-
    call_constructs_type(site, ty), type_constructor("client", ty, m),
    !call_flow_imprecise(site),
    call_kwarg(site, kw, a), kw != "",
    param_decl("client", kw, _, _, m, ph),
    expr_type("client", a, t).

// ── param_arg_method(ParamHash, MethodHash) — a CALLABLE reaching a parameter ──
// `Delegator(target)` puts the FUNCTION `target` into the parameter `fn`. Java would
// need a functional interface for this; in Python it is an ordinary assignment.
param_arg_method(ph, r) :-
    call_arg_offset(site, m, off),
    !call_flow_imprecise(site),
    call_arg(site, posStr, a),
    param_decl("client", _, ppos, _, m, ph),
    to_number(ppos) = to_number(posStr) + off,
    expr_denotes_method("client", a, r).
param_arg_method(ph, r) :-
    expr_call_candidate(site, m),
    !call_flow_imprecise(site),
    call_kwarg(site, kw, a), kw != "",
    param_decl("client", kw, _, _, m, ph),
    expr_denotes_method("client", a, r).
param_arg_method(ph, r) :-
    call_constructs_type(site, ty), type_constructor("client", ty, m),
    !call_flow_imprecise(site),
    call_arg(site, posStr, a),
    param_decl("client", _, ppos, _, m, ph),
    to_number(ppos) = to_number(posStr) + 1,
    expr_denotes_method("client", a, r).

// ── param_flow_assumes_closed_world(ParamHash) ───────────────────────────────
param_flow_assumes_closed_world(ph) :- param_arg_type(ph, _).
param_flow_assumes_closed_world(ph) :- param_arg_method(ph, _).

// ============================================================================
// RETURN FLOW — a function that returns a function
// ============================================================================

// ── method_returns_param(Prov, MethodHash, Position) ─────────────────────────
// `def passthrough(fn): return fn` — the IDENTITY decorator, and the shape that keeps a
// decorated name meaning the `def` written under it. Without this rule @passthrough is
// indistinguishable from @replacing, and one of the two answers is always wrong.
method_returns_param(p, m, pos) :-
    method_return_value_expr(p, m, e),
    expr_names_param(p, e, ph),
    param_decl(p, _, pos, _, m, ph).
// ...and COMPOSED: `return self.filter(name, func, **flags)` returns `func` when filter
// returns the parameter that argument lands on. The registration idiom chains two or
// three of these. Until the return value was restricted to the returned expression
// (call_chain.dl) the shape resolved by accident, because `func` sat INSIDE the return;
// this is the same answer with an argument behind it.
method_returns_param("client", m, q) :-
    method_return_value_expr("client", m, e),
    call_of_expr(e, site),
    expr_call_candidate(site, g),
    method_returns_param("client", g, pos),
    call_arg_offset(site, g, off),
    !call_flow_imprecise(site),
    call_arg(site, argPos, a),
    to_number(pos) = to_number(argPos) + off,
    expr_names_param("client", a, ph),
    param_decl("client", _, q, _, m, ph).
method_returns_param("client", m, q) :-
    method_return_value_expr("client", m, e),
    call_of_expr(e, site),
    expr_call_candidate(site, g),
    method_returns_param("client", g, pos),
    !call_flow_imprecise(site),
    call_kwarg(site, kw, a), kw != "",
    param_decl("client", kw, pos, _, g, _),
    expr_names_param("client", a, ph),
    param_decl("client", _, q, _, m, ph).

// ── binding_value_method(Prov, BindingHash, MethodHash) ──────────────────────
// `adder = make_adder(3)` then `adder(4)`. The binding holds the FUNCTION that
// make_adder returned. Same single-binding guard as the type-valued case: symtable
// itself reports one binding site, so there is no second assignment for the name to
// mean something else.
binding_value_method(p, b, r) :-
    binding_rebinding(p, "1", _, _, b),
    expr_binding(p, b, "STORE", tgt),
    assign_pair(p, tgt, val),
    call_of_expr(val, site),
    expr_call_candidate(site, f),
    method_returns_method(p, f, r).
// `handler = do_work` — a direct function alias.
binding_value_method(p, b, r) :-
    binding_rebinding(p, "1", _, _, b),
    expr_binding(p, b, "STORE", tgt),
    assign_pair(p, tgt, val),
    expr_denotes_method(p, val, r).

// ============================================================================
// FUNCTION-VALUED ATTRIBUTES — `self.op = add`, and calling through it
// ============================================================================

// ── field_holds_method(Prov, FieldHash, MethodHash) ──────────────────────────
// An attribute holding a FUNCTION is NOT a method of the class: no `self` is bound, so
// `self.op(1, 2)` passes 1 and 2 as the first two parameters. Keeping this separate from
// field_type is what makes that distinction survive into argument flow.
field_holds_method(p, f, m) :-
    field_write_value(p, f, val),
    expr_denotes_method(p, val, m).

// ── type_attr_method_value(Prov, TypeHash, Name, MethodHash) ─────────────────
// The same, found through the MRO like any other member.
type_attr_method_value(p, t, n, m) :-
    type_attr_field(p, t, n, f), field_holds_method(p, f, m).

// ── type_attr_class_value(Prov, TypeHash, Name, ClassHash) ───────────────────
// The CLASS-valued twin: `self._row_class = RowIterable`, then
// `self._row_class(self)`. field_type_holds_class recorded the write and nothing read
// it, so the call was neither resolved nor explained (`no_rule`) -- and worse, the
// construction it performs was invisible to argument flow, so the constructor's parameter
// was typed from the OTHER callers alone. With one sibling constructing it directly, that
// is a wrong type rather than a missing one, and every call on the parameter was
// `member_absent_from_type`. A multi-write attribute gives the union, as field_type_union
// does for instances.
type_attr_class_value(p, t, n, c) :-
    type_attr_field(p, t, n, f), field_type_holds_class(p, f, c).

// ── instance_attr_method_value(Prov, TypeHash, Name, MethodHash) ─────────────
// A function ASSIGNED ONTO AN INSTANCE from outside its class (issue #1283):
//
//     def init(inst: Schema, checked: bool):
//         inst._i.parse = lambda x: x + 1
//         inst._i.run = inst._i.parse
//
// The instance attribute shadows the class's `def parse`, so `schema._i.parse(x)` runs
// the lambda. The parser records no py_field row for a write through anything but `self`
// (a foreign write, schema §4.1), so field_holds_method never saw it, and a call through
// the member reached only the class body's `def` -- the assigned functions had no callers.
//
// Keyed on the written-through object's TYPE, as type_attr_method_value is: a call whose
// receiver may be that type may run the assigned function. The write is not ordered
// against the call, so the class's own method stays a candidate and the site is a set,
// never a single edge to the assigned value. `self.x = ...` is left to the field rules,
// which see it with its write count.
instance_attr_method_value(p, t, n, m) :-
    expr_node(p, "ATTRIBUTE_ACCESS", _, n, e), n != "",
    expr_name_context(p, "STORE", e),
    expr_parent(p, e, "ATTRIBUTE_OBJECT", _, obj),
    !expr_node(p, "SELF_REFERENCE", _, _, obj),
    expr_type(p, obj, t),
    assign_pair(p, e, val),
    expr_denotes_method(p, val, m).

// Read back as a VALUE -- the alias `inst._i.run = inst._i.parse` -- the attribute
// denotes what was assigned to it, beside the bound class method expr_denotes_bound_method
// already gives it.
expr_denotes_method(p, e, m) :-
    expr_node(p, "ATTRIBUTE_ACCESS", _, n, e), n != "",
    !expr_name_context(p, "STORE", e),
    !call_callee_expr(_, e),
    expr_parent(p, e, "ATTRIBUTE_OBJECT", _, obj),
    expr_type(p, obj, t),
    instance_attr_method_value(p, t, n, m).

// ── the dispatch envelope: the class member, and a function that may run instead ──
// Basis `value`, as the other front ends record a function held where a member is
// called: flow-derived, not declared.
method_dispatch_candidate(base, m, "value") :-
    instance_attr_method_value(p, t, n, m),
    mro_lookup(p, t, n, base),
    m != base.

// Read as a value -- `k = self._row_class` -- the attribute denotes the class, so a
// call on it or through it resolves like any other class object.
expr_type_class_object(p, e, c) :-
    expr_node(p, "ATTRIBUTE_ACCESS", _, n, e), n != "",
    !expr_name_context(p, "STORE", e),
    expr_parent(p, e, "ATTRIBUTE_OBJECT", _, obj),
    expr_type(p, obj, t),
    type_attr_class_value(p, t, n, c).

// ============================================================================
// THE UNION — what a callee EXPRESSION denotes, name and value flow together
// ============================================================================

// ── expr_denotes_method(Prov, ExprHash, MethodHash) ──────────────────────────
// (a) the static name.
expr_denotes_method(p, e, m) :- expr_names_method(p, e, m).
// (b) a dotted module member.
//     A decorator-replaced def is not what `mod.f` denotes; (g) below follows the chain.
//     expr_attr_names_method itself keeps the def, because the task and decorator rules
//     that read it want the declaration, not the value.
expr_denotes_method(p, e, m) :- expr_attr_names_method(p, e, m), !method_target_replaced(p, m).
// (c) a parameter that some call site put a function into.
expr_denotes_method(p, e, m) :- expr_names_param(p, e, ph), param_arg_method(ph, m).
// (d) a single-binding local or module name holding a function.
expr_denotes_method(p, e, m) :-
    expr_binding(p, b, ctx, e), ctx != "STORE", binding_lookup(p, b, b2), binding_value_method(p, b2, m).
// (e) a decorated name, which denotes whatever the decorator stack returned rather than
//     the `def` written under it (resolution/decorators.dl).
expr_denotes_method(p, e, m) :-
    expr_binding(p, b, ctx, e), ctx != "STORE", binding_lookup(p, b, b2),
    binding_binds_replaced_method(p, b2, def), decorated_name_target(def, m).
// (f) the same decorated name, IMPORTED into another module (#1248). `from pkg.lib import
//     f` binds what pkg.lib's `f` denotes, which is the decorator's output: without this
//     the importer reached the undecorated `def` while a call in pkg.lib itself reached
//     the wrapper.
expr_denotes_method(p, e, m) :-
    expr_binding(p, b, ctx, e), ctx != "STORE", binding_lookup(p, b, b2),
    import_binds_method(p, b2, def), method_target_replaced(p, def),
    decorated_name_target(def, m).
// (g) and reached as a module attribute: `import pkg.lib as lib; lib.f(...)`.
expr_denotes_method(p, e, m) :-
    expr_attr_names_method(p, e, def), method_target_replaced(p, def),
    decorated_name_target(def, m).

// (h) a CALL whose callee returns a function denotes that function: `defer_result(str)`
//     is `decorator`, so `defer_result(str)(func)` calls it. Return flow, not a name match;
//     a factory with two returns gives two targets.
expr_denotes_method("client", e, r) :-
    call_of_expr(e, site),
    expr_call_candidate(site, g),
    method_returns_method("client", g, r).

// ── expr_type from a parameter ───────────────────────────────────────────────
// The duck-typing answer, and the reason it is a DISPATCH SET rather than a guess: the
// set is the union over the arguments actually passed at the call sites the engine
// resolved. `render(Circle())` and `render(Square())` make `thing` a Circle or a Square,
// and `thing.draw()` then has a sound two-element dispatch set — not "every class with a
// method called draw", which is the 24.63-candidates-per-site over-approximation this
// engine refuses.
// param_type, NOT param_arg_type: where the parameter carries a declared annotation that
// annotation is authoritative, and flow may not widen past it. See the note further down.
expr_type(p, e, t) :- expr_names_param(p, e, ph), param_type(ph, t), p = "client".

// ── partial_target(SiteKey, MethodHash) — what a partial will call ───────────
// The callable is argument 0. The remaining arguments are bound, which shifts the
// eventual parameter positions — recorded but not yet propagated, so this produces the
// EDGE without claiming anything about argument flow through it.
partial_target(site, m) :-
    call_is_partial(site),
    call_arg(site, "0", a),
    expr_denotes_method("client", a, m).

// ── a name holding a partial denotes the partial's target ────────────────────
binding_value_method(p, b, m) :-
    binding_rebinding(p, "1", _, _, b),
    expr_binding(p, b, "STORE", tgt),
    assign_pair(p, tgt, val),
    call_of_expr(val, site),
    partial_target(site, m),
    p = "client".

// ── param_arg_class(ParamHash, TypeHash) — a CLASS OBJECT reaching a parameter ─
// Distinct from param_arg_type on purpose: param_arg_type means "an INSTANCE of this
// class arrives here", param_arg_class means "the class ITSELF arrives here". Calling
// through the first dispatches; calling through the second CONSTRUCTS. Conflating them
// turns `cls()` into a method call on an instance.
param_arg_class(ph, t) :-
    call_arg_offset(site, m, off),
    !call_flow_imprecise(site),
    call_arg(site, posStr, a),
    param_decl("client", _, ppos, _, m, ph),
    to_number(ppos) = to_number(posStr) + off,
    expr_type_class_object("client", a, t).

// ── a parameter holding a class object denotes that class ────────────────────
expr_type_class_object("client", e, t) :- expr_names_param("client", e, ph), param_arg_class(ph, t).

// ── binding_value_class(Prov, BindingHash, TypeHash) ─────────────────────────
// `cls = SERIALIZERS[name]` — a single-binding local holding a CLASS OBJECT, which the
// next line CONSTRUCTS. Without this the registry lookup resolved (the subscript knows the
// class) but the name that received it did not, so `cls()` still had no target: the value
// reached the binding and stopped there.
binding_value_class(p, b, t) :-
    binding_rebinding(p, "1", _, _, b),
    expr_binding(p, b, "STORE", tgt),
    assign_pair(p, tgt, val),
    expr_type_class_object(p, val, t).

expr_type_class_object(p, e, t) :-
    expr_binding(p, bref, ctx, e), ctx != "STORE",
    binding_lookup(p, bref, b),
    binding_value_class(p, b, t).

// ── CARRIERS FOR A CLASS OBJECT (issue #57) ──────────────────────────────────
// A class travelling through a value is the registry / plugin / factory shape:
//
//     element_class = REGISTRY.get(kind) or Element
//     return element_class.create(spec)        # and `cls()` inside create
//
// The clauses above already carry a class through a SINGLE-WRITE binding and through a
// dict subscript with a pinned key. What was missing is every other carrier an INSTANCE
// type already has — so a class fell out of the flow at the first `or`, ternary or
// rebinding, and with it went the call on the class, the binding of `cls` inside a
// classmethod, and the construction that classmethod performs. The loss compounds, which
// is why so few links survive the shape.
//
// These mirror the instance-side rules exactly, and stay additive: every site they reach
// resolves to nothing today.

// `Element if flag else Other`, and `REGISTRY.get(k) or Element`.
expr_type_class_object(p, e, t) :-
    expr_node(p, "CONDITIONAL_EXPRESSION", _, _, e),
    expr_parent(p, e, "BODY", _, br), expr_type_class_object(p, br, t).
expr_type_class_object(p, e, t) :-
    expr_node(p, "CONDITIONAL_EXPRESSION", _, _, e),
    expr_parent(p, e, "ORELSE", _, br), expr_type_class_object(p, br, t).
expr_type_class_object(p, e, t) :-
    expr_node(p, "BOOLEAN_OPERATION", _, _, e),
    expr_parent(p, e, "OPERAND_LEFT", _, o), expr_type_class_object(p, o, t).
expr_type_class_object(p, e, t) :-
    expr_node(p, "BOOLEAN_OPERATION", _, _, e),
    expr_parent(p, e, "OPERAND_RIGHT", _, o), expr_type_class_object(p, o, t).

// ── `type[X]` / `Type[X]` HOLDS THE CLASS, not an instance ───────────────────
// The declared spelling of the same idea, and the one a registry's own signature uses
// (`def register(kind: str, cls: type[Element])`). Distinct from every other annotation:
// the parameter holds the CLASS, so it belongs in expr_type_class_object and NOT in
// expr_type — typing it as an instance of X would resolve `cls.create()` to X's
// instance methods, which is the wrong answer rather than a missing one.
annotation_names_a_class("type").
annotation_names_a_class("Type").

expr_type_class_object("client", e, t) :-
    expr_names_param("client", e, ph),
    type_ref_owner("client", ph, "METHOD_PARAM", r),
    type_ref("client", _, "METHOD_PARAM", tn, _, r),
    annotation_names_a_class(tn),
    type_ref_nesting("client", r, _, "1", child),
    type_ref_resolved("client", t, child).

// A name written MORE THAN ONCE takes the union, for the same reason the instance side
// does: a sound set beats a blank, and the tier follows from the target count.
expr_type_class_object(p, e, t) :-
    expr_binding(p, b, ctx, e), ctx != "STORE",
    binding_lookup(p, b, b2),
    binding_rebinding(p, n, _, _, b2), n != "1",
    expr_binding(p, b2, "STORE", tgt),
    assign_pair(p, tgt, val),
    expr_type_class_object(p, val, t).

// ============================================================================
// A DECLARED ANNOTATION IS AUTHORITATIVE — flow may not widen past it
//
// THE BUG THIS FIXES, measured on test/python/projects/two-service-fastapi:
//
//     def to_dict(self, obj: Item) -> Payload:      # ItemSerializer
//         return self.envelope(obj.kind(), ...)
//
// `obj` is annotated `Item`, and param_arg_type handed it Order, RushOrder and GiftOrder
// as well — because both serializers are reached through ONE funnel,
// `serialize(name, obj)`, whose own `obj` is `Any` and receives both items and orders.
// Unioning the annotation with the flow let that imprecision leak THROUGH the
// declaration, so `obj.kind()` inside ItemSerializer resolved to Order.kind. Six spurious
// targets across the two serializers, and the same mistake mirrored in OrderSerializer.
//
// The rule: where the programmer declared a type, THAT is the answer, widened over
// constructed subclasses like any declared type. Flow speaks only where no annotation
// does. A flowed type outside the declaration means the call graph funnels through a
// shared entry point — not that the parameter can hold that type at THIS callee.
//
// WHAT THIS TRADES. Python does not enforce annotations, so a program that genuinely
// violates its own hint loses an edge here. That is a real (small) soundness cost and it
// is recorded rather than absorbed: param_flow_outside_declaration exports every dropped
// pair, so the cost is countable. On this project it drops 6 pairs and recall stays 1.000
// — every one was the funnel, none was a real call.
//
// param_declared_type is derived from annotations alone and sits OUTSIDE the resolution
// fixpoint, so negating it here is stratified — which is what makes "authoritative"
// expressible at all.
// ============================================================================

// ── ONLY A NOMINAL DECLARATION IS AUTHORITATIVE ──────────────────────────────
// A Protocol is a STRUCTURAL constraint: nothing is ever nominally an instance of it, and
// its own members are `...` stubs that can never be call targets. So letting a Protocol
// annotation override flow answers NOTHING where flow had the answer.
//
// MEASURED on test/python/projects/name-collision: `def via_protocol(m: Movable)` calling
// `m.get_distance()`. Treating `Movable` as authoritative resolved it to the Protocol's own
// stub — excluded — and the site went from `Bus.get_distance` to nothing, a REAL missing
// edge. typeCategory=PROTOCOL_TYPE distinguishes the two exactly, so the rule can.
type_is_structural(p, t) :- type_decl(p, _, _, "PROTOCOL_TYPE", t).
param_declared_nominal(p, ph, d) :- param_declared_type(p, ph, d), !type_is_structural(p, d).

// ── param_type(ParamHash, TypeHash) — what a parameter may hold ──────────────
param_type(ph, t) :- param_declared_nominal("client", ph, d), declared_dispatch("client", d, t).
// ── the LIB half, in the layer that owns parameter typing ────────────────────
// A client parameter annotated with a LIBRARY class. declared_dispatch is already
// prov-parametric (annotations.dl) and widens over CONSTRUCTED subclasses on whichever
// side the type lives, so the library half needs no new widening logic -- only the
// declared type, which annotations.dl now resolves. Kept as its own relation because a
// lib type must not flow into client-typed joins unexamined; the boundary consumes it.
param_lib_type(ph, t) :- param_declared_type_lib(ph, d), declared_dispatch("lib", d, t).
param_type(ph, t) :- param_arg_type(ph, t), !param_declared_nominal("client", ph, _).

// ── param_flow_outside_declaration(ParamHash, FlowedType, DeclaredType) ──────
// Flow reached this parameter with a type its annotation does not admit. Each row is one
// edge the declaration suppressed, and a reason to look at the funnel rather than at the
// engine.
param_flow_outside_declaration(ph, f, d) :-
    param_declared_nominal("client", ph, d),
    param_arg_type(ph, f), f != d,
    !type_ancestor("client", f, d).

// ── binding_value_lib_type(BindingHash, LibTypeHash) — LIB half of binding flow ──
// `c = Doubler()` where Doubler is a library class. Beside the client binding flow,
// for the same reason: this file owns what a name holds.
// ── binding_value_lib_type(BindingHash, LibTypeHash) ─────────────────────────
// Same single-binding guard as the client-side rule: symtable reports one binding site,
// so the name cannot be holding anything else.
binding_value_lib_type(b, t) :-
    binding_rebinding("client", "1", _, _, b),
    expr_binding("client", b, "STORE", tgt),
    assign_pair("client", tgt, val),
    call_of_expr(val, site),
    call_constructs_lib_type(site, t).
// ── and from a call that RETURNS a library instance ──────────────────────────
// `f = Factory.from_config(cfg)` -- a factory method, not a constructor. The clause
// above covers `f = Factory(...)` only, so the result of every library factory,
// classmethod-constructor and `-> "Self"` builder was untyped and the next call on it
// went unresolved. Same single-write gate.
binding_value_lib_type(b, t) :-
    binding_rebinding("client", "1", _, _, b),
    expr_binding("client", b, "STORE", tgt),
    assign_pair("client", tgt, val),
    call_of_expr(val, site),
    call_returns_lib_type(site, t).

// ── ANY value the lib layer can type, and EVERY write ────────────────────────
// The two clauses above require the value to be a CALL, so `s = Mid() if flag else Base()`
// -- both library classes -- left the name untyped even though each branch is a
// construction the lib layer already types. Deferring to expr_lib_type covers the ternary
// and `or` shapes without restating what they mean, and dropping the write-count gate
// gives a rebound name the UNION for the same reason the client half does.
binding_value_lib_type(b, t) :-
    expr_binding("client", b, "STORE", tgt),
    assign_pair("client", tgt, val),
    expr_lib_type(val, t).
