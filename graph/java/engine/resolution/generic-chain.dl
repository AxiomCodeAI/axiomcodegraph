// ============================================================================
// Resolution · CHAINED GENERIC RETURN PROPAGATION  (list.iterator().next().m())
//
// The existing type-variable substitution (expr-type.dl) resolves `list.get(0)` when
// the receiver is a DECLARED var (recv_decl_ref) and the callee returns a BARE type
// variable. It misses the chained case: `list.iterator().next()` — because
//   (a) iterator() returns a PARAMETERIZED type Iterator<E> (not a bare E), and
//   (b) next()'s receiver is the iterator() RESULT (a call, not a declared var).
//
// This layer adds an EXPRESSION-LEVEL binding, expr_arg_binding(expr, type, param, arg):
// "expr's inferred type is `type`, with `type`'s parameter `param` bound to `arg`."
//   - seeded from declared receivers (recv_decl_ref + type_arg_binding), and
//   - PROPAGATED through a generic method whose return is a parameterized type carrying
//     the owner's type variable: List<Dog>.iterator() : Iterator<E=Dog> ⇒ Iterator<Dog>.
// The bare-tvar substitution then fires off expr_arg_binding (not just recv_decl_ref), so
// the chained next() (returns Iterator's E) resolves to Dog.
//
// STRATIFICATION: all POSITIVE (expr_arg_binding ⇄ expr_call_candidate is positive mutual
// recursion, like the existing recv_tvar substitution) — no negation added.
//
// lib_type_reference (18): 1 context 5 parentRef 6 position 7 depth 8 name 10 tvarName
//   15 ownerEntity 16 ownerKind 17 uniqueHash
// lib_type_parameter (8): 0 paramName 1 position 6 owner 7 hash
// ============================================================================

// A lib method m whose RETURN is a parameterized type `retType<… ownerTv …>`: retType's
// parameter `retParam` (at position pos) is filled by the owner's type variable `ownerTv`.
// NOTE: get the resolved base return type from lib_method_return_type (lib-hierarchy.dl
// already resolves it by name/context) — NOT lib_type_ref_resolves (engine-ii, absent in
// client-only mode) and NOT a raw completeTypeName match (the IR stores only the SIMPLE
// name there, e.g. "Iterator", so it won't match lib_type's qualifiedName). The return
// base ref is used only to reach the depth-1 type-argument.
// lib_type_reference (18): 1 context 5 parentRef 6 pos 7 depth 10 tvarName 15 owner
//   16 ownerKind 17 uniqueHash.  lib_type_parameter (8): 0 name 1 pos 6 owner.
lib_method_ret_param(m, retType, retParam, ownerTv) :-
    lib_method_return_type(m, retType),
    lib_type_reference(_, "METHOD_RETURN", _, _, _, _, _, "0", _, _, _, _, _, _, _, m, "METHOD", retRef),
    lib_type_reference("TYPE_VARIABLE", _, _, _, _, retRef, pos, "1", _, _, ownerTv, _, _, _, _, _, _, _),
    lib_type_parameter(retParam, pos, _, _, _, _, retType, _).

// ── expr_arg_binding(Expr, Type, Param, Arg) ──
// (base) a declared receiver's written type arguments.
expr_arg_binding(recv, bt, param, arg) :- recv_decl_ref(recv, ref, _),
    type_arg_binding(ref, bt, param, arg).
// (base, library side) the same, for arguments WRITTEN on a library reference — a lib method's
// return type such as `Box<Pair<K,V>>`. Sound to key on the reference: the argument is written
// there, so it is the same fact at every call site, unlike one inferred from a call.
expr_arg_binding(recv, bt, param, arg) :- recv_decl_ref(recv, ref, _),
    lib_type_arg_binding(ref, bt, param, arg).
// (propagate) recv : owner<ownerTv=arg>; call = recv.m(); m returns retType<ownerTv> ⇒
// call : retType<retParam = arg>.
expr_arg_binding(call, retType, retParam, arg) :- call_site(call, _, recv),
    expr_arg_binding(recv, _, ownerTv, arg),
    applicable_candidate(call, callee),
    lib_method_ret_param(callee, retType, retParam, ownerTv).

// (through a bare type variable) `entries().get(0).value()` — `get` returns Box's element E, not a
// parameterised type, so the propagate clause has nothing to substitute into and the chain stopped.
// The receiver binds E to a type that CARRIES ITS OWN arguments (E = Pair<String,Widget>), so the
// call's value is that type, and it keeps that type's bindings.
expr_arg_binding(call, nested, np, arg) :- call_site(call, _, recv),
    applicable_candidate(call, callee),
    lib_method_ret_tvar(callee, owner, tv),
    expr_arg_binding(recv, owner, tv, nested),
    expr_arg_binding(recv, nested, np, arg).

// (for-each variable) `for (var e : map.entrySet()) e.getValue()` — the loop variable is a LOCAL
// with no initializer expression, so the var-local clause below cannot see it; its bindings are
// the ITERABLE's element bindings. Same per-expression key, same method scoping.
expr_arg_binding(recv, bt, param, arg) :-
    java_expression(_, _, _, _, _, _, _, _, _, _, name, _, _, _, "LOCAL_VARIABLE", _, _, _, _, _, _, _, _, _, recv),
    expr_ultimate_method("client", recv, m),
    java_local_variable(name, _, _, _, _, _, _, _, _, _, _, _, _, m, _, _, _, _, local),
    foreach_iterable(local, iterExpr),
    expr_arg_binding(iterExpr, bt, param, arg).

// (nested return argument) `map.entrySet()` : Set<Entry<K,V>> — the element type is itself
// parameterised, and ITS parameters are the receiver's, one level further down. The propagate
// clause above only reaches a return argument that is a bare type variable (`Iterator<E>`), so
// `e.getValue()` after an entrySet had nothing bound for V. Same shape, same per-expression key.
expr_arg_binding(call, nested, nestedParam, arg) :- call_site(call, _, recv),
    expr_arg_binding(recv, _, ownerTv, arg),
    applicable_candidate(call, callee),
    lib_ret_nested_param(callee, nested, nestedParam, ownerTv).

// (var local) `var it = xs.iterator(); it.next()` — the receiver is a LOCAL, so the two clauses
// above never reach it: the base clause needs a declared reference carrying written arguments, and
// `var` writes none, while the propagate clause keys on the call expression, not on the variable
// the call was assigned to. The initializer expression already carries the fully substituted
// bindings, so the local's receiver uses simply inherit them.
//
// KEYED BY EXPRESSION, deliberately. The obvious shortcut — deriving type_arg_binding against the
// callee's RETURN REFERENCE — is wrong: a library method has exactly one return-type reference
// shared by every call site in the program, so a binding inferred at one site is then read by
// every other call of that method. Measured: doing it that way retyped a `String` parameter as
// `List` in an unrelated class and lost the correct `write(String,int,int)` overload. expr_arg_binding
// is per-expression, which is what makes the propagation sound.
//
// Scoped to the enclosing method (expr_ultimate_method) so a name is matched against the local of
// the method it actually appears in — same guard the recv_decl_ref clauses in expr-type.dl use.
// java_expression (25): 11 name 15 referenceKind 25 hash.  java_local_variable (19): 1 name 14 method 19 hash.
expr_arg_binding(recv, bt, param, arg) :-
    local_use_init(recv, initExpr),
    expr_arg_binding(initExpr, bt, param, arg).

// ── INHERITED generics with a CONCRETE super-arg (c9): `class DogBox extends Box<Dog>`.
// super_tvar_rename (type-arg-binding.dl) climbs type-VARIABLE renames; this is the concrete
// counterpart — a subtype that fixes its supertype's parameter to a concrete type. Then ANY
// receiver of that subtype carries the binding (so `new DogBox().get()` → Box.T=Dog → Dog).
// type_super_ref_h(sub, superName, sref) is defined in type-arg-binding.dl (the extends/implements
// reference). Depth-1 arg at the parameter's position, kind != TYPE_VARIABLE (a concrete type).
// java_type_parameter (8): 0 name 1 pos 6 owner.  java_type (14): 0 name 13 hash.
type_fixes_super(sub, super, superParam, argType) :-
    type_super_ref_h(sub, superName, sref),
    type_parent(sub, super),
    java_type(superName, _, _, _, _, _, _, _, _, _, _, _, _, super),
    java_type_parameter(superParam, pos, _, _, _, _, super, _),
    java_type_reference(k, _, _, _, _, sref, pos, "1", _, _, _, _, _, _, _, _, _, argRef),
    k != "TYPE_VARIABLE",
    type_ref_resolves(_, argRef, argType).
type_fixes_super(sub, super, superParam, argType) :-
    type_super_ref_h(sub, superName, sref),
    type_parent(sub, super),
    lib_type(superName, _, _, _, _, _, _, _, _, _, _, _, _, super),
    lib_type_parameter(superParam, pos, _, _, _, _, super, _),
    java_type_reference(k, _, _, _, _, sref, pos, "1", _, _, _, _, _, _, _, _, _, argRef),
    k != "TYPE_VARIABLE",
    type_ref_resolves(_, argRef, argType).
// class_tvar_binding(Type, Super, SuperParam, Arg): as seen from Type, Super's parameter is
// Arg. Seeded by the clause that fixes it, then carried two ways (#1478, #1412):
//   UP, through a supertype that passes its own variable straight on. `ChainStub extends
//   Mid<ChainStub>`, `Mid<S> extends Base<S>`: Mid.S = ChainStub, so Base.S = ChainStub.
//   Binding only the direct parent lost `withTimeout`'s S, declared on Base, and the call
//   after it; one level (`DirectStub extends Base<DirectStub>`) resolved.
//   DOWN, to every subtype of the type that fixed it: a subclass of OrderService inherits
//   Base.M = OrderMapper exactly as OrderService does.
// Bounded by the hierarchy (a finite DAG), and seeded only where a clause writes a concrete
// argument, so a type that passes a variable through adds nothing by itself.
class_tvar_binding(sub, super, superParam, argType) :- type_fixes_super(sub, super, superParam, argType).
class_tvar_binding(sub, super2, p2, argType) :- class_tvar_binding(sub, super1, p1, argType),
    super_tvar_rename(super1, super2, p2, p1).
class_tvar_binding(sub2, super, p, argType) :- class_tvar_binding(sub, super, p, argType),
    type_parent(sub2, sub), sub2 != sub.

// a receiver whose type fixes a supertype parameter carries that binding.
expr_arg_binding(recv, super, superParam, argType) :-
    expr_type(_, recv, subType),
    class_tvar_binding(subType, super, superParam, argType).

// ── THE RECEIVER IS IMPLICIT: an inherited member typed as the superclass's variable (#1412) ──
// `class OrderService extends Base<OrderMapper>` calling `getMapper().findClosed()` or
// `mapper.findOpen()`: the member is Base's, typed M, and the receiver is `this`, which no
// clause above sees because nothing is written at the call. The binding is the enclosing
// type's own, from its extends clause. The field form was worse than unresolved: M, read as
// a class name nothing declares, became an external type and the call a library boundary on
// `external:M` (external-types.dl now refuses a type variable's name).
expr_type(prov, call, argType) :- call_unqualified(call, _),
    applicable_candidate(call, callee),
    java_method_ret_tvar(callee, owner, tv),
    expr_ultimate_type("client", call, encl),
    class_tvar_binding(encl, owner, tv, argType),
    type_prov(argType, prov).
expr_type(prov, call, argType) :- call_unqualified(call, _),
    applicable_candidate(call, callee),
    lib_method_ret_tvar(callee, owner, tv),
    expr_ultimate_type("client", call, encl),
    class_tvar_binding(encl, owner, tv, argType),
    type_prov(argType, prov).

// field_tvar(Field, OwnerType, TypeVariable): a field declared as its owner's type
// variable. The parser writes a field's variable as a CLASS reference carrying the name
// (the TYPE_VARIABLE kind appears in method signatures), so both encodings are read.
// java_type_reference (18): 0 kind 1 context 2 typeRegistryLinkHash 7 depth 8 typeName
//   10 typeVariableName 15 ownerHash 16 ownerKind
field_tvar(field, owner, tv) :- java_field(_, _, _, _, _, _, _, _, owner, _, _, _, _, field),
    java_type_reference("CLASS", "FIELD_TYPE", _, _, _, _, _, "0", tv, _, _, _, _, _, _, field, "FIELD", _),
    java_type_parameter(tv, _, _, _, _, _, owner, _).
field_tvar(field, owner, tv) :- java_field(_, _, _, _, _, _, _, _, owner, _, _, _, _, field),
    java_type_reference("TYPE_VARIABLE", "FIELD_TYPE", _, _, _, _, _, "0", _, _, tv, _, _, _, _, field, "FIELD", _),
    java_type_parameter(tv, _, _, _, _, _, owner, _).
field_tvar(field, owner, tv) :- lib_field(_, _, _, _, _, _, _, _, owner, _, _, _, _, field),
    lib_type_reference("CLASS", "FIELD_TYPE", _, _, _, _, _, "0", tv, _, _, _, _, _, _, field, "FIELD", _),
    lib_type_parameter(tv, _, _, _, _, _, owner, _).
field_tvar(field, owner, tv) :- lib_field(_, _, _, _, _, _, _, _, owner, _, _, _, _, field),
    lib_type_reference("TYPE_VARIABLE", "FIELD_TYPE", _, _, _, _, _, "0", _, _, tv, _, _, _, _, field, "FIELD", _),
    lib_type_parameter(tv, _, _, _, _, _, owner, _).

// a bare inherited field: the enclosing type's binding for its declaring type's variable.
expr_type(prov, e, argType) :- java_expression(_, _, _, _, _, _, _, _, _, _, name, _, _, _, "FIELD", _, _, _, _, _, _, _, _, _, e),
    expr_ultimate_type("client", e, encl),
    type_ancestor(encl, anc),
    java_field(name, _, _, _, _, _, _, _, anc, _, _, _, _, field),
    field_tvar(field, anc, tv),
    class_tvar_binding(encl, anc, tv, argType),
    type_prov(argType, prov).
expr_type(prov, e, argType) :- java_expression(_, _, _, _, _, _, _, _, _, _, name, _, _, _, "FIELD", _, _, _, _, _, _, _, _, _, e),
    expr_ultimate_type("client", e, encl),
    type_ancestor(encl, anc),
    lib_field(name, _, _, _, _, _, _, _, anc, _, _, _, _, field),
    field_tvar(field, anc, tv),
    class_tvar_binding(encl, anc, tv, argType),
    type_prov(argType, prov).
// `this.mapper` / `svc.mapper`: the same, keyed on the qualifier's type.
expr_type(prov, e, argType) :- java_expression("FIELD_ACCESS", _, _, _, _, _, _, _, _, _, name, _, _, _, _, _, _, _, _, _, _, _, _, _, e),
    java_expression(_, "QUALIFIER", _, _, _, _, e, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, q),
    expr_type(_, q, qtype),
    type_ancestor(qtype, anc),
    java_field(name, _, _, _, _, _, _, _, anc, _, _, _, _, field),
    field_tvar(field, anc, tv),
    class_tvar_binding(qtype, anc, tv, argType),
    type_prov(argType, prov).
expr_type(prov, e, argType) :- java_expression("FIELD_ACCESS", _, _, _, _, _, _, _, _, _, name, _, _, _, _, _, _, _, _, _, _, _, _, _, e),
    java_expression(_, "QUALIFIER", _, _, _, _, e, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, q),
    expr_type(_, q, qtype),
    type_ancestor(qtype, anc),
    lib_field(name, _, _, _, _, _, _, _, anc, _, _, _, _, field),
    field_tvar(field, anc, tv),
    class_tvar_binding(qtype, anc, tv, argType),
    type_prov(argType, prov).

// ── A GENERIC METHOD'S OWN VARIABLE, BOUND BY A CLASS LITERAL (#1547) ───────────────────────
// `static <T> T get(Class<T> type)`, called `Beans.get(OrderStore.class).save("a")`: T is the
// METHOD's type parameter, and the only place it is fixed is the argument. Every clause above
// binds a CLASS's parameters from a receiver, so the call had no type and `save` was
// unresolved: the service-locator lookup (`getBean(X.class)`, `getMapper(X.class)`). The
// binding is sound where it applies: the argument IS `Class<X>`, so T is X.
// Only a class literal written at the call binds; a Class-typed variable does not.
mtvar_ret(m, tv) :- java_type_reference("TYPE_VARIABLE", "METHOD_RETURN", _, _, _, _, _, "0", _, _, tv, _, _, _, _, m, "METHOD", _),
    tv != "", java_method_type_parameter(tv, _, _, _, _, _, _, m, _, _).
mtvar_ret(m, tv) :- lib_type_reference("TYPE_VARIABLE", "METHOD_RETURN", _, _, _, _, _, "0", _, _, tv, _, _, _, _, m, "METHOD", _),
    tv != "", lib_method_type_parameter(tv, _, _, _, _, _, _, m, _, _).

// mtvar_class_param(Method, TypeVariable, Position): parameter Position is `Class<TypeVariable>`.
mtvar_class_param(m, tv, pos) :- java_method_parameter(_, pos, m, _, _, _, _, _, _, _, _, _, param),
    java_type_reference(_, "METHOD_PARAM", _, _, _, _, _, "0", "Class", _, _, _, _, _, _, param, "METHOD_PARAM", cref),
    java_type_reference("TYPE_VARIABLE", _, _, _, _, cref, "0", "1", _, _, tv, _, _, _, _, _, _, _).
mtvar_class_param(m, tv, pos) :- lib_method_parameter(_, pos, m, _, _, _, _, _, _, _, _, _, param),
    lib_type_reference(_, "METHOD_PARAM", _, _, _, _, _, "0", "Class", _, _, _, _, _, _, param, "METHOD_PARAM", cref),
    lib_type_reference("TYPE_VARIABLE", _, _, _, _, cref, "0", "1", _, _, tv, _, _, _, _, _, _, _).

// class_literal_type(Expr, Prov, Type): the type a class literal names.
class_literal_type(e, "client", t) :- java_expression("CLASS_LITERAL", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, pqn, _, _, _, _, _, _, e),
    pqn != "", java_type(_, pqn, _, _, _, _, _, _, _, _, _, _, _, t).
class_literal_type(e, "lib", t) :- java_expression("CLASS_LITERAL", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, pqn, _, _, _, _, _, _, e),
    pqn != "", lib_type(_, pqn, _, _, _, _, _, _, _, _, _, _, _, t).
class_literal_type(e, prov, t) :- java_expression("CLASS_LITERAL", _, _, _, _, _, _, _, _, _, name, _, _, _, _, _, _, pqn, _, _, _, _, _, _, e),
    name != "", !type_qname_known(pqn),
    expr_ultimate_type("client", e, encl),
    java_type(_, _, _, _, _, _, _, file, _, _, _, _, _, encl),
    type_resolves_in_file(prov, name, file, t).

expr_type(prov, call, t) :- java_expression("CLASS_LITERAL", "ARGUMENT", _, _, _, _, call, pos, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, lit),
    applicable_candidate(call, callee),
    mtvar_ret(callee, tv),
    mtvar_class_param(callee, tv, pos),
    class_literal_type(lit, prov, t).

// ── NESTED generics (c4): `List<Box<Dog>> l; l.get(0).get()`. type_arg_binding only binds
// TOP-LEVEL (depth-1) args, so the inner Box.T=Dog is lost. arg_ref_at keys on the PARENT
// reference (any nesting depth) to reach a base ref's child argument REFERENCE, so we can
// descend into a parameterized argument. java_type_reference (18): 5 parentRef 6 pos 17 uhash.
arg_ref_at(baseRef, baseType, param, argRef) :- type_ref_resolves(_, baseRef, baseType),
    java_type_parameter(param, pos, _, _, _, _, baseType, _),
    java_type_reference(_, _, _, _, _, baseRef, pos, _, _, _, _, _, _, _, _, _, _, argRef).
arg_ref_at(baseRef, baseType, param, argRef) :- type_ref_resolves(_, baseRef, baseType),
    lib_type_parameter(param, pos, _, _, _, _, baseType, _),
    java_type_reference(_, _, _, _, _, baseRef, pos, _, _, _, _, _, _, _, _, _, _, argRef).

// l : Container<Elem<Arg>>; call = l.m() returns Container's tv (the element); the RESULT
// carries the element type's OWN nested binding (Elem.param = Arg). Two hops down the ref tree:
// recvRef → element ref (Box<Dog>) → its arg (Dog).
expr_arg_binding(call, elemBase, elemParam, elemArg) :- call_site(call, _, recv),
    recv_decl_ref(recv, recvRef, _),
    applicable_candidate(call, callee),
    lib_method_ret_tvar(callee, owner, tv),
    arg_ref_at(recvRef, owner, tv, elemRef),
    arg_ref_at(elemRef, elemBase, elemParam, argRef2),
    type_ref_resolves(_, argRef2, elemArg).
expr_arg_binding(call, elemBase, elemParam, elemArg) :- call_site(call, _, recv),
    recv_decl_ref(recv, recvRef, _),
    applicable_candidate(call, callee),
    java_method_ret_tvar(callee, owner, tv),
    arg_ref_at(recvRef, owner, tv, elemRef),
    arg_ref_at(elemRef, elemBase, elemParam, argRef2),
    type_ref_resolves(_, argRef2, elemArg).

// ── substitution: a call whose callee returns a BARE type variable of `owner`, on a
// receiver bound (owner.tv = arg), types to arg. Generalizes the expr-type.dl rules from
// recv_decl_ref to expr_arg_binding, so CHAINED-call receivers (iterator() result) work.
expr_type(prov, call, arg) :- call_site(call, _, recv),
    expr_arg_binding(recv, owner, tv, arg),
    applicable_candidate(call, callee),
    lib_method_ret_tvar(callee, owner, tv),
    type_prov(arg, prov).
expr_type(prov, call, arg) :- call_site(call, _, recv),
    expr_arg_binding(recv, owner, tv, arg),
    applicable_candidate(call, callee),
    java_method_ret_tvar(callee, owner, tv),
    type_prov(arg, prov).
