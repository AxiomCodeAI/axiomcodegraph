// ============================================================================
// CALL-EDGE-GEN · CLIENT CALL EDGES  (rules)
//
// Resolved call-graph edges out of client call sites, split by whether the callee is
// CLIENT or LIBRARY code. Consumes expr_resolves_to_method (the disambiguated callee
// set) + method_owner (client/lib provenance, methods.dl). Runs in the engine pass —
// it needs those relations. Export directives live separately in export/call-edges.dl.
//
// Row: CallerProv  CallSiteExprHash  CalleeProv  CalleeMethodHash
//   client_calls_client : "client"  callSite  "client"  callee   (client → client)
//   client_calls_lib    : "client"  callSite  "lib"     callee   (client → lib)
// The provenance tags are baked into each row so a row is self-describing, independent
// of which file it lives in. CallerProv is "client" today (all call sites are client
// code); it becomes "lib" once external expansion adds lib call sites.
//
// A call site may resolve to MULTIPLE callees (applicable set / CHA fan-out) → multiple
// rows. Constructors (new Foo(...)) are included — they resolve through the same
// expr_resolves_to_method relation (call site = OBJECT_CREATION node, callee = ctor).
// Roll up a call site to its enclosing caller method (for method→method chains) via
// expr_ultimate_method — kept out of here so this stays the precise per-call-site base.
// ============================================================================

client_calls_client("client", call, "client", callee) :- expr_resolves_to_method(call, callee),
    method_owner("client", _, callee).

// ── LIB-BOUNDARY GATE (FIX-12): emit only the NEAREST library declaration, per call site ──
// method_name_in_type hands callee-resolution EVERY declaration of the name reachable from the
// receiver's type, so one `list.add(x)` produced java.util.List#add AND AbstractList#add AND
// Collection#add AND AbstractCollection#add AND ArrayList#add. Java binds exactly one: the
// declaration NEAREST the receiver's type. Suppress a lib target when another target of the SAME
// call site has the same name+arity and its owner is a PROPER SUBTYPE of this one's owner — i.e.
// this declaration is the inherited copy that nothing binds to.
//
// Applied HERE, at boundary emission, rather than in callee-resolution: method_name_in_type sits
// inside the expr_type <-> expr_call_candidate fixpoint (lookup_type is seeded from expr_type), so a
// negation there is cyclic and souffle refuses to stratify. client_calls_lib is downstream of that
// fixpoint and nothing reads it back, so the negation is legal in this stratum.
//
// Both flow types survive: `List x = new ArrayList<>()` yields receiver types List AND ArrayList,
// so the site's targets are List#add (nearest for List) and ArrayList#add (nearest for ArrayList);
// only the intermediate ancestors (AbstractList, Collection, AbstractCollection) are dropped. A
// GLOBAL most-derived filter would delete List#add too — measured as -0.038 recall / 2,091 correct
// lib edges lost, because bytecode names the interface for an interface-typed receiver.
// lib_method (22): 1 name  18 parameterCount  22 hash
lib_msig(m, name, pc) :- lib_method(name, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, pc, _, _, _, m).
// shadowed FOR ONE receiver type: a nearer declaration of the same name+arity exists below it in
// that receiver's own hierarchy.
// AN OVERLOAD IS NOT A SHADOW. lib_msig keys on (name, parameterCount), so a method declared
// LOWER in the receiver's hierarchy with the same name and arity but DIFFERENT parameter types
// was treated as a nearer declaration of it. `FileWriter.write(aString)` is the shape: the
// applicable target is Writer#write(String), and OutputStreamWriter#write(int) — an overload,
// two hops down, accepting an incompatible type — hid it. Every Writer-declared write was then
// filtered out while only OutputStreamWriter's were kept, none of which overload resolution had
// selected, so the site emitted no edge at all.
//
// A shadowing declaration overrides: same name, same arity AND the same parameter types. Where
// the types differ at any position the two are siblings and both are members of the receiver.
// The polarity is deliberate — failing to shadow keeps an extra target inside the sound
// envelope, while shadowing wrongly DELETES the hand-off, which is the error class that is not
// allowed to happen.

// The candidate pairs, from the narrow body this filter already had.
lib_shadow_cand(call, rt, m, m2) :- lib_recv_target(call, rt, m), method_owner("lib", o, m),
    lib_msig(m, name, pc),
    lib_recv_target(call, rt, m2), m2 != m, method_owner("lib", o2, m2),
    lib_msig(m2, name, pc),
    o2 != o,
    type_ancestor(o2, o).

// ...and whether such a pair differs in signature at some position. SCOPED TO THOSE PAIRS: a
// join over param_decl alone is a cross product across every library method that shares a
// parameter position — on a platform-scale library root that is ~10^10 tuples and the solve is
// OOM-killed. Same reason copruned in overload.dl is scoped to one call and one owner.
lib_shadow_param_differs(m, m2) :- lib_shadow_cand(_, _, m, m2),
    param_decl("lib", _, pos, t1, m, _),
    param_decl("lib", _, pos, t2, m2, _),
    t1 != t2.

lib_shadowed_for(call, rt, m) :- lib_shadow_cand(call, rt, m, m2),
    !lib_shadow_param_differs(m, m2).
// kept when it is the nearest declaration for AT LEAST ONE of the site's receiver types...
lib_target_kept(call, m) :- lib_recv_target(call, rt, m), !lib_shadowed_for(call, rt, m).
// ...and unconditionally when it did not come from a receiver-typed lookup at all (static call,
// constructor, method reference, chained/generic resolution) — those must never be filtered here.
lib_target_kept(call, m) :- expr_resolves_to_method(call, m), method_owner("lib", _, m),
    !lib_recv_target(call, _, m).
client_calls_lib("client", call, "lib", callee) :- expr_resolves_to_method(call, callee),
    method_owner("lib", _, callee),
    lib_target_kept(call, callee).
