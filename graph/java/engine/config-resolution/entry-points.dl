// ============================================================================
// CONFIG-RESOLUTION · CONFIG-DRIVEN ENTRY POINTS
//
// annotation_flow.dl's premise, restated from config: a method the framework calls
// and no client call site calls has NO incoming call_edge, so without an entry_point
// row it looks like a dead root and everything downstream of it is invisible to
// reachability, dead-code and change-impact.
//
// annotation_flow.dl covers the cases decidable from an annotation NAME (main,
// test, http, cli). This file covers the ones that need a config VALUE:
//   web.xml <servlet-class>/<filter-class>/<listener-class>   -> web_servlet/…
//   <bean init-method="start"/>                               -> lifecycle_init
//   @PostConstruct / @PreDestroy                              -> lifecycle_*
//   @Scheduled / @KafkaListener / @JmsListener / …            -> scheduled / queue
//   a config key whose value names a handler class            -> config_handler
//   @Bean factory methods and bean constructors               -> factory / bean_ctor
//
// Same relation and same shape as annotation_flow.dl: entry_point(Method, Kind).
// config_entry_point additionally records the SITE, so a reported entry point can
// be traced back to the line of config that caused it.
// ============================================================================

// ── knob: methods a container invokes BY NAME on a registered class ──────────
// Needed because the servlet/JMS APIs are usually NOT in the analysed library set
// (the JDK IR alone has no javax.servlet), so the "overrides a library method"
// test below finds nothing. Keeping both paths means the rule degrades to this
// name list instead of to silence.
cfg_container_callback_name("init").              cfg_container_callback_name("destroy").
cfg_container_callback_name("service").           cfg_container_callback_name("doFilter").
cfg_container_callback_name("doGet").             cfg_container_callback_name("doPost").
cfg_container_callback_name("doPut").             cfg_container_callback_name("doDelete").
cfg_container_callback_name("doHead").            cfg_container_callback_name("doOptions").
cfg_container_callback_name("contextInitialized").cfg_container_callback_name("contextDestroyed").
cfg_container_callback_name("sessionCreated").    cfg_container_callback_name("sessionDestroyed").
cfg_container_callback_name("onMessage").         cfg_container_callback_name("onEvent").
cfg_container_callback_name("run").               cfg_container_callback_name("call").
cfg_container_callback_name("handle").            cfg_container_callback_name("execute").
// The methods SpringFactoriesLoader's documented extension points are called through,
// for a class a spring.factories key names (services.dl). Kept apart from the list above:
// `initialize` and `analyze` are ordinary names on a servlet or a ServiceLoader provider.
cfg_factories_callback_name("initialize").        cfg_factories_callback_name("onApplicationEvent").
cfg_factories_callback_name("postProcessEnvironment"). cfg_factories_callback_name("analyze").

// cfg_registered_type(TypeHash, Kind): a type the container instantiates because
// config named it. Everything below fans out from here.
cfg_registered_type(t, kind) :- xml_container_class(kind, t, _).
cfg_registered_type(t, "config_handler") :- config_class_ref(fmt, k, _, t, "client"),
    fmt != "annotation", cfg_key_expects_class(k).

// … a type an ANNOTATION registers: @WebServlet / @WebFilter / @WebListener, exactly as
// their web.xml twins; a JPA @Converter; a JAX-RS @Provider (knobs.dl (6b)).
cfg_registered_type(t, kind) :- ann_on_type("client", _, n, t), cfg_registering_type_ann(n, kind).
// … a class an annotation ARGUMENT names, for the arguments that mean "instantiate this":
// @EntityListeners(Audit.class), @Convert(converter = PriceConverter.class). Keyed on the
// annotation AND the argument, so an arbitrary @Foo(Bar.class) still registers nothing.
cfg_registered_type(t, kind) :- ann_arg(prov, a, arg, _, "CLASS_REFERENCE", _),
    cfg_registering_class_arg(n, arg, kind), cfg_ann_name_of(prov, a, n),
    cfg_ann_class_arg(prov, a, arg, t), type_decl("client", _, _, _, _, _, t).
cfg_ann_name_of(prov, a, n) :- ann_on_type(prov, a, n, _).
cfg_ann_name_of(prov, a, n) :- ann_on_field(prov, a, n, _, _).
cfg_ann_name_of(prov, a, n) :- ann_on_method(prov, a, n, _, _).
// … a class registered IN CODE with the servlet container, by a class literal or an
// instance: ctx.addServlet("orders", OrderServlet.class), ctx.addFilter("a", new F()),
// ctx.addListener(L.class). The receiver has to be typed as a registrar (knobs.dl (6b)).
cfg_registered_type(t, kind) :- cfg_servlet_registration(name, kind), call_site(call, name, recv),
    servlet_registrar_recv(recv), call_arg(call, _, arg), registered_arg_type(arg, t).
// … and Spring Boot's new ServletRegistrationBean<>(new OrderServlet(), "/orders").
cfg_registered_type(t, kind) :- cfg_servlet_registration_bean(bn, kind),
    object_creation_named(e, bn), expr_child("client", e, "ARGUMENT", arg),
    registered_arg_type(arg, t).
object_creation_named(e, bn) :- java_expression("OBJECT_CREATION", _, _, _, _, _, _, _, _, _, v, _, _, _, _, _, _, _, _, _, _, _, _, _, e),
    cfg_servlet_registration_bean(bn, _), v = bn.
object_creation_named(e, bn) :- java_expression("OBJECT_CREATION", _, _, _, _, _, _, _, _, _, v, _, _, _, _, _, _, _, _, _, _, _, _, _, e),
    cfg_servlet_registration_bean(bn, _), v = cat(bn, "<>").
// the type an argument hands over: X.class, or new X(..)
registered_arg_type(arg, t) :- java_expression("CLASS_LITERAL", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, q, _, _, _, _, _, _, arg),
    java_type(_, q, _, _, _, _, _, _, _, _, _, _, _, t).
registered_arg_type(arg, t) :- object_creation_type_resolves("client", arg, _, t).
// a receiver typed as ServletContext (or a Jetty handler), whether the type is staged as a
// library or known only by its written name
servlet_registrar_recv(recv) :- recv_type_simple(recv, n), cfg_servlet_registrar_type(n).
// recv_type_simple(Expr, SimpleName): an expression typed by a library or external type of
// that simple name, for the few framework names a rule asks about (typed_simple_demand).
typed_simple_demand(n) :- cfg_servlet_registrar_type(n).
typed_simple_demand(n) :- cfg_jaxrs_client_owner(n).
recv_type_simple(e, n) :- typed_simple_demand(n), lib_type(n, _, _, _, _, _, _, _, _, _, _, _, _, t),
    expr_type("lib", e, t).
recv_type_simple(e, n) :- typed_simple_demand(n), x = cat("external:", n), expr_type("external", e, x).
recv_type_simple(e, n) :- typed_simple_demand(n), expr_type("external", e, x),
    strlen(x) > strlen(n) + 1,
    substr(x, max(0, strlen(x) - strlen(n) - 1), min(strlen(n) + 1, strlen(x))) = cat(".", n).

// (1) callbacks on a registered type — by name …
config_entry_point(m, kind, t) :- cfg_registered_type(t, kind),
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", _, _, _, _, m),
    cfg_container_callback_name(name).
// … and by the per-kind name list (a JPA converter's convertTo*, a JAX-RS provider's filter).
config_entry_point(m, kind, t) :- cfg_registered_type(t, kind),
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", _, _, _, _, m),
    cfg_registered_callback_name(kind, name).
config_entry_point(m, "spring_factories", t) :- cfg_registered_type(t, "spring_factories"),
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", _, _, _, _, m),
    cfg_factories_callback_name(name).
// … and by "overrides something declared in a library supertype", which is what a
// servlet/filter/listener actually is. Independent of the name list, so a container
// API that IS in the library set is covered exactly rather than approximately.
config_entry_point(m, kind, t) :- cfg_registered_type(t, kind),
    type_ancestor(t, libT), lib_type(_, _, _, _, _, _, _, _, _, _, _, _, _, libT),
    lib_method(name, _, _, _, _, _, _, libT, _, _, _, _, _, _, _, _, _, pc, _, _, _, _),
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", pc, _, _, _, m).
// (2) the registered type's constructor — the container calls `new` on it.
config_entry_point(m, kind, t) :- cfg_registered_type(t, kind),
    method_kind("client", "CONSTRUCTOR", _, m), method_owner("client", t, m).

// (3) XML lifecycle callbacks: <bean init-method="start"/> names `start` on the
// bean's class. Looked up through method_name_in_type so an INHERITED init method
// is found too — which is how Spring resolves it.
config_entry_point(m, kind, t) :- xml_lifecycle_method(t, mname, kind),
    method_name_in_type(mname, t, m), method_owner("client", _, m).

// (3b) the annotation twin of (3): @Bean(initMethod = "start", destroyMethod = "stop")
// names `start` and `stop` on the type the @Bean method builds.
config_entry_point(m, kind, fm) :- cfg_factory(prov, a, fm, _), ann_arg(prov, a, arg, mname, _, _),
    cfg_bean_lifecycle_arg(arg, kind), mname != "", cfg_factory_type(fm, t),
    method_name_in_type(mname, t, m), method_owner("client", _, m).

// (4) annotation-driven container callbacks that annotation_flow.dl does not cover.
config_entry_point(m, "lifecycle", m) :- ann_on_method(_, _, n, m, _), cfg_lifecycle_ann(n).
// JPA entity callbacks, on an entity, a mapped superclass or an @EntityListeners class.
config_entry_point(m, "orm_hook", m) :- ann_on_method(_, _, n, m, _), cfg_jpa_callback_ann(n).
// A JAX-RS @QueryParam / @PathParam / … parameter of a client type T: the runtime builds
// it with T.valueOf(String), T.fromString(String) or new T(String).
jaxrs_param_type(t) :- ann_on_param(_, _, n, p, _), cfg_jaxrs_param_ann(n),
    method_param_type_resolves("client", p, _, t).
config_entry_point(m, "framework_hook", t) :- jaxrs_param_type(t),
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, _, "1", _, _, _, m),
    cfg_jaxrs_param_factory(name), string_param_0(m).
config_entry_point(m, "framework_hook", t) :- jaxrs_param_type(t),
    method_kind("client", "CONSTRUCTOR", _, m), method_owner("client", t, m),
    java_method(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, "1", _, _, _, m),
    string_param_0(m).
string_param_0(m) :- java_method_parameter(_, "0", m, _, tn, _, _, _, _, _, _, _, _),
    jaxrs_string_type(tn).
jaxrs_string_type("String"). jaxrs_string_type("java.lang.String").
config_entry_point(m, "scheduled", m) :- ann_on_method(_, _, n, m, _), cfg_scheduled_ann(n).
config_entry_point(m, "queue", m)     :- ann_on_method(_, _, n, m, _), cfg_listener_ann(n).
// … and an ApplicationListener<E> implementation's onApplicationEvent, which Spring calls
// for every matching published event without any annotation on the method (#1391).
config_entry_point(m, "queue", m)     :- event_listener_method(m).
// A listener/scheduler annotation on the TYPE (@KafkaListener on a class, with
// @KafkaHandler methods) registers the type, not one method.
config_entry_point(m, "queue", t) :- ann_on_type(_, _, n, t), cfg_listener_ann(n),
    java_method(_, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", _, _, _, _, m).

// (5) beans the container builds: a @Bean factory method is invoked by the
// container, and a bean class's constructor is invoked by the container. Without
// these, a @Configuration class's whole method set is unreachable.
config_entry_point(m, "factory", m) :- cfg_factory(_, _, m, _).
config_entry_point(m, "bean_ctor", t) :- bean_def(_, t, "stereotype", _),
    method_kind("client", "CONSTRUCTOR", _, m), method_owner("client", t, m).
config_entry_point(m, "bean_ctor", t) :- bean_def(_, t, "xml", _),
    method_kind("client", "CONSTRUCTOR", _, m), method_owner("client", t, m).
// A properties class registered by @EnableConfigurationProperties / a properties scan is
// constructed by the binder (di.dl (d)).
config_entry_point(m, "bean_ctor", t) :- bean_def(_, t, "enabled_properties", _),
    method_kind("client", "CONSTRUCTOR", _, m), method_owner("client", t, m).

// (6) GENERATED-STUB OVERRIDES — the gRPC shape. A method that OVERRIDES one declared
// in a supertype whose simple name matches a stub-base suffix (GreeterImplBase) is
// invoked by the server, never by client code. Keyed on the SUPERTYPE's name because
// the generated class name comes from the .proto and cannot be listed.
// Matching is name + arity against the ancestor's declaration, which is what "overrides"
// means at this layer (resolution/virtual-dispatch.dl uses the same test).
cfg_stub_base(base, kind) :- java_type(name, _, _, _, _, _, _, _, _, _, _, _, _, base),
    cfg_stub_base_suffix(suffix, kind),
    strlen(name) >= strlen(suffix),
    // Clamped, not merely guarded: Soufflé evaluates the functor on pairs the length
    // test rejects, and `substr("Access", -2, 8)` — a six-character type name against
    // the eight-character suffix "ImplBase" — warned 656 times on one real codebase.
    // The answer was always right; the noise could hide a fault that is not.
    substr(name, max(0, strlen(name) - strlen(suffix)), min(strlen(suffix), strlen(name))) = suffix.
config_entry_point(m, kind, t) :- cfg_stub_base(base, kind),
    type_ancestor(t, base),
    java_method(name, _, _, _, _, _, _, base, _, _, _, _, _, _, _, _, _, pc, _, _, _, _),
    name != "",
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", pc, _, _, _, m).
// ...and when protoc ran at build time, the ImplBase is an external type with no declared methods
// to test an override against. The service's own rpc-shaped methods are the handlers
// (framework-behavior/destinations.dl, grpc_ext_handler; #1548).
config_entry_point(m, "grpc_service", t) :- grpc_ext_handler(t, _, _),
    java_method(_, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", _, _, _, _, m),
    grpc_rpc_shaped(m).

// (6b) A REGISTERED type's method marked @Override whose supertype is known only by its
// written name (the framework API is not in the analysed library set): it overrides the
// framework's declaration, so the framework calls it. A JAX-RS ContainerRequestFilter's
// filter(..), an ExceptionMapper's toResponse(..).
config_entry_point(m, kind, t) :- cfg_registered_type(t, kind),
    type_parent(t, x), external_type(x),
    ann_on_method(_, _, "Override", m, t),
    method_kind("client", "INSTANCE_METHOD", _, m).

// (7) A REGISTERED type's overrides, generalised. cfg_registered_type covers web.xml
// and config-named handlers; clause (1) matched a knob name list or a LIBRARY supertype.
// A generated base is neither — it is a CLIENT type in the same project — so an
// override of it was missed. Any override of any ancestor's declaration counts.
config_entry_point(m, kind, t) :- cfg_registered_type(t, kind),
    type_ancestor(t, anc),
    java_method(name, _, _, _, _, _, _, anc, _, _, _, _, _, _, _, _, _, pc, _, _, _, _),
    name != "",
    java_method(name, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, "INSTANCE_METHOD", pc, _, _, _, m).

// ── feed the EXISTING entry_point relation ───────────────────────────────────
// One line. entry_reachable, and everything that reads it, needs no change.
entry_point(m, kind) :- config_entry_point(m, kind, _).
