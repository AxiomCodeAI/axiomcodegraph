// ============================================================================
// CONFIG-RESOLUTION · ANNOTATION ARGUMENTS  (values, not just names)
//
// annotation_flow.dl matches annotation NAMES against three name sets and marks
// entry points. That is the whole of the current use of annotations. The
// ARGUMENTS — 9 columns the parser fills for every `@Foo(bar = Baz.class)` —
// had zero consumers.
//
// This file gives an argument three things it did not have:
//   (a) an ATTACH POINT   which type / field / method / parameter it decorates,
//                         and therefore which .java FILE it can resolve names in
//   (b) a TYPE            CLASS_REFERENCE and FQN-shaped strings become type
//                         hashes, so `@Scheduled`-style class naming is a real edge
//   (c) a SHAPE           arrays (one row per element, shared name, distinct
//                         arrayIndex) and NESTED annotations (a child annotation
//                         whose own arguments are themselves interpreted) are
//                         flattened into relations a rule can join on.
//
// annotation_on(Prov, Name, Kind, Context, OwnerHash, AnnHash)
// annotation_arg(Prov, ParentAnn, ArgName, ArgValue, ValueType, ArrayIndex,
//                RefTypeHash, NestedAnnHash, ArgHash)
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// 1. ATTACH POINTS
// ─────────────────────────────────────────────────────────────────────────────
// The Context column says what the annotation is on; the join against the owner's
// own base relation CONFIRMS it. Both are kept: Context alone is a parser string
// (and a mis-stamped one would silently mis-attribute), the join alone would let a
// hash collision across entity kinds through.
// PROVENANCE. Both columns the projection emits are read, not just "client". A
// dependency supplied with --library is staged annotation for annotation (#136), and
// scoping this file to the application made the whole phase blind to it: an
// auto-configuration library contributed no beans, so every injection point it
// satisfies read `unsatisfied`. The owner join therefore goes through the
// provenance-parameterised projections (type_decl / field_decl / method_owner /
// param_decl) rather than the bare java_* base relations, which only ever hold the
// application's own.
//
// Prov is threaded, never defaulted. A rule that wants one side says so: the DI
// narrowing in di.dl still gates on a CLIENT-typed slot, because that gate is about
// what the analysis can see, not about where the annotation was written.
ann_on_type(prov, a, n, t) :- annotation_on(prov, n, _, "TYPE_DECLARATION", t, a),
    type_decl(prov, _, _, _, _, _, t).
ann_on_field(prov, a, n, f, owner) :- annotation_on(prov, n, _, "FIELD_DECLARATION", f, a),
    field_decl(prov, _, _, owner, f).
ann_on_method(prov, a, n, m, owner) :- annotation_on(prov, n, _, "METHOD_DECLARATION", m, a),
    method_owner(prov, owner, m).
ann_on_method(prov, a, n, m, owner) :- annotation_on(prov, n, _, "CONSTRUCTOR_DECLARATION", m, a),
    method_owner(prov, owner, m).
ann_on_param(prov, a, n, p, m) :- annotation_on(prov, n, _, "PARAMETER_DECLARATION", p, a),
    param_decl(prov, _, _, _, m, p).
// A record component is a field AND a constructor parameter; Spring binds it as
// either, so both shapes must see it.
ann_on_field(prov, a, n, f, owner) :- annotation_on(prov, n, _, "RECORD_COMPONENT", f, a),
    field_decl(prov, _, _, owner, f).

// ann_owner_type(Ann, TypeHash) — the type the annotation ultimately sits in,
// whatever it is attached to. This is what gives an annotation a FILE.
ann_owner_type(prov, a, t) :- ann_on_type(prov, a, _, t).
ann_owner_type(prov, a, t) :- ann_on_field(prov, a, _, _, t).
ann_owner_type(prov, a, t) :- ann_on_method(prov, a, _, _, t).
ann_owner_type(prov, a, t) :- ann_on_param(prov, a, _, _, m), method_owner(prov, t, m).
// Nested annotation: inherits its parent's attach point (@Table(indexes=@Index(...))).
ann_owner_type(prov, a, t) :- annotation_arg(prov, parent, _, _, "NESTED_ANNOTATION", _, _, a, _),
    ann_owner_type(prov, parent, t).

ann_file(prov, a, f) :- ann_owner_type(prov, a, t), type_decl(prov, _, _, f, _, _, t).

// ─────────────────────────────────────────────────────────────────────────────
// 2. VALUES
// ─────────────────────────────────────────────────────────────────────────────
// ann_arg(Ann, ArgName, CleanValue, ValueType, ArrayIndex) — every argument, with
// the source quotes removed. `@RequestMapping("/x")` names its single unnamed
// argument "value", so ArgName is always usable as a key.
ann_arg(prov, a, an, v, vt, ai) :- annotation_arg(prov, a, an, raw, vt, ai, _, _, _),
    cfg_clean(raw, v).

// ann_arg_value(Ann, CleanValue) — shorthand for the single/unnamed argument, the
// shape almost every framework annotation uses.
ann_arg_value(prov, a, v) :- ann_arg(prov, a, "value", v, _, _).

// ARRAYS need no relation of their own. `@Foo({"a.b.C","d.e.F"})` is stored as N
// rows sharing ArgName and differing by ArrayIndex, and ann_arg emits one row per
// element — so every element is already interpreted individually by the name->type
// rules below. A relation that merely re-labels that shape would have no consumer,
// which is precisely the defect this change set exists to remove.
//
// NESTED annotations. The child is a first-class annotation row with its own
// annotation_arg rows, so its arguments are interpreted by the same rules. The one
// thing it lacks is an attach point — a nested annotation is attached to nothing —
// which is why ann_owner_type recurses through NESTED_ANNOTATION above: that is what
// gives `@JsonSubTypes({@Type(value = Dog.class)})` a FILE, and therefore lets
// `Dog.class` resolve through that file's imports.

// ─────────────────────────────────────────────────────────────────────────────
// 3. ARGUMENT -> TYPE
// ─────────────────────────────────────────────────────────────────────────────
// A CLASS_REFERENCE argument (`Foo.class`) stores the NAME in ArgValue and leaves
// ReferencedTypeHash empty — the projection header says so explicitly: "resolve the
// name to a type". That resolution is here.
//
// Two name shapes reach a type:
//   - a bare simple name (`Foo.class`), resolvable only through the imports of the
//     file the annotation sits in -> cfg_ann_name_in_file, consumed by
//     value-interpretation.dl
//   - a fully-qualified name, in a CLASS_REFERENCE or in a plain string argument
//     (`@Component("com.x.Y")`-style config-by-string) -> cfg_name_demand
cfg_ann_name_in_file(v, f) :- ann_arg(prov, a, _, v, "CLASS_REFERENCE", _), ann_file(prov, a, f).
cfg_name_demand(v) :- ann_arg(_, _, _, v, "CLASS_REFERENCE", _).
cfg_name_demand(v) :- ann_arg(_, _, _, v, "STRING_LITERAL", _), cfg_fqn_shaped(v).

// ── config_class_ref: the EXPORTED "this string names this type" fact ─────────
// config_class_ref(Mechanism, Site, Name, TypeHash, Prov). One row per resolved
// class reference, from any of the four mechanisms; the Mechanism column is what
// makes per-mechanism precision/recall reportable instead of an aggregate.
config_class_ref("annotation", a, v, t, prov) :- ann_arg(_, a, _, v, "CLASS_REFERENCE", _),
    cfg_name_type(v, prov, t).
config_class_ref("annotation", a, v, t, prov) :- ann_arg(_, a, _, v, "STRING_LITERAL", _),
    cfg_fqn_shaped(v), cfg_name_type(v, prov, t).

// ── DECLARED UNKNOWN: a class-shaped argument that resolves to nothing ────────
config_unresolved("annotation", a, v, "unresolved_class") :-
    ann_arg(_, a, _, v, "CLASS_REFERENCE", _), !cfg_name_resolved(v).
config_unresolved("annotation", a, v, "unresolved_class") :-
    ann_arg(_, a, _, v, "STRING_LITERAL", _), cfg_fqn_shaped(v), !cfg_name_resolved(v).
// An UNKNOWN-typed argument is the parser's own fallback ("complex expression"):
// a concatenation, a constant reference, a SpEL expression. It is a real blind
// spot in exactly the way reflection is, and is recorded as one.
config_unresolved("annotation", a, v, "uninterpretable_argument") :-
    ann_arg(_, a, _, v, "UNKNOWN", _), v != "".
