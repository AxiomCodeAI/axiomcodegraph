// ============================================================================
// EXPRESSION RESOLUTION · CALLEE
//
// expr_resolves_to_method(Prov, SiteExpr, MethodHash) -- the disambiguated target set
// for a call site. 0, 1 or N. The call-edge layer turns the COUNT into a confidence
// tier, so this relation's job is to be complete and sound: every target that could
// run, and nothing that could not.
//
// ONE RULE PER CALL SHAPE, and the shapes are not interchangeable:
//
//   qualified instance call   receiver type -> member lookup -> dispatch fan
//   qualified static call     receiver names a TYPE -> static member -> exact
//   unqualified call          this, then enclosing types, then `using static`
//   constructor call          type name -> its constructors -> overload by arity
//   base/this ctor delegation no name at all; the target is structural
//   base.M()                  non-virtual: the base's implementation, exactly
//   delegate invoke           value flow, not member lookup (delegates.dl)
//   operator / conversion     a static method wearing other syntax
//   extension method          only where member lookup found nothing
//
// A SHAPE WITH NO RULE STILL REACHES THE OUTPUT as a declared unknown, because the
// edge layer keys on the site universe rather than on what resolved. That is the
// property that makes a missing rule a visible gap instead of a silent one.
// ============================================================================

// ── QUALIFIED INSTANCE CALL ─────────────────────────────────────────────────
// The receiver's type, the member of that name, then every body dispatch says could
// run. Restricted to concrete targets, since the runtime receiver is concrete.
//
// NARROWED BY ARITY, AND THIS IS NOT OPTIONAL. `member_method` returns every
// overload of the name; a site calls exactly one of them. Without the arity test:
//
//   * a 2-argument call matched a 1-parameter member, which on one corpus member
//     resolved `validator.Validate(instance, options => ...)` to
//     `AbstractValidator.Validate/1` -- an edge the compiler does not make, and the
//     kind of wrong answer that is worse than a missing one.
//   * every overload entered the candidate set, so each one's dispatch fan was
//     unioned into the site's targets. On another one site reported 43 targets
//     spanning two different arities.
//
// ARITY IS A RANGE, NOT A NUMBER (method_accepts_argc): optional parameters and a
// `params` array both widen it, and both are idiomatic C# rather than corner cases.
expr_call_candidate(prov, e, m) :-
    call_needs_member_lookup(prov, e),
    call_recv_type(prov, e, gk),
    call_callee_name(prov, e, n),
    member_method(prov, gk, n, m),
    call_argc(prov, e, ac),
    method_accepts_argc(prov, m, ac).

// A site whose arity matches NO overload of the name. Either the engine's receiver
// type is wrong, or the target is an EXTENSION method (whose `this` parameter makes
// the declared arity one greater than the argument count), or the overload is
// declared in an unstaged base. Recorded so the three are separable, and consumed by
// resolution/extensions.dl -- which is exactly the language's own rule: extension
// methods are considered only where instance lookup found nothing.
call_arity_no_member(prov, e) :-
    call_needs_member_lookup(prov, e),
    call_recv_type(prov, e, gk),
    call_callee_name(prov, e, n),
    member_method(prov, gk, n, _),
    !expr_call_candidate(prov, e, _).

// ── TWO STRATA, AND WHY ─────────────────────────────────────────────────────
// TYPE INFERENCE AND DISPATCH ARE MUTUALLY RECURSIVE in C#: a receiver's type may
// come from a call's return type, and that call's target depends on ITS receiver's
// type. That recursion is fine as long as it stays POSITIVE. The exactness test is
// not positive -- "fan out unless the receiver is exact" is a negation -- and
// putting it inside the recursion makes the program unstratifiable, which souffle
// reports as `Unable to stratify relation(s) {call_recv_type, dispatch_is_exact,
// expr_resolves_to_method, expr_type, ...}`.
//
// So it is split:
//
//   expr_target_any        POSITIVE and recursive. The declared member AND its whole
//                          dispatch fan. This is what expr-type.dl reads, so typing
//                          has a monotone fixpoint to converge to.
//   expr_resolves_to_method NARROWED, in a later stratum. Applies exactness and the
//                          dispatch cap once types have settled. This is what the
//                          edge layer reads.
//
// THE PRICE, STATED: a receiver typed through an invocation is typed from the whole
// fan's return types rather than from the selected target's. In practice the fan's
// members are overrides of one declaration, and an override's return type is the
// same or covariant, so the type SET is the same or one element wider -- never
// narrower, so nothing is lost, and a wider set can only make a downstream site
// multi_inferred where it might have been known_edge. That trade buys a program
// that stratifies; the alternative is no answer at all.
expr_target_any(prov, e, declared) :- expr_call_candidate(prov, e, declared).
expr_target_any(prov, e, target) :-
    expr_call_candidate(prov, e, declared),
    dispatch_concrete_target(prov, declared, target).

// A site whose receiver is EXACTLY typed (a fresh `new`) resolves in that type
// specifically, not in the declared type of whatever holds it.
expr_call_candidate(prov, e, m) :-
    call_recv_exact_type(prov, e, gk),
    call_callee_name(prov, e, n),
    member_method(prov, gk, n, m),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

// ── THE NARROWED ANSWER ─────────────────────────────────────────────────────
// An EXACT site takes the declared member itself, with no fan. This is the COMMON
// case in C#, where dispatch is opt-in.
expr_resolves_to_method(prov, e, declared) :-
    expr_call_candidate(prov, e, declared),
    dispatch_is_exact(prov, e),
    !ovl_drop(prov, e, declared).
expr_resolves_to_method(prov, e, target) :-
    expr_call_candidate(prov, e, declared),
    !dispatch_is_exact(prov, e),
    dispatch_concrete_target(prov, declared, target),
    !call_fan_refused(prov, e),
    // Narrowed by the argument types (overload-args.dl) at the DECLARATION, so an
    // overload the arguments rule out takes its whole fan with it.
    !ovl_drop(prov, e, declared),
    // The fan is already arity-matched against the DECLARATION, and the declaration
    // is arity-matched against the site, so this is redundant in principle. It is
    // kept because the two matches use different relations and a future change to
    // either could let an overload of another arity into a site's targets, which is
    // the defect this whole block exists to prevent.
    call_argc(prov, e, ac), method_accepts_argc(prov, target, ac).

// ── `base.M()` -- NON-VIRTUAL, EXACTLY THE BASE'S BODY ───────────────────────
// Stated as its own rule rather than relying on dispatch_is_exact, because the
// LOOKUP is different too: it starts at the base, so an override in the CURRENT type
// must not be the answer. That override is precisely what `base.M()` exists to skip.
expr_exact_target(prov, e, m) :-
    call_is_base(prov, e),
    expr_ultimate_type_group(prov, e, gk), type_extends(prov, gk, bgk),
    call_callee_name(prov, e, n),
    member_method(prov, bgk, n, m),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

// ── QUALIFIED STATIC CALL ───────────────────────────────────────────────────
// `Console.WriteLine(x)`, `Math.Sqrt(x)`. The receiver names a type. A static method
// is never dispatched, so the target is exact.
expr_exact_target(prov, e, m) :-
    call_needs_member_lookup(prov, e),
    call_receiver_expr(prov, e, r), ref_names_type(prov, r, gk),
    call_callee_name(prov, e, n),
    member_method(prov, gk, n, m),
    method_is_static(prov, m),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

// ── UNQUALIFIED CALL ────────────────────────────────────────────────────────
// `M()`. Resolved in this order, which is the language's:
//   1. a LOCAL FUNCTION in the enclosing method (or a lexically enclosing one)
//   2. a member of the enclosing type, then of its bases
//   3. a member of each ENCLOSING type, outward
//   4. a static member brought in by `using static`
// Each source is a ranked candidate; the best rank wins, and ties survive as a set.

// (1) a local function, in this method or an enclosing one.
scope_cand(prov, e, n, m, 0) :-
    call_is_unqualified(prov, e), call_callee_name(prov, e, n),
    expr_ultimate_method(prov, e, cm),
    method_lexical_ancestor(prov, cm, anc),
    method_is_local_function(prov, m),
    method_lexical_parent(prov, m, anc),
    method_name(prov, m, n),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

// (2) a member of the enclosing type or its bases. member_method already walks the
// base chain by distance, so this is one clause.
scope_cand(prov, e, n, m, 1) :-
    call_is_unqualified(prov, e), call_callee_name(prov, e, n),
    expr_ultimate_type_group(prov, e, gk),
    member_method(prov, gk, n, m),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

// (3) a member of an ENCLOSING type. A nested class calling a helper on its outer
// class writes no receiver, and without this the site is unresolved.
scope_cand(prov, e, n, m, 2) :-
    call_is_unqualified(prov, e), call_callee_name(prov, e, n),
    expr_ultimate_type_group(prov, e, gk),
    type_nest_ancestor(prov, gk, anc), anc != gk,
    member_method(prov, anc, n, m),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

// (4) `using static System.Math;` makes `Sqrt(x)` resolve with no qualifier at all.
// This is the ONLY way an unqualified call reaches a type the enclosing type has no
// relation to, so an engine without it reports those sites unresolved. Ranked last,
// which matches the language: a member of your own type wins over an imported static.
scope_cand(prov, e, n, m, 3) :-
    call_is_unqualified(prov, e), call_callee_name(prov, e, n),
    expr_ultimate_module(prov, e, mod),
    using_static_type(prov, mod, tn),
    name_to_type(prov, mod, tn, gk),
    member_method(prov, gk, n, m),
    method_is_static(prov, m),
    call_argc(prov, e, ac), method_accepts_argc(prov, m, ac).

scope_best_rank(prov, e, r) :-
    scope_cand(prov, e, _, _, _),
    r = min k : { scope_cand(prov, e, _, _, k) }.

// The unqualified candidate, and then its dispatch fan. An unqualified call to a
// VIRTUAL member of the enclosing type is still a virtual call: `Area()` inside
// `Shape.Describe()` dispatches to Circle.Area at runtime. Missing that is the
// difference between a correct graph and one that stops at the abstract declaration.
expr_call_candidate(prov, e, m) :-
    scope_cand(prov, e, _, m, r), scope_best_rank(prov, e, r).

// Same two-stratum split as the qualified case: the fan feeds typing positively,
// and exactness narrows it afterwards. An unqualified call to a VIRTUAL member of
// the enclosing type is still a virtual call -- `Area()` inside `Shape.Describe()`
// dispatches to Circle.Area at runtime, and stopping at the abstract declaration is
// the difference between a correct graph and one that ends at the base.

// A STATIC unqualified call is never dispatched, so it is exact regardless of the
// receiver rules above.
dispatch_is_exact(prov, e) :-
    call_is_unqualified(prov, e),
    scope_cand(prov, e, _, m, r), scope_best_rank(prov, e, r),
    method_is_static(prov, m).

// ── CONSTRUCTOR CALL ────────────────────────────────────────────────────────
// `new Foo(a, b)`. The callee NAME is the type name, and the target is the type's
// constructor whose arity accepts the argument count. A constructor is never
// dispatched: `new` constructs exactly what it names.
//
// PRIMARY CONSTRUCTORS AND RECORDS go through the same path, because
// method_is_ctor includes PRIMARY_CONSTRUCTOR. Without that, every `new Point(1, 2)`
// on a positional record is unresolved, and records are the normal way to write a
// C# data type.
call_ctor_target(prov, e, ctor) :-
    call_needs_ctor_lookup(prov, e),
    expr_new_type(prov, e, gk),
    type_ctor(prov, gk, ctor),
    call_argc(prov, e, ac),
    ctor_accepts_argc(prov, ctor, ac).

// A STAGED LIBRARY TYPE'S CONSTRUCTOR. `new StringBuilder()` on a staged type has
// its constructor, its parameters and its arity under "lib", so the single-
// provenance clause above finds nothing -- and the implicit-constructor clause
// below then asserts the type declares NO constructor, which is a wrong claim and
// worse than not staging at all, since an unstaged type at least names the
// boundary.
call_ctor_target("client", e, ctor) :-
    call_needs_ctor_lookup("client", e),
    expr_new_type("client", e, gk),
    type_ctor("lib", gk, ctor),
    call_argc("client", e, ac),
    ctor_accepts_argc("lib", ctor, ac).

expr_exact_target(prov, e, ctor) :- call_ctor_target(prov, e, ctor).

// A type with NO declared constructor has an implicit public parameterless one. The
// parser does not synthesise a row for it, so `new Foo()` on such a type resolves to
// nothing -- and that is a REAL answer rather than a miss: there is no user code to
// call. Recorded so the site is classified as a known structural case.
call_ctor_implicit(prov, e, gk) :-
    call_needs_ctor_lookup(prov, e),
    expr_new_type(prov, e, gk),
    !type_ctor(prov, gk, _),
    !type_ctor_staged(prov, gk),
    // AND NOT FOR A STAGED TYPE AT ALL. `type_ctor_staged` only covers a library
    // type whose constructor IS carried. A library IR is a signature SUBSET, so
    // one that carries no constructor for a type says nothing about whether the
    // type declares any, and this class asserts exactly that: "the type declares
    // no constructor, so there is no user code to call". A producer that omits
    // constructors would have every `new` on every staged type reported as a
    // known structural case.
    !type_group("lib", _, gk),
    call_argc(prov, e, "0").

// "This type declares no constructor" is only true if nobody declares one. A
// staged library type's constructors are under "lib", so without this the claim
// is made about a type whose constructor the run was given.
type_ctor_staged("client", gk) :- type_ctor("lib", gk, _).

// ── CONSTRUCTOR DELEGATION ──────────────────────────────────────────────────
// `: this(a)` targets another constructor of the SAME type; `: base(a)` targets one
// of the base. Neither writes a name, so the target is structural and there is no
// name to resolve -- which is why a name-matching graph misses both entirely.
expr_exact_target(prov, e, ctor) :-
    call_is_this_ctor(prov, e),
    expr_ultimate_type_group(prov, e, gk),
    type_ctor(prov, gk, ctor),
    call_argc(prov, e, ac), ctor_accepts_argc(prov, ctor, ac),
    expr_ultimate_method(prov, e, self), ctor != self.
expr_exact_target(prov, e, ctor) :-
    call_is_base_ctor(prov, e),
    expr_ultimate_type_group(prov, e, gk), type_extends(prov, gk, bgk),
    type_ctor(prov, bgk, ctor),
    call_argc(prov, e, ac), ctor_accepts_argc(prov, ctor, ac).

// A PRIMARY CONSTRUCTOR'S BASE INVOCATION is written in the heritage clause:
// `class D(int a) : B(a)`. There is no call syntax anywhere in the body, and the
// parser's own corpus audit counted 2207 such sites as misses. The edge comes from
// the heritage flag rather than from an expression, so it is emitted directly by
// the call-edge layer; here the target is computed.
primary_ctor_base_target(prov, gk, ctor) :-
    heritage_has_ctor_args(prov, t, pos), type_group(prov, t, gk),
    heritage_resolves(prov, gk, pos, bgk),
    type_ctor(prov, bgk, ctor).

// ── ARITY ACCEPTANCE ────────────────────────────────────────────────────────
// ARITY IS A RANGE, NOT A NUMBER, and this is where most naive overload selection
// goes wrong. A method of four parameters accepts a two-argument call if two have
// defaults, and a `params` method accepts any count from its position onward.
// Matching parameterCount exactly rejects both, and both are extremely common in
// C# -- optional parameters are the idiomatic alternative to overloads.
method_arity_min(prov, m, lo) :-
    method_paramc(prov, m, pcs), pc = to_number(pcs),
    opt = count : { param_of(prov, p, m), param_optional(prov, p) },
    lo = pc - opt.
method_arity_max(prov, m, hi) :-
    method_paramc(prov, m, pcs), pc = to_number(pcs),
    !method_has_params_array(prov, m),
    hi = pc.
// A `params` array accepts an unbounded tail. 9999 stands in for unbounded, which is
// sufficient against real argument counts and keeps the column a number.
method_arity_max(prov, m, 9999) :- method_has_params_array(prov, m).

param_optional(prov, p) :- param_has_default(prov, p).
param_optional(prov, p) :- param_is_params(prov, p).
method_has_params_array(prov, m) :- param_of(prov, p, m), param_is_params(prov, p).

method_accepts_argc(prov, m, acs) :-
    method_arity_min(prov, m, lo), method_arity_max(prov, m, hi),
    call_argc_value(acs, ac),
    ac >= lo, ac <= hi.
// The same boundary for ARITY. A client call site asks whether the method it
// resolved accepts its argument count, and for a library method the parameter
// facts that answer that are under "lib". Without this the candidate is found and
// then rejected for an arity nobody could compute, which reads exactly like a
// receiver typed wrong.
method_accepts_argc("client", m, acs) :-
    method_arity_min("lib", m, lo), method_arity_max("lib", m, hi),
    call_argc_value(acs, ac),
    ac >= lo, ac <= hi.
ctor_accepts_argc(prov, ctor, ac) :- method_is_ctor(prov, ctor), method_accepts_argc(prov, ctor, ac).

// The argument counts that actually occur, so the join above is over real values
// rather than over every number.
call_argc_value(acs, ac) :- call_argc(_, _, acs), ac = to_number(acs).

// ── OPERATORS AND CONVERSIONS ───────────────────────────────────────────────
// `a + b` where the operand type overloads `+` is a static call to op_Addition, and
// an IMPLICIT conversion runs with no syntax at the call site at all. Both are edges
// into user code that a syntactic reading never produces. The parser emits
// OPERATOR_CALL and CONVERSION_CALL where it can see the shape; the target is found
// by matching the operator token against the declaring type's operator methods.
// RESOLVED AGAINST THE OPERANDS, NOT A RECEIVER. `a + b` writes no `a.` before
// the member, so the site has receiverKind NONE and call_recv_type is never
// populated for it -- the rule this replaces could not fire on any program. A
// user-defined operator is a static member of ONE OF THE OPERAND TYPES and the
// syntax does not say which, so both are tried; the arity then separates the
// overloads, which is not optional: a type may declare `operator -(Money)` and
// `operator -(Money, Money)` and both carry the token `-`.
expr_exact_target(prov, e, m) :-
    call_is_operator(prov, e),
    expr_operator(prov, e, op),
    expr_operand_child(prov, e, c),
    expr_type(prov, c, gk),
    // ON THE OPERAND'S TYPE OR ANY ANCESTOR OF IT. C# gathers the candidate
    // user-defined operators from the operand's type AND its base types, so an
    // `operator ==` declared on a base entity is found for every derived one --
    // which is the shape a domain model is written in, and `x == null` on a derived
    // type is written in almost every handler.
    //
    // THE MISS WAS INVISIBLE, not merely wrong: a site whose operator is not found
    // is counted as known_builtin_operator, the bucket for a site that ran no user
    // code, so it was filed as a correct answer. The arity test below is what keeps
    // the widened lookup honest -- a type may declare `operator -(Money)` and
    // `operator -(Money, Money)` and an inherited one of the wrong arity must not
    // be let in by the ancestor hop.
    type_self_or_ancestor(prov, gk, ownerGk),
    method_in_type(prov, ownerGk, m),
    method_operator(prov, m, op),
    call_argc(prov, e, acs),
    method_accepts_argc(prov, m, acs).

// AN EXPLICIT CAST, `(Money)d`. The conversion is declared on the target type or
// on the operand's type -- `(Money)d` and `(decimal)m` are both written as casts
// and only one of them is declared on the type named in the parentheses.
//
// NARROWED BY THE RETURN TYPE, not by the conversion kind. A cast to `Money`
// runs whichever conversion PRODUCES a Money, and that may be declared
// `implicit`: `(decimal)money` is written explicitly and invokes op_Implicit.
// Matching on the kind would take the wrong one of a type's two conversions.
conversion_target_name(prov, e, tn) :-
    expr_cast_ref(prov, e, tr),
    type_ref_resolves(prov, tr, targetGk),
    type_group(prov, t, targetGk),
    type_decl(prov, tn, _, _, _, t).

expr_exact_target(prov, e, m) :-
    call_is_conversion(prov, e),
    conversion_target_name(prov, e, tn),
    conversion_candidate_type(prov, e, gk),
    method_in_type(prov, gk, m),
    method_conversion(prov, m, _),
    method_return_type_name(prov, m, tn).

// Where to look for it: the type named in the parentheses, and the operand's own
// type. Both are real: a conversion between two source types is declared on
// exactly one of them.
conversion_candidate_type(prov, e, gk) :-
    expr_cast_ref(prov, e, tr), type_ref_resolves(prov, tr, gk).
conversion_candidate_type(prov, e, gk) :-
    expr_operand_child(prov, e, c), expr_type(prov, c, gk).

// ── AN INDEXER: `a[i]` ──────────────────────────────────────────────────────
// A user-defined indexer is a property whose accessors are real methods. `a[i]` on
// the read side calls the getter.
expr_exact_target(prov, e, getter) :-
    call_is_element_access(prov, e),
    call_recv_type(prov, e, gk),
    property_in_type(prov, gk, p), property_is_indexer(prov, p),
    method_accessor_of(prov, getter, p, "INDEXER"),
    method_kind(prov, getter, "INDEXER_GET").

// ── THE EXACT SHAPES, FED INTO BOTH STRATA ──────────────────────────────────
// Every shape above that is EXACT BY CONSTRUCTION -- a base call, a static call, a
// constructor, `this(...)`/`base(...)` delegation, an operator, a conversion, an
// indexer -- writes expr_exact_target. None of them is virtually dispatched, so its
// answer needs no narrowing and is the same in both strata.
//
// They write expr_exact_target rather than expr_resolves_to_method directly because
// the positive stratum has to be able to read them. Deriving expr_call_candidate
// FROM expr_resolves_to_method is what put a negation back inside the recursion, and
// souffle listed the whole component: {call_fan_refused, call_recv_type,
// dispatch_is_exact, expr_call_candidate, expr_resolves_to_method, expr_target_any,
// expr_type, ...}. The direction of these two rules is the fix.
expr_target_any(prov, e, m) :- expr_exact_target(prov, e, m).
expr_resolves_to_method(prov, e, m) :- expr_exact_target(prov, e, m), !ovl_drop(prov, e, m).
expr_target_any(prov, e, m) :- expr_call_candidate(prov, e, m).

// ── THE DYNAMIC BLIND SPOT, DECLARED ────────────────────────────────────────
// A call through a `dynamic` value is dispatched at runtime by the DLR. No reading
// of the source settles it, so the engine resolves it to nothing and says why. This
// is the one place where "unresolved" is the correct and final answer rather than a
// gap to close.
call_unresolvable_by_design(prov, e, "dynamic") :- call_is_dynamic(prov, e).

// THE PARSER'S `DYNAMIC_CALL` KIND IS RESERVED WITH ZERO ROWS, so the clause above
// fires nowhere and the tier it feeds had no rows on any project measured. What the
// parser DOES record is the receiver's written type, and `dynamic` is written down:
// on a parameter, on a local, on a field, on a property. That is the same fact the
// external-labelling path was reading when it fabricated a type named `dynamic`, so
// it is taken here instead, where the answer is "undecidable" rather than a name.
//
// The receiver must not have typed, which is what `!call_recv_type` says: a name
// that did resolve is not a DLR site whatever it is spelled.
expr_dynamic_typed(prov, e) :-
    ref_denotes(prov, e, "LOCAL_VARIABLE", v), var_type_name(prov, v, "dynamic", _).
expr_dynamic_typed(prov, e) :-
    ref_denotes(prov, e, "PARAMETER", p), param_type_name(prov, p, "dynamic", _).
expr_dynamic_typed(prov, e) :-
    ref_denotes(prov, e, "FIELD", f), field_type_name(prov, f, "dynamic", _).
expr_dynamic_typed(prov, e) :-
    ref_denotes(prov, e, "PROPERTY", p), property_type_name(prov, p, "dynamic", _).

call_unresolvable_by_design(prov, e, "dynamic") :-
    call_receiver_expr(prov, e, r),
    expr_dynamic_typed(prov, r),
    !call_recv_type(prov, e, _).

// READING A PROPERTY THROUGH `dynamic` IS THE SAME SITE. `d.Name` invokes a getter
// the DLR picks at runtime, and it arrived at the external-labelling path by the
// same route the method call did, so removing `dynamic` from that path without this
// would turn a false label into silence -- and silence reads as a site the engine
// never saw, which is the worse of the two.
dynamic_property_read(prov, acc) :-
    expr_kind(prov, acc, "MEMBER_ACCESS"),
    !member_access_resolved(prov, acc),
    expr_qualifier_child(prov, acc, q),
    expr_dynamic_typed(prov, q).
