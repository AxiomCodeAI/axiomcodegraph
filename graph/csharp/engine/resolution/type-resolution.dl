// ============================================================================
// RESOLUTION · TYPE NAMES
//
// type_name_resolves(Prov, ModuleHash, WrittenName, Arity, GroupKey) -- what a type
// name written in a given file denotes. Everything downstream depends on this: a
// receiver's type, a base class, a constructor's target, an extension method's
// receiver constraint.
//
// C# RESOLVES A SIMPLE TYPE NAME IN THIS ORDER, and the order is not cosmetic --
// getting it wrong resolves names to types the compiler would not choose:
//
//   1. a type PARAMETER in scope          (`T` is never a type called T)
//   2. a type nested in the enclosing types, innermost outward
//   3. a using ALIAS                       (`using Foo = A.B;`)
//   4. the enclosing namespaces, innermost outward
//   5. the namespaces brought in by `using`
//
// This file does not implement 1-5 as a priority cascade with cut-offs, because
// Datalog has no cut and because the honest answer when two sources both match is
// a SET rather than a silent pick. Instead each source produces a candidate with
// its RANK, and type_name_resolves takes the best available rank per (module, name,
// arity). Ties at the same rank survive as multiple answers and are reported as
// ambiguous, which is what the compiler itself would call them.
//
// ARITY IS PART OF THE KEY EVERYWHERE. `List` and `List<T>` are two types. A
// resolver that matches on name alone answers `new Dictionary<K,V>()` with whatever
// `Dictionary` it found first, and on a codebase with its own non-generic helper of
// the same name that is a wrong edge rather than a missing one.
// ============================================================================

// ── RANK 2: nested in an enclosing type ─────────────────────────────────────
// Searched from the site's own type outward. The nesting distance is the rank
// offset, so an inner declaration wins over an outer one, which is what shadowing
// means.
type_name_cand(prov, mod, n, ar, igk, 2) :-
    type_module(prov, t, mod), type_group(prov, t, ogk),
    type_nest_ancestor(prov, ogk, anc),
    nested_declares(prov, anc, n, ar, igk).

// A type can also name ITSELF and its enclosing types by simple name.
type_name_cand(prov, mod, n, ar, gk, 2) :-
    type_module(prov, t, mod), type_group(prov, t, ogk),
    type_nest_ancestor(prov, ogk, gk),
    type_decl(prov, n, _, ar, _, d), type_group(prov, d, gk).

// ── RANK 3: a using alias ───────────────────────────────────────────────────
// `using Shapes = Probe.Geometry;` makes `Shapes` denote `Probe.Geometry`. The
// written name is the alias and it must be rewritten before any match is attempted,
// or every use of the alias is unresolved. The target is matched by QUALIFIED name,
// which is what an alias target always is.
type_name_cand(prov, mod, alias, ar, gk, 3) :-
    using_alias(prov, mod, alias, target),
    type_decl(prov, _, target, ar, _, t), type_group(prov, t, gk).

// An alias may also name a type by simple name where the target is unqualified.
type_name_cand(prov, mod, alias, ar, gk, 3) :-
    using_alias(prov, mod, alias, target),
    !contains(".", target),
    type_decl(prov, target, _, ar, _, t), type_group(prov, t, gk),
    type_ns(prov, gk, ns), module_in_scope(prov, mod, ns).

// ── RANK 4 AND 5: a namespace in scope ──────────────────────────────────────
// module_in_scope already unions the file's own namespaces, its enclosing
// namespaces, its usings and every global using in the same assembly. Splitting
// rank 4 from rank 5 would require knowing which of those a namespace came from,
// and the C# rule that matters in practice -- a name in your own namespace beats a
// name you imported -- is captured by giving the file's own namespaces the better
// rank.
type_name_cand(prov, mod, n, ar, gk, 4) :-
    module_namespace_own(prov, mod, ns),
    ns_declares(prov, ns, n, ar, gk).
type_name_cand(prov, mod, n, ar, gk, 5) :-
    module_in_scope(prov, mod, ns),
    ns_declares(prov, ns, n, ar, gk).

// ── A FULLY QUALIFIED NAME ──────────────────────────────────────────────────
// `Probe.Geometry.Circle` written in full, and `global::Probe.Circle`. Rank 1: a
// qualified name is not shadowed by anything.
type_name_cand(prov, mod, qn, ar, gk, 1) :-
    module_decl(prov, _, _, _, mod),
    type_decl(prov, _, qn, ar, _, t), type_group(prov, t, gk),
    type_is_top_level(prov, gk).

// A qualified name naming a NESTED type: `Outer.Inner`. The parser writes the full
// chain in qualifiedName, so this is the same match; it is separated only because
// nested types are deliberately absent from ns_declares.
type_name_cand(prov, mod, qn, ar, gk, 1) :-
    module_decl(prov, _, _, _, mod),
    type_decl(prov, _, qn, ar, _, t), type_group(prov, t, gk),
    !type_is_top_level(prov, gk).

// ── A QUALIFIED NAME READ FROM ITS NAMESPACE ────────────────────────────────
// `Reflection.Info.Create(..)` written inside namespace Shop names
// Shop.Reflection.Info: the first segment of a qualified name is a
// simple name, looked up in the enclosing namespaces like any other. Matched only
// in full, such a receiver stays untyped and every call through it unresolved.
//
// Keyed from the DECLARATION side, so nothing is enumerated per written name: each
// type's qualified name is split at each dot into the namespace before it and the
// dotted tail after it, and the tail is a candidate in every file whose namespace
// chain holds that prefix. A tail with no dot is a simple name, which ranks 2-5
// already answer.
type_qn_tail(prov, qn, p, s) :-
    type_decl(prov, _, qn, _, _, _),
    i = range(1, strlen(qn)), substr(qn, i, 1) = ".",
    p = substr(qn, 0, i), s = substr(qn, i + 1, strlen(qn) - i - 1),
    contains(".", s).
type_name_cand(prov, mod, s, ar, gk, 1) :-
    type_qn_tail(prov, qn, p, s), module_ns_chain(prov, mod, p),
    type_decl(prov, _, qn, ar, _, t), type_group(prov, t, gk).

// ── ...FROM THE SITE'S NAMESPACE, NOT THE FILE'S ────────────────────────────
// The candidate above is per FILE: module_ns_chain holds every namespace the file
// declares a type in. A file declaring P.Models, P.Other.Models and a class in P
// therefore offered `Models.Report` written in P both P.Models.Report and
// P.Other.Models.Report -- and P.Other is a child of P, not in scope there.
//
// C# reads the first segment from the namespaces enclosing the SITE, innermost
// outward, and the innermost level that has a match wins: it does not merge
// levels, and a name found at a level hides the same name read in full from the
// global namespace. So per (site namespace, written name), the candidates are
// ranked by the length of the prefix they were found under and only the longest
// survives; a full match is the outermost level and survives only when no
// enclosing namespace matched.
//
// PRUNE-ONLY. The file-level answer is kept as it is and a site drops from it only
// what its own namespace rules out; the site's own answer is always one of the
// file-level ones, so nothing correct is lost. A site whose enclosing type is not
// known drops nothing.
type_name_rel_at(prov, n, ar, gk, p) :-
    type_qn_tail(prov, qn, p, n),
    type_decl(prov, _, qn, ar, _, t), type_group(prov, t, gk).
type_name_rel_src(prov, n, ar, gk) :- type_name_rel_at(prov, n, ar, gk, _).

// The namespaces a name written in `ns` is read from, with the length of each.
ns_read_level(prov, ns, ns, l) :- ns_exists(prov, ns), l = strlen(ns).
ns_read_level(prov, ns, p, l) :- ns_prefix(prov, ns, p), l = strlen(p).

// A dotted name some site in this file actually writes. type_name_resolves answers
// every tail of every type in every file whose chain holds its prefix, written or
// not, so the scoping below is keyed on what is written. Keyed by FILE as well, so
// the probe into type_name_resolves binds (module, name) and reuses the index its
// consumers already need rather than building one on the name alone.
type_name_written_dotted(prov, mod, n) :-
    type_ref_name(prov, tr, n), contains(".", n), type_ref_module(prov, tr, mod).
type_name_written_dotted(prov, mod, n) :-
    expr_written_name(prov, e, n), contains(".", n), expr_ultimate_module(prov, e, mod).
type_name_written_dotted(prov, mod, n) :-
    call_callee_name(prov, e, n), contains(".", n), call_module(prov, e, mod).
type_name_written_dotted(prov, mod, n) :-
    heritage_slot(prov, t, _, n, _, ""), contains(".", n), type_module(prov, t, mod).

type_name_scope_demand(prov, mod, ns, n, ar) :-
    type_name_written_dotted(prov, mod, n),
    type_name_resolves(prov, mod, n, ar, _),
    module_namespace_own(prov, mod, ns).
type_name_scope_level(prov, ns, n, ar, gk, l) :-
    type_name_scope_demand(prov, _, ns, n, ar),
    ns_read_level(prov, ns, p, l),
    type_name_rel_at(prov, n, ar, gk, p).
type_name_scope_best(prov, ns, n, ar, b) :-
    type_name_scope_level(prov, ns, n, ar, _, _),
    b = max l : { type_name_scope_level(prov, ns, n, ar, _, l) }.
type_name_scope_keep(prov, ns, n, ar, gk) :-
    type_name_scope_level(prov, ns, n, ar, gk, b),
    type_name_scope_best(prov, ns, n, ar, b).

// type_name_out_of_scope(Prov, Namespace, Name, Arity, GroupKey) -- a file-level
// answer that a site in `ns` does not see: a relative candidate not at the
// innermost matching level (a child or sibling namespace, or a shallower level),
// or a full match hidden by a relative one.
type_name_out_of_scope(prov, ns, n, ar, gk) :-
    type_name_scope_demand(prov, mod, ns, n, ar),
    type_name_resolves(prov, mod, n, ar, gk),
    type_name_rel_src(prov, n, ar, gk),
    !type_name_scope_keep(prov, ns, n, ar, gk).
type_name_out_of_scope(prov, ns, n, ar, gk) :-
    type_name_scope_demand(prov, mod, ns, n, ar),
    type_name_resolves(prov, mod, n, ar, gk),
    !type_name_rel_src(prov, n, ar, gk),
    type_name_scope_best(prov, ns, n, ar, _).

// The site side, one per consumer below: the written name, the site's enclosing
// type, and that type's namespace. Joined from the (small) out-of-scope set, so only
// sites that write a pruned name are visited.
type_ref_scope_type(prov, tr, t) :- type_ref_owner(prov, tr, o, "TYPE"), t = o.
type_ref_scope_type(prov, tr, t) :- type_ref_owner(prov, tr, o, "METHOD"), method_owner(prov, t, o).
type_ref_scope_type(prov, tr, t) :- type_ref_owner(prov, tr, o, "FIELD"), field_decl(prov, _, t, o).
type_ref_scope_type(prov, tr, t) :- type_ref_owner(prov, tr, o, "PROPERTY"), property_decl(prov, _, t, o).
type_ref_scope_type(prov, tr, t) :- type_ref_owner(prov, tr, o, "EVENT"), event_decl(prov, _, t, o).
type_ref_scope_type(prov, tr, t) :-
    type_ref_owner(prov, tr, o, "METHOD_PARAMETER"), param_of(prov, o, m), method_owner(prov, t, m).
type_ref_scope_type(prov, tr, t) :-
    type_ref_owner(prov, tr, o, "VARIABLE"), var_method(prov, o, m), method_owner(prov, t, m).
type_ref_scope_type(prov, tr, t) :- type_ref_owner(prov, tr, o, "EXPRESSION"), expr_ultimate_type(prov, o, t).

type_ref_name_dropped(prov, tr, gk) :-
    type_name_out_of_scope(prov, ns, n, ar, gk),
    type_ref_name(prov, tr, n), type_ref_argc(prov, tr, ar),
    type_ref_scope_type(prov, tr, t), type_namespace(prov, t, ns).
expr_name_dropped(prov, e, gk) :-
    type_name_out_of_scope(prov, ns, n, ar, gk),
    expr_written_name(prov, e, n), expr_type_argc(prov, e, ar),
    expr_ultimate_type(prov, e, t), type_namespace(prov, t, ns).
expr_callee_name_dropped(prov, e, gk) :-
    type_name_out_of_scope(prov, ns, n, ar, gk),
    call_callee_name(prov, e, n), call_type_argc(prov, e, ar),
    expr_ultimate_type(prov, e, t), type_namespace(prov, t, ns).
heritage_name_dropped(prov, t, n, gk) :-
    type_name_out_of_scope(prov, ns, n, ar, gk),
    heritage_slot(prov, t, _, n, ar, ""), type_namespace(prov, t, ns).

// ── A CLIENT FILE NAMING A STAGED LIBRARY TYPE ──────────────────────────────
// Every clause above is SINGLE-PROVENANCE: it joins a module and a declaration
// under one `prov`, so a client module and a library namespace are never brought
// together and `type_name_cand("client", mod, _, _, <lib group>, _)` has no
// derivation at all. A C# library could therefore be staged and nothing it
// declares could ever be named.
//
// MEASURED before this existed, on a one-type library and a client that extends
// it: `resolution-type-base-unresolved` held the client's base as unresolved,
// `resolution-type-ancestor` was empty, member lookup found nothing, and the
// edge set was byte-identical to the same client analysed with no --library at
// all. Every client-to-library call was reported as if the dependency had not
// been supplied.
//
// The clauses below are the cross-provenance halves of the four above, at the
// same ranks and with the same bodies. Nothing else changes: the assembly guard
// was already written for exactly this case, and member_cand's base-chain
// clause, implements_member's cross-provenance clause and
// dispatch_runtime_target were all already written and simply unreachable.
//
// ONE DIRECTION ONLY. A client file resolving a LIBRARY type is what a
// dependency is. A library file resolving a CLIENT type is a cycle the real
// compiler cannot have, so there is no mirror of these.
type_name_cand("client", mod, n, ar, gk, 4) :-
    module_namespace_own("client", mod, ns),
    ns_declares("lib", ns, n, ar, gk).
type_name_cand("client", mod, n, ar, gk, 5) :-
    module_in_scope("client", mod, ns),
    ns_declares("lib", ns, n, ar, gk).

// A library type named in FULL, which needs no namespace in scope.
type_name_cand("client", mod, qn, ar, gk, 1) :-
    module_decl("client", _, _, _, mod),
    type_decl("lib", _, qn, ar, _, t), type_group("lib", t, gk),
    type_is_top_level("lib", gk).
type_name_cand("client", mod, qn, ar, gk, 1) :-
    module_decl("client", _, _, _, mod),
    type_decl("lib", _, qn, ar, _, t), type_group("lib", t, gk),
    !type_is_top_level("lib", gk).

// ── THE ASSEMBLY GUARD ──────────────────────────────────────────────────────
// A candidate is only usable if the file could actually see it. Client code sees
// client types and staged library types; it does NOT see a type from an unrelated
// client assembly by simple name. Applied as a filter rather than folded into each
// rule above so the condition is stated once.
//
// Cross-provenance is permitted in one direction: a client file resolving a LIBRARY
// type is the normal case (that is what a dependency is). A library file resolving a
// CLIENT type is not, and would be a cycle the real compiler cannot have.
type_name_visible(prov, mod, gk) :-
    type_name_cand(prov, mod, _, _, gk, _),
    module_assembly(prov, mod, asm, _), type_assembly(prov, gk, asm).
type_name_visible("client", mod, gk) :-
    type_name_cand("client", mod, _, _, gk, _),
    type_group("lib", _, gk).

// A file with no assembly name (the parser leaves it empty for a loose .cs file with
// no project) cannot be filtered this way, and refusing every candidate there would
// make the engine answer nothing on exactly the small inputs the test cases use.
// Treated as visible, and the looseness is confined to this clause.
type_name_visible(prov, mod, gk) :-
    type_name_cand(prov, mod, _, _, gk, _),
    module_assembly(prov, mod, "", _).

// ── BEST RANK, AND THE ANSWER ───────────────────────────────────────────────
type_name_best_rank(prov, mod, n, ar, r) :-
    type_name_cand(prov, mod, n, ar, _, _),
    r = min k : { type_name_cand(prov, mod, n, ar, g, k), type_name_visible(prov, mod, g) }.

type_name_resolves(prov, mod, n, ar, gk) :-
    type_name_cand(prov, mod, n, ar, gk, r),
    type_name_best_rank(prov, mod, n, ar, r),
    type_name_visible(prov, mod, gk).

// ── AMBIGUITY, DECLARED RATHER THAN HIDDEN ──────────────────────────────────
// Two types matching one name at the same rank. The compiler reports this as an
// error and requires a qualifier; the engine keeps both answers and says so, which
// is why a downstream edge derived through an ambiguous name is never presented as
// monomorphic.
type_name_count(prov, mod, n, ar, c) :-
    type_name_resolves(prov, mod, n, ar, _),
    c = count : { type_name_resolves(prov, mod, n, ar, _) }.
type_name_ambiguous(prov, mod, n, ar) :- type_name_count(prov, mod, n, ar, c), c >= 2.

// ── A NAME THAT RESOLVES TO NOTHING ─────────────────────────────────────────
// An unstaged third party, a type from an assembly nobody passed, or a real typo in
// generated code. Recorded so the site that needed it can be classified as a
// boundary rather than as an unexplained miss. See resolution/external-types.dl,
// which turns these into named external targets.
type_name_unresolved(prov, mod, n, ar) :-
    type_ref_demand(prov, mod, n, ar),
    !type_name_resolves(prov, mod, n, ar, _).

// type_ref_demand -- every (module, name, arity) the engine actually needs an answer
// for. Demand-driven rather than "every name in the program", so the unresolved
// count is a count of real failures and not of names nothing asked about.
type_ref_demand(prov, mod, n, ar) :-
    type_ref(prov, _, _, owner, "METHOD", n, tr), method_module(prov, owner, mod),
    type_ref_argc(prov, tr, ar).
type_ref_demand(prov, mod, n, ar) :-
    heritage_slot(prov, t, _, n, ar, _), type_module(prov, t, mod).
type_ref_demand(prov, mod, n, "0") :-
    call_needs_ctor_lookup(prov, e), call_callee_name(prov, e, n), call_module(prov, e, mod),
    call_type_argc(prov, e, "0").
type_ref_demand(prov, mod, n, ar) :-
    call_needs_ctor_lookup(prov, e), call_callee_name(prov, e, n), call_module(prov, e, mod),
    call_type_argc(prov, e, ar), ar != "0".

// A CALL RECEIVER WRITTEN AS A BARE NAME. `Console.WriteLine(x)` asks whether
// `Console` is a type, and that question has to be ASKED for the answer "it is a
// type nobody staged" to exist. Without this clause `Console` is demanded by
// nothing, so type_name_unresolved never mentions it, so external-types.dl cannot
// name the target and every BCL call is counted as an engine blind spot instead of
// as a boundary. Measured on the probe project: 3 of 3 unresolved sites.
//
// Restricted to a receiver NEITHER the parser NOR THE ENGINE bound to a value.
// expr_ref_unknown is the parser's own flag and says nothing about whether local
// binding later answered: `foreach (var s in xs) s.M()` leaves `s` unknown to the
// parser and bound by the engine. Guarding only on the parser's flag demanded `s` as
// a type name and produced `external:s.Describe` -- an external target named after a
// local variable, which is a wrong answer rather than a missing one. The !ref_denotes
// term is what makes the guard "unbound by anyone".
type_ref_demand(prov, mod, n, ar) :-
    call_receiver_expr(prov, e, r),
    expr_ref_unknown(prov, r),
    expr_written_name(prov, r, n), expr_type_argc(prov, r, ar),
    !ref_denotes(prov, r, _, _),
    call_module(prov, e, mod).

// A DECLARED TYPE NAME that did not resolve. `List<IShape> xs` and `ILogger log`
// name types the client does not declare, and the variable's type is what labels
// every call made on it.
type_ref_demand(prov, mod, n, "0") :-
    var_type_name(prov, v, n, _), var_method(prov, v, m), method_module(prov, m, mod).
type_ref_demand(prov, mod, n, "0") :-
    param_type_name(prov, p, n, _), n != "", param_of(prov, p, m), method_module(prov, m, mod).
type_ref_demand(prov, mod, n, "0") :-
    field_type_name(prov, f, n, _), n != "", field_decl(prov, _, t, f), type_module(prov, t, mod).
type_ref_demand(prov, mod, n, "0") :-
    property_type_name(prov, p, n, _), n != "", property_decl(prov, _, t, p), type_module(prov, t, mod).
type_ref_demand(prov, mod, n, "0") :-
    method_return_type_name(prov, m, n), n != "", method_module(prov, m, mod).

// ── RESOLVING A TYPE REFERENCE NODE ─────────────────────────────────────────
// type_ref_resolves(Prov, RefHash, GroupKey) -- a written type reference to the type
// it denotes. Goes through type_name_resolves, so it inherits the ordering and the
// ambiguity handling rather than re-deriving them.
//
// A reference naming a TYPE PARAMETER resolves to no type, deliberately: `T` denotes
// whatever it is instantiated with, and pretending it denotes a type called T
// produces members that do not exist. Its members come from its constraint
// (resolution/generics.dl).
type_ref_resolves(prov, tr, gk) :-
    type_ref_name(prov, tr, n),
    !type_ref_type_param(prov, tr, _),
    type_ref_argc(prov, tr, ar),
    type_ref_module(prov, tr, mod),
    type_name_resolves(prov, mod, n, ar, gk),
    !type_ref_name_dropped(prov, tr, gk).

// The module a type reference is written in, by owner kind. Every owner kind that
// can carry a reference is listed; one that is missing makes every reference in that
// position unresolvable, which is why they are enumerated rather than defaulted.
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "METHOD"), method_module(prov, o, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "TYPE"), type_module(prov, o, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "FIELD"), field_decl(prov, _, t, o), type_module(prov, t, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "PROPERTY"), property_decl(prov, _, t, o), type_module(prov, t, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "EVENT"), event_decl(prov, _, t, o), type_module(prov, t, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "METHOD_PARAMETER"), param_of(prov, o, m), method_module(prov, m, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "VARIABLE"), var_method(prov, o, m), method_module(prov, m, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "EXPRESSION"), expr_module(prov, o, mod).
type_ref_module(prov, tr, mod) :- type_ref_owner(prov, tr, o, "ATTRIBUTE"), attribute_module(prov, o, mod).

attribute_module("client", a, mod) :-
    cs_attribute(_, _, _, _, _, _, mod, _, _, _, _, _, _, _, _, _, _, _, a).
attribute_module("lib", a, mod) :-
    lib_cs_attribute(_, _, _, _, _, _, mod, _, _, _, _, _, _, _, _, _, _, _, a).

// ── C# KEYWORD TYPE ALIASES ─────────────────────────────────────────────────
// `int`, `string`, `double`, `void` and the rest are the language's own spellings of
// framework types. They are not names the client declares, so in a client-only run
// they resolve to nothing and land in type_name_unresolved beside a genuinely
// missing dependency -- which is misleading in both directions: they are not a
// blind spot, and they are not a third-party boundary either.
//
// Named here so they are classified as PREDEFINED. Where a library IR is staged they
// resolve through it like any other type; where it is not, a call on a `string`
// receiver is a boundary to the framework and is labelled as one, never as an
// engine failure.
//
// `void` is in the list deliberately: it appears as a return type on most methods,
// so leaving it out puts the most common return type in the unresolved column.
cs_predefined_alias("void").
cs_predefined_alias("object").
cs_predefined_alias("string").
cs_predefined_alias("bool").
cs_predefined_alias("byte").
cs_predefined_alias("sbyte").
cs_predefined_alias("char").
cs_predefined_alias("decimal").
cs_predefined_alias("double").
cs_predefined_alias("float").
cs_predefined_alias("int").
cs_predefined_alias("uint").
cs_predefined_alias("long").
cs_predefined_alias("ulong").
cs_predefined_alias("short").
cs_predefined_alias("ushort").
cs_predefined_alias("nint").
cs_predefined_alias("nuint").
cs_predefined_alias("dynamic").
cs_predefined_alias("var").

// ── WHICH FRAMEWORK TYPE A KEYWORD SPELLS ───────────────────────────────────
// cs_predefined_alias records that a name IS a keyword and nothing recorded WHAT
// it names, so a library declaring System.String was useless to source writing
// `string` -- and `string` and `object` head the list of receiver types that
// block resolution. The aliases are a closed set fixed by the language, so this
// is a table and not an inference.
//
// `var` and `dynamic` are deliberately absent: neither names a type. `void` is
// absent because it is never a receiver.
cs_alias_framework_type("object", "System.Object").
cs_alias_framework_type("string", "System.String").
cs_alias_framework_type("bool", "System.Boolean").
cs_alias_framework_type("byte", "System.Byte").
cs_alias_framework_type("sbyte", "System.SByte").
cs_alias_framework_type("char", "System.Char").
cs_alias_framework_type("decimal", "System.Decimal").
cs_alias_framework_type("double", "System.Double").
cs_alias_framework_type("float", "System.Single").
cs_alias_framework_type("int", "System.Int32").
cs_alias_framework_type("uint", "System.UInt32").
cs_alias_framework_type("long", "System.Int64").
cs_alias_framework_type("ulong", "System.UInt64").
cs_alias_framework_type("short", "System.Int16").
cs_alias_framework_type("ushort", "System.UInt16").
cs_alias_framework_type("nint", "System.IntPtr").
cs_alias_framework_type("nuint", "System.UIntPtr").

// A keyword names the staged framework type it spells. Rank 1, because a keyword
// cannot be shadowed by anything a project declares.
type_name_cand("client", mod, alias, "0", gk, 1) :-
    module_decl("client", _, _, _, mod),
    cs_alias_framework_type(alias, qn),
    lib_type_named(qn, gk).

// AND A LIBRARY FILE WRITES `string` TOO. `public string Trim()` in a staged IR
// has to resolve its OWN return type, or a chain through the library dies one
// hop in: `sb.ToString().Trim()` resolved the first call into the library and
// then had no receiver type for the second, while `sb.Append(...)` on the same
// receiver was fine. The declaring side is still the library, so this adds no
// direction -- a library file naming a library type is not a cycle.
type_name_cand("lib", mod, alias, "0", gk, 1) :-
    module_decl("lib", _, _, _, mod),
    cs_alias_framework_type(alias, qn),
    lib_type_named(qn, gk).

// A predefined name that did not resolve is PREDEFINED-UNSTAGED, not unresolved.
type_name_predefined_unstaged(prov, mod, n) :-
    type_name_unresolved(prov, mod, n, "0"), cs_predefined_alias(n).

// ── RESOLVING A WRITTEN TYPE NAME IN A MEMBER SIGNATURE ─────────────────────
// A parameter, field, property or local carries its type as TEXT as well as as a
// reference. The reference is the better source (it decomposes generics), but it is
// absent for some positions, so the text path is kept as a fallback. `List<IShape>`
// arrives as typeName `List` plus completeTypeName `List<IShape>`; the bare name and
// the ARGUMENT COUNT are what the lookup needs, and the count is recovered from the
// reference where there is one.
name_to_type(prov, mod, n, gk) :- type_name_resolves(prov, mod, n, "0", gk).
name_to_type(prov, mod, n, gk) :-
    type_name_resolves(prov, mod, n, ar, gk), ar != "0",
    !type_name_resolves(prov, mod, n, "0", _).
