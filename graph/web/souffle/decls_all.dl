// Every derived relation of the web engine (graph/web/engine/). Exported ones are listed in
// export_manifest.tsv; the bundle (graph/bundle/web/) reads them from raw/.
.decl web_external_url_kind(k:symbol)
.decl web_local_url_kind(k:symbol)
.decl web_link_sheet(page:symbol, sheet:symbol, ref:symbol, elem:symbol)
.decl web_ref_indexed_sheet(ref:symbol)
.decl web_link_sheet_unknown(page:symbol, ref:symbol, reason:symbol, url:symbol)
.decl web_import(from:symbol, to:symbol, vref:symbol)
.decl web_vref_indexed_import(vref:symbol)
.decl web_import_unknown(from:symbol, vref:symbol, reason:symbol, url:symbol)
.decl web_link_kind(kind:symbol)
.decl web_links_to(elem:symbol, page:symbol, to:symbol, ref:symbol, kind:symbol)
.decl web_defines_var(decl:symbol, name:symbol)
.decl web_uses_var(vref:symbol, name:symbol, decl:symbol)
// projections/elements.dl, projections/selectors.dl, containment/ownership.dl, resolution/selectors.dl
// (and web_page_sheet in resolution/loads.dl): structural selector matching
.decl web_el(el:symbol, page:symbol, parent:symbol)
.decl web_el_tag(el:symbol, tag:symbol)
.decl web_el_id(el:symbol, id:symbol)
.decl web_el_class(el:symbol, c:symbol)
.decl web_sel_part(sel:symbol, k:number, kind:symbol, name:symbol)
.decl web_sel_comb(sel:symbol, k:number, comb:symbol)
.decl web_sel_last(sel:symbol, n:number)
.decl web_rule_parent(r:symbol, p:symbol)
.decl web_rule_in_style(r:symbol)
.decl web_sel_unsupported(sel:symbol)
.decl web_sel_has(sel:symbol, k:number)
.decl web_selector_supported(sel:symbol)
.decl web_comp_cand(sel:symbol, k:number, el:symbol)
.decl web_comp_fail(sel:symbol, k:number, el:symbol)
.decl web_comp_ok(sel:symbol, k:number, el:symbol)
.decl web_sel_m(sel:symbol, k:number, el:symbol)
.decl web_sel_below(sel:symbol, k:number, el:symbol)
.decl web_page_sheet(page:symbol, sheet:symbol)
.decl web_selector_match(sel:symbol, page:symbol, el:symbol)
// ── executor knobs (written by run-souffle.sh for every language; unread here) ──
.decl dispatch_cap(c0:symbol)
.decl dispatch_closed_world(c0:symbol)
.decl jdk_max_depth(c0:number)
.decl lib_max_depth(c0:number)
.decl taint_gating(c0:symbol)
