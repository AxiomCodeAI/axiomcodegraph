<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE INSTRUMENTER. Rewrites a MIRROR of a subject's source so that every method
    body reports its own entry at run time, then the subject's own test suite is the
    workload.

    THE SUITE IS THE DRIVER, not a workload written for this measurement. A trace
    produced by a program someone wrote while looking at the engine's output measures
    the author.

    Pinned to the same Roslyn as the static oracle, so the two agree about what a
    method IS and produce the same join key for it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>axiom-cs-instrument</AssemblyName>
    <RootNamespace>AxiomCsInstrument</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

</Project>
