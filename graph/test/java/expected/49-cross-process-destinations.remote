http	exact	/api/items/{id}	testcases.destinations.ItemClient#viaLiteral(String) -> testcases.destinations.ItemController#get(String)
http	exact	/api/items/{id}	testcases.destinations.ItemClient#viaPost(String) -> testcases.destinations.ItemController#replace(String)
