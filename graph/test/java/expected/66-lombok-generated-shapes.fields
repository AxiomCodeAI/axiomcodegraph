known_edge	read	probe.Point#sum() -> probe.Point#y
known_edge	read	probe.Temp#kelvin() -> probe.Temp#degrees
known_edge	read	probe.Worker#work() -> generated:probe.Worker#log
known_edge	read	probe.Worker#work() -> probe.Worker#audit
