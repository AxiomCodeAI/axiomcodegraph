known_edge	FUNCTION_CALL	x#viaNamed(string) @L5 -> formats#fromArrow(?)
known_edge	FUNCTION_CALL	x#viaParam(Format,string) @L17 -> Format#<arrow@3>(string)
known_edge	METHOD_CALL	x#aliasNamespace(string) @L9 -> formats#fromAlias(?)
known_edge	METHOD_CALL	x#factoryNamespace(string) @L16 -> Format#<arrow@3>(string)
known_edge	METHOD_CALL	x#viaNamespace(string) @L4 -> formats#fromArrow(?)
