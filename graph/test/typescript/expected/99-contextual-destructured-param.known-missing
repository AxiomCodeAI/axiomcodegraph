# Accepted gaps for 99-contextual-destructured-param — each line is an edge the TypeScript compiler
# resolves and this engine does not. A NEW missing edge fails the suite;
# a line here that STARTS working also fails, so the debt cannot rot.
#
# The engine DOES resolve these three (they show as `extra` with the same target): the edge differs
# only in its caller's label. A function whose parameter is destructured is labelled with one slot
# per bound name as well as the pattern, `(?,?,?)` for `({ url, utils })`, where the compiler names
# one parameter. `annotated` had this before contextual typing was added; it is the label, not the edge.
use#<arrow@43>(?) -> Utils#send(string)
use#annotated(Ctx) -> Utils#send(string)
use#viaConst(?) -> Utils#send(string)
# A parameter typed by an object type LITERAL ({ utils: Other }) has a shape, not a type
# declaration, and a bound name reads only a declaration's fields. Not covered yet.
use#otherConst(?) -> Other#send(string)
