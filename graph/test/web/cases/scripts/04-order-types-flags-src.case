# shape: admin pages loading a dozen scripts: async/defer/nomodule, type as written in any case (Module, text/javascript), JSON-LD, client-side templates, an import map, speculation rules, and src forms (../, query string, CDN, missing)
kinds=script
@@@ file: src/js/app.mjs
@@@ file: src/js/legacy.js
@@@ file: src/js/vendor.js
@@@ file: src/pages/index.html
