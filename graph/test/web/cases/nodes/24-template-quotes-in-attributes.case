# shape: Django forms whose attribute values hold {% trans "..." %} with double quotes inside double-quoted values
# (placeholder, title, onclick): the template tag is rendered first, the value does not end at the inner quote (V3-11b)
kinds=attribute,handler
@@@ file: src/form.html
<!doctype html>
<html>
<body>
<input name="q" placeholder="{% trans "Search employees" %}" title="{{ _("Find") }}">
<button onclick="confirm('{% trans "Delete?" %}')" class="btn">x</button>
</body>
</html>
