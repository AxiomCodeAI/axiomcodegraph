# shape: theme CSS with build comments inside values (`.6em /*{radius}*/`, `Arial/*{ff}*/`), a CRLF inside a
# function value, and a comment inside a grouped selector (V4-05: text as stored, bytes = its UTF-8 length)
kinds=value_text,prelude_text
@@@ file: src/index.html
<!doctype html>
<html><head><link rel="stylesheet" href="s.css"></head><body><p class="a b">x</p></body></html>
