# shape: Django pages whose first line is {% load i18n static %} before <!DOCTYPE html>, next to a partial that
# starts with {% load %} and writes no <html> (V3-11: a page when it writes <html> or a doctype anywhere)
kinds=page,loads_sheet,styles
@@@ file: src/templates/page.html
{% load i18n static %}
<!DOCTYPE html>
<html lang="en">
<head>
<link rel="stylesheet" href="site.css">
</head>
<body>
<main class="m">{% trans "Hello" %}</main>
</body>
</html>
@@@ file: src/templates/part.html
{% load i18n %}
<div class="m">{% trans "Part" %}</div>
@@@ file: src/templates/site.css
.m { a: 1 }
