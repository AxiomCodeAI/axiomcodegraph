# shape: pages with srcset candidates, video posters, form actions, <base href>, meta refresh, data: URIs, mailto:, protocol-relative CDN links and template URLs
kinds=reference
@@@ file: src/favicon.ico
@@@ file: src/site/img/a.png
@@@ file: src/site/img/p.jpg
@@@ file: src/site/index.html
<!doctype html>
<html>
<head>
  <meta http-equiv="refresh" content="5; url=next.html">
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="//cdn.example.org/x.css">
</head>
<body>
  <img src="img/a.png" srcset="img/a.png 1x, img/a@2x.png 2x" alt="">
  <video src="v.mp4" poster="img/p.jpg"></video>
  <form action="search.html?q=1"><button formaction="other.html">go</button></form>
  <a href="mailto:x@example.org">mail</a>
  <img src="data:image/png;base64,AAAA">
  <a href="{{ url_for('home') }}">tpl</a>
  <a href="../up.html#sec">up</a>
</body>
</html>
