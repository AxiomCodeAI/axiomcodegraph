# shape: copy-pasted demo widgets: the same id twice on one page, with a label and aria-labelledby pointing at it
kinds=id,id_ref
@@@ file: src/index.html
<!doctype html>
<html>
<body>
  <input id="dup"><input id="dup">
  <label for="dup">ambiguous</label>
  <h2 id="t">title</h2>
  <section aria-labelledby="t missing"></section>
  <a href="#t">jump</a> <a href="#nowhere">broken</a>
</body>
</html>
