# shape: Alpine/Vue/Angular dashboards binding ids and state attributes (:id, x-bind:data-state, [attr.aria-expanded], id="row-{{ n }}") that sheets select on
kinds=styles,unknown
@@@ file: src/index.html
<!doctype html>
<html>
<head><link rel="stylesheet" href="s.css"></head>
<body>
<div class="tab" :id="'tab-' + n">t</div>
<button class="t" x-bind:data-state="open ? 'on' : 'off'">b</button>
<button class="t" data-state="on">static</button>
<nav [attr.aria-expanded]="isOpen">n</nav>
<li id="row-{{ n }}">r</li>
<div class="m" :class="{ open: o }" :data-k="k">m</div>
</body>
</html>
@@@ file: src/s.css
#tab-1 { a: 1 }
.t[data-state="on"] { a: 2 }
[aria-expanded="true"] { a: 3 }
#row-3 { a: 4 }
.m.open[data-k] { a: 5 }
.tab { a: 6 }
