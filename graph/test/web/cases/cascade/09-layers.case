# shape: a design-system sheet declaring @layer order up front, layered blocks, nested layers, @import layer() and unlayered overrides
kinds=cascade,layer
@@@ file: src/index.html
<!doctype html>
<html>
<head><link rel="stylesheet" href="s.css"></head>
<body>
<p class="p">x</p>
</body>
</html>
@@@ file: src/s.css
@layer reset, components;
@import url("vendor.css") layer(vendor);
@layer components { .p { a: 1 } }
@layer reset { p { a: 2 } }
@layer components.buttons { .p { a: 3 } }
@layer { .p { a: 4 } }
.p { a: 5 }
@@@ file: src/vendor.css
.p { a: 6 }
