# shape: table striping and list styling with nth-child formulas, nth-child(of S), and the -of-type family
kinds=styles
@@@ file: src/index.html
<!doctype html>
<html>
<head><link rel="stylesheet" href="s.css"></head>
<body>
<ul><li class="x">1</li><li>2</li><li class="x">3</li><li>4</li><li class="x">5</li></ul>
<div><p>a</p><span>b</span><p>c</p></div>
<section><em>only</em></section>
</body>
</html>
@@@ file: src/s.css
li:nth-child(2n+1) { a: 1 }
li:nth-child(even) { a: 2 }
li:nth-last-child(2) { a: 3 }
li:nth-child(2 of .x) { a: 4 }
li:first-child, li:last-child { a: 5 }
p:first-of-type { a: 6 }
p:last-of-type { a: 7 }
p:nth-of-type(2) { a: 8 }
em:only-child { a: 9 }
span:only-of-type { a: 10 }
li:nth-child(-n+2) { a: 11 }
