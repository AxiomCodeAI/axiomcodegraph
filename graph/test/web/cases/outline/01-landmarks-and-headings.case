# shape: dashboard pages mixing semantic landmarks, role= landmarks without the element (role=main on a div), named and unnamed sections, a named form, and headings incl. role=heading with aria-level
kinds=outline
@@@ file: src/index.html
<!doctype html>
<html>
<head>

</head>
<body>
<header><h1>Site</h1><nav aria-label="Main"><a>a</a></nav></header>
<div role="main"><section aria-label="Sales"><h2>Sales</h2></section><section><h3>Other</h3></section>
<article><div role="heading" aria-level="4">Note</div></article><form aria-label="Find"><input></form><form><input></form></div>
<aside><h2>Side</h2></aside><footer>f</footer>
</body>
</html>
