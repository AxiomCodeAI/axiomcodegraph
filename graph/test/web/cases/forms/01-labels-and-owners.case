# shape: admin forms with labels by for=, by wrapping, by aria-labelledby, aria-label and title, unlabelled controls, a control owned through form= from outside, a hidden input, a contenteditable editor and a duplicate id that steals the label
kinds=form,form_control
@@@ file: src/index.html
<!doctype html>
<html>
<head>

</head>
<body>
<form id="f" action="save.html" method="POST">
<label for="name">Name</label><input id="name" name="name" required>
<label>Age <input name="age" type="number"></label>
<span id="ql">Query</span><input name="q" aria-labelledby="ql">
<input name="s" aria-label="Search">
<select name="c" title="Country"></select>
<textarea name="n"></textarea>
<input type="hidden" name="tok">
<button>Save</button>
</form>
<input name="ext" form="f">
<div contenteditable="true">edit</div>
<label for="dup">Dup</label><span id="dup">first</span><input id="dup" name="d">
</body>
</html>
@@@ file: src/save.html
<!doctype html>
<html>
<head>

</head>
<body>
<p>ok</p>
</body>
</html>
