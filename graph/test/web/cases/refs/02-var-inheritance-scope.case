# shape: component sheets defining a custom property on one component and using it in a sibling component (no inheritance path) and in a descendant
kinds=var
check=var_budget
@@@ file: src/index.html
<!doctype html>
<html>
<head>
<link rel="stylesheet" href="s.css">
</head>
<body>
<div class="card"><p class="body">x</p></div><div class="other">y</div>
</body>
</html>
@@@ file: src/s.css
.card { --pad: 4px; }
.card .body { padding: var(--pad); }
.other { padding: var(--pad); }
.card:hover { --hov: 1; }
.body { opacity: var(--hov); }
