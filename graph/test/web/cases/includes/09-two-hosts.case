# shape: one card partial included by two pages that load different stylesheets (an admin page with a dark theme
# sheet and a public page with the light one): each host decides the partial's rules
kinds=page,include,host_styles,usage,unknown
@@@ file: src/a.html
<!doctype html>
<html>
<head>
<link rel="stylesheet" href="css/a.css">
</head>
<body class="light">
<include src="parts/card.html"></include>
</body>
</html>
@@@ file: src/b.html
<!doctype html>
<html>
<head>
<link rel="stylesheet" href="css/b.css">
</head>
<body class="dark">
<div><include src="parts/card.html"></include></div>
</body>
</html>
@@@ file: src/css/a.css
.card { color: red }
.card .t { a: 1 }
@@@ file: src/css/b.css
.card { color: blue }
.dark .card .t { a: 2 }
.light .card { a: 3 }
@@@ file: src/parts/card.html
<div class="card"><h3 class="t">x</h3></div>
