# shape: a widget partial carrying its own <link> to a widget sheet and a <style>, included by one page before the
# page's own sheet and by another after it: each host loads the partial's sheets at the include site, in its own
# load order (iter4 orchestrator: loads_sheet per host, via_include), and a hostless copy leaves its sheet orphan
kinds=loads_sheet,loads_via_include,unknown,host_styles,styles
@@@ file: src/a.html
<!doctype html>
<html>
<head>
<include src="parts/widget.html"></include>
<link rel="stylesheet" href="css/page.css">
</head>
<body><p class="w">a</p></body>
</html>
@@@ file: src/b.html
<!doctype html>
<html>
<head>
<link rel="stylesheet" href="css/page.css">
</head>
<body>
<p class="w">b</p>
<include src="parts/widget.html"></include>
</body>
</html>
@@@ file: src/css/old.css
.o { a: 1 }
@@@ file: src/css/page.css
.w { a: 1 }
@@@ file: src/css/widget.css
.w { b: 1 }
@@@ file: src/parts/unused.html
<link rel="stylesheet" href="../css/old.css">
<div class="o">o</div>
@@@ file: src/parts/widget.html
<link rel="stylesheet" href="css/widget.css">
<style>.w { c: 1 }</style>
<div class="w">w</div>
