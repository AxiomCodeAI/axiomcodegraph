# shape: a dashboard shell whose layout partial itself includes a widget partial (<include src> two levels deep,
# the inner src relative to the partial's own directory)
kinds=page,include,host_styles,styles,unknown
@@@ file: src/css/app.css
.shell .b { a: 1 }
.shell > .a { a: 2 }
.a > .b { a: 3 }
.b { a: 4 }
.shell > .b { a: 5 }
@@@ file: src/index.html
<!doctype html>
<html>
<head>
<link rel="stylesheet" href="css/app.css">
</head>
<body>
<div class="shell"><include src="parts/a.html"></include></div>
</body>
</html>
@@@ file: src/parts/a.html
<section class="a"><include src="b.html"></include></section>
@@@ file: src/parts/b.html
<span class="b">b</span>
