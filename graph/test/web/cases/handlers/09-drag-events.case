# shape: kanban boards with native drag and drop
kinds=handler
@@@ file: src/index.html
<!doctype html>
<html>
<head>

</head>
<body>
<li draggable="true" ondragstart="ds(event)" ondrag="d()" ondragend="de()">card</li>
<ul ondragenter="den()" ondragover="dov(event)" ondragleave="dl()" ondrop="drop(event)"></ul>
</body>
</html>
