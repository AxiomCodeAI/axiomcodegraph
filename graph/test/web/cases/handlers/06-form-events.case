# shape: admin forms validated inline
kinds=handler
@@@ file: src/index.html
<!doctype html>
<html>
<head>

</head>
<body>
<form onsubmit="return check(this)" onreset="clear()" onformdata="add(event)">
<input oninput="live(this)" onchange="save(this)" oninvalid="mark(this)" onbeforeinput="guard(event)">
</form>
</body>
</html>
