# shape: legacy admin markup: on* attributes in every letter case, code verbatim (braces, entities, multiple lines), and attributes that only look like handlers
kinds=handler
@@@ file: src/index.html
<!doctype html>
<html>
<head>

</head>
<body>
<button onclick="if(x){y()}">a</button>
<button onClick="x">b</button>
<button ONCLICK="save(&quot;a&quot;)">c</button>
<div onMouseOver="hover(1);
  track()">d</div>
<div on-foo="bar()">e</div>
<div onclick2="x">f</div>
<div once>g</div>
<div data-onclick="nope()">h</div>
<div title="onclick=evil()">i</div>
<input onkeyup="">
<div onboarding="tour()">j</div>
</body>
</html>
