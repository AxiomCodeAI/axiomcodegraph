# shape: Tailwind-like utility classes with no rule, classes named by rules that match no carrier, and classes styled normally
kinds=class
@@@ file: src/index.html
<!doctype html>
<html>
<head>
<link rel="stylesheet" href="s.css">
</head>
<body>
<div class="card flex mt-4"><p class="title">x</p></div><span class="badge">b</span>
</body>
</html>
@@@ file: src/s.css
.card { a: 1 }
.card .title { a: 2 }
ul .badge { a: 3 }
.never { a: 4 }
