// ============================================================================
// CALL-EDGE-GEN · CLIENT CALL EDGES
//
// Resolved call-graph edges out of client call sites, split by whether the callee
// is CLIENT or LIBRARY code. A library here is a dependency parsed FROM SOURCE and
// staged with --library; its methods are lib_js_method rows and an edge into one is
// `client_calls_lib` — a real method hash in the library IR, not a name.
//
// Row: CallerProv  CallSiteExpr  CalleeProv  CalleeMethod
//
// ── STRATIFICATION ──────────────────────────────────────────────────────────
// A leaf. Reads the resolution output and feeds nothing back, so the negations
// here are legal.
// ============================================================================

method_prov(m, "client") :- method_decl("client", _, _, _, _, _, _, m).
method_prov(m, "lib") :- method_decl("lib", _, _, _, _, _, _, m).

client_calls_client("client", ce, "client", callee) :- expr_resolves_to_method(ce, callee),
    call_site("client", _, _, _, _, _, ce, _, _),
    method_prov(callee, "client").

client_calls_lib("client", ce, "lib", callee) :- expr_resolves_to_method(ce, callee),
    call_site("client", _, _, _, _, _, ce, _, _),
    method_prov(callee, "lib").

// ── client_calls_lib_detail — the navigation row ────────────────────────────
client_calls_lib_detail(ce, callee, pkg, file, line) :- client_calls_lib(_, ce, _, callee),
    method_module(callee, lmod),
    lib_module_origin(lmod, pkg),
    method_lines("lib", file, line, _, callee).
lib_module_origin(m, pkg) :- module_package("lib", pkg, m).
lib_module_origin(m, qn) :- module_decl("lib", _, qn, _, _, m), !module_package("lib", _, m).

// ── unresolved_receiver(CallExpr, CalleeName, Kind, Reason) ─────────────────
// A DECLARED blind spot with its cause attached:
//
//   receiver_untyped   the receiver expression got no value at all — an unstaged
//                      dependency, a parameter nobody visible passes, a value the
//                      flow rules do not model
//   member_absent      the receiver WAS valued and the value has no member of that
//                      name — an engine or parser defect, the row to read first
//   callee_untyped     a receiverless call whose callee expression has no value
//   no_target          the callee was valued but nothing callable came of it
//   dynamic            a computed name, eval, or import() — complete by saying so
call_resolved(ce) :- expr_resolves_to_method(ce, _).
call_resolved(ce) :- call_target_is_implicit_ctor(ce).

unresolved_receiver(ce, cn, ck, "receiver_untyped") :- call_site("client", ck, cn, "SYNTACTIC", _, _, ce, _, _),
    !call_resolved(ce), !receiver_value_known(ce), !call_kind_is_dynamic(ck).
unresolved_receiver(ce, cn, ck, "member_absent") :- call_site("client", ck, cn, "SYNTACTIC", _, _, ce, _, _),
    !call_resolved(ce), receiver_value_known(ce), !callee_value_known(ce), !call_kind_is_dynamic(ck).
unresolved_receiver(ce, cn, ck, "no_target") :- call_site("client", ck, cn, _, _, _, ce, _, _),
    !call_resolved(ce), callee_value_known(ce), !call_kind_is_dynamic(ck).
unresolved_receiver(ce, cn, ck, "callee_untyped") :- call_site("client", ck, cn, rp, _, _, ce, _, _), rp != "SYNTACTIC",
    !call_resolved(ce), !callee_value_known(ce), !call_kind_is_dynamic(ck).
// A receiver or callee that is a parameter of a capped function: see fan-cap.dl.
unresolved_receiver(ce, cn, ck, "param_fan_capped") :- call_site("client", ck, cn, "SYNTACTIC", _, _, ce, _, _),
    !call_resolved(ce), expr_child(_, ce, "RECEIVER", _, r), expr_param(_, p, r), param_fan_capped(p, _).
unresolved_receiver(ce, cn, ck, "param_fan_capped") :- call_site("client", ck, cn, _, _, _, ce, _, _),
    !call_resolved(ce), expr_child(_, ce, "CALLEE", _, c), expr_param(_, p, c), param_fan_capped(p, _).
unresolved_receiver(ce, cn, ck, "dynamic") :- call_site("client", ck, cn, _, _, _, ce, _, _),
    !call_resolved(ce), call_kind_is_dynamic(ck).
// Conservation over the diagnostic table too: any unresolved site the reasons
// above did not cover. Written over the CONDITIONS of the rules above, never over
// their head — a negation of unresolved_receiver from inside a rule that derives
// it is a cycle.
unresolved_covered(ce) :- call_site("client", ck, _, "SYNTACTIC", _, _, ce, _, _), !call_kind_is_dynamic(ck).
unresolved_covered(ce) :- call_site("client", ck, _, _, _, _, ce, _, _), callee_value_known(ce), !call_kind_is_dynamic(ck).
unresolved_covered(ce) :- call_site("client", ck, _, rp, _, _, ce, _, _), rp != "SYNTACTIC", !call_kind_is_dynamic(ck).
unresolved_covered(ce) :- call_site("client", ck, _, _, _, _, ce, _, _), call_kind_is_dynamic(ck).
unresolved_receiver(ce, cn, ck, "other_form") :- call_site("client", ck, cn, _, _, _, ce, _, _),
    !call_resolved(ce), !unresolved_covered(ce).

// ── library_receiver(CallExpr, Specifier) ───────────────────────────────────
// An unresolved member call whose receiver is a PACKAGE'S value: a binding imported
// from a package no staged IR declares, a member of one, what calling or constructing
// one returns, and a const holding any of those — `request(app).get('/x').expect(200)`,
// `new grpc.Metadata().get(k)`, `const md = new Metadata(); md.get(k)`. The receiver's
// origin is known, so the site is not an untyped `x.get()`: a project method of the
// same name is not what it calls. It stays unresolved (the package is not staged), and
// consumers list it apart from the name matches on unknown receivers rather than
// among them. Read off the source, never the value flow, so it cannot invent a value.
// A call handed a project INSTANCE is left out: a wrapper, a proxy or a mock helper
// may return the very object it was given (`mocked(repo).get(1)`).
// A package is named by a bare specifier: a relative or absolute path that reached no
// file (`require('./not-here')`) is a missing PROJECT module, and an alias (`@/x`, `~/x`,
// `#x`) may map onto the project's own source.
package_import(imp, spec) :- import_decl(_, spec, _, _, _, _, out, _, imp), import_outcome_is_package(out),
    !match("[.#~/].*", spec), !match("@/.*", spec).
library_value(e, spec) :- expr_kind(_, "IDENTIFIER", _, e), expr_binding(_, v, e), var_import(_, imp, v),
    package_import(imp, spec).
library_value(e, spec) :- expr_kind(_, "MODULE_EDGE_CALL", _, e), expr_module_edge(_, imp, e), package_import(imp, spec).
library_value(e, spec) :- expr_kind(_, k, _, e), access_kind_reads_member(k), expr_child(_, e, "ACCESS_TARGET", _, r),
    library_value(r, spec).
library_value(e, spec) :- expr_kind(_, k, _, e), (k = "CALL" ; k = "NEW"), expr_child(_, e, role, _, c),
    (role = "CALLEE" ; role = "RECEIVER"), library_value(c, spec), !call_passes_project_instance(e).
library_value(e, spec) :- expr_kind(_, "AWAIT", _, e), expr_child(_, e, _, _, c), library_value(c, spec).
library_value(e, spec) :- expr_kind(_, "IDENTIFIER", _, e), expr_binding(_, v, e), !var_import(_, _, v),
    var_init("client", _, i, v), !variable_reassigned(v), library_value(i, spec).
call_passes_project_instance(e) :- call_arg(e, _, a), expr_value(a, "inst", _).
library_receiver(ce, spec) :- call_site("client", ck, _, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    !call_resolved(ce), expr_child(_, ce, "RECEIVER", _, r), library_value(r, spec).

// ── unresolved_value_callee(CallExpr, Binding) ──────────────────────────────
// An unresolved call whose callee is a VALUE, not a name: `cb()` on a parameter,
// `f()` on a loop variable or a local, `table[k]()`, `eval(s)`. Nothing about its
// name narrows what it calls, so any function that escapes as a value may be the
// callee, and a question that finds no chain from its caller must answer "unknown",
// never "independent" (#1649). Binding: parameter | loop_variable | local |
// computed | dynamic_code | module_variable | field | instance_member |
// parameter_member | expression | imported_variable. An imported binding is one only
// when it names a variable its module reassigns (below); otherwise it names a module
// member.
value_callee_open(ce, c) :- call_site("client", ck, _, _, _, _, ce, _, _), !call_kind_is_dynamic(ck),
    !call_resolved(ce), !callee_value_known(ce), expr_child(_, ce, "CALLEE", _, c).
unresolved_value_callee(ce, "parameter") :- value_callee_open(ce, c), expr_param(_, _, c).
unresolved_value_callee(ce, "loop_variable") :- value_callee_open(ce, c), expr_binding(_, v, c), loop_head(v, _).
unresolved_value_callee(ce, "local") :- value_callee_open(ce, c), expr_binding(_, v, c), !loop_head(v, _),
    var_owner_method("client", _, v), !var_import(_, _, v), !expr_param(_, _, c).
// The two below keep a callee whose value IS known but calls nothing the graph holds
// (`let handler = null`, a constructed `Function`): the value in the graph is not
// the one the call runs.
value_callee_unresolved(ce, c) :- call_site("client", ck, _, _, _, _, ce, _, _), !call_kind_is_dynamic(ck),
    !call_resolved(ce), expr_child(_, ce, "CALLEE", _, c).
// `let handler = null; … handler()`: a module-level variable holds whatever a setter
// or an importer stored in it (#1675). One holding a platform function
// (`let f = Math.floor`) is a platform call; `null` is a literal, not a function.
unresolved_value_callee(ce, "module_variable") :- value_callee_unresolved(ce, c), expr_binding(_, v, c),
    var_decl("client", _, _, _, _, _, v), !var_owner_method("client", _, v), !var_import(_, _, v), !expr_param(_, _, c),
    !callee_platform_function(ce), !module_variable_from_call(v).
callee_platform_function(ce) :- callee_value(ce, "ambient", n), n != "LITERAL".
// `const log = require('debug')('app')`: a variable only ever holding what a call
// returned holds a function the library made, not one a setter stored. One that
// was handed a function (`const Card = memo(Inner)`) may call it, so stays open.
module_variable_from_call(v) :- var_init("client", _, e, v), expr_kind(_, k, _, e), (k = "CALL" ; k = "NEW"),
    !variable_reassigned(v), !call_passes_function(e).
call_passes_function(e) :- call_arg(e, _, a), expr_value(a, "func", _).
call_passes_function(e) :- call_arg(e, _, a), expr_introduces(_, _, a).
// `promisify(store.find.bind(store))`: a `.bind` always evaluates to a function, typed
// receiver or not. A bound platform function (`Math.max.bind(Math)`) is the platform's.
call_passes_function(e) :- call_arg(e, _, a), call_site(_, "FUNCTION_CALL_BIND", _, _, _, _, a, _, _),
    expr_child(_, a, "CALLEE", _, f), !bound_platform_function(f).
bound_platform_function(f) :- expr_kind(_, "PROPERTY_ACCESS", _, f), expr_child(_, f, "ACCESS_TARGET", _, r),
    expr_value(r, "ambient", _).
// A holder whose value is what a PLATFORM call returned when handed a project function
// (`this.find = promisify(s.find.bind(s))`, `const f = util.callbackify(g)`): the value
// is a wrapper the platform made around that function, and calling it runs the
// function. The platform value on the holder made the call an ambient terminal, a
// claimed correct end, and path said "independent" of the very method the wrapper
// runs. A platform value made from no project function (`promisify(setTimeout)`)
// keeps its platform reading.
// When the graph knows the function the wrapper was made from (a function value, or
// the method a `.bind` site resolves to), the call runs it: one of a set, beside the
// platform row the call keeps. Only when it knows none is the callee an open value.
unresolved_value_callee(ce, "field") :- wrapper_holder_call(ce, val), !wrapper_call_target(ce, _), made_from_function(val),
    field_call(ce, _, _, _).
unresolved_value_callee(ce, "module_variable") :- wrapper_holder_call(ce, e), !wrapper_call_target(ce, _), made_from_function(e),
    !field_call(ce, _, _, _).
wrapper_holder_call(ce, val) :- field_call(ce, k, t, n), !call_resolved(ce), field_assignment(k, t, n, val).
wrapper_holder_call(ce, e) :- value_callee_unresolved(ce, c), expr_binding(_, v, c),
    var_decl("client", _, _, _, _, _, v), !var_owner_method("client", _, v), !var_import(_, _, v), !expr_param(_, _, c),
    var_init("client", _, e, v), !variable_reassigned(v).
made_from_function(e) :- expr_kind(_, "CALL", _, e), expr_value(e, "ambient", _), call_passes_function(e).
wrapper_runs(e, m) :- made_from_function(e), call_arg(e, _, a), expr_value(a, "func", m).
wrapper_runs(e, m) :- made_from_function(e), call_arg(e, _, a), call_site(_, "FUNCTION_CALL_BIND", _, _, _, _, a, _, _),
    expr_resolves_to_method(a, m).
wrapper_call_target(ce, m) :- wrapper_holder_call(ce, e), wrapper_runs(e, m), call_target_count(ce, 0).
call_chain_edge(ce, caller, "-", m, "client", "multi_inferred", kind) :-
    wrapper_call_target(ce, m), !call_over_cap(ce), call_from(ce, caller), invocation_site(ce, kind).
variable_reassigned(v) :- expr_kind(_, "ASSIGNMENT", _, a), expr_child(_, a, "ASSIGNMENT_TARGET", _, tgt),
    expr_binding(_, v, tgt).
// `(c ? a : b)()`, `(0, cb)()`, `make()()`: the callee is computed by an expression.
// `new Function(s)()` / `Function(s)()` runs code built at run time.
unresolved_value_callee(ce, "dynamic_code") :- value_callee_unresolved(ce, c), callee_builds_code(c).
unresolved_value_callee(ce, "expression") :- value_callee_open(ce, c), expr_kind(_, k, _, c),
    k != "IDENTIFIER", k != "THIS", k != "SUPER", !callee_builds_code(c).
callee_builds_code(c) :- expr_kind(_, k, _, c), (k = "NEW" ; k = "CALL"), expr_child(_, c, "CALLEE", _, f),
    expr_text(_, "Function", f), expr_binding_resolution(_, "GLOBAL_BUILTIN", f).
// `this.cb()` where `cb` is a field (`this.cb = cb`), not a method: the function
// stored there is whatever the constructor or a setter was handed. The same for
// `self.cb()` (`const self = this`), a static `this.cb()`, `new this.Ctor()`, and a
// field that holds only `null` until a setter runs.
unresolved_value_callee(ce, "field") :- field_call(ce, k, t, n), !call_resolved(ce), !callee_holds_function(ce),
    this_field_named(k, t, n).
// `this.cb = cb || function () {}`: the call resolves to the fallback, but the
// parameter it falls back from is a function no caller in the graph supplies.
unresolved_value_callee(ce, "field") :- field_call(ce, k, t, n), field_open_fallback(k, t, n).
// `this.hook()` where neither the class, an ancestor, nor any write the graph can
// follow gives it a `hook`: the function is stored on the instance from outside,
// through another reference (`e.hook = fn`) or a copy (`Object.assign(this, opts)`)
// (#1709). A class with a base the graph could not resolve is left out: that base
// may declare `hook`, and then the call names a method, not a value.
unresolved_value_callee(ce, "instance_member") :- field_call(ce, "inst", t, n), !call_resolved(ce),
    !callee_value_known(ce), !ambient_site(ce), !this_field_named("inst", t, n), !this_type_open(t),
    expr_child(_, ce, "RECEIVER", _, r), expr_kind(_, "THIS", _, r).
this_type_open(t) :- heritage_unresolved(t, _, _).
this_type_open(t) :- heritage_dynamic(t, _).
this_type_open(t) :- type_ancestor(t, a), heritage_unresolved(a, _, _).
this_type_open(t) :- type_ancestor(t, a), heritage_dynamic(a, _).
field_call(ce, k, t, n) :- call_site("client", ck, n, "SYNTACTIC", _, _, ce, _, _),
    (call_kind_is_member_form(ck) ; ck = "CONSTRUCTOR_CALL"), !call_kind_is_dynamic(ck),
    expr_child(_, ce, "RECEIVER", _, r), instance_or_class_value(r, k, t).
instance_or_class_value(r, k, t) :- expr_kind(_, rk, _, r), (rk = "THIS" ; rk = "IDENTIFIER"), expr_value(r, k, t),
    (k = "inst" ; k = "ctor").
callee_holds_function(ce) :- callee_value(ce, k, n), (k = "func" ; k = "ctor" ; (k = "ambient", n != "LITERAL")).
callee_holds_function(ce) :- new_callee_value(ce, _, _).
this_field_named(k, t, n) :- field_decl("client", n, t, _, _, _, _, _), (k = "inst" ; k = "ctor").
this_field_named(k, t, n) :- type_ancestor(t, a), field_decl("client", n, a, _, _, _, _, _), (k = "inst" ; k = "ctor").
this_field_named(k, t, n) :- field_assignment(k, t, n, _).
field_assignment(k, t, n, val) :- expr_kind(_, "ASSIGNMENT", _, a), expr_child(_, a, "ASSIGNMENT_TARGET", _, tgt),
    expr_kind(_, "PROPERTY_ACCESS", _, tgt), expr_name(_, n, tgt), expr_child(_, tgt, "ACCESS_TARGET", _, r),
    instance_or_class_value(r, k, t), expr_child(_, a, "ASSIGNMENT_VALUE", _, val).
field_open_fallback(k, t, n) :- field_assignment(k, t, n, val), expr_kind(_, "BINARY", _, val), expr_operator(_, op, val),
    (op = "||" ; op = "??"), expr_child(_, val, "OPERAND", _, p), expr_param(_, _, p), !expr_value(p, "func", _).
// A callback in an options object: a member of an untyped parameter that the code
// treats as an optional FUNCTION — `opts.onReady?.()`, `typeof opts.onReady ===
// 'function'`, `opts.onReady && opts.onReady()`. A bare `res.send()` / `s.trim()` on
// an untyped parameter is left out: without a type it reads the same as a library
// or platform method, and counting it made 10 of 12 independent pairs on a real
// Express app unknown.
unresolved_value_callee(ce, "parameter_member") :- call_site("client", ck, n, "SYNTACTIC", _, _, ce, _, _),
    call_kind_is_member_form(ck), !call_kind_is_dynamic(ck), !call_resolved(ce), !callee_value_known(ce),
    !ambient_site(ce), expr_child(_, ce, "RECEIVER", _, r), expr_param(_, p, r),
    (ck = "OPTIONAL_CALL" ; param_member_tested(p, n)).
param_member_tested(p, n) :- expr_kind(_, "UNARY", _, u), expr_operator(_, "typeof", u), expr_child(_, u, _, _, a),
    param_member_read(a, p, n).
param_member_tested(p, n) :- expr_kind(_, "BINARY", _, b), expr_operator(_, op, b), (op = "&&" ; op = "||" ; op = "??"),
    expr_child(_, b, "OPERAND", _, a), param_member_read(a, p, n).
param_member_tested(p, n) :- expr_child(_, _, "CONDITION", _, a), param_member_read(a, p, n).
param_member_tested(p, n) :- expr_root(_, "CONDITION", a), param_member_read(a, p, n).
param_member_read(a, p, n) :- expr_kind(_, k, _, a), (k = "PROPERTY_ACCESS" ; k = "OPTIONAL_ACCESS"), expr_name(_, n, a),
    expr_child(_, a, "ACCESS_TARGET", _, t), expr_param(_, p, t).
unresolved_value_callee(ce, "computed") :- call_site("client", "COMPUTED_CALL", _, _, _, _, ce, _, _), !call_resolved(ce).
unresolved_value_callee(ce, "dynamic_code") :- call_site("client", "DYNAMIC_CODE_CALL", _, _, _, _, ce, _, _), !call_resolved(ce).
// `import { handler } from './hub'; handler()` or `hub.handler()` through a namespace,
// where hub does `export let handler = null` and reassigns it in a setter (#1708): an
// ES import is a LIVE binding, so the call runs whatever the setter stored last. The
// callee's value may be known (`null`) and still not be the one the call runs. An
// export the module never reassigns keeps its answer: its value is the one it holds.
unresolved_value_callee(ce, "imported_variable") :- value_callee_unresolved(ce, c), expr_binding(_, v, c),
    var_import("client", imp, v), import_decl(_, _, _, bf, n, _, _, _, imp), import_binding_is_named(bf), n != "",
    import_module(imp, mod), live_export_variable(mod, n).
unresolved_value_callee(ce, "imported_variable") :- call_site("client", ck, n, _, _, _, ce, _, _),
    call_kind_is_member_form(ck), !call_kind_is_dynamic(ck), !call_resolved(ce),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "module", mod), live_export_variable(mod, n).
// live_export_variable(Module, Name): the module exports, under Name, a variable some
// code assigns after its declaration — directly, or re-exported by name or by `export *`.
live_export_variable(mod, n) :- export_decl(_, n, _, _, _, "VARIABLE", v, _, mod, x), n != "", !export_overwritten(_, x),
    variable_reassigned(v).
live_export_variable(mod, en) :- export_decl(_, en, ln, form, _, _, _, _, mod, x), form != "EXPORT_ALL", ln != "",
    export_reexport(_, _, imp, x), import_module(imp, src), live_export_variable(src, ln).
live_export_variable(mod, n) :- export_decl(_, en, _, "EXPORT_ALL", _, _, _, _, mod, x), export_all_is_spread(en),
    export_reexport(_, _, imp, x), import_module(imp, src), live_export_variable(src, n), n != "default".
