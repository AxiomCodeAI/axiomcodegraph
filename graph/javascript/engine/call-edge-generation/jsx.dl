// ============================================================================
// CALL-EDGE-GEN · JSX ELEMENTS  (`<Component …/>` renders Component)
//
// A JSX element whose tag is a reference — `<TodoList/>`, `<ui.Panel/>` — is a call
// of that component by the renderer: a function component runs with the element's
// props as its first argument; a class component is constructed with them and its
// `render` runs. The parser emits the element as a JSX_ELEMENT expression with the
// tag under JSX_TAG_NAME and each attribute as a JSX_ATTRIBUTE_VALUE row (role
// PROPERTY_KEY, name = the prop) whose PROPERTY_VALUE child is the value. No
// js_call_site row exists for it, so before this file the element was neither an
// edge nor a miss: `impact TodoList` answered "nothing uses it".
//
// An INTRINSIC tag (`<div/>`, `<my-element/>`) is JSX_INTRINSIC_ELEMENT and has no
// tag reference: it names no project code and gets no row here.
//
// Two effects, both through the ordinary value layer:
//   1. an edge per element: call_chain_edge(Element, Caller, -, Component, …,
//      "JSX_ELEMENT"), tiered like a call (one target known_edge, several
//      multi_inferred); a tag with no value is ambiguous_unknown — a declared miss,
//      never silence.
//   2. the element's attributes are an object value keyed by the element, and it is
//      what the component receives: `<TodoItem onToggle={handleToggle}/>` makes
//      `onToggle(todo)` inside `TodoItem({ onToggle })` resolve to handleToggle.
//      Brace children are the `children` prop (a render prop is a function).
//
// A tag bound to a component WRAPPER (`memo(C)`, `forwardRef(fn)`, `observer(C)`,
// `withRouter(C)`) or a LOADER (`lazy(() => import("./x"))`) renders what the wrapper
// was handed or what the loader settles to — see "wrapped and lazy components" below.
// Redux's curried `connect(…)(C)` is such a wrapper, and it also hands C the props its
// map functions return; React context hands `useContext(Ctx)` the provider's `value`
// — see "props that come from outside the element" below. Not modelled: other curried
// wrappers.
// ============================================================================

// ── the element and what its tag holds ──────────────────────────────────────
jsx_element_tag(je, tag) :- expr_kind(_, "JSX_ELEMENT", _, je), expr_child(_, je, "JSX_TAG_NAME", _, tag).
jsx_tag_value(je, k, i) :- jsx_element_tag(je, tag), expr_value(tag, k, i).
// A CommonJS module value renders through its default export, as a call of it does.
jsx_tag_value(je, k, i) :- jsx_element_tag(je, tag), expr_value(tag, "module", mod),
    module_export_value(mod, "default", k, i), k != "module".
// A tag that holds a wrapper or loader call renders what that call renders.
jsx_tag_value(je, k, i) :- jsx_element_tag(je, tag), jsx_holds(tag, w), jsx_call_renders(w, k, i).

// ── wrapped and lazy components ─────────────────────────────────────────────
// `const Card = memo(Inner)` binds Card to what memo RETURNED, and memo's library is
// usually not staged, so the tag has no value and the element was an ambiguous_unknown
// row. What renders is argument 0. JSX only, and NOT an expr_value of the call: at an
// ordinary call site `wrap(f)` is a factory whose argument says nothing about what
// runs, and valuing the call would turn every `Card()` blind spot into a claimed
// no_target. The wrappers are named by the libraries that define them — `memo` and
// `forwardRef` (React, Preact), `observer` (MobX) — and by the higher-order-component
// convention, a `with` prefix and a capital. Read off the callee name, so
// `React.memo(…)` counts as `memo(…)`.
jsx_wrapper_name("memo").
jsx_wrapper_name("forwardRef").
jsx_wrapper_name("observer").
jsx_component_wrapper(w) :- expr_kind(_, "CALL", _, w), call_site("client", _, n, _, _, _, w, _, _), jsx_wrapper_name(n).
jsx_component_wrapper(w) :- expr_kind(_, "CALL", _, w), call_site("client", _, n, _, _, _, w, _, _), match("with[A-Z].*", n).
// A LOADER — `lazy(() => import("./Settings"))`, Next.js `dynamic(…)`, `loadable(…)`:
// argument 0 returns a module or a promise of one, and what renders settles out of it.
jsx_loader_name("lazy").
jsx_loader_name("dynamic").
jsx_loader_name("loadable").
jsx_component_loader(w) :- expr_kind(_, "CALL", _, w), call_site("client", _, n, _, _, _, w, _, _), jsx_loader_name(n).
// A Vue DEFINER — `defineComponent({ setup() {…} })` (Nuxt: `defineNuxtComponent`): the
// tag invokes the options object's `setup` with its props, or its `render` when there is
// no setup; a render function setup returns is reached from setup's body. The function
// form, `defineComponent((props) => () => …)`, is argument 0 itself, as for memo. Named by
// the definer, so the same object handed to any other call stays out.
jsx_vue_definer_name("defineComponent").
jsx_vue_definer_name("defineNuxtComponent").
jsx_vue_definer(w) :- expr_kind(_, "CALL", _, w), call_site("client", _, n, _, _, _, w, _, _), jsx_vue_definer_name(n).
// Redux `connect(mapState, mapDispatch)(C)`: the OUTER call is the wrapper, its argument
// 0 the component. Keyed on the callee being a call of `connect`, so a plain
// `connect(db)` or a `connect(…)` whose result is not called again stays out.
jsx_connect_call(w, inner) :- expr_kind(_, "CALL", _, w), expr_child(_, w, "CALLEE", _, inner),
    expr_kind(_, "CALL", _, inner), call_site("client", _, "connect", _, _, _, inner, _, _).
jsx_component_wrapper(w) :- jsx_connect_call(w, _).
// React `createContext(…)`: not a wrapper, but it reaches `<Ctx.Provider>` and
// `useContext(Ctx)` the ways a component reaches a tag, so jsx_holds follows it too.
// No jsx_call_renders rule reads it: holding a context renders nothing.
jsx_context_create(c) :- expr_kind(_, "CALL", _, c), call_site("client", _, "createContext", _, _, _, c, _, _).

// jsx_holds(Expr, Call) — the wrapper or loader call an expression holds, followed the
// ways a component reaches a tag: the call itself, a const initialised with it, a named
// or default import of an export that holds it, and a re-export of one.
jsx_holds(w, w) :- jsx_component_wrapper(w).
jsx_holds(w, w) :- jsx_component_loader(w).
jsx_holds(w, w) :- jsx_vue_definer(w).
jsx_holds(c, c) :- jsx_context_create(c).
jsx_holds(e, w) :- expr_binding(_, v, e), jsx_var_holds(v, w).
jsx_var_holds(v, w) :- var_init(_, _, e, v), !var_binding_form(_, "OBJECT_PATTERN", v), !var_binding_form(_, "ARRAY_PATTERN", v),
    jsx_holds(e, w).
jsx_var_holds(v, w) :- var_import(_, imp, v), jsx_import_holds(imp, w).
jsx_import_holds(imp, w) :- import_decl(_, _, _, "DEFAULT", _, _, _, _, imp), import_module(imp, mod),
    jsx_export_holds(mod, "default", w).
jsx_import_holds(imp, w) :- import_decl(_, _, _, bf, n, _, _, _, imp), import_binding_is_named(bf), n != "",
    import_module(imp, mod), jsx_export_holds(mod, n, w).
jsx_export_holds(mod, n, w) :- export_decl(_, n, _, _, _, "VARIABLE", v, _, mod, x), n != "", v != "",
    !export_overwritten(_, x), jsx_var_holds(v, w).
// `export default memo(Inner)` / `export default Card` — the source expression.
jsx_export_holds(mod, n, w) :- export_decl(_, n, _, _, _, _, _, se, mod, x), n != "", se != "",
    !expr_kind(_, "ASSIGNMENT", _, se), !export_overwritten(_, x), jsx_holds(se, w).
jsx_export_holds(mod, en, w) :- export_decl(_, en, ln, form, _, _, _, _, mod, x), form != "EXPORT_ALL", ln != "",
    export_reexport(_, _, imp, x), import_module(imp, src), jsx_export_holds(src, ln, w).

// jsx_call_renders(Call, K, I) — the value a wrapper or loader call renders.
// A wrapper: its argument 0, or what argument 0 renders when it is itself a wrapped
// component — `memo(forwardRef(function Inner() {…}))`, `memo(Card)`.
jsx_call_renders(w, k, i) :- jsx_component_wrapper(w), call_arg(w, 0, a), expr_value(a, k, i), k != "ambient".
jsx_call_renders(w, k, i) :- jsx_component_wrapper(w), call_arg(w, 0, a), jsx_holds(a, w2), jsx_call_renders(w2, k, i).
// A loader: what argument 0 returns — the module, a promise of it, or through
// `.then(cb)` what cb returns (promises.dl carries the module into cb's parameter).
jsx_loader_settles(w, k, i) :- jsx_component_loader(w), call_arg(w, 0, a), expr_value(a, "func", f), return_value(f, k, i).
// …the module itself: its default export renders.
jsx_call_renders(w, k, i) :- jsx_loader_settles(w, "module", mod), module_export_value(mod, "default", k, i), k != "module".
// …re-wrapped for `lazy`, `{ default: m.Named }`: the object's `default` property.
jsx_call_renders(w, k, i) :- jsx_loader_settles(w, "obj", o), prop_value("obj", o, "default", k, i).
// …or a component projected out of it, `.then((m) => m.Named)` (the `dynamic` form).
jsx_call_renders(w, k, i) :- jsx_loader_settles(w, k, i), jsx_component_kind(k).
jsx_component_kind("func").
jsx_component_kind("ctor").
// A Vue definer: the options object's `setup`, else its `render` — one target, not both.
// "Has a setup" is read off the literal's own keys, not the value layer, which this
// relation feeds.
jsx_call_renders(w, "func", m) :- jsx_vue_definer(w), call_arg(w, 0, a), expr_value(a, "obj", o),
    prop_value("obj", o, "setup", "func", m).
jsx_call_renders(w, "func", m) :- jsx_vue_definer(w), call_arg(w, 0, a), expr_value(a, "obj", o),
    !jsx_vue_has_setup(o), prop_value("obj", o, "render", "func", m).
jsx_call_renders(w, "func", f) :- jsx_vue_definer(w), call_arg(w, 0, a), expr_value(a, "func", f).
jsx_vue_has_setup(o) :- expr_kind(_, "OBJECT_LITERAL", _, o), expr_child(_, o, "PROPERTY_KEY", _, key), expr_name(_, "setup", key).
jsx_vue_has_setup(o) :- literal_owns_method(o, m), method_decl(_, "setup", _, _, _, _, _, m).

// ── Vue single-file components ──────────────────────────────────────────────
// A `.vue` template tag, `<Child/>`, reaches this file as a JSX_ELEMENT (the parser
// writes it into the component's virtual script), so everything above applies to it.
// A definer call renders when its argument is a function or names setup/render — read
// off the literal's own keys, as jsx_vue_has_setup is.
jsx_vue_option(a, n) :- literal_owns_method(a, m), method_decl(_, n, _, _, _, _, _, m).
jsx_vue_option(a, n) :- expr_child(_, a, "PROPERTY_KEY", _, key), expr_name(_, n, key).
jsx_vue_definer_renders(w) :- jsx_vue_definer(w), call_arg(w, 0, a), expr_kind(_, "FUNCTION_EXPRESSION", _, a).
jsx_vue_definer_renders(w) :- jsx_vue_definer(w), call_arg(w, 0, a), jsx_vue_option(a, "setup").
jsx_vue_definer_renders(w) :- jsx_vue_definer(w), call_arg(w, 0, a), jsx_vue_option(a, "render").

// A single-file component, `import Child from "./Child.vue"`: its script is the
// module's top-level code — a `<script setup>` body runs once per instance, and the
// virtual script writes the component's template there too — so the tag reaches the
// module initializer. A `<script setup>` component has no default export at all, and
// an Options API one (`export default { components: {…}, data() {…} }`) exports an
// object no rule above renders. One whose default export is a definer that renders is
// reached through that export instead.
jsx_vue_module(mod) :- module_file("client", fp, mod), match(".*[.]vue", fp).
jsx_vue_module_renders(mod) :- jsx_export_holds(mod, "default", w), jsx_vue_definer_renders(w).
jsx_vue_tag_module(je, mod) :- jsx_element_tag(je, tag), expr_binding(_, v, tag), var_import(_, imp, v),
    import_decl(_, _, _, "DEFAULT", _, _, _, _, imp), import_module(imp, mod), jsx_vue_module(mod).

// ── jsx_renders(Element, Component) — the callables the element runs ───────
// A function component (a constructor FUNCTION is callable_value's "ctor" half).
jsx_renders(je, m) :- jsx_tag_value(je, k, i), callable_value(k, i, m).
// A class component: constructed, then rendered.
jsx_renders(je, m) :- jsx_tag_value(je, "ctor", t), type_construct_target(t, m).
jsx_renders(je, m) :- jsx_tag_value(je, "ctor", t), type_member(t, "render", m).
// A Vue single-file component: its module initializer (see "Vue components" above).
jsx_renders(je, init) :- jsx_vue_tag_module(je, mod), !jsx_vue_module_renders(mod), module_init("client", init, mod).

// ── the props object ────────────────────────────────────────────────────────
// Keyed by the element, as an object literal is keyed by the literal.
prop_value("obj", je, n, k, i) :- expr_kind(_, "JSX_ELEMENT", _, je),
    expr_child(_, je, "PROPERTY_KEY", _, a), expr_kind(_, "JSX_ATTRIBUTE_VALUE", _, a), expr_name(_, n, a),
    expr_child(_, a, "PROPERTY_VALUE", _, v), expr_value(v, k, i).
// `<C {...rest}/>` hands over every property of `rest`.
prop_value("obj", je, n, k, i) :- expr_kind(_, "JSX_ELEMENT", _, je),
    expr_child(_, je, "SPREAD_OPERAND", _, o), expr_value(o, k0, i0), prop_value(k0, i0, n, k, i).
// `<C>{(x) => …}</C>` — a brace child is `props.children`.
prop_value("obj", je, "children", k, i) :- expr_kind(_, "JSX_ELEMENT", _, je),
    expr_child(_, je, "OPERAND", _, c), expr_value(c, k, i).

// A function component's first parameter receives the props — client functions only,
// and not a fan-capped one, exactly as argument flow at a call.
param_value(p, "obj", je) :- jsx_tag_value(je, k, i), k != "ctor", callable_value(k, i, m),
    method_decl("client", _, _, _, _, _, _, m), !method_is_hot(m, _),
    param_decl(_, _, "0", m, p), !param_is_rest(_, p).
// A class component: its constructor receives them, and `this.props` holds them.
param_value(p, "obj", je) :- jsx_tag_value(je, "ctor", t), type_construct_target(t, m),
    method_decl("client", _, _, _, _, _, _, m), !method_is_hot(m, _),
    param_decl(_, _, "0", m, p), !param_is_rest(_, p).
prop_value("inst", t, "props", "obj", je) :- jsx_tag_value(je, "ctor", t), type_decl("client", _, _, _, _, t).

// ── props that come from outside the element ────────────────────────────────
// Two library conventions hand a component values no JSX attribute names, so a
// handler reached through them had no use: `onClick={props.onClickLogout}` and
// `const { logout } = useContext(Ctx); … onClick={logout}` registered nothing.
//
// connect(mapState, mapDispatch)(C): C's props also hold what each map function
// returns, and the object form of mapDispatch (`connect(null, { onSave })`) itself.
// Every returned object is merged into one props value, as the library does.
jsx_connect_props(w, k, i) :- jsx_connect_call(w, inner), call_arg(inner, pos, a), pos <= 1,
    expr_value(a, "func", f), return_value(f, k, i), k = "obj".
jsx_connect_props(w, "obj", o) :- jsx_connect_call(w, inner), call_arg(inner, 1, a), expr_value(a, "obj", o).
param_value(p, k, i) :- jsx_connect_props(w, k, i), jsx_call_renders(w, kc, ic), kc != "ctor", callable_value(kc, ic, m),
    method_decl("client", _, _, _, _, _, _, m), !method_is_hot(m, _),
    param_decl(_, _, "0", m, p), !param_is_rest(_, p).
// A class component reads them as `this.props` in its OWN methods. Not a prop_value of
// the instance: that is inherited (value-flow.dl), and a subclass connected on its own
// (`class Favorites extends Profile`, each with its connect) would read the parent's
// handlers too.
jsx_connect_class_props(t, k, i) :- jsx_connect_props(w, k, i), jsx_call_renders(w, "ctor", t), type_decl("client", _, _, _, _, t).
expr_value(e, k, i) :- expr_kind(_, "PROPERTY_ACCESS", _, e), expr_name(_, "props", e),
    expr_child(_, e, "ACCESS_TARGET", _, r), expr_kind(_, "THIS", _, r), expr_owner(_, m, _, r),
    this_value(m, "inst", t), jsx_connect_class_props(t, k, i).

// React context: `useContext(Ctx)` (and React 19's `use(Ctx)`) evaluates to the `value`
// of every `<Ctx.Provider value={…}>` (React 19: `<Ctx value={…}>`) of the same
// createContext call, and to that call's default argument. "Same" is the call the
// argument and the tag hold, followed through consts, imports and re-exports — never
// the name — so two contexts in one app keep their values apart.
jsx_context_tag(je, c) :- jsx_element_tag(je, tag), expr_kind(_, "PROPERTY_ACCESS", _, tag), expr_name(_, "Provider", tag),
    expr_child(_, tag, "ACCESS_TARGET", _, r), jsx_holds(r, c), jsx_context_create(c).
jsx_context_tag(je, c) :- jsx_element_tag(je, tag), jsx_holds(tag, c), jsx_context_create(c).
jsx_context_value(c, k, i) :- jsx_context_tag(je, c), prop_value("obj", je, "value", k, i).
jsx_context_value(c, k, i) :- jsx_context_create(c), call_arg(c, 0, a), expr_value(a, k, i).
// The provider's value is usually memoised — `useMemo(() => ({ user, logout }), [user])`
// with its handlers in `useCallback(fn, deps)` — and React's library is not staged, so
// both calls had no value. useMemo evaluates to what its argument 0 returns,
// useCallback to argument 0 itself.
expr_value(u, k, i) :- expr_kind(_, "CALL", _, u), call_site("client", _, "useMemo", _, _, _, u, _, _),
    call_arg(u, 0, a), expr_value(a, "func", f), return_value(f, k, i).
expr_value(u, "func", f) :- expr_kind(_, "CALL", _, u), call_site("client", _, "useCallback", _, _, _, u, _, _),
    call_arg(u, 0, a), expr_value(a, "func", f).
jsx_context_reader_name("useContext").
jsx_context_reader_name("use").
expr_value(u, k, i) :- expr_kind(_, "CALL", _, u), call_site("client", _, n, _, _, _, u, _, _), jsx_context_reader_name(n),
    call_arg(u, 0, a), jsx_holds(a, c), jsx_context_create(c), jsx_context_value(c, k, i).
// `<Ctx.Consumer>{(value) => …}</Ctx.Consumer>` — the render function receives it.
param_value(p, k, i) :- jsx_element_tag(je, tag), expr_kind(_, "PROPERTY_ACCESS", _, tag), expr_name(_, "Consumer", tag),
    expr_child(_, tag, "ACCESS_TARGET", _, r), jsx_holds(r, c), jsx_context_create(c),
    prop_value("obj", je, "children", "func", m), method_decl("client", _, _, _, _, _, _, m),
    param_decl(_, _, "0", m, p), !param_is_rest(_, p), jsx_context_value(c, k, i).

// ── the rows ────────────────────────────────────────────────────────────────
// The caller is the callable whose body holds the markup; top-level markup
// (`root.render(<App/>)`) belongs to the module initializer, as a top-level call does.
jsx_caller(je, m) :- jsx_element_tag(je, _), expr_owner(_, m, _, je), m != "".
jsx_caller(je, init) :- jsx_element_tag(je, _), expr_owner(_, "", mod, je), module_init(_, init, mod).
jsx_target_count(je, n) :- jsx_element_tag(je, _), n = count : { jsx_renders(je, _) }.
jsx_class(je, "known_edge") :- jsx_target_count(je, 1).
jsx_class(je, "multi_inferred") :- jsx_target_count(je, n), n >= 2.

call_chain_edge(je, caller, "-", m, "client", cls, "JSX_ELEMENT") :- jsx_renders(je, m),
    method_prov(m, "client"), jsx_caller(je, caller), jsx_class(je, cls).
call_chain_edge(je, caller, "-", m, "lib", "boundary_lib", "JSX_ELEMENT") :- jsx_renders(je, m),
    method_prov(m, "lib"), jsx_caller(je, caller).
// A tag that names something the value layer could not follow: a declared unknown.
call_chain_edge(je, caller, "-", "-", "-", "ambiguous_unknown", "JSX_ELEMENT") :-
    jsx_target_count(je, 0), jsx_caller(je, caller).

// ── a function handed over as an attribute ──────────────────────────────────
// `<form onSubmit={submit}>`, `<button onClick={logout}>`, `<UserForm action={createUser}/>`
// hands the function to the renderer or the component, which may invoke it: the same
// hand-off as `xs.forEach(f)`, and labelled the same way, callback_registered. Without
// it an event handler on an intrinsic tag (`<div/>` renders no project code, so the
// props object above reaches nobody) had no incoming edge at all, and `impact submit`
// answered that it is used only where it is declared. Emitted for every element,
// whatever its tag renders, as a call argument is whatever the callee resolved to.
// The site is the attribute row; a value that is not a function (`value={count}`,
// `className="x"`) is data and gets nothing.
jsx_attribute_handler(a, m) :- expr_kind(_, "JSX_ATTRIBUTE_VALUE", _, a),
    expr_child(_, a, "PROPERTY_VALUE", _, v), expr_value(v, "func", m).
jsx_attribute_caller(a, m) :- jsx_attribute_handler(a, _), expr_owner(_, m, _, a), m != "".
jsx_attribute_caller(a, init) :- jsx_attribute_handler(a, _), expr_owner(_, "", mod, a), module_init(_, init, mod).
call_chain_edge(a, caller, "-", m, "client", "callback_registered", "JSX_ATTRIBUTE") :-
    jsx_attribute_handler(a, m), method_prov(m, "client"), jsx_attribute_caller(a, caller).
