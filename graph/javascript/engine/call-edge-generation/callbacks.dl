// ============================================================================
// CALL-EDGE-GEN · CALLBACKS AND EVENTS  (edges into functions handed to others)
//
// Measured before this file existed: 3,992 function literals were passed as
// arguments across the corpora and 406 had any incoming edge. A callback's body
// was analysed — the calls inside it resolved — but nothing pointed INTO it, so
// reachability stopped at every `.forEach`, `.then`, `.on` and `setTimeout`.
//
// Two edge classes, both labelled so a reader never mistakes them for a resolved
// call of the site's own callee:
//
//   callback_registered   the site's callee RECEIVES the function and may invoke it:
//                         `xs.forEach(f)`, `p.then(a, b)`, `emitter.on('x', h)`,
//                         `app.get('/', h)`, `setTimeout(f)`. Emitted for every call
//                         site with a function-valued argument, whatever the callee
//                         resolved to. When the callee is project code that calls its
//                         parameter, the ordinary edge exists too — from INSIDE the
//                         callee — and this one says the same thing from the outside.
//   event_dispatch        `x.emit('name', …)` runs every handler registered by
//                         `x.on('name', h)` (`once`, `addListener`, `prependListener`)
//                         on a value x may hold. Name-sensitive when both names are
//                         string literals; a computed name on either side matches
//                         every handler on that receiver value. Requires the receiver
//                         to HAVE a value — an untyped emitter registers nothing.
//
// Both feed method_call_edge and so entry_reachable: a handler registered from a
// reachable function is reachable, which is what a change-impact query needs.
// ============================================================================

// ── callback_registered(CallExpr, CallbackMethod) ───────────────────────────
callback_registered(ce, m) :- invocation_site(ce, _), call_arg(ce, _, arg), expr_value(arg, "func", m).
// A function handed over as a PROPERTY of an options object (`lib({ filter: f })`,
// `opts.resolve = f; lib(opts)`, `https.request({ createConnection: f })`,
// `new Transform({ transform })`) is a callback too (#643): the callee reads the property
// and invokes it, and nothing else in the project points into the function. Followed
// two levels (`{ hooks: { visit } }`), and only across the boundary: a callee that is
// NOT a project function (a staged library, the platform, an unknown, a dynamic call),
// because a project callee that reads the property has the ordinary edge from inside
// its body. Only object values carry it (below); an array, a collection, a string, a
// module, an instance and the platform are left out.
callback_registered(ce, m) :- invocation_site(ce, _), !call_has_client_target(ce), !reflective_site(ce),
    call_arg(ce, _, arg), expr_value(arg, k, i), options_value_kind(k), options_member_func(k, i, m).
// `Object.assign(dst, src)`, `Object.entries(o)`, `Object.setPrototypeOf(a, b)`,
// `Reflect.ownKeys(o)`, `JSON.stringify(o)`: reflection over an object reads its
// properties and never invokes them; an options-object edge there would be invented.
reflective_site(ce) :- call_site(_, ck, _, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "ambient", n), reflective_ambient(n).
reflective_ambient("Object").
reflective_ambient("Reflect").
reflective_ambient("JSON").
reflective_ambient("Array").
options_member_func(k, i, m) :- prop_value(k, i, _, "func", m).
options_member_func(k, i, m) :- prop_value(k, i, _, k1, i1), options_value_kind(k1), prop_value(k1, i1, _, "func", m).
// Object values only: an INSTANCE passed to the platform is data (`arr.push(this)`,
// `Promise.resolve(w)`, `items.map(fn, this)`), and registering every method it has
// would invent an edge per method at every such site.
options_value_kind("obj").
call_has_client_target(ce) :- expr_resolves_to_method(ce, m), method_prov(m, "client").
call_has_client_target(ce) :- new_constructs(ce, t), type_decl("client", _, _, _, _, t).

// A listener runs with the EMITTER as `this` (`e.on('x', function () { this.other(); })`).
this_value(m, k, i) :- event_handler(k, i, _, m), method_this_binding(_, "DYNAMIC", m), !method_owner_type(m, _), k != "module".

// ── event registration and emission ─────────────────────────────────────────
// event_handler(K, I, Name, Handler): `<recv>.on(<name>, <handler>)` on value (K, I).
event_handler(k, i, name, m) :- call_site(_, ck, mn, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    event_register_method(mn),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, k0, i0), receiver_identity(k0, i0, k, i),
    call_arg(ce, 0, ne), event_name_of(ne, name),
    call_arg(ce, 1, he), expr_value(he, "func", m).
event_register_method("on").
event_register_method("once").
event_register_method("addListener").
event_register_method("prependListener").
event_register_method("prependOnceListener").
event_register_method("addEventListener").
// The name's string value(s), or "*" for an expression no literal reaches.
event_name_of(e, n) :- expr_value(e, "str", n).
event_name_of(e, "*") :- expr_child(_, ce, "ARGUMENT", _, e), call_site(_, _, mn, _, _, _, ce, _, _),
    (event_register_method(mn); event_emit_method(mn)), !expr_kind(_, "LITERAL", _, e).

event_dispatch(ce, m) :- call_site(_, ck, mn, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    event_emit_method(mn),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, k0, i0), receiver_identity(k0, i0, k, i),
    call_arg(ce, 0, ne), event_name_of(ne, n1),
    event_handler(k, i, n2, m),
    (n1 = n2; n1 = "*"; n2 = "*").
// `module.exports = new Store()` then `store.on(...)` elsewhere: the registration's
// receiver is the MODULE value, the emit's `this` is the instance — one object.
receiver_identity(k, i, k, i) :- expr_value(_, k, i).
receiver_identity("module", mod, k, i) :- module_export_value(mod, "default", k, i), k != "module".
event_emit_method("emit").
event_emit_method("dispatchEvent").
event_emit_method("trigger").

// ── what the handler receives, and what a registration call evaluates to ─────
// `emit('x', a, b)` passes a, b to the handler's first two parameters.
param_value(p, k, i) :- event_dispatch(ce, m), call_arg(ce, pos, arg), pos >= 1,
    param_decl(_, _, ppos, m, p), to_number(ppos) = pos - 1, expr_value(arg, k, i).
// `on()` / `once()` / `addListener()` on an emitter RETURN THE EMITTER — `b.on(...).once(...)`
// chains — so the registration call's value is its receiver's value.
expr_value(ce, k, i) :- call_site(_, ck, mn, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    event_register_method(mn), expr_child(_, ce, "RECEIVER", _, r), expr_value(r, k, i), k != "obj".

// ── the rows ────────────────────────────────────────────────────────────────
call_chain_edge(ce, caller, "-", m, "client", "callback_registered", kind) :- callback_registered(ce, m),
    method_prov(m, "client"), call_from(ce, caller), invocation_site(ce, kind).
call_chain_edge(ce, caller, "-", m, "client", "event_dispatch", kind) :- event_dispatch(ce, m),
    method_prov(m, "client"), call_from(ce, caller), invocation_site(ce, kind).
method_call_edge(caller, m) :- callback_registered(ce, m), method_prov(m, "client"), call_from(ce, caller).
method_call_edge(caller, m) :- event_dispatch(ce, m), method_prov(m, "client"), call_from(ce, caller).

// ── platform_hook_call(CallExpr, HookMethod) — the platform calls back into a subclass ──
// A class extending a platform stream base (`Writable`, `Readable`, `Transform`,
// `Duplex`) has hook methods the platform alone invokes: `write()` on the instance
// runs `_write`, `end()` runs `_final`, `resume()` / `pipe()` / `read()` run `_read`,
// `destroy()` runs `_destroy`. The trigger site is an `ambient_terminal` (its callee IS
// the platform); what was missing is the edge the platform makes into the subclass's
// own body, without which a protocol parser fed only through `write()` hangs off an
// unreachable `_write`. Stated as facts, like the framework handler models: base,
// trigger, hook. `Duplex` inherits both sides; `Transform` is a Duplex whose `_write`
// is the platform's own and dispatches to `_transform` / `_flush`.
platform_hook("Writable", "write", "_write").
platform_hook("Writable", "write", "_writev").
platform_hook("Writable", "end", "_final").
platform_hook("Writable", "end", "_write").
platform_hook("Writable", "cork", "_writev").
platform_hook("Readable", "read", "_read").
platform_hook("Readable", "resume", "_read").
platform_hook("Readable", "pipe", "_read").
platform_hook("Readable", "on", "_read").
platform_hook("Transform", "write", "_transform").
platform_hook("Transform", "end", "_transform").
platform_hook("Transform", "end", "_flush").
platform_hook("Transform", "read", "_transform").
platform_hook("Transform", "resume", "_transform").
platform_hook("Transform", "pipe", "_transform").
platform_hook(b, "destroy", "_destroy") :- platform_hook(b, _, _).
platform_hook(b, "end", "_destroy") :- platform_hook(b, _, _).
platform_hook("Duplex", tr, h) :- platform_hook("Writable", tr, h).
platform_hook("Duplex", tr, h) :- platform_hook("Readable", tr, h).
platform_hook("PassThrough", tr, h) :- platform_hook("Transform", tr, h).
platform_hook("Transform", tr, h) :- platform_hook("Duplex", tr, h), h != "_write", h != "_writev", h != "_read".
// The ambient value of `require('stream')` is the MODULE name, so the base class is read
// from the heritage row's written name (`Writable`, `stream.Writable` -> Writable) on a
// class whose superclass resolved to that platform module; a subclass of such a class
// inherits the base.
stream_module("stream").
stream_module("node:stream").
stream_module("stream/web").
platform_stream_base(t, base) :- heritage(_, t, _, base, _, _, _, _), platform_hook(base, _, _), type_super_ambient(t, mod), stream_module(mod).
platform_stream_base(t, base) :- type_super(t, s), platform_stream_base(s, base).
platform_hook_call(ce, m) :- call_site(_, ck, tr, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "inst", t), platform_stream_base(t, base),
    platform_hook(base, tr, hook), type_member(t, hook, m).
// `src.pipe(dest)`: the DESTINATION's write-side hooks run as `src` flows (`_write` /
// `_transform` per chunk, `_final` / `_flush` when the source ends and the platform
// calls `dest.end()`). What one piped stream's push does inside the next (`_transform`
// -> the sink's `_write`) is platform-internal chaining and stays unmodelled.
platform_hook_call(ce, m) :- call_site(_, ck, "pipe", "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    call_arg(ce, 0, d), expr_value(d, "inst", t), platform_stream_base(t, base),
    pipe_destination_trigger(tr), platform_hook(base, tr, hook), type_member(t, hook, m).
pipe_destination_trigger("write").
pipe_destination_trigger("end").
call_chain_edge(ce, caller, "-", m, "client", "callback_registered", kind) :- platform_hook_call(ce, m),
    method_prov(m, "client"), call_from(ce, caller), invocation_site(ce, kind).
method_call_edge(caller, m) :- platform_hook_call(ce, m), method_prov(m, "client"), call_from(ce, caller).
