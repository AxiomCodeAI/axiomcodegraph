// ============================================================================
// CALL-EDGE-GEN · CALL CHAIN  (the confidence-classified, queryable call graph)
//
// ── THE CONSERVATION CONTRACT ───────────────────────────────────────────────
// EVERY call site in, every call site out. The universe is seeded from the RAW
// js_call_site relation — one row per call regardless of form — never from the
// resolution-gated one, so an unresolvable `new ThirdPartyX()` still produces a row.
//
// ── CONFIDENCE CLASSES ──────────────────────────────────────────────────────
//   known_edge           exactly ONE resolved target. The chain continues.
//   multi_inferred       2+ targets — a parameter passed several functions, a
//                        binding written twice, a member on several instances'
//                        writes. SOUND: the true target is in the set.
//   boundary_lib         client -> a staged library's method. Marked, not expanded.
//   implicit_constructor `new C()` / `super()` where no constructor exists up the
//                        chain: the synthesized default runs. A correct end.
//   ambient_terminal     the receiver or callee is a platform builtin (`console`,
//                        `Object`, `Promise`, a Node core module) with no
//                        declaration in any staged IR. A correct end, not a gap —
//                        and the class the parser's own triage measured at 15-24%
//                        of all sites.
//   dynamic_terminal     `obj[expr]()`, `eval`, `import()` — no static target by
//                        construction. Complete because it says so.
//   fan_capped           more targets than --dispatch-cap: refused, declared, counted.
//   ambiguous_unknown    a real site that resolved to NOTHING. The declared blind spot.
//
// ── STRATIFICATION ──────────────────────────────────────────────────────────
// A leaf. The count aggregate reads expr_resolves_to_method, complete before this
// file runs.
// ============================================================================

// ── the site universe, seeded from the RAW relation ─────────────────────────
invocation_site(ce, ck) :- call_site("client", ck, _, _, _, _, ce, _, _).

// ── per-site resolved target count ──────────────────────────────────────────
call_target_count(ce, n) :- invocation_site(ce, _),
    n = count : { expr_resolves_to_method(ce, _) }.

// ── the caller, never blank ─────────────────────────────────────────────────
call_from(ce, caller) :- call_site("client", _, _, _, _, _, ce, _, cs),
    call_caller_method(cs, caller).

// ── ambient sites: a builtin on the far side ────────────────────────────────
// The callee or receiver VALUE is the platform (resolution/ambient.dl) — reached
// through a binding, a property chain or a literal — or the parser's own triage
// said so (AMBIENT_BUILTIN_TARGET / NODE_BUILTIN).
ambient_site(ce) :- invocation_site(ce, _), callee_value(ce, "ambient", _).
ambient_site(ce) :- invocation_site(ce, _), new_callee_value(ce, "ambient", _).
ambient_site(ce) :- invocation_site(ce, _), expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "ambient", _).
ambient_site(ce) :- invocation_site(ce, _), expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "arr", _).
ambient_site(ce) :- invocation_site(ce, _), call_site("client", _, _, _, _, _, ce, _, cs),
    call_site_outcome(_, _, "AMBIENT_BUILTIN_TARGET", cs).
ambient_site(ce) :- invocation_site(ce, _), call_site("client", _, _, _, _, _, ce, _, cs),
    call_site_outcome(_, "NODE_BUILTIN", _, cs).
expr_kind_is_literal("LITERAL").
expr_kind_is_literal("ARRAY_LITERAL").
expr_kind_is_literal("TEMPLATE").
// An `Object.prototype` member on a project value (#686): `this.hasOwnProperty('x')`,
// `opts.hasOwnProperty(k)`, `this.toString()`, `Ctor.valueOf()`. The receiver is known
// (an instance, a constructor, a literal, a prototype, a function) and no value it
// holds declares the member, so the callee is empty and the site read as a declared
// unknown (member_absent); every object inherits these from `Object.prototype`, so
// the site is the platform's, as `arr.push` on an `arr` already is. A class that
// declares its own `toString` resolves to it first (call_target_count >= 1, this
// row is not consulted); a receiver whose class has an UNRESOLVED superclass may
// inherit an override the engine cannot see and keeps its declared unknown.
// heritage_unresolved is a negation of the hierarchy and this relation feeds only
// call_class, both above the value fixpoint.
ambient_site(ce) :- invocation_site(ce, ck), call_kind_is_member_form(ck),
    call_site("client", ck, n, "SYNTACTIC", _, _, ce, _, _), object_prototype_member(n),
    receiver_value_known(ce), !receiver_may_inherit_unknown(ce).
receiver_may_inherit_unknown(ce) :- expr_child(_, ce, "RECEIVER", _, r), expr_value(r, k, t),
    receiver_kind_is_type(k), type_or_ancestor(t, a), heritage_unresolved(a, _, _).
receiver_kind_is_type("inst").
receiver_kind_is_type("ctor").
receiver_kind_is_type("proto").
type_or_ancestor(t, t) :- type_decl(_, _, _, _, _, t).
type_or_ancestor(t, a) :- type_ancestor(t, a).
object_prototype_member("hasOwnProperty").
object_prototype_member("isPrototypeOf").
object_prototype_member("propertyIsEnumerable").
object_prototype_member("toString").
object_prototype_member("toLocaleString").
object_prototype_member("valueOf").

// ── confidence class ────────────────────────────────────────────────────────
// A site whose callee value may ALSO be the platform (`const f = cond ? mine :
// Math.floor`) has an alternative no project target covers: it is multi_inferred
// even with one project target, and it carries an ambient_terminal row beside the
// project edge so the alternative is in the graph.
call_ambient_alternative(ce) :- call_target_count(ce, n), n >= 1, callee_value(ce, "ambient", _).
call_ambient_alternative(ce) :- call_target_count(ce, n), n >= 1, new_callee_value(ce, "ambient", _).
// `this.toString()` in a base class that declares none while a subclass does (#686):
// the subclass's method is a target through `this` widening, and on the base's own
// instances the call is `Object.prototype.toString`. The platform row stands beside
// the project edge. type_member is the resolved hierarchy's lookup, complete once
// the value fixpoint is, and this relation feeds only call_class.
call_ambient_alternative(ce) :- call_target_count(ce, n), n >= 1, object_prototype_call_on_bare_type(ce).
object_prototype_call_on_bare_type(ce) :- invocation_site(ce, ck), call_kind_is_member_form(ck),
    call_site("client", ck, n, "SYNTACTIC", _, _, ce, _, _), object_prototype_member(n),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "inst", t), !type_member(t, n, _), !receiver_may_inherit_unknown(ce).
// A fan wider than --dispatch-cap is REFUSED rather than emitted, as in the Java and
// Python rule sets: a capped site is a declared unknown (`fan_capped`), never a
// silent drop and never a 70-way edge set a reader would have to distrust.
call_over_cap(ce) :- call_target_count(ce, n), dispatch_cap(s), n > to_number(s).
call_class(ce, "known_edge") :- call_target_count(ce, 1), !call_ambient_alternative(ce).
call_class(ce, "multi_inferred") :- call_target_count(ce, n), n >= 2, !call_over_cap(ce).
call_class(ce, "multi_inferred") :- call_target_count(ce, 1), call_ambient_alternative(ce).
call_class(ce, "fan_capped") :- call_over_cap(ce).
call_class(ce, "implicit_constructor") :- call_target_count(ce, 0), call_target_is_implicit_ctor(ce).
call_class(ce, "dynamic_terminal") :- call_target_count(ce, 0), !call_target_is_implicit_ctor(ce),
    invocation_site(ce, ck), call_kind_is_dynamic(ck).
call_class(ce, "ambient_terminal") :- call_target_count(ce, 0), !call_target_is_implicit_ctor(ce),
    invocation_site(ce, ck), !call_kind_is_dynamic(ck), ambient_site(ce).
call_class(ce, "ambiguous_unknown") :- call_target_count(ce, 0), !call_target_is_implicit_ctor(ce),
    invocation_site(ce, ck), !call_kind_is_dynamic(ck), !ambient_site(ce).

// ── method_has_unknown_call(Caller, CallExpr) ───────────────────────────────
method_has_unknown_call(caller, ce) :- call_class(ce, "ambiguous_unknown"), call_from(ce, caller).
method_has_unknown_call(caller, ce) :- call_class(ce, "fan_capped"), call_from(ce, caller).

// ============================================================================
// THE MERGED EDGE — one self-describing row per edge, the single export
//   call_chain_edge(FromExpr, FromMethod, ToExpr, ToMethod, Prov, EdgeStatus, Kind)
// Every site appears at least once. A resolved site appears once per callee; an
// unresolved one appears once with ToMethod = "-".
// ============================================================================
call_chain_edge(ce, caller, "-", callee, "client", cls, kind) :-
    client_calls_client("client", ce, "client", callee), !call_over_cap(ce),
    call_from(ce, caller), call_class(ce, cls), invocation_site(ce, kind).
call_chain_edge(ce, caller, "-", callee, "lib", "boundary_lib", kind) :-
    client_calls_lib("client", ce, "lib", callee), !call_over_cap(ce),
    call_from(ce, caller), invocation_site(ce, kind).
call_chain_edge(ce, caller, "-", "-", "-", cls, kind) :-
    call_class(ce, cls), class_is_terminal(cls),
    call_from(ce, caller), invocation_site(ce, kind).
call_chain_edge(ce, caller, "-", "-", "-", "ambient_terminal", kind) :-
    call_ambient_alternative(ce),
    call_from(ce, caller), invocation_site(ce, kind).
class_is_terminal("ambiguous_unknown").
class_is_terminal("ambient_terminal").
class_is_terminal("dynamic_terminal").
class_is_terminal("implicit_constructor").
class_is_terminal("fan_capped").

// ── method_call_edge(FromMethod, ToMethod) — the method->method graph ───────
method_call_edge(caller, callee) :- call_chain_edge(_, caller, _, callee, "client", _, _), callee != "-".

// ── entry-point reachability ────────────────────────────────────────────────
// A module nothing imports is a root of the import graph — the honest entry
// point for a language with no `main`. Its initializer is the seed.
module_imported(target) :- import_module(imp, target), import_decl("client", _, _, _, _, _, _, _, imp).
entry_module(m) :- module_decl("client", _, _, _, _, m), !module_imported(m).
entry_point(init, "unimported_module") :- entry_module(m), module_init("client", init, m).
entry_reachable(m) :- entry_point(m, _).
entry_reachable(callee) :- entry_reachable(caller), method_call_edge(caller, callee).
