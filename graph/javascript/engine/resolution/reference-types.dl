// ============================================================================
// Resolution · JSDOC TYPE REFERENCES
//
// `@param {Widget} w`, `@type {Widget}`, `@returns {Widget}` — the only declared
// type channel in the language, parsed by the compiler into a tree the parser
// emits as js_type_reference rows. The NAMED node names a class; the nodes around
// it (`?Widget`, `Widget|null`, `!Widget`, `Widget=`) are structure that is walked
// through. `Array<Widget>` is NOT walked into: the parameter is an array, and its
// elements' type is a claim about a different value.
//
// A name resolves through the import hop the parser attached to the reference
// row, else to a class declared in the same module. A builtin (`Object`, `string`,
// `Function`) resolves to nothing here — it is the platform, and a call through it
// is an ambient terminal, classified in call_chain.dl.
// ============================================================================

type_ref_type(r, t) :- type_ref(_, _, "NAMED", _, _, _, _, _, imp, _, r), imp != "",
    import_value(imp, k, i), constructible_value(k, i, t).
type_ref_type(r, t) :- type_ref(_, n, "NAMED", _, _, _, _, _, "", mod, r), !type_ref_builtin(_, r),
    type_decl(_, n, _, _, mod, t).
// `@param {ns.Thing}` through a namespace binding (`@import * as ns`, `import * as
// ns`, `const ns = require(...)`): the parser links the import that binds the ROOT,
// and the member is the rest of the name, looked up on the module's surface (#621).
type_ref_type(r, t) :- type_ref(_, n, "NAMED", _, _, _, _, _, imp, _, r), imp != "", contains(".", n),
    import_local(_, q, imp), strlen(n) > strlen(q) + 1,
    substr(n, 0, strlen(q) + 1) = cat(q, "."),
    import_value(imp, "module", mod),
    module_export_value(mod, substr(n, strlen(q) + 1, strlen(n) - strlen(q) - 1), k, i),
    constructible_value(k, i, t).
// `import('./x.js').T` — the reference names the import row, whose importedName
// is the member.
type_ref_type(r, t) :- type_ref(_, _, "IMPORT_TYPE", _, _, _, _, _, imp, _, r), imp != "",
    import_value(imp, k, i), constructible_value(k, i, t).
// `@typedef {import('./x.js').default} Chart` — a name that is an ALIAS of another
// type expression. The typedef is a type-only js_type whose own reference row
// (context TYPEDEF, owner = the typedef) is the aliased expression.
type_ref_type(r, t) :- type_ref(_, n, "NAMED", _, _, _, _, _, "", mod, r),
    type_only_decl(_, n, "JSDOC_TYPEDEF", mod, td),
    type_ref(_, _, _, "", "TYPEDEF", "TYPE", td, _, _, _, c), c != r,
    type_ref_type(c, t).
// Wrappers: the child is the type.
type_ref_type(r, t) :- type_ref(_, _, k, _, _, _, _, _, _, _, r), type_ref_kind_is_wrapper(k),
    type_ref(_, _, _, r, _, _, _, _, _, _, c), type_ref_type(c, t).
type_ref_kind_is_wrapper("NULLABLE").
type_ref_kind_is_wrapper("NON_NULLABLE").
type_ref_kind_is_wrapper("OPTIONAL").
type_ref_kind_is_wrapper("UNION").
type_ref_kind_is_wrapper("TYPE_QUERY").

// ── type_ref_module(RefHash, ModuleHash): a type that names a MODULE (#631) ──
// `@typedef {import("./surface")} Surface` of a file that exports through
// `exports.x =`, or `import("./esm.mjs")` of an ES module: the type is the namespace
// object, and a value declared with it holds the module, whose properties are the
// export surface. The same hops as type_ref_type: the import row, a typedef alias, a
// wrapper.
type_ref_module(r, mod) :- type_ref(_, _, k, _, _, _, _, _, imp, _, r), imp != "", type_ref_kind_names_import(k),
    import_value(imp, "module", mod).
type_ref_kind_names_import("NAMED").
type_ref_kind_names_import("IMPORT_TYPE").
type_ref_module(r, mod) :- type_ref(_, n, "NAMED", _, _, _, _, _, "", m, r),
    type_only_decl(_, n, "JSDOC_TYPEDEF", m, td),
    type_ref(_, _, _, "", "TYPEDEF", "TYPE", td, _, _, _, c), c != r,
    type_ref_module(c, mod).
type_ref_module(r, mod) :- type_ref(_, _, k, _, _, _, _, _, _, _, r), type_ref_kind_is_wrapper(k),
    type_ref(_, _, _, r, _, _, _, _, _, _, c), type_ref_module(c, mod).
param_value(p, "module", mod) :- param_type_name(_, _, r, p), type_ref_module(r, mod).
var_value(v, "module", mod) :- var_type_name(_, _, r, v), type_ref_module(r, mod).
return_value(m, "module", mod) :- method_return_type(_, _, r, m), type_ref_module(r, mod).
prop_value("inst", t, n, "module", mod) :- field_type_name(_, n, t, _, r, _), type_ref_module(r, mod).

// ── type_ref_unresolved(RefHash, TypeName) — countable ──────────────────────
// A NAMED reference that reached no class: a typedef (type-only by design), a
// builtin, or a dependency not staged. The fastest read on what is missing.
type_ref_unresolved(r, n) :- type_ref(_, n, "NAMED", _, _, _, _, _, _, _, r), !type_ref_type(r, _), !type_ref_builtin(_, r).

// ── #488: `@this {T}`, an inline cast, and the collection / promise generics ────
this_value(m, "inst", t) :- type_ref(_, _, _, _, "THIS", "METHOD", m, _, _, _, r), type_ref_type(r, t).
expr_value(e, "inst", t) :- type_ref(_, _, _, _, "CAST", "EXPRESSION", e, _, _, _, r), type_ref_type(r, t).
expr_value(e, "arr", r) :- type_ref(_, _, _, _, "CAST", "EXPRESSION", e, _, _, _, r), type_ref_is_array(r).
// `Promise<T>` is a wrapper: the declared value is T (await is transparent).
type_ref_kind_is_promise(r) :- type_ref(_, "Promise", "GENERIC_APPLICATION", _, _, _, _, _, _, _, r).
type_ref_type(r, t) :- type_ref_kind_is_promise(r), type_ref(_, _, _, r, _, _, _, _, _, _, c), type_ref_type(c, t).
// `Map<K, V>` / `Set<T>` / `WeakMap` / `WeakSet`: a collection whose elements are the LAST
// type argument, identified by the reference row like `@type {T[]}` is.
type_ref_is_coll(r) :- type_ref(_, n, "GENERIC_APPLICATION", _, _, _, _, _, _, _, r), ambient_collection(n).
var_value(v, "coll", r) :- var_type_name(_, _, r, v), type_ref_is_coll(r).
param_value(p, "coll", r) :- param_type_name(_, _, r, p), type_ref_is_coll(r).
return_value(m, "coll", r) :- method_return_type(_, _, r, m), type_ref_is_coll(r).
prop_value("inst", t, n, "coll", r) :- field_type_name(_, n, t, _, r, _), type_ref_is_coll(r).
elem_value(r, "inst", t) :- type_ref_is_coll(r), type_ref(_, _, _, r, _, _, _, _, _, _, c), coll_last_child(r, c), type_ref_type(c, t).
elem_value(r, "arr", c) :- type_ref_is_coll(r), coll_last_child(r, c), type_ref_is_array(c).
coll_last_child(r, c) :- type_ref_is_coll(r), type_ref_child_index(r, c, idx),
    to_number(idx) = max n : { type_ref_child_index(r, _, idx2), n = to_number(idx2) }.
