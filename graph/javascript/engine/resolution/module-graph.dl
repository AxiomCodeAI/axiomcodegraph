// ============================================================================
// Resolution · MODULE GRAPH
//
// An import names a module AND a name in it; the module is reached through the
// parser's `resolvedFilePath` (extension-less, joining `module_qname`), and the
// name through the target module's EXPORT SURFACE. The surface is the part that is
// JavaScript-specific:
//
//   CommonJS   `module.exports = X`     the whole surface IS the value X — a function,
//                                       a class, an object literal whose properties are
//                                       the members, or `require('./y')` (a re-export)
//              `module.exports.a = f`   one member
//              `exports.a = f`          one member (unless module.exports was reassigned
//                                       AFTER it, which the parser marks as overwritten)
//   ESM        `export function f`      one member, targetKind METHOD
//              `export const x = ...`   one member, targetKind VARIABLE
//              `export default X`       the member named "default"
//              `export * from './y'`    every member of y
//
// Both systems are read into ONE relation, `module_export_value(Mod, Name, K, I)`,
// keyed by the exported name with "default" for the module.exports value, so that
// an ES `import x from './cjs'`, a CJS `require('./esm').default` and every other
// interop spelling reads the same rows. What a NAMESPACE binding (`import * as ns`,
// `const ns = require('m')`) evaluates to is the "module" value, whose properties
// are the export surface — see value-flow.dl `prop_value("module", ...)`.
// ============================================================================

// ── import_module(ImportHash, ModuleHash) ───────────────────────────────────
// The far side of an import edge. Joins on the extension-less qualified name in
// EITHER provenance, which is how a client import reaches a staged library module
// by the same rule as a sibling file.
import_module(imp, mod) :- import_decl(_, _, _, _, _, rf, _, _, imp), rf != "", module_qname(_, rf, mod).
// A dependency: the parser resolved the specifier to an ABSOLUTE file under
// node_modules. A library staged from that very directory joins on root + file; one
// staged from a copy elsewhere joins on the package name and the file within it.
// The exact join comes first, and the package-name join is a FALLBACK in fact, not only
// in name: with two staged copies of one package (a top-level copy and a nested second
// version another dependency pins), the name join matched both, and the client got a
// boundary_lib edge into the copy that can never run from it (#599). Both sides of the
// join are parser facts, so the negation is stratified.
import_module_exact(imp, mod) :- import_decl(_, _, _, _, _, rf, "RESOLVED_EXTERNAL", _, imp),
    module_base_path("lib", bp, mod), module_file("lib", fp, mod), rf = cat(bp, cat("/", fp)).
import_module(imp, mod) :- import_module_exact(imp, mod).
import_module(imp, mod) :- import_decl(_, _, _, _, _, rf, "RESOLVED_EXTERNAL", _, imp), !import_module_exact(imp, _),
    module_package("lib", pkg, mod), module_file("lib", fp, mod),
    contains(cat("/node_modules/", cat(pkg, cat("/", fp))), rf).
// A package that ships typings resolves to its `index.d.ts` — the compiler's answer,
// and the right one for TYPES. The code that runs is the `.js` beside it, which is
// what a library parsed from source holds; the declaration file is not in any IR.
import_module(imp, mod) :- import_decl(_, _, _, _, _, rf, "RESOLVED_EXTERNAL", _, imp), !import_module_exact(imp, _),
    strlen(rf) > 5, substr(rf, strlen(rf) - 5, 5) = ".d.ts",
    js = cat(substr(rf, 0, strlen(rf) - 5), ".js"),
    module_package("lib", pkg, mod), module_file("lib", fp, mod),
    contains(cat("/node_modules/", cat(pkg, cat("/", fp))), js).

// A bare specifier the parser could NOT resolve (the client has no installed tree: a CI
// checkout, a library IR set built elsewhere) reaches a staged package through the
// package's own entry facts (#602; the facts are #616): `require('pkg')` and
// `require('pkg/sub')` join the staged library's package_entry rows on the exact
// specifier (package + subpath). The entry is chosen the way the runtime chooses it:
// an `exports` entry governs when the package publishes one for that subpath, and
// among those the condition the import form selects (`require` for require() and
// createRequire, `import` or `module` for an import declaration or import()) before
// an unconditional or `default` target; `main` (or the index.js fallback) only when
// no `exports` entry names the subpath. A fallback behind the path-based rules above,
// so an installed client keeps today's answer. Every side of every negation is a
// parser fact, so the stratification holds.
entry_specifier(pkg, ".", pkg) :- package_entry("lib", pkg, ".", _, _, _, _, _).
entry_specifier(pkg, sp, cat(pkg, substr(sp, 1, strlen(sp) - 1))) :- package_entry("lib", pkg, sp, _, _, _, _, _), sp != ".", strlen(sp) > 2, substr(sp, 0, 2) = "./".
bare_import(imp, spec, form, pkg, sp) :- import_decl(_, spec, form, _, _, _, "UNRESOLVED_MISSING", _, imp), spec != "", entry_specifier(pkg, sp, spec).
entry_exports_selected(imp, mod) :- bare_import(imp, _, form, pkg, sp),
    package_entry("lib", pkg, sp, cond, "EXPORTS", _, "RESOLVED", mod), mod != "", cond != "", import_form_condition(form, c), contains(c, cond).
entry_exports_default(imp, mod) :- bare_import(imp, _, _, pkg, sp),
    package_entry("lib", pkg, sp, cond, "EXPORTS", _, "RESOLVED", mod), mod != "", (cond = ""; contains("default", cond)).
entry_has_exports(imp) :- bare_import(imp, _, _, pkg, sp), package_entry("lib", pkg, sp, _, "EXPORTS", _, _, _).
entry_main(imp, mod) :- bare_import(imp, _, _, pkg, sp), package_entry("lib", pkg, sp, _, src, _, "RESOLVED", mod), mod != "", entry_source_is_main(src).
entry_source_is_main("MAIN").
entry_source_is_main("DEFAULT_INDEX").
import_module(imp, mod) :- entry_exports_selected(imp, mod).
import_module(imp, mod) :- entry_exports_default(imp, mod), !entry_exports_selected(imp, _).
import_module(imp, mod) :- entry_main(imp, mod), !entry_has_exports(imp).
import_form_condition("REQUIRE_CALL", "require").
import_form_condition("CREATE_REQUIRE", "require").
import_form_condition("IMPORT_EQUALS", "require").
import_form_condition("IMPORT_DECLARATION", "import").
import_form_condition("IMPORT_DECLARATION", "module").
import_form_condition("DYNAMIC_IMPORT", "import").
import_form_condition("DYNAMIC_IMPORT", "module").
import_form_condition("JSDOC_IMPORT_TYPE", "import").
import_form_condition("JSDOC_IMPORT_TYPE", "require").
// Countable: a staged package a client names by a bare specifier and does not reach
// through any entry (the entry's file is absent from the library IR, a subpath the
// package does not publish, or a condition the form does not select). The "staged
// package, client not installed" outcome, kept apart from a package never staged.
import_staged_package_unreached(imp, spec, pkg) :- import_decl(_, spec, _, _, _, _, "UNRESOLVED_MISSING", _, imp), spec != "",
    package_entry("lib", pkg, _, _, _, _, _, _), (spec = pkg; contains(cat(pkg, "/"), spec)), !import_module(imp, _).

// ── import_unresolved(ImportHash, Specifier, Outcome) — countable ───────────
// A dependency that is not staged (RESOLVED_EXTERNAL with no matching module), a
// builtin, or a specifier the parser could not resolve. The reason is kept so the
// three fixes — stage the package, accept the platform terminal, fix the specifier —
// are not one bucket.
import_unresolved(imp, spec, out) :- import_decl(_, spec, _, _, _, _, out, _, imp), !import_module(imp, _).

// ── export_target_value(ExportHash, K, I) — the value one export row names ──
// The parser records the target as an ENTITY where the syntax declares one
// (`export function f` -> METHOD, `export class C` -> TYPE, `export const x` ->
// VARIABLE, `module.exports = run` -> METHOD) and as an EXPRESSION_VALUE where it
// is an assignment: the ASSIGNMENT's value child is then the exported value.
export_target_value(x, "func", m) :- export_decl(_, _, _, _, _, "METHOD", m, _, _, x), m != "".
export_target_value(x, "ctor", t) :- export_decl(_, _, _, _, _, "TYPE", t, _, _, x), t != "".
export_target_value(x, k, i) :- export_decl(_, _, _, _, _, "VARIABLE", v, _, _, x), v != "", var_value(v, k, i).
export_target_value(x, k, i) :- export_decl(_, _, _, _, _, _, _, se, _, x), se != "",
    expr_kind(_, "ASSIGNMENT", _, se),
    expr_child(_, se, "ASSIGNMENT_VALUE", _, val),
    expr_value(val, k, i).
// `export default <expr>` — the source expression is the value itself.
export_target_value(x, k, i) :- export_decl(_, _, _, _, _, _, _, se, _, x), se != "",
    !expr_kind(_, "ASSIGNMENT", _, se),
    expr_value(se, k, i).

// ── module_export_value(ModuleHash, Name, K, I) — the export surface ────────
// Direct rows, minus the ones a later `module.exports =` overwrote.
module_export_value(mod, n, k, i) :- export_decl(_, n, _, _, _, _, _, _, mod, x), n != "",
    !export_overwritten(_, x),
    export_target_value(x, k, i).
// `module.exports = { a, b }` / `module.exports = SomeClass`: the members of the
// exported VALUE are members of the surface. Restricted to the CommonJS assignment
// form — an ES `export default` does not spread its properties onto the namespace.
module_export_value(mod, n, k, i) :- export_decl(_, "default", _, "MODULE_EXPORTS_ASSIGNMENT", _, _, _, _, mod, x),
    !export_overwritten(_, x),
    export_target_value(x, vk, vi),
    prop_value(vk, vi, n, k, i),
    n != "default".
// `export default function () {}` / `export default class extends Base {}` — the
// ANONYMOUS forms carry a DECLARATION target since parser#494 (PD-JS-3 closed; the
// engine's modifier and type_form joins that recovered them are retired).
// Re-exports: `export * from './y'`, `export { a } from './y'`,
// `module.exports = require('./y')`. The import row carries the resolved file.
// `export * from './y'` spreads y's surface; `export * as ns from './y'` — which the
// parser also files as EXPORT_ALL, with exportedName = ns — is ONE export holding the
// module (#483).
module_export_value(mod, n, k, i) :- export_decl(_, en, _, "EXPORT_ALL", _, _, _, _, mod, x), export_all_is_spread(en),
    export_reexport(_, _, imp, x), import_module(imp, src),
    module_export_value(src, n, k, i), n != "default".
module_export_value(mod, en, "module", src) :- export_decl(_, en, _, "EXPORT_ALL", _, _, _, _, mod, x), !export_all_is_spread(en),
    export_reexport(_, _, imp, x), import_module(imp, src).
export_all_is_spread("").
export_all_is_spread("*").
module_export_value(mod, en, k, i) :- export_decl(_, en, ln, form, _, _, _, _, mod, x), form != "EXPORT_ALL",
    export_reexport(_, _, imp, x), import_module(imp, src), ln != "",
    module_export_value(src, ln, k, i).
module_export_value(mod, "default", "module", src) :- export_decl(_, "default", _, "MODULE_EXPORTS_ASSIGNMENT", "REQUIRE_REEXPORT", _, _, _, mod, x),
    export_reexport(_, _, imp, x), import_module(imp, src).

// ── import_value(ImportHash, K, I) — what a binding introduced by an import holds ──
import_value(imp, "module", mod) :- import_decl(_, _, _, "NAMESPACE", _, _, _, _, imp), import_module(imp, mod).
// A CommonJS `require()` binding IS `module.exports` — when that is an array, a class
// or a function, the binding holds that value too, so `methods.forEach(...)` over a
// module that exports an array iterates it and `new (require('./x'))` constructs it.
import_value(imp, k, i) :- import_decl(_, _, "REQUIRE_CALL", "NAMESPACE", _, _, _, _, imp), import_module(imp, mod),
    module_decl(_, _, _, _, "COMMONJS", mod), module_export_value(mod, "default", k, i), k != "module".
import_value(imp, k, i) :- import_decl(_, _, _, "DEFAULT", _, _, _, _, imp), import_module(imp, mod),
    module_export_value(mod, "default", k, i).
// `import util from './util.cjs'` — an ES default import of a COMMONJS module is
// `module.exports`: the module's own surface when the file exports through
// `exports.x =`, beside any `module.exports = X` value the rule above found (#596).
import_value(imp, "module", mod) :- import_decl(_, _, _, "DEFAULT", _, _, _, _, imp), import_module(imp, mod),
    module_decl(_, _, _, _, "COMMONJS", mod).
import_value(imp, k, i) :- import_decl(_, _, _, bf, n, _, _, _, imp), import_binding_is_named(bf), n != "",
    import_module(imp, mod), module_export_value(mod, n, k, i).
import_binding_is_named("NAMED").
import_binding_is_named("DESTRUCTURED").
// `const { nested: { inner } } = require('m')` — the imported name is the binding's
// PATH (`nested.inner`), walked from the module value like any pattern (#487).
import_value(imp, k, i) :- import_decl(_, _, _, "DESTRUCTURED", n, _, _, _, imp), contains(".", n),
    import_module(imp, mod), path_value("module", mod, n, k, i).
// A JSDoc `import('./x.js').Name` — no local binding; the imported name is the
// member (`default` for the default export). Type-only, and read only by the
// type-reference rules.
import_value(imp, k, i) :- import_decl(_, _, "JSDOC_IMPORT_TYPE", _, n, _, _, _, imp), n != "",
    import_module(imp, mod), module_export_value(mod, n, k, i).
// A bare `import('./x')` with no qualifier (#631): `@typedef {import("../Module")} Module`,
// the JSDoc-typed CommonJS idiom for "the class that file exports". Of a CommonJS module
// it is `module.exports`, exactly as `require('./x')` is at runtime and as an ES default
// import of one is (#596): the default export's value. Of any module it is also the
// module value, the namespace object, whose properties are the export surface.
import_value(imp, k, i) :- import_decl(_, _, "JSDOC_IMPORT_TYPE", "NO_LOCAL_BINDING", "", _, _, _, imp),
    import_module(imp, mod), module_decl(_, _, _, _, "COMMONJS", mod),
    module_export_value(mod, "default", k, i), k != "module".
import_value(imp, "module", mod) :- import_decl(_, _, "JSDOC_IMPORT_TYPE", "NO_LOCAL_BINDING", "", _, _, _, imp),
    import_module(imp, mod).

// ── import_binding_unresolved(ImportHash, Name) — countable ─────────────────
// The module was reached and exports no such name (or the name's value is not
// derivable). Distinct from import_unresolved: the dependency IS staged.
import_binding_unresolved(imp, n) :- import_decl(_, _, _, bf, n, _, _, _, imp), import_binding_is_named(bf), n != "", !contains(".", n),
    import_module(imp, _), !import_value(imp, _, _).
// A DEFAULT binding that reached its module and holds nothing: an ES module with
// no default export, imported as one.
import_binding_unresolved(imp, "default") :- import_decl(_, _, _, "DEFAULT", _, _, _, _, imp),
    import_module(imp, _), !import_value(imp, _, _).
