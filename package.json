{
  "name": "@axiomcode/code-graph",
  "version": "0.1.0",
  "description": "AxiomCode Graph: a resolved call graph of your codebase grounded in formal methods, so you and your coding agents can see who calls what, what a change breaks, and which tests it reaches.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxiomCodeAI/axiomcodegraph.git"
  },
  "main": "dist/reason.js",
  "types": "dist/reason.d.ts",
  "scripts": {
    "reason": "node dist/index.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "npm --prefix parser run build && tsc && tsc-alias",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "schema-doc": "tsx graph/bundle/cli.ts --print-schema > graph/bundle/SCHEMA.md"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0"
  },
  "workspaces": [
    "parser"
  ],
  "license": "FSL-1.1-Apache-2.0",
  "optionalDependencies": {
    "@axiomcode/engine-darwin-arm64": "0.1.0",
    "@axiomcode/engine-darwin-x64": "0.1.0",
    "@axiomcode/engine-linux-x64": "0.1.0",
    "@axiomcode/engine-linux-arm64": "0.1.0",
    "@axiomcode/engine-win32-x64": "0.1.0"
  },
  "bin": {
    "axiomcode": "bin/axiomcode.js"
  },
  "files": [
    "bin/",
    "dist/",
    "graph/",
    "!graph/test/",
    "plugins/axiomcode/",
    "!plugins/axiomcode/validate/",
    "!plugins/**/__pycache__/",
    "parser/dist/",
    "parser/package.json",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "sax": "^1.4.4",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-groovy": "^0.1.2",
    "tree-sitter-java": "0.23.4",
    "tree-sitter-python": "^0.21.0",
    "typescript": "^5.3.3",
    "yaml": "^2.8.2"
  }
}
