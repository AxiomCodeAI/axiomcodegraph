// ============================================================================
// Resolution · MODULE GRAPH  (import -> module -> export -> declaration)
//
// THE FILE THE WHOLE ENGINE HANGS ON. In Java, `import a.b.C` names its target
// completely and `type_resolves_in_file` is a name match. Here an import names a
// MODULE and a NAME within it, the module must be located on disk, and the name may
// travel an arbitrary re-export chain before it reaches a declaration. Both halves
// of what the user asked for — client -> client and client -> lib — are decided in
// this file and nowhere else.
//
// ── THE HASH RULE, and why paths are used instead ───────────────────────────
// `ts_import.resolvedModuleLinkHash` is filled by the parser, and it is RUN-LOCAL:
// it can only ever name a module extracted in the SAME run. A library IR is by
// definition a different run, so that column is structurally incapable of crossing
// the client->lib boundary — staging more library relations does not help, because
// no hash on either side was ever computed from the other's inputs. (This is the
// same trap `.claude/building-an-engine.md` records for Python's
// `resolvedCalleeHash`: 24 resolved callees, 3 dangling, and staging 13 -> 25
// relations changed nothing.)
//
// So cross-run linking goes through NAMES, and TypeScript supplies two good ones:
//
//   1. THE SPECIFIER. `ts.resolveModuleName` may resolve nothing on disk and the
//      import still be answerable, because a package can ship
//      `declare module "foo"`. Measured on @types/node: 111 of 198 modules are
//      AMBIENT_MODULE_DECLARATION rows carrying declaredSpecifier "fs", "node:fs",
//      "fs/promises", … and the client's importedPath is exactly that string.
//      Every Node builtin import in the corpus (63 of them) links this way and by
//      no other, because their resolvedFilePath is empty.
//
//   2. THE RESOLVED FILE PATH, matched at a path-segment boundary. The parser wrote
//      the path `ts.resolveModuleName` chose, WITHOUT its extension (measured:
//      "src/analysis-methods/java/MethodRegistry", while the module's own filePath
//      is "…/MethodRegistry.ts"), so the extension column must be re-appended
//      before any comparison — a plain equality join on the raw column matches
//      NOTHING, silently, which is exactly the failure shape this engine is
//      supposed to make loud.
//
// The two IRs are rooted differently (a client rooted at the repo, a library rooted
// at the package), so the paths agree only on a SUFFIX. Suffixes are enumerated at
// "/" boundaries and the LONGEST match wins, which is what keeps a library file
// called `index.d.ts` from matching every client `index.ts` in the tree.
//
// ── STRATIFICATION ──────────────────────────────────────────────────────────
// Everything here reads projections of base facts only. Nothing reads expr_type,
// expr_call_candidate or any call-graph relation, so this whole file sits BELOW the
// resolution fixpoint and the negations it uses (!module_is_external,
// !module_has_export_row) are legal. Downstream files may negate anything derived
// here for the same reason. The one recursion (module_export through re-exports) is
// positive and monotone.
// ============================================================================

// ── path_key(Path) — every path this file will need suffixes of ─────────────
// Bounded on purpose: only import targets, never every string in the IR.
import_full_path(h, full) :- import_resolved_file("client", fp, _, h),
    ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, fp, _, ext, _, _, _, _, _, _, _, _, h),
    full = cat(fp, ext).
// An import whose resolvedExtension is empty (the specifier resolved to a path the
// compiler could not extension-tag) still gets its raw path as a candidate.
import_full_path(h, fp) :- import_resolved_file("client", fp, _, h),
    ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, fp, _, "", _, _, _, _, _, _, _, _, h).

path_key(p) :- import_full_path(_, p).
// Client module paths too: a RELATIVE re-export (`export * from "./Foo"`) is resolved
// by directory, and the directory of a module is a prefix of its own file path.
path_key(p) :- module_file("client", p, _).

// ── path_tail(Path, Tail) — suffixes beginning at a segment boundary ────────
// Souffle has no index-of, so the "/" positions are found by a linear character
// scan. Bounded by (import paths) x (path length): ~1.5k x ~120 on the measured
// corpus, which is nothing next to the 163k expression rows already loaded.
path_pos(p, 0) :- path_key(p), strlen(p) > 0.
path_pos(p, j) :- path_pos(p, i), i < strlen(p) - 1, j = i + 1.
path_slash(p, i) :- path_pos(p, i), substr(p, i, 1) = "/".
path_tail(p, p) :- path_key(p).
path_tail(p, t) :- path_slash(p, i),
    n = strlen(p) - i - 1,
    n > 0,
    t = substr(p, i + 1, n).

// ── path_dir / path_base — the last segment boundary ────────────────────────
// Needed for RELATIVE re-export resolution. `max` over the scan gives the last "/"
// without an index-of; a path with no "/" at all is its own basename and has the
// empty directory, which is the correct answer for a module at the corpus root.
path_last_slash(p, n) :- path_slash(p, _), n = max i : { path_slash(p, i) }.
path_dir(p, d) :- path_last_slash(p, i), d = substr(p, 0, i + 1).
path_dir(p, "") :- path_key(p), !path_slash(p, _).
path_base(p, b) :- path_last_slash(p, i), n = strlen(p) - i - 1, n > 0, b = substr(p, i + 1, n).
path_base(p, p) :- path_key(p), !path_slash(p, _).

// ============================================================================
// IMPORT -> TARGET MODULE
// ============================================================================

// ── Route 1: same-run hash. Client -> client only, by construction. ─────────
import_target_module(h, "client", m) :- import_resolved_module("client", m, h),
    module_decl("client", _, _, _, _, m).

// ── Route 2: specifier -> ambient module declaration. The client->lib route ──
// for anything shipping `declare module "x"`, and the ONLY route for a Node
// builtin, whose resolvedFilePath is empty by construction.
import_target_module(h, "lib", m) :- import_specifier("client", spec, h),
    module_ambient_specifier("lib", spec, m).
import_target_module(h, "client", m) :- import_specifier("client", spec, h),
    module_ambient_specifier("client", spec, m).

// ── Route 3: resolved file path, longest segment-aligned suffix ─────────────
// Both directions of containment are tried, because which side is the longer path
// depends on where each IR was rooted: a client rooted at the repo has the deeper
// path when it points into node_modules, and a library rooted at the package root
// has the shallower one. Only the suffix side is enumerated, so at most one of the
// two fires for any given pair.
import_path_cand(h, "lib", m, l) :- import_full_path(h, p),
    path_tail(p, t),
    module_file("lib", t, m),
    l = strlen(t).
import_path_cand(h, "client", m, l) :- import_full_path(h, p),
    path_tail(p, t),
    module_file("client", t, m),
    l = strlen(t).
import_path_best(h, n) :- import_path_cand(h, _, _, _),
    n = max l : { import_path_cand(h, _, _, l) }.
import_target_module(h, prov, m) :- import_path_cand(h, prov, m, l),
    import_path_best(h, l).

// ── import_unresolved(ImportHash) — a DECLARED blind spot, not a silence ────
// An import that reached no module. Exported, because "which dependency is not
// staged" is the single question that explains most of a TypeScript engine's
// unresolved call sites, and a count is the only way to answer it.
import_has_target(h) :- import_target_module(h, _, _).
import_unresolved(h, rk) :- import_resolution_kind("client", rk, h),
    !import_has_target(h).

// ============================================================================
// MODULE -> EXPORTED NAME -> DECLARATION
// ============================================================================

// ── module_local_decl(Prov, ModuleHash, Name, Kind, Hash) ───────────────────
// A module's own top-level declarations, keyed by the name written in source. The
// input to both the export table (an `export { x }` names one of these) and the
// global scope (an ambient script's declarations ARE these).
//
// Types: any placement except LOCAL/EXPRESSION — a class declared inside a function
// body is not a module-level name. Namespace members are reached through their
// namespace, not here.
module_local_decl(prov, mod, name, "TYPE", t) :- type_module(prov, mod, t),
    type_decl(prov, name, _, _, _, place, t),
    placement_is_module_level(place).
// Functions with NO owning type. Measured on @types/node: 849 of them inside
// ambient modules — `fs.readFile`, `path.join`, every free function in the Node
// surface. A rule keyed on an owning type finds none of them.
module_local_decl(prov, mod, name, "METHOD", m) :- method_module(prov, mod, m),
    method_owner(prov, "", m),
    method_decl(prov, _, name, _, m),
    name != "".
// Module-scope variables — including the `const f = () => {}` shape, whose bound
// function is reached through var_bound_function.
module_local_decl(prov, mod, name, "VARIABLE", v) :- var_decl(prov, name, _, sk, _, mod, v),
    scope_is_module_level(sk).

// NAMESPACE_PLACEMENT IS DELIBERATELY ABSENT, and leaving it in was a measured
// precision bug. A namespace member is reached through its namespace — `Reflect.set`,
// `ts.isIdentifier` — and admitting it as a module-level declaration puts it in the
// GLOBAL scope, where every bare `set(...)` and `get(...)` in the program then
// resolves to `Reflect.set`. On zustand that produced 94 wrong FUNCTION_CALL targets
// out of 97 total: `set(state)` inside a store initialiser, resolved to
// lib.es2015.reflect.d.ts. Namespace contents reach the export table through
// namespace_member and rule (g2) instead, which is where `export = ts` puts them.
placement_is_module_level("TOP_LEVEL_PLACEMENT").
placement_is_module_level("AMBIENT_MODULE_PLACEMENT").
scope_is_module_level("MODULE_SCOPE").
scope_is_module_level("GLOBAL_SCOPE").
scope_is_module_level("AMBIENT_SCOPE").
scope_is_module_level("NAMESPACE_SCOPE").

// ── module_export_any / module_export(Prov, Mod, ExportedName, Kind, EntityHash) ──
// TWO tables, and the split is not cosmetic. 45.6% of ecosystem imports and a large
// share of exports are TYPE-ONLY: they name a real declaration, they are the correct
// answer for a type reference, and they must NEVER produce a call edge (§3.3). So
// `module_export_any` is the resolution surface for the TYPE graph, and
// `module_export` — the same table minus the type-only names — is the surface for
// the CALL graph. Collapsing them either strands every `import type { Foo }` used as
// a receiver annotation, or fills the call graph with phantoms.
//
// (a) INLINE_DECLARATION — `export class C {}`. The entity hash is on the row.
module_export_any(prov, mod, en, ek, eh) :- export_decl(prov, en, _, _, mod, h),
    export_entity(prov, ek, eh, _, h).

// (b) NAMED_EXPORT / NAMED_ALIAS with no entity hash — `export { c }`,
// `export { c as d }`. Measured on this repository's own source: 300 of 935 export
// rows are exactly this shape with an EMPTY entity hash, so a rule that only reads
// (a) loses a third of the client export surface. The local name is matched against
// the module's own declarations.
module_export_any(prov, mod, en, k, hh) :- export_decl(prov, en, ln, ek, mod, h),
    export_kind_is_local_name(ek),
    !export_entity(prov, _, _, _, h),
    !export_source(prov, _, _, h),
    ln != "",
    module_local_decl(prov, mod, ln, k, hh).

// (c) RE-EXPORT of a named binding — `export { a as b } from "./m"`. localName is
// the name in the SOURCE module, exportedName the alias seen by an importer. Using
// one where the other belongs resolves to nothing, silently.
module_export_any(prov, mod, en, k, hh) :- export_decl(prov, en, ln, ek, mod, h),
    export_kind_is_local_name(ek),
    export_target_module(h, prov, src),
    ln != "",
    module_export_any(prov, src, ln, k, hh).

// (d) EXPORT_STAR — `export * from "./m"`. The row cannot name what it exports, so
// the set is expanded from the source module. `default` is NOT re-exported by a
// star, per the language, and including it would let one barrel file's default leak
// into every module that stars it.
module_export_any(prov, mod, en, k, hh) :- export_decl(prov, _, _, ek, mod, h),
    export_kind_is_star(ek),
    export_target_module(h, prov, src),
    module_export_any(prov, src, en, k, hh),
    en != "default".

// (e) `export default X` — recorded on the module, not only on the export row.
module_export_any(prov, mod, "default", "UNKNOWN", ent) :- module_default_export(prov, ent, mod).

// (f) AMBIENT MODULE — no export rows exist at all; the members ARE the surface.
// This is the rule that makes @types/* reachable: measured on @types/node, 198
// modules, 0 export rows, 6,929 methods. Gated on the module kind so a SOURCE_MODULE
// that exports nothing keeps exporting nothing.
module_export_any(prov, mod, name, k, h) :- module_decl(prov, _, _, _, kind, mod),
    module_kind_is_ambient(kind),
    module_local_decl(prov, mod, name, k, h).

// (g) A non-external DECLARATION_FILE has global declarations rather than exports,
// but a client import may still resolve to its FILE (a `.d.ts` reached by path).
// Treat its top-level declarations as reachable through that file, which is what the
// compiler does for a triple-slash-referenced declaration file.
module_export_any(prov, mod, name, k, h) :- module_decl(prov, _, _, _, "DECLARATION_FILE", mod),
    !module_is_external(prov, mod),
    module_local_decl(prov, mod, name, k, h).

// (g2) `export = ts` / `export = Parser` — an EXPORT ASSIGNMENT whose entity is a
// NAMESPACE. The assigned namespace IS the module's export surface, so its members
// are the module's exports. This is how the entire TypeScript compiler API is
// reached: typescript.d.ts is `declare namespace ts { … } export = ts`, and without
// this rule its module exports exactly ONE name — the namespace itself — while
// `ts.isIdentifier`, `ts.forEachChild` and 641 other measured call sites resolve to
// nothing. tree-sitter.d.ts has the identical shape.
module_export_any(prov, mod, name, k, ent) :- export_decl(prov, _, _, ek, mod, h),
    export_kind_is_assignment(ek),
    export_entity(prov, "TYPE", ns, _, h),
    namespace_member(prov, ns, name, k, ent).
export_kind_is_assignment("EXPORT_ASSIGNMENT").
export_kind_is_assignment("DEFAULT_EXPORT").

// (h) RECOVERY — a module with NO export rows and no export-assignment column.
// `export = Parser` written INSIDE `declare module "tree-sitter" { ... }`, and the
// same construct at the end of `typescript.d.ts`, produce neither a ts_export row nor
// a populated exportAssignmentLinkHash — measured: 0 export rows across @types/node,
// the TypeScript lib and tree-sitter, all of which use `export =`. Filed as a parser
// defect; recovered here rather than worked around silently, because without it the
// export table of every CommonJS-shaped dependency is EMPTY and no client->lib edge
// into one can exist at all.
//
// The recovery is name-based and its scope is stated: only for a module that exports
// NOTHING by any other route, so it can never override a real export row. Counted in
// module_export_recovered so the defect stays visible in the numbers instead of
// disappearing into a working engine.
module_has_export_surface(mod) :- export_decl(_, _, _, _, mod, _).
module_has_export_surface(mod) :- module_default_export(_, _, mod).
module_has_export_surface(mod) :- module_export_assignment(_, _, mod).
module_export_recovered(mod, "no_export_rows") :- module_decl(_, _, _, _, _, mod),
    !module_has_export_surface(mod),
    module_local_decl(_, mod, _, _, _).
module_export_any(prov, mod, name, k, h) :- module_export_recovered(mod, _),
    module_local_decl(prov, mod, name, k, h).

// ── the runtime subset ──────────────────────────────────────────────────────
// A name whose export row is type-only is removed from the call-graph surface. The
// negation reads only base export rows (never module_export_any), so it stratifies
// below the re-export recursion.
module_export_type_only(prov, mod, en) :- export_decl(prov, en, _, _, mod, h),
    export_is_type_only(prov, h).
module_export(prov, mod, en, k, h) :- module_export_any(prov, mod, en, k, h),
    !module_export_type_only(prov, mod, en).

export_kind_is_star("EXPORT_STAR").
export_kind_is_star("EXPORT_STAR_AS_NAMESPACE").
export_kind_is_local_name("NAMED_EXPORT").
export_kind_is_local_name("NAMED_ALIAS").
export_kind_is_local_name("EXPORT_IMPORT_EQUALS").

// ── export_target_module(ExportHash, Prov, ModuleHash) ──────────────────────
// Where a re-export points. Same three routes as an import, for the same reason:
// the hash is run-local, the specifier reaches an ambient module, and the path
// reaches a file in either IR. `export * from "./x"` inside a library's barrel file
// is how a package's real declarations become visible under its package name, so
// this must work on the LIB side too, not only the client side.
export_target_module(h, "client", m) :- export_source("client", _, m, h),
    m != "",
    module_decl("client", _, _, _, _, m).
export_target_module(h, "lib", m) :- export_source("lib", _, m, h),
    m != "",
    module_decl("lib", _, _, _, _, m).
// A LIBRARY's own re-export chain, resolved by the same directory join. Measured on
// vitest: 18 of 19 re-export rows carry an EMPTY resolvedSourceModuleLinkHash, so
// without this the package's barrel file exports nothing and every `expect(...)`,
// `it(...)` and `describe(...)` in a test suite is unresolved.
lib_export_relative_base(h, base) :- export_source("lib", spec, "", h),
    strlen(spec) > 2,
    substr(spec, 0, 2) = "./",
    base = substr(spec, 2, strlen(spec) - 2).
lib_export_relative_base(h, stem) :- export_source("lib", spec, "", h),
    strlen(spec) > 5,
    substr(spec, 0, 2) = "./",
    l = strlen(spec),
    substr(spec, l - 3, 3) = ".js",
    stem = substr(spec, 2, l - 5).
// A LIBRARY re-exporting from ANOTHER PACKAGE — `export * from "@vitest/runner"` in
// vitest's barrel. Non-relative, so the mapping is project-wide and any import of the
// same specifier anywhere in the staged library set answers it. Without this a
// package that presents itself by re-exporting its siblings exports only what it
// declares itself, which for a modern monorepo-published package is almost nothing:
// measured on vitest, `it` and `describe` come from @vitest/runner and were
// unreachable while `expect` (declared locally) resolved.
lib_specifier_global_target(spec, prov, m) :- import_specifier("lib", spec, ih),
    !specifier_is_relative(spec),
    lib_import_target(ih, prov, m).
export_target_module(h, prov, m) :- export_source("lib", spec, "", h),
    spec != "",
    lib_specifier_global_target(spec, prov, m).
export_target_module(h, "lib", m) :- export_source("lib", spec, "", h),
    spec != "",
    module_ambient_specifier("lib", spec, m).

export_target_module(h, "lib", m) :- lib_export_relative_base(h, base),
    lib_ts_export(_, _, _, _, _, _, _, emod, _, _, _, _, _, _, _, _, _, _, _, _, h),
    module_file("lib", epath, emod),
    path_dir(epath, dir),
    ts_source_extension(ext),
    cand = cat(cat(dir, base), ext),
    module_file("lib", cand, m).
path_key(p) :- module_file("lib", p, _).
export_target_module(h, "lib", m) :- export_source("client", spec, "", h),
    spec != "",
    module_ambient_specifier("lib", spec, m).
export_target_module(h, "client", m) :- export_source("client", spec, "", h),
    spec != "",
    module_ambient_specifier("client", spec, m).

// ── Route 4: the specifier resolved the way an IMPORT of it resolves ────────
// The parser runs `ts.resolveModuleName` for IMPORTS and not for EXPORTS, so a
// re-export row arrives with resolvedSourceModuleLinkHash EMPTY and only a
// specifier. Measured on this repository's own source that is not an edge case: the
// barrel file `analysis-types/python/index.ts` is 30 consecutive
// `export { X } from '@/analysis-types/python/X'` lines, every one with an empty
// source hash — and with no route for them, 425 client NAMED imports resolved to
// nothing and 89 references to a class in this very repository were reported as
// unresolved library types.
//
// A NON-RELATIVE specifier ("@/x", "lodash") maps to one module PROJECT-WIDE, because
// tsconfig paths and node resolution are both global. So the mapping any import of
// that specifier produced is the mapping this export gets. A RELATIVE specifier is
// per-directory and must NOT use this route — hence the leading-character test.
specifier_is_relative(spec) :- import_specifier("client", spec, _), spec != "", substr(spec, 0, 1) = ".".
specifier_is_relative(spec) :- export_source("client", spec, _, _), spec != "", substr(spec, 0, 1) = ".".
specifier_is_relative(spec) :- import_specifier("lib", spec, _), spec != "", substr(spec, 0, 1) = ".".
specifier_is_relative(spec) :- export_source("lib", spec, _, _), spec != "", substr(spec, 0, 1) = ".".
specifier_global_target(spec, prov, m) :- import_specifier("client", spec, ih),
    !specifier_is_relative(spec),
    import_target_module(ih, prov, m).
export_target_module(h, prov, m) :- export_source("client", spec, "", h),
    spec != "",
    specifier_global_target(spec, prov, m).

// ── Route 5: a RELATIVE re-export, resolved by directory + basename ─────────
// `export * from "./PyTypeRegistry"` in `a/b/index.ts` names `a/b/PyTypeRegistry.ts`.
// Same directory, and the target's basename is the specifier's basename plus an
// extension. Deliberately narrow: `../x/Foo` is NOT covered, because collapsing `..`
// needs real path arithmetic and guessing it would be worse than counting it.
// export_specifier_unresolved records exactly what this leaves behind.
export_relative_base(h, base) :- export_source("client", spec, "", h),
    specifier_is_relative(spec),
    strlen(spec) > 2,
    substr(spec, 0, 2) = "./",
    base = substr(spec, 2, strlen(spec) - 2).
// The exporter's DIRECTORY joined with the specifier, then an extension. A plain
// concatenation, so `./chunks/api.js` in `dist/index.d.ts` reaches
// `dist/chunks/api.d.ts` — which a same-directory rule cannot, and which is how every
// bundled npm package lays out its declarations.
export_target_module(h, "client", m) :- export_relative_base(h, base),
    ts_export(_, _, _, _, _, _, _, emod, _, _, _, _, _, _, _, _, _, _, _, _, h),
    module_file("client", epath, emod),
    path_dir(epath, dir),
    ts_source_extension(ext),
    cand = cat(cat(dir, base), ext),
    module_file("client", cand, m).
// The same, with a `.js` specifier rewritten to a declaration extension. ESM output
// imports `./x.js` and ships `./x.d.ts` beside it; taking the specifier literally
// finds a file that is not in any IR.
export_relative_js_stem(h, stem) :- export_relative_base(h, base),
    l = strlen(base),
    l > 3,
    substr(base, l - 3, 3) = ".js",
    stem = substr(base, 0, l - 3).
export_target_module(h, "client", m) :- export_relative_js_stem(h, stem),
    ts_export(_, _, _, _, _, _, _, emod, _, _, _, _, _, _, _, _, _, _, _, _, h),
    module_file("client", epath, emod),
    path_dir(epath, dir),
    ts_source_extension(ext),
    cand = cat(cat(dir, stem), ext),
    module_file("client", cand, m).

// ── Route 6: the specifier as a PATH SUFFIX, with an extension appended ─────
// A tsconfig `paths` alias — `@/analysis-types/python/PyBindingRegistry` — is neither
// relative nor resolvable from another import when the barrel file is the only place
// that names it. But the alias only ever rewrites a PREFIX, so the specifier's tail
// is a tail of the target's file path, and appending each legal source extension
// turns that into an equality join instead of a search.
//
// Required to be MULTI-SEGMENT (`base_has_slash`): a single-segment tail like "index"
// matches every barrel file in the tree, and the longest-match tie-break cannot
// separate them. Better to leave those to route 5 and count what is left.
ts_source_extension(".ts").
ts_source_extension(".tsx").
ts_source_extension(".d.ts").
ts_source_extension(".mts").
ts_source_extension(".cts").
ts_source_extension(".js").
ts_source_extension("/index.ts").
ts_source_extension("/index.tsx").
ts_source_extension("/index.d.ts").
path_key(spec) :- export_source("client", spec, "", _), spec != "".
// A MULTI-SEGMENT tail: taken at a slash that has another slash after it, plus the
// whole path when it contains any slash at all.
path_tail_multi(p, t) :- path_slash(p, i), path_slash(p, j), j > i,
    n = strlen(p) - i - 1, n > 0, t = substr(p, i + 1, n).
path_tail_multi(p, p) :- path_slash(p, _).
export_spec_cand(h, cand, l) :- export_source("client", spec, "", h),
    spec != "",
    path_tail_multi(spec, t),
    ts_source_extension(ext),
    cand = cat(t, ext),
    l = strlen(t).
module_tail("client", t, m) :- module_file("client", p, m), path_tail(p, t).
export_spec_best(h, n) :- export_spec_cand(h, _, _),
    n = max l : { export_spec_cand(h, _, l) }.
export_target_module(h, "client", m) :- export_spec_cand(h, cand, l),
    export_spec_best(h, l),
    module_tail("client", cand, m).

// ── export_specifier_unresolved(ExportHash, Specifier) ──────────────────────
// EVERY SUPPRESSION COUNTABLE. A re-export whose source module was not located, with
// the specifier that failed — the row to read when a barrel file is silently empty.
export_has_target(h) :- export_target_module(h, _, _).
export_specifier_unresolved(h, spec) :- export_source("client", spec, _, h),
    spec != "",
    !export_has_target(h).

// ============================================================================
// IMPORT BINDING -> DECLARATION
// ============================================================================

// ── import_binds_any / import_binds(ImportHash, Kind, EntityHash) ──────────
// The same two-table split as the export surface, for the same reason: a
// `import type { Handler }` binding is the CORRECT answer when `Handler` annotates a
// receiver, and a WRONG one the moment anything tries to call through it.
import_binds_any(h, prov, k, ent) :- import_binding("client", ik, _, orig, _, h),
    import_kind_binds_named(ik),
    orig != "",
    import_target_module(h, prov, m),
    module_export_any(prov, m, orig, k, ent).

// A DEFAULT import binds the module's `default` export. The parser leaves
// originalName empty for these (there is no name in the source module to carry), so
// the export name is the literal "default" rather than anything on the row.
import_binds_any(h, prov, k, ent) :- import_binding("client", ik, _, _, _, h),
    import_kind_binds_default(ik),
    import_target_module(h, prov, m),
    module_export_any(prov, m, "default", k, ent).
import_binds_any(h, prov, "UNKNOWN", ent) :- import_binding("client", ik, _, _, _, h),
    import_kind_binds_default(ik),
    import_target_module(h, prov, m),
    module_default_export(prov, ent, m).

// `import x = require("m")` binds the module's EXPORT ASSIGNMENT — the whole module
// as one entity. No Java or Python analogue; the dominant shape in @types packages
// for CommonJS libraries, so omitting it silently loses those dependencies whole.
import_binds_any(h, prov, "UNKNOWN", ent) :- import_binding("client", "IMPORT_EQUALS_REQUIRE", _, _, _, h),
    import_target_module(h, prov, m),
    module_export_assignment(prov, ent, m).

// `import X from "m"` where m has NO `default` export. Under esModuleInterop that is
// the CommonJS shape — `export = Parser` — and X denotes the whole module entity. Two
// bindings follow, both name-based and both stated rather than inferred:
//   * X is a NAMESPACE onto m, which is what makes `Parser.SyntaxNode` resolve (768
//     references to that one name on this repository's own source).
//   * X is m's export of the same LOCAL NAME, which is what makes `new Parser()` and
//     `parser.parse()` resolve when the local name matches the exported one.
// The second is a heuristic and is labelled as one: it fires ONLY where the module has
// no `default`, and every row it produces is counted in import_binds_interop.
module_has_default_export(prov, m) :- module_export_any(prov, m, "default", _, _).
import_binds_interop(h, prov, k, ent) :- import_binding("client", ik, local, _, _, h),
    import_kind_binds_interop(ik),
    local != "",
    import_target_module(h, prov, m),
    !module_has_default_export(prov, m),
    module_export_any(prov, m, local, k, ent).
// NAMESPACE imports take the same route, and for a measured reason. `import * as path
// from "path"` against a module written `namespace path { interface PlatformPath {
// join(...) } } const path: path.PlatformPath; export = path` exports ONE name — the
// value `path` — and `join` is a member of ITS TYPE, not an export of the module. So
// treating the binding purely as a namespace finds no `join` at all: 176 sites on
// this corpus. Binding the local name to the module's export of the same name is what
// the `export =` interop actually does.
import_kind_binds_interop("DEFAULT").
import_kind_binds_interop("TYPE_ONLY_DEFAULT").
import_kind_binds_interop("NAMESPACE").
import_kind_binds_interop("TYPE_ONLY_NAMESPACE").
import_kind_binds_interop("IMPORT_EQUALS_REQUIRE").
import_binds_any(h, prov, k, ent) :- import_binds_interop(h, prov, k, ent).
import_binds_namespace_any(h, prov, m) :- import_binding("client", ik, _, _, _, h),
    import_kind_binds_default(ik),
    import_target_module(h, prov, m),
    !module_has_default_export(prov, m).

import_binds(h, prov, k, ent) :- import_binds_any(h, prov, k, ent),
    !import_is_type_only("client", h).

import_kind_binds_default("DEFAULT").
import_kind_binds_default("TYPE_ONLY_DEFAULT").
import_kind_binds_named("NAMED").
import_kind_binds_named("NAMED_ALIAS").
import_kind_binds_named("TYPE_ONLY_NAMED").
import_kind_binds_named("INLINE_TYPE_SPECIFIER").

// ── import_binds_namespace(ImportHash, Prov, ModuleHash) ────────────────────
// `import * as fs from "fs"` binds a MODULE, not a declaration — so `fs.readFile()`
// is a lookup in an export table, not a member lookup on a type. Measured: every
// Node builtin import in the corpus takes this shape. Keeping namespaces in their
// own relation rather than forcing them through expr_type is what stops the engine
// inventing a type for something that has none.
import_binds_namespace_any(h, prov, m) :- import_binding("client", ik, _, _, _, h),
    import_kind_binds_namespace(ik),
    import_target_module(h, prov, m).
import_binds_namespace(h, prov, m) :- import_binds_namespace_any(h, prov, m),
    !import_is_type_only("client", h).
// An export-assignment module imported as a namespace still exposes its members by
// name, so it is reachable through the same relation.
import_kind_binds_namespace("NAMESPACE").
import_kind_binds_namespace("TYPE_ONLY_NAMESPACE").
import_kind_binds_namespace("IMPORT_EQUALS_REQUIRE").

// ── import_binding_unresolved(ImportHash, Kind, LocalName) ──────────────────
// A runtime binding that reached a module and found no export of that name — a
// DECLARED blind spot, and a materially different diagnosis from "the module was
// never staged". Exported so the two can be counted apart.
import_binding_resolved(h) :- import_binds(h, _, _, _).
import_binding_resolved(h) :- import_binds_namespace(h, _, _).
import_binding_unresolved(h, ik, local) :- import_binding("client", ik, local, _, _, h),
    !import_is_type_only("client", h),
    import_kind_is_runtime(ik),
    import_has_target(h),
    !import_binding_resolved(h).

import_kind_is_runtime("NAMED").
import_kind_is_runtime("NAMED_ALIAS").
import_kind_is_runtime("DEFAULT").
import_kind_is_runtime("NAMESPACE").
import_kind_is_runtime("IMPORT_EQUALS_REQUIRE").
import_kind_is_runtime("IMPORT_EQUALS_ENTITY").

// ============================================================================
// GLOBAL SCOPE
// ============================================================================

// ── global_decl(Name, Kind, Prov, Hash) ─────────────────────────────────────
// Declarations visible with no import at all: the contents of every non-external
// script and every `declare global`. This is where `console`, `Promise`, `JSON`,
// `Array` and `process` live once the corresponding library IR is staged — and
// where they do NOT live when it is not, which is why an unstaged `lib.es5.d.ts`
// shows up as thousands of unresolved receivers rather than as an error.
global_decl(name, k, prov, h) :- module_is_global(prov, mod),
    module_local_decl(prov, mod, name, k, h).
global_decl(name, k, prov, h) :- module_decl(prov, _, _, _, "DECLARATION_FILE", mod),
    !module_is_external(prov, mod),
    module_local_decl(prov, mod, name, k, h).
