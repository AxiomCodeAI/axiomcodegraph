// ============================================================================
// Projections · IMPORTS AND EXPORTS  (pure column views — no joins, no closures)
//
// THE PAIR WITH NO JAVA ANALOGUE. Java visibility is a modifier and there is no
// re-export, so `import a.b.C` names its target completely and one projection
// suffices. Here an import names a MODULE and a NAME within it, and that name may
// be re-exported through an arbitrary chain of barrel files before it reaches a
// declaration (1,251 export declarations and 86 `export *` measured on one corpus).
// A client->lib rule that stops at the first module reaches `index.d.ts` and finds
// nothing, every time.
//
// The two halves are projected here; the CHAIN they form is derived in
// resolution/module-graph.dl.
//
// ts_import / lib_ts_import cols (27):
//   0 importKind  1 importedPath  2 moduleOrEntityName  3 simpleName  4 filePath
//   5 lineNumber  6 isTypeOnly  7 isWildcard  8 isModuleImport  9 originalName
//   10 aliasName  11 isDefaultImport  12 isSideEffectOnly  13 tsModuleLinkHash
//   14 resolvedModuleLinkHash  15 resolvedFilePath  16 resolutionKind
//   17 resolvedExtension  18 isExternalTarget  19 packageName
//   20 specifierHasExtension  21 importClauseIndex  22 tsExpressionLinkHash
//   23 startColumn  24 isExternal  25 serviceVersionLinkHash  26 tsImportUniqueHash
//
// ts_export / lib_ts_export cols (21):
//   0 exportedName  1 localName  2 exportKind  3 isTypeOnly  4 isDefault
//   5 isReExport  6 sourceSpecifier  7 tsModuleLinkHash
//   8 resolvedSourceModuleLinkHash  9 exportedEntityKind  10 exportedEntityLinkHash
//   11 exportedGroupKey  12 position  13 startLine  14 endLine  15 startColumn
//   16 isAmbient  17 tsExpressionLinkHash  18 isExternal
//   19 serviceVersionLinkHash  20 tsExportUniqueHash
// ============================================================================

// ── import_binding(Prov, Kind, LocalName, ImportedName, ImporterModule, ImportHash) ──
// One declaration with N named specifiers emits N ROWS, each binding one name, so
// this is already per-binding and needs no destructuring.
//
// Kind (col 0, TsImportKind):
//   NAMED / NAMED_ALIAS       import { f }        / import { f as g }
//   DEFAULT                   import f from "m"
//   NAMESPACE                 import * as ns from "m"
//   SIDE_EFFECT               import "m"          — binds nothing
//   TYPE_ONLY_* / INLINE_TYPE_SPECIFIER           — 45.6% of ecosystem imports;
//                             these bind a TYPE and must never produce a call edge
//   IMPORT_EQUALS_REQUIRE     import f = require("m")   — the CommonJS shape
//   IMPORT_EQUALS_ENTITY      import A = N.M.A          — a namespace alias
//   DYNAMIC_IMPORT / REQUIRE_CALL / TRIPLE_SLASH_REFERENCE / TYPE_IMPORT_NODE
//
// LocalName is col 3 (simpleName) — the name AS WRITTEN IN THIS FILE, which is what
// an identifier reference in the file binds to. ImportedName is col 9
// (originalName) — the name in the TARGET module, which is what the export table is
// keyed by. For `import { f as g }` they differ, and using one where the other
// belongs silently resolves to nothing.
import_binding("client", k, local, orig, mod, h) :- ts_import(k, _, _, local, _, _, _, _, _, orig, _, _, _, mod, _, _, _, _, _, _, _, _, _, _, _, _, h).
import_binding("lib", k, local, orig, mod, h) :- lib_ts_import(k, _, _, local, _, _, _, _, _, orig, _, _, _, mod, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── import_expr(Prov, ExprHash, ImportHash) ─────────────────────────────────
// Column 22, and nothing read it. A `import("./m")` is the only import that IS an
// expression, and this is the link back from that expression to the resolved import
// row — a join the static form does not even have. Without it a literal dynamic import
// named its module in the IR and typed nothing in the graph (#352).
import_expr("client", e, h) :- ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, e, _, _, _, h), e != "".
import_expr("lib", e, h) :- lib_ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, e, _, _, _, h), e != "".

// ── import_specifier(Prov, ImportedPath, ImportHash) ────────────────────────
// The specifier as WRITTEN ("./util", "lodash", "@/constants"). Kept because it is
// the only key an AMBIENT MODULE declaration can be matched on — a
// `declare module "foo"` claims a specifier, not a file.
import_specifier("client", p, h) :- ts_import(_, p, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
import_specifier("lib", p, h) :- lib_ts_import(_, p, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── import_resolved_module(Prov, TargetModuleHash, ImportHash) ──────────────
// Filled by the parser only when the target module was IN THE SAME extraction run.
// It is the fast path and covers client->client; a client->lib import has it empty
// and must go through import_resolved_file below.
import_resolved_module("client", t, h) :- ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, _, _, _, h), t != "".
import_resolved_module("lib", t, h) :- lib_ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, t, _, _, _, _, _, _, _, _, _, _, _, h), t != "".

// ── import_resolved_file(Prov, ResolvedFilePath, ResolutionKind, ImportHash) ─
// THE CLIENT->LIB JOIN KEY. `ts.resolveModuleName` — the compiler's own resolver,
// which needs no Program — ran at parse time and wrote the absolute path of the
// file the specifier resolves to, even when that file is in node_modules and was
// never extracted as client code. Staging that package's IR with --library then
// makes the join land, and nothing about the client extraction has to change.
//
// ResolutionKind (col 16, TsImportResolutionKind):
//   RELATIVE_FILE        ./util                    -> client, almost always
//   PATHS_ALIAS          @/constants               -> client, via tsconfig paths
//   NODE_MODULES_TYPES   lodash -> @types/lodash   -> lib
//   NODE_MODULES_SOURCE  a package shipping .ts    -> lib
//   PACKAGE_EXPORTS      an "exports" map entry    -> lib
//   AMBIENT_MODULE       matched a declare module  -> lib, by specifier not path
//   BUILTIN_NODE         node:fs, path             -> lib, needs @types/node staged
//   UNRESOLVED           nothing on disk answered  -> an honest dead end
import_resolved_file("client", fp, rk, h) :- ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, fp, rk, _, _, _, _, _, _, _, _, _, h), fp != "".
import_resolved_file("lib", fp, rk, h) :- lib_ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, fp, rk, _, _, _, _, _, _, _, _, _, h), fp != "".

// ── import_resolution_kind(Prov, ResolutionKind, ImportHash) ────────────────
// Projected separately so an UNRESOLVED import can be counted without first
// requiring a path it does not have.
import_resolution_kind("client", rk, h) :- ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, rk, _, _, _, _, _, _, _, _, _, h).
import_resolution_kind("lib", rk, h) :- lib_ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, rk, _, _, _, _, _, _, _, _, _, h).

// ── import_is_type_only(Prov, ImportHash) ───────────────────────────────────
// 45.6% of ecosystem imports are type-only. A type-only binding has NO runtime
// existence, so an edge through one is a phantom — §3.3's tripwire, enforced at
// every place a binding could become a call target.
import_is_type_only("client", h) :- ts_import(_, _, _, _, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
import_is_type_only("lib", h) :- lib_ts_import(_, _, _, _, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── import_package(Prov, PackageName, ImportHash) ───────────────────────────
// Which npm package a resolved import landed in. The slicing key for
// "which dependency is costing us recall", the same question Java answers with
// `--library` coverage.
import_package("client", p, h) :- ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, p, _, _, _, _, _, _, h), p != "".
import_package("lib", p, h) :- lib_ts_import(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, p, _, _, _, _, _, _, h), p != "".

// ── export_decl(Prov, ExportedName, LocalName, Kind, ModuleHash, ExportHash) ──
// Kind (col 2, TsExportKind):
//   INLINE_DECLARATION        export class C {}       — entity hash present (col 10)
//   NAMED_EXPORT              export { c }            — entity hash EMPTY; the local
//                             name must be matched against the module's declarations
//   NAMED_ALIAS               export { c as d }
//   DEFAULT_EXPORT / DEFAULT_EXPRESSION
//   EXPORT_STAR               export * from "./m"     — exports a set this row
//                             cannot name; the engine expands it
//   EXPORT_STAR_AS_NAMESPACE  export * as ns from "./m"
//   EXPORT_ASSIGNMENT         export = X              — the module IS the entity
//   TYPE_ONLY_NAMED / TYPE_ONLY_STAR                  — never a call edge
//   EXPORT_IMPORT_EQUALS      export import A = N.A
export_decl("client", en, ln, k, mod, h) :- ts_export(en, ln, k, _, _, _, _, mod, _, _, _, _, _, _, _, _, _, _, _, _, h).
export_decl("lib", en, ln, k, mod, h) :- lib_ts_export(en, ln, k, _, _, _, _, mod, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── export_entity(Prov, EntityKind, EntityHash, GroupKey, ExportHash) ───────
// Present for INLINE_DECLARATION (the declaration is right there); empty for a
// NAMED_EXPORT, which names a local the engine has to find.
// EntityKind (col 9): TYPE | METHOD | FIELD | VARIABLE | ENUM | NAMESPACE | MODULE |
//   EXPRESSION | UNKNOWN.
export_entity("client", ek, eh, gk, h) :- ts_export(_, _, _, _, _, _, _, _, _, ek, eh, gk, _, _, _, _, _, _, _, _, h), eh != "".
export_entity("lib", ek, eh, gk, h) :- lib_ts_export(_, _, _, _, _, _, _, _, _, ek, eh, gk, _, _, _, _, _, _, _, _, h), eh != "".

// ── export_source(Prov, SourceSpecifier, ResolvedSourceModuleHash, ExportHash) ──
// A re-export's target module. This is the edge the chain in
// resolution/module-graph.dl walks; resolvedSourceModuleLinkHash is filled when the
// source module was in the same run, and the specifier is the fallback.
export_source("client", spec, src, h) :- ts_export(_, _, _, _, _, _, spec, _, src, _, _, _, _, _, _, _, _, _, _, _, h).
export_source("lib", spec, src, h) :- lib_ts_export(_, _, _, _, _, _, spec, _, src, _, _, _, _, _, _, _, _, _, _, _, h).

// ── export_is_type_only(Prov, ExportHash) / export_is_default(Prov, ExportHash) ──
export_is_type_only("client", h) :- ts_export(_, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
export_is_type_only("lib", h) :- lib_ts_export(_, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
export_is_default("client", h) :- ts_export(_, _, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
export_is_default("lib", h) :- lib_ts_export(_, _, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
