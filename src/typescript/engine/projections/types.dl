// ============================================================================
// Projections · TYPES  (pure column views — no joins, no closures)
//
// Named views over type declarations, type references and type parameters, client
// (ts_*) and library (lib_ts_*), provenance-tagged.
//
// THE ONE THING THAT DOES NOT PORT FROM JAVA. A Java type is one declaration and
// one entity, so `type_decl` keyed on the declaration hash is also keyed on the
// entity. TypeScript MERGES declarations: `interface Options` in three files is one
// type. So there are two keys here and they are not interchangeable —
//   * the DECLARATION hash (col 32) identifies a syntactic site: where a member is
//     written, what file it is in, what a call-chain row points at.
//   * declarationGroupKey (col 15) identifies the ENTITY: what a type reference
//     resolves TO, and what member lookup must search across.
// A rule that searches members by declaration hash finds only the members written in
// that one declaration, which for a merged interface is an arbitrary subset. Member
// lookup therefore joins through the group; call targets stay per declaration.
//
// ts_type / lib_ts_type cols (33):
//   0 name  1 qualifiedName  2 fileName  3 typeCategory  4 typeAccess  5 typeModifier
//   6 typePlacement  7 filePath  8 baseMservPath  9 startLine  10 endLine
//   11 isExternal  12 tsModuleLinkHash  13 enclosingTypeLinkHash
//   14 enclosingMethodLinkHash  15 declarationGroupKey  16 mergeScopeKey
//   17 escapedName  18 declarationSpaces  19 isAmbientDeclaration  20 isTypeOnly
//   21 typeParameterCount  22 heritageCount  23 memberCount  24 requiredMemberCount
//   25 shapeDigest  26 aliasTargetReferenceLinkHash  27 isExported
//   28 hasIndexSignature  29 startColumn  30 endColumn  31 serviceVersionLinkHash
//   32 tsTypeUniqueHash
// ============================================================================

// ── type_decl(Prov, Name, QName, FilePath, Category, Placement, TypeHash) ────
// Category (col 3, TsTypeCategory):
//   CLASS_TYPE             a class — has a runtime value and a constructor
//   INTERFACE_TYPE         an interface — TYPE ONLY, never a call target itself,
//                          but its method signatures ARE call targets (44.3% of
//                          resolved targets are bodiless, per the schema's measure)
//   ENUM_TYPE              an enum — both a type and a runtime object
//   CONST_ENUM_TYPE        a const enum — INLINED at use sites, so a reference to a
//                          member may have no runtime target at all
//   TYPE_ALIAS_TYPE        a type alias — TYPE ONLY, no runtime existence
//   NAMESPACE_TYPE         a namespace — a runtime object holding other declarations
//   CLASS_EXPRESSION_TYPE  `const C = class { ... }`
//
// Placement (col 6, TsTypePlacement): TOP_LEVEL_PLACEMENT | NAMESPACE_PLACEMENT |
//   NESTED_PLACEMENT | LOCAL_PLACEMENT | EXPRESSION_PLACEMENT |
//   AMBIENT_MODULE_PLACEMENT.
type_decl("client", name, qname, fp, categ, place, h) :- ts_type(name, qname, _, categ, _, _, place, fp, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_decl("lib", name, qname, fp, categ, place, h) :- lib_ts_type(name, qname, _, categ, _, _, place, fp, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_group(Prov, GroupKey, TypeHash) ────────────────────────────────────
// The declaration -> merged-entity map. Deliberately NOT unique in either
// direction of use: N declarations share one group. Member lookup and type
// reference resolution both key on the group; nothing else may.
type_group("client", grp, h) :- ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, grp, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h), grp != "".
type_group("lib", grp, h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, grp, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h), grp != "".

// ── type_module(Prov, ModuleHash, TypeHash) ─────────────────────────────────
// The module a type declaration lives in — the scope a name is looked up in.
type_module("client", m, h) :- ts_type(_, _, _, _, _, _, _, _, _, _, _, _, m, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_module("lib", m, h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, _, _, _, m, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_escaped_name(Prov, EscapedName, TypeHash) ──────────────────────────
// The name as the compiler's symbol table holds it (`__proto` escaping, etc.).
// Name lookup matches on THIS, never on col 0, so a member called `constructor`
// or `__proto__` cannot collide with the intrinsic of the same spelling.
type_escaped_name("client", en, h) :- ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, en, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_escaped_name("lib", en, h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, en, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_is_type_only(Prov, TypeHash) ───────────────────────────────────────
// isTypeOnly (col 20) is true for INTERFACE_TYPE and TYPE_ALIAS_TYPE: the
// declaration has no runtime existence. §3.3's rule — no call-graph edge may name
// one of these as a VALUE. It may still OWN call targets (an interface's method
// signatures), which is why the flag is on the type and not on its members.
type_is_type_only("client", h) :- ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, h).
type_is_type_only("lib", h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, "true", _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_alias_target(Prov, TypeRefHash, TypeHash) ──────────────────────────
// `type A = B` — the right-hand side as a type reference. Following it is how an
// alias-typed receiver reaches the real declaration; not following it strands
// every aliased receiver.
type_alias_target("client", ref, h) :- ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, ref, _, _, _, _, _, h), ref != "".
type_alias_target("lib", ref, h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, ref, _, _, _, _, _, h), ref != "".

// ── type_enclosing(Prov, EnclosingTypeHash, TypeHash) ───────────────────────
// A type declared inside another (a namespace member, a class expression in a
// class body). Java derives this from line ranges because its IR does not carry
// it; here it is an explicit column, so no line-containment machinery is needed.
type_enclosing("client", enc, h) :- ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, enc, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h), enc != "".
type_enclosing("lib", enc, h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, _, _, _, _, enc, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h), enc != "".

// ── type_lines(Prov, StartLine, EndLine, TypeHash) — reporting only ──────────
type_lines("client", sl, el, h) :- ts_type(_, _, _, _, _, _, _, _, _, sl, el, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_lines("lib", sl, el, h) :- lib_ts_type(_, _, _, _, _, _, _, _, _, sl, el, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_ref(Prov, Kind, Context, TypeName, CompleteName, OwnerHash, OwnerKind, RefHash) ──
// THE TYPE GRAPH. Every type-level construct lives here and nowhere else, which is
// the structural guarantee that a conditional or mapped type cannot reach the call
// graph — there is no relation for it to arrive through.
//
// Kind (col 0, TsTypeRefKind) — which kinds RESOLVE to a named declaration:
//   TYPE_REFERENCE  a named type (Foo, Foo<T>)      -> resolves
//   ARRAY           T[]                             -> the ELEMENT child resolves
//   UNION / INTERSECTION  A | B, A & B              -> each MEMBER child resolves
//   PARENTHESIZED / OPTIONAL / REST / NAMED_TUPLE_MEMBER -> the child resolves
//   TYPE_LITERAL    { a: string }                   -> an anonymous SHAPE; owns
//                   members through ts_field/ts_method col 8/7, no ts_type row
//   PRIMITIVE / LITERAL / TYPE_VARIABLE / THIS_TYPE / TYPE_QUERY / TYPE_OPERATOR /
//   CONDITIONAL / MAPPED / TEMPLATE_LITERAL / INDEXED_ACCESS / INFER / IMPORT_TYPE /
//   TYPE_PREDICATE / FUNCTION_TYPE / CONSTRUCTOR_TYPE / TUPLE / INTRINSIC
//                                                   -> no single named target
//
// Context (col 1, TsTypeRefContext, 33 values), grouped by how resolution uses it:
//   hierarchy:      SUPER_TYPE, IMPLEMENTS_INTERFACE, HERITAGE_TWIN
//   declared type:  FIELD_TYPE, METHOD_PARAM, METHOD_RETURN, VARIABLE_TYPE,
//                   TYPE_ELEMENT   <- the receiver-typing sources
//   expression:     AS_TARGET, SATISFIES_TARGET, TYPE_ASSERTION, OBJECT_CREATION_TYPE,
//                   INSTANCEOF_TYPE
//   generics:       TYPE_ARGUMENT, METHOD_TYPE_ARGUMENT, TYPE_PARAM_BOUND,
//                   METHOD_TYPE_PARAM_BOUND, TYPE_PARAM_DEFAULT
//   type-level:     TYPE_ALIAS_RHS, INDEX_SIGNATURE_KEY, INDEX_SIGNATURE_VALUE,
//                   MAPPED_CONSTRAINT, MAPPED_TEMPLATE, CONDITIONAL_*, TEMPLATE_SPAN,
//                   IMPORT_TYPE_QUALIFIER, TYPE_PREDICATE_TARGET, ENUM_MEMBER_TYPE
//   decorators:     DECORATOR_TYPE, DECORATOR_ARGUMENT_TYPE
//
// OwnerKind (col 16, TsReferenceOwnerKind): TYPE | METHOD | METHOD_PARAM | FIELD |
//   VARIABLE | TYPE_PARAMETER | EXPRESSION | DECORATOR | HERITAGE | TYPE_REFERENCE |
//   ENUM_MEMBER | EXPORT | MODULE.
type_ref("client", kind, ctx, tn, ctn, owner, ownerKind, h) :- ts_type_reference(kind, ctx, _, _, _, _, _, _, tn, ctn, _, _, _, _, _, owner, ownerKind, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_ref("lib", kind, ctx, tn, ctn, owner, ownerKind, h) :- lib_ts_type_reference(kind, ctx, _, _, _, _, _, _, tn, ctn, _, _, _, _, _, owner, ownerKind, _, _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_ref_parent(Prov, ParentRefHash, Position, ChildRefHash) ────────────
// A union is N ROWS, not one row with a list (max arity measured: 208). Every
// composite type node links its children here, so walking `A | B` means walking
// this relation — there is no list to destructure.
type_ref_parent("client", parent, pos, h) :- ts_type_reference(_, _, _, _, _, parent, pos, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h), parent != "".
type_ref_parent("lib", parent, pos, h) :- lib_ts_type_reference(_, _, _, _, _, parent, pos, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h), parent != "".

// ── type_ref_depth(Prov, Depth, RefHash) / type_ref_module(Prov, ModuleHash, RefHash) ──
// Depth 0 is the ENTITY'S OWN type; depth >= 1 are its type arguments. Every
// declared-type rule filters on depth 0 for the reason Java's does: without it a
// field of type `Map<string, Handler>` maps that field to Map AND string AND
// Handler, and a call on the field dispatches against all three.
type_ref_depth("client", d, h) :- ts_type_reference(_, _, _, _, _, _, _, d, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_ref_depth("lib", d, h) :- lib_ts_type_reference(_, _, _, _, _, _, _, d, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, h).
type_ref_module("client", m, h) :- ts_type_reference(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, m, _, _, _, _, _, _, _, _, _, _, _, h).
type_ref_module("lib", m, h) :- lib_ts_type_reference(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, m, _, _, _, _, _, _, _, _, _, _, _, h).

// ── type_ref_import_specifier(Prov, Specifier, RefHash) ─────────────────────
// `import("./m").Foo` — an IMPORT_TYPE writes its module specifier inline. The
// only type reference that carries its own module edge instead of relying on the
// file's imports.
type_ref_import_specifier("client", spec, h) :- ts_type_reference(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, spec, _, _, _, _, _, _, h), spec != "".
type_ref_import_specifier("lib", spec, h) :- lib_ts_type_reference(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, spec, _, _, _, _, _, _, h), spec != "".

// ── type_ref_literal_value(Prov, Value, RefHash) ────────────────────────────
// A LITERAL type reference's text, quotes included — `'expectTypeOf'`. The index half of
// an indexed access is one of these.
type_ref_literal_value("client", v, h) :- ts_type_reference(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, v, _, _, _, h), v != "".
type_ref_literal_value("lib", v, h) :- lib_ts_type_reference(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, v, _, _, _, h), v != "".

// ── type_param(Prov, Name, Position, OwnerKind, OwnerHash, ParamHash) ───────
// ONE relation where Java has two, because TypeScript attaches type parameters to
// seven owner kinds (col 7). Consumed by generic substitution, not by dispatch.
type_param("client", name, pos, ok, owner, h) :- ts_type_parameter(name, pos, _, _, _, _, _, ok, owner, _, _, _, _, _, _, _, _, _, _, h).
type_param("lib", name, pos, ok, owner, h) :- lib_ts_type_parameter(name, pos, _, _, _, _, _, ok, owner, _, _, _, _, _, _, _, _, _, _, h).

// ── type_param_constraint(Prov, ConstraintRefHash, ParamHash) ───────────────
// `<T extends HasId>` — the bound is the only thing a call on a T-typed receiver
// can dispatch against, so this is the generic analogue of a declared type.
type_param_constraint("client", cref, h) :- ts_type_parameter(_, _, _, _, _, _, _, _, _, cref, _, _, _, _, _, _, _, _, _, h), cref != "".
type_param_constraint("lib", cref, h) :- lib_ts_type_parameter(_, _, _, _, _, _, _, _, _, cref, _, _, _, _, _, _, _, _, _, h), cref != "".
