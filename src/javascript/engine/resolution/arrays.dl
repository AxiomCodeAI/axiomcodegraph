// ============================================================================
// Resolution · ARRAYS
//
// The one platform type modelled by the engine, because it is where instances
// travel: `this.children.push(node)`, `nodes.forEach((n) => n.render())`,
// `items[i].update()`, `for (const x of xs)`. Without it every collection is a
// wall the flow stops at, and the parser's own measurement puts a large share of
// unresolved receivers behind exactly that wall.
//
// A seventh value kind, `arr`, identified by the expression (or JSDoc reference)
// that made the array, with ONE relation for what it holds:
//
//   elem_value(ArrayId, K, I)   an element of the array may be (K, I)
//
// Elements come from: the literal's elements, `push`/`unshift` at any site whose
// receiver is the array, `a[i] = v`, `map`'s callback return, and `@type {T[]}` /
// `Array<T>`. Elements are read by: `a[i]`, `find`/`pop`/`shift`/`at`, the first
// parameter of a `forEach`/`map`/`filter`/`find`/`some`/`every` callback, a
// `for..of` binding, and a `[first] = a` pattern.
//
// Array METHODS themselves (`push`, `map`, ...) are platform calls with no body
// in any IR here; the call sites stay ambient terminals. This file models what
// flows THROUGH them, not the calls.
// ============================================================================

// ── the array values ────────────────────────────────────────────────────────
expr_value(e, "arr", e) :- expr_kind(_, "ARRAY_LITERAL", _, e).
// `a.map(f)`, and the methods that return the same elements in a new array.
expr_value(ce, "arr", ce) :- array_method_call(ce, "map", _).
expr_value(ce, "arr", a) :- array_method_call(ce, n, a), array_method_returns_same_elements(n).
array_method_returns_same_elements("filter").
array_method_returns_same_elements("slice").
array_method_returns_same_elements("concat").
array_method_returns_same_elements("reverse").
array_method_returns_same_elements("sort").
array_method_returns_same_elements("flat").
array_method_returns_same_elements("splice").
// `@type {T[]}` / `@type {Array<T>}`: the reference row IS the array's identity.
var_value(v, "arr", r) :- var_type_name(_, _, r, v), type_ref_is_array(r).
param_value(p, "arr", r) :- param_type_name(_, _, r, p), type_ref_is_array(r).
return_value(m, "arr", r) :- method_return_type(_, _, r, m), type_ref_is_array(r).
prop_value("inst", t, n, "arr", r) :- field_type_name(_, n, t, _, r, _), type_ref_is_array(r).
type_ref_is_array(r) :- type_ref(_, _, "ARRAY", _, _, _, _, _, _, _, r).
type_ref_is_array(r) :- type_ref(_, "Array", "GENERIC_APPLICATION", _, _, _, _, _, _, _, r).
// Through a wrapper (`?T[]`, `T[] | undefined`) the array is the child.
type_ref_array_child(r, a) :- type_ref(_, _, k, _, _, _, _, _, _, _, r), type_ref_kind_is_wrapper(k),
    type_ref(_, _, _, r, _, _, _, _, _, _, a), type_ref_is_array(a).
var_value(v, "arr", a) :- var_type_name(_, _, r, v), type_ref_array_child(r, a).
param_value(p, "arr", a) :- param_type_name(_, _, r, p), type_ref_array_child(r, a).
prop_value("inst", t, n, "arr", a) :- field_type_name(_, n, t, _, r, _), type_ref_array_child(r, a).

// ── array_method_call(CallExpr, Name, ArrayId) — a member call on an array value ──
array_method_call(ce, n, a) :- call_site(_, ck, n, "SYNTACTIC", _, _, ce, _, _), call_kind_is_member_form(ck),
    expr_child(_, ce, "RECEIVER", _, r), expr_value(r, "arr", a).

// ── elem_value ──────────────────────────────────────────────────────────────
elem_value(l, k, i) :- expr_kind(_, "ARRAY_LITERAL", _, l), expr_child(_, l, "ELEMENT", _, c), expr_value(c, k, i).
elem_value(l, k, i) :- expr_kind(_, "ARRAY_LITERAL", _, l), expr_child(_, l, _, _, s), expr_kind(_, "SPREAD", _, s),
    expr_child(_, s, _, _, o), expr_value(o, "arr", a0), elem_value(a0, k, i).
elem_value(a, k, i) :- array_method_call(ce, n, a), array_method_adds_args(n), call_arg(ce, _, arg), expr_value(arg, k, i).
array_method_adds_args("push").
array_method_adds_args("unshift").
elem_value(a, k, i) :- expr_kind(_, "ASSIGNMENT", _, asg), expr_operator(_, "=", asg),
    expr_child(_, asg, "ASSIGNMENT_TARGET", _, tgt), expr_kind(_, "ELEMENT_ACCESS", _, tgt),
    expr_child(_, tgt, "ACCESS_TARGET", _, r), expr_value(r, "arr", a),
    expr_child(_, asg, "ASSIGNMENT_VALUE", _, val), expr_value(val, k, i).
// `a.map(f)` holds what f returns.
elem_value(ce, k, i) :- array_method_call(ce, "map", _), call_arg(ce, 0, f), expr_value(f, "func", m), return_value(m, k, i).
// `@type {T[]}`: instances of T.
elem_value(r, "inst", t) :- type_ref_is_array(r), type_ref(_, _, _, r, _, _, _, _, _, _, c), type_ref_type(c, t).
elem_value(r, "arr", c) :- type_ref_is_array(r), type_ref(_, _, _, r, _, _, _, _, _, _, c), type_ref_is_array(c).

// ── reads ───────────────────────────────────────────────────────────────────
// `a[i]`
expr_value(e, k, i) :- expr_kind(_, "ELEMENT_ACCESS", _, e), expr_child(_, e, "ACCESS_TARGET", _, r),
    expr_value(r, "arr", a), elem_value(a, k, i).
// `a.find(...)`, `a.pop()`, `a.shift()`, `a.at(i)`
expr_value(ce, k, i) :- array_method_call(ce, n, a), array_method_returns_element(n), elem_value(a, k, i).
array_method_returns_element("find").
array_method_returns_element("findLast").
array_method_returns_element("pop").
array_method_returns_element("shift").
array_method_returns_element("at").
// The callback's first parameter is an element (`forEach`, `map`, `filter`, `find`,
// `some`, `every`, `flatMap`, `findIndex`); `reduce`'s second parameter is.
param_value(p, k, i) :- array_method_call(ce, n, a), array_method_iterates(n), call_arg(ce, 0, f),
    expr_value(f, "func", m), param_decl(_, _, "0", m, p), elem_value(a, k, i).
param_value(p, k, i) :- array_method_call(ce, "reduce", a), call_arg(ce, 0, f),
    expr_value(f, "func", m), param_decl(_, _, "1", m, p), elem_value(a, k, i).
array_method_iterates("forEach").
array_method_iterates("map").
array_method_iterates("filter").
array_method_iterates("find").
array_method_iterates("findLast").
array_method_iterates("findIndex").
array_method_iterates("some").
array_method_iterates("every").
array_method_iterates("flatMap").
// `for (const x of a)`: the loop binding has no initializer and no link to the
// iterated expression; the parser roots that expression under ITERABLE on the
// same line, in the same module, which is the join.
var_value(v, k, i) :- var_decl(_, _, reg, _, _, mod, v), var_regime_is_block(reg), !var_init(_, _, _, v),
    var_lines(_, mod, l, v), expr_root(_, "ITERABLE", e), expr_owner(_, _, mod, e), expr_span(_, l, _, _, _, e),
    expr_value(e, "arr", a), elem_value(a, k, i).
var_regime_is_block("CONST_BLOCK_TDZ").
var_regime_is_block("LET_BLOCK_TDZ").
var_regime_is_block("VAR_FUNCTION_SCOPED_HOISTED").
// `const [first, second] = a` — every binding of the pattern is an element.
var_value(v, k, i) :- var_binding_form(_, "ARRAY_PATTERN", v), var_init(_, _, e, v), expr_value(e, "arr", a), elem_value(a, k, i).
