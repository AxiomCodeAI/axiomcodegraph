// ============================================================================
// RESOLUTION · COLLECTION FLOW  (dict-literal and subscript dispatch)
//
// THE IDIOM THIS EXISTS FOR is the decorator registry — click, Flask, pytest's
// hookimpl, every plugin system:
//
//     REGISTRY = {}
//     def route(name):
//         def register(fn):
//             REGISTRY[name] = fn      <- populated at IMPORT time
//             return fn
//         return register
//     @route("go")
//     def handler(): ...
//     ...
//     REGISTRY["go"]()                 <- no name at the call site denotes `handler`
//
// and the table-of-lambdas, which is the same shape written inline:
//
//     TABLE = {"double": lambda n: n * 2}
//     TABLE["double"](21)
//
// Both are call sites whose callee is a VALUE reached by a literal key. Nothing about
// them is dynamic in the sense the escape hatches are: the key is a constant, the dict
// is written once, and the value is a function this engine can name. Reporting them as
// blind spots would be conceding a resolvable edge.
//
// A NOTE ON HOW THE PARSER CLASSIFIES THEM. `TABLE["double"](21)` arrives as
// callKind=DYNAMIC_CALL with calleeName="" — not as SUBSCRIPT_CALL, which the schema's
// own enum provides for exactly this shape. DYNAMIC_CALL is documented as
// getattr/eval/exec, i.e. "unresolvable by construction", so the two are conflated and a
// consumer that trusts the kind will refuse to try. Filed as PD-9; this file keys on the
// callee's expression SHAPE instead, which is unambiguous.
//
// ── WHAT MAKES THIS SOUND RATHER THAN CLEVER ─────────────────────────────────
// Three guards, all of them structural:
//   * the container name is bound EXACTLY ONCE (symtable's own bindingCount), so it
//     cannot be a different dict by the time the subscript runs;
//   * the key is a LITERAL, or a parameter that only ever received literals — never an
//     expression;
//   * a container that is subscript-STORED with a key the engine cannot pin gets NO
//     entry rows at all, so an unknown write cannot be silently ignored: it lands in
//     dict_key_unknown and the site stays a declared unknown.
// Multiple entries under one key produce multiple targets, i.e. multi_inferred, which is
// the correct answer for a registry populated from two places.
// ============================================================================

// ── expr_literal_text(Prov, ExprHash, Text) ──────────────────────────────────
// A literal's value as written. literalValue (c10) is the name slot, and for a LITERAL
// node it holds the literal text.
expr_literal_text(p, e, v) :- expr_node(p, "LITERAL", _, v, e), v != "".

// ── expr_lambda_method(Prov, ExprHash, MethodHash) ───────────────────────────
// A LAMBDA node is a callable with a real py_method row; lambdaScopeHash bridges the
// expression to the scope, and the scope's owner is the method. Lambdas are first-class
// call targets in Python — 369 rows in the measured corpus — which is why this is a
// dispatch edge rather than decoration.
expr_lambda_method(p, e, m) :- expr_lambda_scope(p, s, e), method_scope(p, s, m).

// ── expr_key_text(Prov, ExprHash, Text) — what a key expression evaluates to ──
// (a) a literal, written in place.
expr_key_text(p, e, v) :- expr_literal_text(p, e, v).
// (b) a parameter that only ever received literals. This is what carries `name` from
//     `@route("go")` into `REGISTRY[name] = fn`, across two nested function scopes.
expr_key_text(p, e, v) :- expr_names_param(p, e, ph), param_arg_literal(ph, v), p = "client".

// ── param_arg_literal(ParamHash, Text) — a literal reaching a parameter ──────
param_arg_literal(ph, v) :-
    call_arg_offset(site, m, off),
    !call_flow_imprecise(site),
    call_arg(site, posStr, a),
    param_decl("client", _, ppos, _, m, ph),
    to_number(ppos) = to_number(posStr) + off,
    expr_literal_text("client", a, v).
param_arg_literal(ph, v) :-
    expr_call_candidate(site, m),
    !call_flow_imprecise(site),
    call_kwarg(site, kw, a), kw != "",
    param_decl("client", kw, _, _, m, ph),
    expr_literal_text("client", a, v).

// ============================================================================
// DICT ENTRIES — from a literal, and from a subscript store
// ============================================================================

// ── dict_literal_entry(Prov, DictExprHash, KeyText, ValueExprHash) ───────────
// KEY and VALUE are the two halves of one dict entry and share a position. They exist as
// distinct edgeRoles precisely so a display's children do not have to wear ARGUMENT —
// the schema records that a rule joining edgeRole=ARGUMENT without checking the parent
// kind picked up 17% non-arguments.
dict_literal_entry(p, d, k, v) :-
    expr_node(p, "DICT", _, _, d),
    expr_parent(p, d, "KEY", pos, ke),
    expr_literal_text(p, ke, k),
    expr_parent(p, d, "VALUE", pos, v).

// ── dict_store_entry(Prov, ContainerBindingHash, KeyText, ValueExprHash) ─────
// `REGISTRY[name] = fn`. The container is resolved through the LEGB walk, so a
// module-level registry written from inside two nested functions still lands on the same
// binding.
dict_store_entry(p, b, k, val) :-
    expr_node(p, "SUBSCRIPT", _, _, tgt),
    expr_name_context(p, "STORE", tgt),
    expr_parent(p, tgt, "SUBSCRIPT_OBJECT", _, obj),
    expr_parent(p, tgt, "SUBSCRIPT_INDEX", _, idx),
    expr_key_text(p, idx, k),
    expr_binding(p, ob, _, obj),
    binding_lookup(p, ob, b),
    assign_pair(p, tgt, val).

// ── dict_key_unknown(Prov, ContainerBindingHash, ExprHash) ───────────────────
// A subscript store whose KEY the engine cannot pin. The container's contents are then
// only partially known, so a lookup on it must not report a miss as a negative. Emitted
// as a positive fact, and consumed below.
dict_key_unknown(p, b, tgt) :-
    expr_node(p, "SUBSCRIPT", _, _, tgt),
    expr_name_context(p, "STORE", tgt),
    expr_parent(p, tgt, "SUBSCRIPT_OBJECT", _, obj),
    expr_parent(p, tgt, "SUBSCRIPT_INDEX", _, idx),
    !expr_key_text(p, idx, _),
    expr_binding(p, ob, _, obj),
    binding_lookup(p, ob, b).

// ── binding_dict_entry_method(Prov, BindingHash, KeyText, MethodHash) ────────
// The container name, a key, and the CALLABLE stored under it.
// (a) from a dict literal assigned to the name.
binding_dict_entry_method(p, b, k, m) :-
    binding_rebinding(p, "1", _, _, b),
    expr_binding(p, b, "STORE", tgt),
    assign_pair(p, tgt, val),
    dict_literal_entry(p, val, k, ve),
    expr_denotes_method(p, ve, m).
binding_dict_entry_method(p, b, k, m) :-
    binding_rebinding(p, "1", _, _, b),
    expr_binding(p, b, "STORE", tgt),
    assign_pair(p, tgt, val),
    dict_literal_entry(p, val, k, ve),
    expr_lambda_method(p, ve, m).
// (b) from a subscript store into the name.
binding_dict_entry_method(p, b, k, m) :-
    binding_rebinding(p, "1", _, _, b),
    dict_store_entry(p, b, k, ve),
    expr_denotes_method(p, ve, m).
binding_dict_entry_method(p, b, k, m) :-
    binding_rebinding(p, "1", _, _, b),
    dict_store_entry(p, b, k, ve),
    expr_lambda_method(p, ve, m).

// ============================================================================
// THE CALLEE — a subscript with a pinned key
// ============================================================================

// ── expr_denotes_method through a subscript ──────────────────────────────────
expr_denotes_method(p, e, m) :-
    expr_node(p, "SUBSCRIPT", _, _, e),
    expr_parent(p, e, "SUBSCRIPT_OBJECT", _, obj),
    expr_parent(p, e, "SUBSCRIPT_INDEX", _, idx),
    expr_key_text(p, idx, k),
    expr_binding(p, ob, ctx, obj), ctx != "STORE",
    binding_lookup(p, ob, b),
    binding_dict_entry_method(p, b, k, m).

// ── a bare LAMBDA used directly as a callee: `(lambda n: n)(3)` ───────────────
expr_denotes_method(p, e, m) :- expr_lambda_method(p, e, m).

// ── subscript_dispatch_incomplete(SiteKey) ───────────────────────────────────
// The site subscripts a container that is also written with a key the engine could not
// pin, so the resolved set may be short. A declared limitation attached to the site
// rather than a footnote in a document.
subscript_dispatch_incomplete(site) :-
    call_callee_expr(site, e),
    expr_node("client", "SUBSCRIPT", _, _, e),
    expr_parent("client", e, "SUBSCRIPT_OBJECT", _, obj),
    expr_binding("client", ob, _, obj),
    binding_lookup("client", ob, b),
    dict_key_unknown("client", b, _).
