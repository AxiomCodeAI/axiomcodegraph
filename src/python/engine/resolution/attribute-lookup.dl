// ============================================================================
// RESOLUTION · ATTRIBUTE LOOKUP THROUGH THE MRO
//
// Given a receiver TYPE and an attribute NAME, which definition wins. This is the rule
// that turns "24.63 naive name-based candidates per attribute call" (measured, 1.22M
// candidate edges over 49k sites) into one answer — and it is what makes an honest
// multi_inferred possible, because it can distinguish "two classes in one MRO both
// define this, and C3 decides which" from "two unrelated classes happen to share a
// method name", which is not a dispatch set at all.
//
// ONE NAME PER CLASS BODY WINS. Python has no overloading, so
// java/engine/expression-resolution/overload.dl is deliberately NOT ported: there is no
// applicable-set computation, no arity-based narrowing between same-named siblings. The
// only "overload"-shaped thing in Python is @overload, and those are DECLARATIONS with
// bodyIsStub=true that must never be call targets — gated below.
//
// THREE GATES ON WHAT COUNTS AS A DEFINITION, all measured needs:
//   bodyIsStub          @overload stubs (567 corpus-wide), Protocol members, .pyi bodies.
//                       Resolving to one is an edge into a body that is `...`.
//                       linkage-sample exercises this: Service.lookup has 3 py_method
//                       rows, 2 of them OVERLOAD_STUB, and without the gate a call to
//                       self.lookup() would fan to 3.
//   MODULE_INITIALIZER / CLASS_INITIALIZER  the synthetic <module>/<classbody> owners.
//                       Real methods, but not attributes of anything.
//   replacesTarget      a decorator that returns something other than the function, and
//                       that this engine does not model. Handled in
//                       resolution/decorators.dl, which subtracts from this relation.
// ============================================================================

// ── type_defines_method(Prov, TypeHash, Name, MethodHash) ────────────────────
// A method DECLARED DIRECTLY in this class — no inheritance, no MRO. The atom the
// MRO search is over.
type_defines_method(p, t, n, m) :-
    method_owner(p, t, m),
    method_decl(p, n, _, _, _, m),
    method_kind(p, kind, _, m),
    kind != "MODULE_INITIALIZER", kind != "CLASS_INITIALIZER",
    !method_body_is_stub(p, m),
    !method_target_replaced(p, m),
    // A class body is a statement list like any other: a second `def` of the same name
    // rebinds the first, and the class ends up with only the later function (#383).
    // Both routes to a callable need the gate, because a class member is reached through
    // here and never through binding_binds_method.
    !def_rebound_by_later_def(p, m).

// ── type_name_opaque(Prov, TypeHash, Name) ───────────────────────────────────
// The class DOES bind this name, but to a def whose own name no longer refers to it —
// an unmodelled decorator replaced it (resolution/decorators.dl). Emitted so the site
// becomes a DECLARED unknown with a stated reason, instead of resolving past the
// replacement to an inherited definition, which is the wrong answer twice over.
type_name_opaque(p, t, n) :-
    method_owner(p, t, m), method_decl(p, n, _, _, _, m),
    method_target_replaced(p, m).

// ── type_defines_field(Prov, TypeHash, Name, FieldHash) ──────────────────────
// A class attribute or a recovered `self.x`. Present so an attribute lookup can report
// "this name is data, not a method" instead of a miss — the PROPERTY_BACKED case has
// BOTH a field and a PROPERTY_GETTER method and the engine must see both candidates.
type_defines_field(p, t, n, f) :- field_decl(p, n, t, _, f).

// ── type_defines_any(Prov, TypeHash, Name) ───────────────────────────────────
// The name is bound in this class body at all — method or attribute. Used for the
// SHADOWING test, because a data attribute in a subclass genuinely shadows an inherited
// method (that is how @property backing works), so restricting shadowing to methods
// would resolve past a real override.
type_defines_any(p, t, n) :- type_defines_method(p, t, n, _).
type_defines_any(p, t, n) :- type_defines_field(p, t, n, _).
// An opaque (decorator-replaced) name STILL SHADOWS. `@audit def tagged` in Child means
// Child.tagged is not the inherited definition either — resolving past it to a base
// class's `tagged` would be a fabricated edge dressed as inheritance.
type_defines_any(p, t, n) :- type_name_opaque(p, t, n).

// ============================================================================
// THE MRO SEARCH
// ============================================================================

// ── mro_definer(Prov, ReceiverType, Name, DefiningType) ──────────────────────
// A class in A(ReceiverType) that defines Name.
mro_definer(p, t, n, c) :- mro_member(p, t, c), type_defines_any(p, c, n).
// A member of a CLIENT class's MRO may be a LIBRARY class, and what it defines is a
// library fact. Without this the definer set is empty for every inherited library
// member, so mro_winner has nothing to rank and the lookup returns nothing however
// correct the linearisation is. type-hierarchy.dl puts those members in A(T); this is
// what makes them count as definers.
mro_definer("client", t, n, c) :- mro_member("client", t, c), type_defines_any("lib", c, n).

// ── mro_definer_shadowed(Prov, ReceiverType, Name, DefiningType) ─────────────
// Another definer of the SAME name is ordered STRICTLY BEFORE this one in the MRO of
// the receiver. mro_prec is sound (C3 is one of its linear extensions), so a definer
// with a prec-predecessor definer can never be the C3 winner.
mro_definer_shadowed(p, t, n, c) :-
    mro_definer(p, t, n, c),
    mro_definer(p, t, n, c2), c2 != c,
    mro_prec(p, c2, c).

// ── mro_winner(Prov, ReceiverType, Name, DefiningType) ───────────────────────
// The prec-MINIMAL definers. Exactly one row => exactly C3's answer. More than one row
// => C3's leftmost-eligible-head tie-break would pick one of them and this engine does
// not guess; every one is emitted and the site becomes multi_inferred.
mro_winner(p, t, n, c) :- mro_definer(p, t, n, c), !mro_definer_shadowed(p, t, n, c).

// ── mro_tie(Prov, ReceiverType, Name) ────────────────────────────────────────
// Two incomparable classes in one MRO both define this name — the ONLY place this
// engine is less precise than real C3. Counted, exported, and 0 on linkage-sample.
mro_tie(p, t, n) :-
    mro_winner(p, t, n, c1), mro_winner(p, t, n, c2), c1 != c2.

// ── mro_lookup(Prov, ReceiverType, Name, MethodHash) ─────────────────────────
// THE ANSWER: attribute Name on a receiver of type ReceiverType resolves to this
// method. The winner class must define the name AS A METHOD; a winner that defines it
// only as data means the attribute is not callable through this path (see
// mro_lookup_data_shadow below), which is a real negative and not a miss.
mro_lookup(p, t, n, m) :-
    mro_winner(p, t, n, c), type_defines_method(p, c, n, m),
    !type_attr_rebound(p, c, n).
// ── the winning class may live in the LIBRARY ────────────────────────────────
// A client class extending a library class has library types in its MRO
// (resolution/type-hierarchy.dl continues the ancestor closure across the boundary), so
// the class that WINS a name is often a library class. Its methods are library rows, and
// the prov-uniform clause above cannot read them -- the linearisation was correct and
// the lookup still returned nothing.
// MEASURED on test/python/torture: `class Overrider(Mid)` linearises to
// [Overrider, Mid, Base] and `Overrider().only_base()` still resolved to nothing,
// because only_base is declared by the library's Base.
// The rebound guard is applied on the LIBRARY side, where that class's body lives.
mro_lookup("client", t, n, m) :-
    mro_winner("client", t, n, c), type_defines_method("lib", c, n, m),
    !type_attr_rebound("lib", c, n).
// The winning class had this name REBOUND from outside its body (monkey patching); the
// value that replaced it is the target. See the section on monkey patching below.
mro_lookup(p, t, n, m) :-
    mro_winner(p, t, n, c), type_attr_monkey_patched(p, c, n, m).

// ── mro_lookup_data_shadow(Prov, ReceiverType, Name, FieldHash) ──────────────
// The winning definition is a DATA attribute, so a call through this name is a call on
// whatever value that attribute holds — not on an inherited method that a name-only
// resolver would happily have found. Emitted so the site is a declared unknown rather
// than a wrong edge.
mro_lookup_data_shadow(p, t, n, f) :-
    mro_winner(p, t, n, c), type_defines_field(p, c, n, f),
    !type_defines_method(p, c, n, _).

// ── ATTRIBUTE ACCESS TO A DECORATED METHOD ───────────────────────────────────
// `handlers.checkout(...)` where `checkout` is @retry-decorated. The name denotes the
// decorator's OUTPUT, and resolution/decorators.dl already computed it — this clause is
// what makes that answer reachable through an ATTRIBUTE and not only through a bare name.
// MEASURED: without it, a call to a decorated METHOD was a declared unknown even where the
// chain had been followed successfully, which on the two-service project was both
// @retry-decorated handlers.
// A SEPARATE relation, not a clause of mro_lookup. decorated_name_target sits inside the
// resolution fixpoint (the chain needs expr_call_candidate to identify the decorator's
// factory), while mro_lookup is upstream of it and uses negation — folding this in makes
// that negation cyclic and souffle refuses the program. Consumed by
// expression-resolution/callee-resolution.dl, which is downstream of both.
mro_lookup_decorated(p, t, n, r) :-
    mro_winner(p, t, n, c),
    method_owner(p, c, def), method_decl(p, n, _, _, _, def),
    method_target_replaced(p, def),
    decorated_name_target(def, r).

// ── mro_lookup_opaque(Prov, ReceiverType, Name) ──────────────────────────────
// The MRO winner is a decorator-replaced def AND the chain could NOT be followed — an
// unmodelled framework decorator. ambiguous_unknown with a reason, never an edge.
mro_lookup_opaque(p, t, n) :-
    mro_winner(p, t, n, c), type_name_opaque(p, c, n),
    !mro_lookup_decorated(p, t, n, _).

// ── mro_lookup_after(Prov, ReceiverType, AnchorType, Name, MethodHash) ───────
// super()'s lookup: search only the part of A(ReceiverType) that comes AFTER the anchor
// class. Same minimality argument, restricted to the slice — which is why this cannot
// be expressed with a reachable-ancestor set: the anchor is a POSITION, not a subtree.
mro_definer_after(p, t, anchor, n, c) :-
    mro_after(p, t, anchor, c), type_defines_any(p, c, n).
mro_definer_after_shadowed(p, t, anchor, n, c) :-
    mro_definer_after(p, t, anchor, n, c),
    mro_definer_after(p, t, anchor, n, c2), c2 != c,
    mro_prec(p, c2, c).
mro_winner_after(p, t, anchor, n, c) :-
    mro_definer_after(p, t, anchor, n, c),
    !mro_definer_after_shadowed(p, t, anchor, n, c).
mro_lookup_after(p, t, anchor, n, m) :-
    mro_winner_after(p, t, anchor, n, c), type_defines_method(p, c, n, m).

// ── mro_lookup_miss(Prov, ReceiverType, Name) ────────────────────────────────
// Nothing in A(ReceiverType) defines the name. Split by REASON, because the two are
// not the same failure:
//   * a class whose hierarchy is INCOMPLETE (unresolved base, dynamic base, metaclass,
//     __getattr__) — the definition may exist where the engine cannot see it;
//   * a class whose hierarchy is fully known — the name genuinely is not there, so it
//     comes from `object`/a builtin, or the code is wrong.
mro_lookup_miss(p, t, n) :- mro_lookup_demand(p, t, n), !mro_definer(p, t, n, _).

// ── mro_lookup_demand(Prov, ReceiverType, Name) ──────────────────────────────
// The (type, name) pairs a call site actually asks about. Keeps mro_lookup_miss from
// enumerating every name in the program against every class.
// Populated by expression-resolution/callee-resolution.dl.

// ── mro_lookup_escape_hatch(Prov, ReceiverType, Name) ────────────────────────
// A miss on a type that declares __getattr__ / __getattribute__ or has an incomplete
// hierarchy. UNRESOLVABLE BY CONSTRUCTION, and nameable as such — which is the whole
// point of the marker columns (schema §4.5: at 1.8% of classes these are not worth
// redesigning around, but they ARE worth being able to name in a report).
mro_lookup_escape_hatch(p, t, n) :- mro_lookup_miss(p, t, n), type_hierarchy_incomplete(p, t).

// ── mro_lookup_absent(Prov, ReceiverType, Name) ──────────────────────────────
// A miss on a type whose hierarchy IS fully known: the name is not a client member at
// all, so the target is outside the analysed code (a builtin, or `object`).
mro_lookup_absent(p, t, n) :- mro_lookup_miss(p, t, n), !type_hierarchy_incomplete(p, t).

// ============================================================================
// CONSTRUCTION — the __init__ / __new__ lookup
// ============================================================================

// ── type_constructor(Prov, TypeHash, MethodHash) ─────────────────────────────
// Calling `T(...)` runs `type(T).__call__`, which runs `T.__new__` and then
// `T.__init__` — both looked up THROUGH THE MRO, which is why this is here and not in
// callee-resolution. `class Child(Base)` with no __init__ of its own constructs through
// Base.__init__, and that is a real edge a name-only resolver misses entirely.
type_constructor(p, t, m) :- mro_lookup(p, t, "__init__", m).
type_constructor(p, t, m) :- mro_lookup(p, t, "__new__", m).

// ── type_constructor_absent(Prov, TypeHash) ──────────────────────────────────
// No __init__ and no __new__ anywhere in A(T). The real target is `object.__init__`, a
// CPython C-level builtin with NO Python source — verified: the 3.10.4 stdlib IR
// contains 0 py_type rows named `object`. So this is a LIBRARY BOUNDARY, not a blind
// spot, and resolution/builtins.dl labels it as one. linkage-sample has exactly this
// shape twice (`Sibling()` in deferred.py and service.py).
type_constructor_absent(p, t) :- type_decl(p, _, _, _, t), !type_constructor_any(p, t).
type_constructor_any(p, t) :- type_constructor(p, t, _).

// ============================================================================
// MONKEY PATCHING — a class attribute rebound from OUTSIDE the class body
//
// `Target.replaced_later = patched` at module level means that after import, the name
// resolves to `patched` and NOT to the `def` in the class body. The parser records no
// py_field row for it — a foreign attribute write cannot be attributed to a class the
// parser has not typed (schema §4.1, 1,620 such sites in the corpus) — so it is
// recovered from py_expression, where it is fully present with nameContext=STORE.
//
// MEASURED: 12-blind-spots emitted `main -> Target.replaced_later` (the class-body def)
// as its one fabricated edge. CPython's answer is `patched`. The class-body def is not
// merely a second candidate; after line 40 it is unreachable through that name.
//
// SOUNDNESS. The rebinding is unconditional module-level code, so it has run before any
// other module's code can call the method — the same argument as the single-binding alias
// rule, and the reason this REPLACES rather than ADDS TO the class-body definition. A
// rebinding inside a function or a conditional is a different shape and gets no row here.
// ============================================================================

// ── type_attr_foreign_write(Prov, TypeHash, Name, ExprHash) ──────────────────
// Any `T.name = ...` written where T is a resolvable class and the write is not in T's
// own body. Emitted even when the assigned value cannot be typed, because the mere
// existence of the write means the class's member set is not what its body says.
type_attr_foreign_write(p, t, n, e) :-
    expr_node(p, "ATTRIBUTE_ACCESS", _, n, e),
    expr_name_context(p, "STORE", e),
    expr_parent(p, e, "ATTRIBUTE_OBJECT", _, obj),
    expr_names_type(p, obj, t).

// ── type_attr_monkey_patched(Prov, TypeHash, Name, MethodHash) ───────────────
type_attr_monkey_patched(p, t, n, m) :-
    type_attr_foreign_write(p, t, n, e),
    assign_pair(p, e, val),
    expr_names_method(p, val, m).

// ── type_attr_rebound(Prov, TypeHash, Name) ──────────────────────────────────
// The name is rebound from outside, whether or not the new value could be typed.
type_attr_rebound(p, t, n) :- type_attr_foreign_write(p, t, n, _).

// ============================================================================
// CALLABLE INSTANCES — `m(5)` where m is an object, not a function
// ============================================================================

// ── type_call_target(Prov, TypeHash, MethodHash) ─────────────────────────────
// Calling an INSTANCE runs type(instance).__call__, looked up through the MRO like any
// other member. The call site names the instance and never names __call__, so this is
// the only way the edge exists at all — and `typeModifier` carries HAS_CALL /
// CALLABLE_INSTANCE precisely so it can be recognised.
type_call_target(p, t, m) :- mro_lookup(p, t, "__call__", m).

// ============================================================================
// PROPERTY READS — an attribute access that is really a call
// ============================================================================

// ── type_property_getter(Prov, TypeHash, Name, MethodHash) ───────────────────
// @property turns `obj.x` from an attribute read into a METHOD CALL (1,014 in the
// corpus). There is no call site spelling `x()` anywhere, so no py_call_site exists and
// the edge has to come from the attribute access itself. It is therefore an EDGE without
// being a SITE — it is added to the exported graph but NOT to the conserved site
// universe, because CPython's own compiler emits no CALL for it either.
type_property_getter(p, t, n, m) :-
    mro_lookup(p, t, n, m), method_kind(p, "PROPERTY_GETTER", _, m).

// ── A USER-WRITTEN DATA DESCRIPTOR IS THE SAME PROTOCOL (issue #326) ─────────
// `@property` IS a data descriptor; the decorator is sugar over `__get__`/`__set__`. So
// the clause above reads one spelling of the protocol and a class-level
// `field = Reactive()` — where Reactive defines `__get__` — is the other, carrying the
// same `-> Target` and getting nothing. Which spelling the author chose decided whether
// their attribute reads resolved.
//
// ONLY A DATA DESCRIPTOR, and this is the part that would be wrong to skip. `__get__`
// alone is a NON-data descriptor: an instance attribute of the same name shadows it, so
// `self.loose` may well be whatever `__init__` put in the instance dict and the
// descriptor never runs. `__set__` or `__delete__` alongside it makes the descriptor win
// on every read, which is the only case where answering is sound. The IR shows both, so
// the distinction costs one join and getting it wrong would answer confidently in exactly
// the case where the instance dictionary wins.
descriptor_get_slot("__get__").
descriptor_data_slot("__set__").
descriptor_data_slot("__delete__").

// PRESENCE, NOT REACHABILITY, decides this. mro_lookup is gated on !method_body_is_stub,
// and `def __delete__(self, obj): pass` is recorded bodyIsStub=true — which is right for
// "can a call land here" and wrong for "is this class a data descriptor". Whether the slot
// has a body has nothing to do with whether Python consults it on read; declaring it is
// what makes the descriptor win over the instance dictionary. Measured: keying this on
// mro_lookup silently classified a __get__/__delete__ pair as a NON-data descriptor and
// left its reads unresolved.
type_declares_slot(p, t, n) :- method_owner(p, t, m), method_decl(p, n, _, _, _, m).

type_is_data_descriptor(p, dt) :-
    descriptor_get_slot(g), type_declares_slot(p, dt, g),
    descriptor_data_slot(d), type_declares_slot(p, dt, d).

// ── type_descriptor_getter(Prov, TypeHash, Name, GetMethodHash) ──────────────
// Deliberately the same SHAPE as type_property_getter, so every consumer of that relation
// needs one extra clause rather than a parallel pipeline: the read is an edge, the
// return types the result, and the tiering already knows what to do with a protocol slot.
type_descriptor_getter(p, t, n, g) :-
    type_attr_field(p, t, n, f),
    field_type(p, f, dt),
    type_is_data_descriptor(p, dt),
    descriptor_get_slot(gs), mro_lookup(p, dt, gs, g).
