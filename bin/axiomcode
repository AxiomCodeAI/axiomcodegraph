#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# axiomcode — the pipeline as subcommands. No npx, no argument order to remember.
#
#   bin/axiomcode parser <src-dir> <ir-dir> [--version V] [--exclude-tests]
#                        source → relational IR, one folder per language found: <ir-dir>/java/,
#                        <ir-dir>/typescript/, <ir-dir>/python/ (javascript, csharp as they land)
#   bin/axiomcode engine --language L --client-ir <ir-dir>/<lang> --out <dir> [engine options]
#                                                                    IR → graph.sqlite
#   bin/axiomcode all    --src <src-dir> --out <dir> [--language L] [parser options] [engine options]
#                                                                    source → <dir>/<lang>/graph.sqlite
#                        The parser emits every language it finds in one pass; `all` then solves each
#                        (java, typescript, python — whichever the IR holds) into its own folder.
#                        --language restricts it to one. Graphs are per language: a Java→TS call is
#                        not an edge in either.
#   bin/axiomcode test   [java|typescript|python|parser|all] [suite options]
#
# Parser options: --version V       the version the IR is stamped with (serviceVersionLink). Default:
#                                   the source tree's git commit; v1.0.0 when it is not a git checkout.
#                 --exclude-tests   leave test code out of the IR. Default: included.
# Engine options: --library <ir-root>[,…]  --intermediate <dir>  --debug  --dispatch-cap N|off
#                 --lib-depth N  --jdk-depth N  --taint on|off   (see graph/pipeline/run-souffle.sh)
# Output: <dir>/graph.sqlite — its schema is inside it (graph/bundle/SCHEMA.md). With --debug
# also <dir>/csv/*.csv and <dir>/raw/. `all` keeps the IR under <dir>/.intermediate/ir.
# Requires Node ≥ 22.5; no Soufflé or compiler (binaries/, or a local souffle if present).
# ─────────────────────────────────────────────────────────────────────────────
set -eu
ROOT="$(d="$(cd "$(dirname "$0")" && pwd)"; while [ "$d" != / ] && { [ ! -f "$d/package.json" ] || [ ! -d "$d/graph" ]; }; do d="$(dirname "$d")"; done; echo "$d")"
PARSER="${AXIOM_PARSER:-$ROOT/parser/dist/index.js}"
usage(){ sed -n '3,26p' "$0" | sed 's/^# \{0,1\}//'; }
die(){ echo "axiomcode: $*" >&2; exit 2; }
need_parser(){ [ -f "$PARSER" ] || { echo "axiomcode: parser not built at $PARSER — run: npm install && npm run build" >&2; exit 1; }; }

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  parser)
    need_parser
    src="${1:-}"; ir="${2:-}"; [ -n "$src" ] && [ -n "$ir" ] || die "usage: axiomcode parser <src-dir> <ir-dir> [--version V] [--exclude-tests]"
    shift 2; version=""; exclude=false
    while [ $# -gt 0 ]; do case "$1" in
      --version) version="$2"; shift 2;; --exclude-tests) exclude=true; shift;;
      --slug) version="$2"; shift 2;;   # the old name for the same thing
      *) die "parser: unknown option $1";; esac; done
    [ -d "$src" ] || die "not a directory: $src"
    # The version stamps every IR row (serviceVersionLink): the commit of the source when it is a
    # git checkout, so a graph can always be traced to what it was built from; v1.0.0 otherwise.
    [ -n "$version" ] || version="$(git -C "$src" rev-parse HEAD 2>/dev/null || echo v1.0.0)"
    mkdir -p "$ir"
    echo "▶ parser: version=$version exclude-tests=$exclude"
    # The parser writes every language's tables into one flat directory. They are sorted here
    # into <ir>/<lang>/ — the prefixed tables (all-typescript-*, all-python-*, all-javascript-*,
    # skipped-<lang>-files) to their language, the unprefixed ones (Java's, and the config
    # tables only Java's rules read) to java/. A language whose marker relation has no rows
    # gets no folder: the parser emits zero-byte files for every language regardless.
    flat="$ir/.flat"; rm -rf "$flat"; mkdir -p "$flat"
    node "$PARSER" "$src" "$version" "$exclude" "$flat"
    rows(){ [ -f "$flat/$1" ] && [ "$(wc -l < "$flat/$1" | tr -d ' ')" -gt 1 ]; }
    found=()
    for l in typescript python javascript csharp; do
      rows "all-$l-modules.csv" || continue
      found+=("$l"); rm -rf "$ir/$l"; mkdir -p "$ir/$l"
      mv "$flat"/all-"$l"-*.csv "$ir/$l/" 2>/dev/null || true
      [ -f "$flat/skipped-$l-files.csv" ] && mv "$flat/skipped-$l-files.csv" "$ir/$l/"
    done
    if rows all-types.csv || rows all-methods.csv; then
      found+=(java); rm -rf "$ir/java"; mkdir -p "$ir/java"
      for f in "$flat"/*.csv; do case "$(basename "$f")" in all-typescript-*|all-python-*|all-javascript-*|all-csharp-*|skipped-*) ;; *) mv "$f" "$ir/java/";; esac; done
    fi
    rm -rf "$flat"
    [ ${#found[@]} -gt 0 ] || { echo "❌ the parser found no Java, TypeScript or Python source under $src" >&2; exit 1; }
    echo "▶ IR: ${found[*]} → $ir/<lang>/"
    ;;
  engine)
    # every option is the engine's own; only --out is spelled for symmetry with `all`
    args=()
    while [ $# -gt 0 ]; do case "$1" in --out) args+=(--output "$2"); shift 2;; *) args+=("$1"); shift;; esac; done
    has(){ for a in ${args[@]+"${args[@]}"}; do [ "$a" = "$1" ] && return 0; done; return 1; }
    has --language && has --client-ir && has --output || die "usage: axiomcode engine --language L --client-ir <ir-dir> --out <dir> [options]"
    has --intermediate || { out=""; for i in "${!args[@]}"; do [ "${args[$i]}" = --output ] && out="${args[$((i+1))]}"; done; args+=(--intermediate "$out/.intermediate"); }
    has --library || args+=(--library "")
    bash "$ROOT/graph/pipeline/run-souffle.sh" "${args[@]}"
    ;;
  all)
    need_parser
    lang=""; src=""; out=""; version=""; popts=(); rest=()
    while [ $# -gt 0 ]; do case "$1" in
      --language) lang="$2"; shift 2;; --src) src="$2"; shift 2;; --out) out="$2"; shift 2;;
      --version|--slug) version="$2"; shift 2;; --exclude-tests) popts+=(--exclude-tests); shift;;
      --library|--intermediate|--dispatch-cap|--lib-depth|--jdk-depth|--taint) rest+=("$1" "$2"); shift 2;;
      --debug) rest+=(--debug); shift;;
      *) die "all: unknown option $1";; esac; done
    [ -n "$src" ] && [ -n "$out" ] || die "usage: axiomcode all --src <src-dir> --out <dir> [--language L] [options]"
    [ -d "$src" ] || die "not a directory: $src"
    [ -z "$lang" ] || [ -d "$ROOT/graph/$lang" ] || die "no engine for --language=$lang (have: $(ls -d "$ROOT"/graph/*/engine 2>/dev/null | sed 's#.*/graph/##; s#/engine##' | tr '\n' ' '))"
    [ -n "$version" ] || version="$(git -C "$src" rev-parse HEAD 2>/dev/null || echo v1.0.0)"
    popts+=(--version "$version")
    mkdir -p "$out"; out="$(cd "$out" && pwd)"; int="$out/.intermediate"; ir="$int/ir"
    rm -rf "$ir"; mkdir -p "$ir"
    echo "▶ parsing $src ($lang) → IR"
    "$0" parser "$src" "$ir" ${popts[@]+"${popts[@]}"} > "$int/parse.log" 2>&1 || { echo "❌ parser failed — see $int/parse.log" >&2; tail -5 "$int/parse.log" >&2; exit 1; }
    head -1 "$int/parse.log"
    # which languages the IR holds — one folder each — and which of them have an engine
    found=(); for d in "$ir"/*/; do l="$(basename "$d")"; [ -d "$ROOT/graph/$l/engine" ] && found+=("$l"); done
    [ ${#found[@]} -gt 0 ] || { echo "❌ no language with an engine in the IR (folders: $(ls "$ir" | tr '\n' ' '))" >&2; exit 1; }
    langs=("${found[@]}")
    if [ -n "$lang" ]; then
      case " ${found[*]} " in *" $lang "*) langs=("$lang");; *) echo "❌ --language=$lang, but the IR holds only: ${found[*]}" >&2; exit 1;; esac
    fi
    echo "▶ languages: ${langs[*]}"
    for l in "${langs[@]}"; do
      echo "▶ solving $l → $out/$l/graph.sqlite"
      "$0" engine --language "$l" --client-ir "$ir/$l" --out "$out/$l" --intermediate "$int" \
           --meta "source_version=$version" --meta "source_dir=$(cd "$src" && pwd)" ${rest[@]+"${rest[@]}"}
    done
    for l in "${langs[@]}"; do echo "$out/$l/graph.sqlite"; done
    ;;
  test)
    which="${1:-all}"; [ $# -gt 0 ] && shift
    rc=0
    run_suite(){ local s="$1"; shift; echo "══ $s"; bash "$ROOT/graph/test/$s/run-tests.sh" "$@" || rc=1; }
    case "$which" in
      java|typescript|python) run_suite "$which" "$@";;
      parser) for t in java-extractor-tests typescript-tests python-tests javascript-tests gradle-tests services-tests; do
                [ -f "$ROOT/parser/src/test/$t.ts" ] || continue; echo "══ parser: $t"; (cd "$ROOT/parser" && npx tsx "src/test/$t.ts") || rc=1; done;;
      all) for l in java typescript python; do run_suite "$l" "$@"; done; "$0" test parser || rc=1;;
      *) die "test: unknown suite $which (java | typescript | python | parser | all)";;
    esac
    exit $rc
    ;;
  -h|--help|help|"") usage; [ -n "$cmd" ] || exit 2;;
  *) die "unknown command '$cmd' (parser | engine | all | test; --help)";;
esac
