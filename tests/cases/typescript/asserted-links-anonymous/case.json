{
 "lang": "typescript",
 "src": "src",
 "checks": [
  {
   "why": "BASE: one call site linked to an anonymous function: the link names it by its declaration, since every one of the arrow functions shares the name <arrow>",
   "run": [
    "link",
    "src/bus.ts:10",
    "src/wire.ts:9"
   ],
   "want": [
    "linked src/bus.ts:10:7 `listener` → <arrow> (src/wire.ts:9) [asserted]"
   ]
  },
  {
   "why": "a second link from the SAME site to ANOTHER of the arrow functions is a second link, not a replacement of the first (both are named <arrow>)",
   "run": [
    "link",
    "src/bus.ts:10",
    "src/wire.ts:10"
   ],
   "want": [
    "linked src/bus.ts:10:7 `listener` → <arrow> (src/wire.ts:10) [asserted]"
   ]
  },
  {
   "why": "both links are kept and both applied",
   "run": [
    "link",
    "--list"
   ],
   "want": [
    "2 asserted link(s)",
    "[applied] src/bus.ts:10:7  → <arrow> (src/wire.ts:9)",
    "[applied] src/bus.ts:10:7  → <arrow> (src/wire.ts:10)"
   ]
  },
  {
   "why": "CONTROL: re-linking the same site to the same declaration replaces its row (idempotent)",
   "run": [
    "link",
    "src/bus.ts:10",
    "src/wire.ts:9"
   ],
   "want": [
    "linked src/bus.ts:10:7 `listener` → <arrow> (src/wire.ts:9) [asserted]"
   ]
  },
  {
   "why": "CONTROL: still two links after the re-link",
   "run": [
    "link",
    "--list"
   ],
   "want": [
    "2 asserted link(s)",
    "→ <arrow> (src/wire.ts:9)",
    "→ <arrow> (src/wire.ts:10)"
   ],
   "avoid": [
    "3 asserted link(s)"
   ]
  },
  {
   "why": "removing by the placeholder name would remove two different links: refused, naming each declaration",
   "run": [
    "link",
    "--remove",
    "src/bus.ts:10",
    "<arrow>"
   ],
   "expect_error": true,
   "want": [
    "`<arrow>` names 2 links at src/bus.ts:10",
    "(src/wire.ts:9)",
    "(src/wire.ts:10)",
    "file:line"
   ]
  },
  {
   "why": "nothing was removed by the refused removal",
   "run": [
    "link",
    "--list"
   ],
   "want": [
    "2 asserted link(s)"
   ]
  },
  {
   "why": "removing by the declaration's file:line removes that link only",
   "run": [
    "link",
    "--remove",
    "src/bus.ts:10",
    "src/wire.ts:9"
   ],
   "want": [
    "removed 1 link(s) at src/bus.ts:10"
   ]
  },
  {
   "why": "the other anonymous target's link stays",
   "run": [
    "link",
    "--list"
   ],
   "want": [
    "1 asserted link(s)",
    "→ <arrow> (src/wire.ts:10)"
   ],
   "avoid": [
    "→ <arrow> (src/wire.ts:9)"
   ]
  },
  {
   "why": "CONTROL: the same site linked to two NAMED functions keeps both",
   "run": [
    "link",
    "src/bus.ts:10",
    "onCreated"
   ],
   "want": [
    "→ onCreated [asserted]"
   ]
  },
  {
   "why": "CONTROL: the second named function",
   "run": [
    "link",
    "src/bus.ts:10",
    "onUpdated"
   ],
   "want": [
    "→ onUpdated [asserted]"
   ]
  },
  {
   "why": "CONTROL: three links: one anonymous, two named",
   "run": [
    "link",
    "--list"
   ],
   "want": [
    "3 asserted link(s)",
    "→ <arrow> (src/wire.ts:10)",
    "→ onCreated",
    "→ onUpdated"
   ]
  },
  {
   "why": "CONTROL: --remove <site> <name> removes only the one named",
   "run": [
    "link",
    "--remove",
    "src/bus.ts:10",
    "onCreated"
   ],
   "want": [
    "removed 1 link(s) at src/bus.ts:10"
   ]
  },
  {
   "why": "CONTROL: the other named link and the anonymous one stay",
   "run": [
    "link",
    "--list"
   ],
   "want": [
    "2 asserted link(s)",
    "→ <arrow> (src/wire.ts:10)",
    "→ onUpdated"
   ],
   "avoid": [
    "→ onCreated  "
   ]
  },
  {
   "why": "`-` still removes every link at the site",
   "run": [
    "link",
    "src/bus.ts:10",
    "-"
   ],
   "want": [
    "removed 2 link(s) at src/bus.ts:10"
   ]
  }
 ]
}
