 "checks": [
  {
   "why": "an edit on the second line of a const whose object initializer spans lines is that const's initializer, not the module's body",
   "run": [
    "changed",
    "{repo}",
    "--old",
    "{repo}/src/config.ts",
    "--new",
    "{repo}/new_member_edited.ts",
    "--file",
    "src/config.ts"
   ],
   "want": [
    "field      Settings",
    "initializer"
   ],
   "avoid": [
    "<module>"
   ]
  },
  {
