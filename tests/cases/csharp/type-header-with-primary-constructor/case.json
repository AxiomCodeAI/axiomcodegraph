  },
  {
   "why": "and one added to a class's primary constructor",
   "run": [
    "changed",
    "{repo}",
    "--old",
    "{repo}/old.txt",
    "--new",
    "{repo}/new-class.txt",
    "--file",
    "src/App/Settings.cs"
   ],
   "want": [
    "primary constructor parameters: +host"
   ],
   "avoid": [
    "header changed (name"
