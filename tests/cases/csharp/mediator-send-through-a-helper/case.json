{"lang": "csharp", "src": "src",
 "checks": [
  {"why": "a request sent through a test helper that hands its parameter to ISender.Send reaches that request's handler",
   "run": ["impact", "DeleteThingCommandHandler", "--kind", "type", "--tests-only"],
   "want": ["DeleteThingTests::ShouldDeleteThing"],
   "avoid": ["ShouldCountThings", "ShouldDescribeArchive", "0 of 3"]},
  {"why": "the generic overload of the helper carries the request's type too, and only to its own handler",
   "run": ["impact", "CountThingsQueryHandler", "--kind", "type", "--tests-only"],
   "want": ["DeleteThingTests::ShouldCountThings"],
   "avoid": ["ShouldDeleteThing", "ShouldDescribeArchive"]},
  {"why": "path follows the helper call to the handler",
   "run": ["path", "DeleteThingTests.ShouldDeleteThing", "DeleteThingCommandHandler.Handle"],
   "want": ["DeleteThingCommandHandler.Handle"],
   "avoid": ["no chain of resolved calls", "the two are independent"]},
  {"why": "near miss: a helper that takes a request and does not send it reaches no handler",
   "run": ["impact", "ArchiveThingCommandHandler", "--kind", "type", "--tests-only"],
   "want": ["0 of 3"],
   "avoid": ["ShouldDescribeArchive"]},
  {"why": "control: a direct Send outside the tests still reaches its handler",
   "run": ["impact", "ArchiveThingCommandHandler", "--kind", "type"],
   "want": ["ThingEndpoints.Archive"]}]}
