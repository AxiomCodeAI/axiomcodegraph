{"lang": "javascript",
 "checks": [
  {"why": "a basename matching five indexed files, one of them under --in, answers for that one and names it (#1666)",
   "run": ["impact", "index.js:2", "--in", "packages/a"],
   "want": ["change: runA (at packages/a/src/index.js:2)", "startA"],
   "avoid": ["matches 5 indexed files", "startB", "runB"]},
  {"why": "the same through path, from everything into the one file under --in",
   "run": ["path", "*", "index.js:2", "--in", "packages/b"],
   "want": ["startB"],
   "avoid": ["matches 5 indexed files", "startA"]},
  {"why": "a dir/file suffix is narrowed the same way",
   "run": ["impact", "src/index.js:2", "--in", "packages/b"],
   "want": ["change: runB (at packages/b/src/index.js:2)", "startB"],
   "avoid": ["matches 2 indexed files", "startA"]},
  {"why": "control: a scope that still leaves two files is refused, listing only those two",
   "run": ["impact", "index.js:2", "--in", "packages/c"],
   "expect_error": true,
   "want": ["matches 2 indexed files under *packages/c*", "packages/c/index.js:2", "packages/c/lib/index.js:2"],
   "avoid": ["packages/a/src/index.js", "change: load"]},
  {"why": "control: the same through path",
   "run": ["path", "*", "index.js:2", "--in", "packages/c"],
   "expect_error": true,
   "want": ["matches 2 indexed files under *packages/c*"],
   "avoid": ["packages/d/index.js"]},
  {"why": "control: a scope holding none of the files is refused with every file listed",
   "run": ["impact", "index.js:2", "--in", "shared"],
   "expect_error": true,
   "want": ["matches 5 indexed files", "none of them under *shared*", "packages/a/src/index.js:2", "packages/d/index.js:2"]},
  {"why": "control: without --in the basename is refused as before (#1599)",
   "run": ["impact", "index.js:2"],
   "expect_error": true,
   "want": ["matches 5 indexed files", "packages/a/src/index.js:2", "packages/c/lib/index.js:2"]},
  {"why": "control: the full path with --in answers for it, labelled as typed",
   "run": ["impact", "packages/a/src/index.js:2", "--in", "packages/a"],
   "want": ["change: runA (at packages/a/src/index.js:2)", "startA"],
   "avoid": ["startB"]},
  {"why": "a const on the line of a partial path matching two files is refused, not answered for one of them",
   "run": ["impact", "config.js:1"],
   "expect_error": true,
   "want": ["matches 2 indexed files", "packages/a/src/config.js:1", "packages/b/src/config.js:1"],
   "avoid": ["change: variable tokenA", "change: const tokenA"]},
  {"why": "the same const line with --in answers for the one file under the scope",
   "run": ["impact", "config.js:1", "--in", "packages/b"],
   "want": ["tokenB"],
   "avoid": ["tokenA", "matches 2 indexed files"]},
  {"why": "control: a partial path matching one file is labelled as typed, with or without --in",
   "run": ["impact", "d/index.js:2", "--in", "packages"],
   "want": ["change: main (at d/index.js:2)"]}]}
