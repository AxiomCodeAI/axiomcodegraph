{"lang": "javascript", "src": "src",
 "checks": [
  {"why": "a file:line whose basename carries an extra dot (order.service.js) is the declaration at that line, not package 'order' + 'service.js'",
   "run": ["impact", "src/services/order.service.js:3"],
   "want": ["change: placeOrder (at src/services/order.service.js:3)", "createOrder"],
   "avoid": ["matches no package"]},
  {"why": "the same in a controllers directory (user.controller.js)",
   "run": ["impact", "src/controllers/user.controller.js:4"],
   "want": ["change: createOrder (at src/controllers/user.controller.js:4)"],
   "avoid": ["matches no package"]},
  {"why": "control: an undotted basename answers as before",
   "run": ["impact", "src/services/userService.js:2"],
   "want": ["change: findUser (at src/services/userService.js:2)", "placeOrder"],
   "avoid": ["matches no package"]},
  {"why": "control: a dotted basename under a directory the index does not have is still refused",
   "run": ["impact", "zzz/order.service.js:3"],
   "expect_error": true,
   "want": ["no callable spans zzz/order.service.js:3"]},
  {"why": "a file:line with a leading ./ (as an editor prints it) is the same declaration",
   "run": ["impact", "./src/services/userService.js:2"],
   "want": ["change: findUser (at ./src/services/userService.js:2)", "placeOrder"],
   "avoid": ["no callable spans"]},
  {"why": "an absolute path under the repository root is read relative to that root",
   "run": ["impact", "{repo}/src/services/order.service.js:3"],
   "want": ["change: placeOrder", "createOrder"],
   "avoid": ["no callable spans", "outside the indexed repository"]},
  {"why": "file:line:col, the Node stack-trace form: the column does not change the declaration",
   "run": ["impact", "{repo}/src/services/userService.js:2:5"],
   "want": ["change: findUser", "placeOrder"],
   "avoid": ["no callable spans"]},
  {"why": "path takes the same normalised file:line",
   "run": ["path", "*", "./src/services/userService.js:2:5"],
   "want": ["findUser", "placeOrder"],
   "avoid": ["no callable spans"]},
  {"why": "control: a root-relative /src/... still answers, as before",
   "run": ["impact", "/src/services/userService.js:2"],
   "want": ["change: findUser"],
   "avoid": ["no callable spans", "outside the indexed repository"]},
  {"why": "an absolute path outside the repository is named as outside, not as a line nothing spans",
   "run": ["impact", "/nowhere-axiomcode/src/services/userService.js:2"],
   "expect_error": true,
   "want": ["is outside the indexed repository"],
   "avoid": ["no callable spans"]}]}
