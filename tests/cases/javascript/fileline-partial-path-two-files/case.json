{"lang": "javascript",
 "checks": [
  {"why": "a basename matching two indexed files is refused with both files named, not answered for the one whose function at that line is shorter (#1599)",
   "run": ["impact", "order.service.js:2"],
   "expect_error": true,
   "want": ["matches 2 indexed files", "src/services/order.service.js", "lib/services/order.service.js"]},
  {"why": "the same through path, with a dir/file suffix",
   "run": ["path", "*", "services/order.service.js:2"],
   "expect_error": true,
   "want": ["matches 2 indexed files", "src/services/order.service.js", "lib/services/order.service.js"],
   "avoid": ["0 method(s)"]},
  {"why": "the same without a dot in the basename, where the src function is the shorter one",
   "run": ["impact", "userService.js:2"],
   "expect_error": true,
   "want": ["matches 2 indexed files", "src/services/userService.js", "lib/services/userService.js"]},
  {"why": "the same through path",
   "run": ["path", "*", "services/userService.js:2"],
   "expect_error": true,
   "want": ["matches 2 indexed files"]},
  {"why": "control: the full path to the file with callers answers for it, with its caller",
   "run": ["impact", "src/services/order.service.js:2"],
   "want": ["change: placeOrder (at src/services/order.service.js:2)", "createOrder"]},
  {"why": "control: the full path to the other file answers for that one alone",
   "run": ["impact", "lib/services/order.service.js:2"],
   "want": ["change: placeOrder (at lib/services/order.service.js:2)"],
   "avoid": ["createOrder", "matches 2 indexed files"]},
  {"why": "control: path from everything into the full path finds the caller",
   "run": ["path", "*", "src/services/order.service.js:2"],
   "want": ["createOrder"],
   "avoid": ["matches 2 indexed files"]},
  {"why": "control: a partial path that matches one indexed file still answers",
   "run": ["impact", "controllers/orders.controller.js:4"],
   "want": ["change: createOrder"],
   "avoid": ["matches 2 indexed files"]},
  {"why": "control: a partial path matching no indexed file is still refused as before",
   "run": ["impact", "zzz/order.service.js:2"],
   "expect_error": true,
   "want": ["no callable spans zzz/order.service.js:2"]}]}
