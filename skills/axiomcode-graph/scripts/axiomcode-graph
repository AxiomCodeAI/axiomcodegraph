#!/usr/bin/env python3
"""axiomcode-graph — the call chains of a codebase, from the engine, as a page.

  axiomcode-graph build  [<repo>] [--out <page.html>]   run the engine (axiomcode-build) then write the page
  axiomcode-graph export [<repo>] [--out <page.html>]   write the page from an existing graph.sqlite (no engine run)

The page (default <repo>/.axiomcode/graph/graph.html, one file, no network) lists one call chain per root —
an entry point (main, a handler, a test) or a method nothing calls — following the heaviest callee at each
hop. Click a chain and it is drawn end to end; `+` under a hop expands its other callees, and each of those
expands again. Every hop carries file:line; every arrow carries the engine's tier. A call the engine could not
resolve is a `?N` count on the hop, never a drawn edge.
"""
import os, re, sys, json, time, sqlite3, collections, subprocess

HERE = os.path.dirname(os.path.abspath(__file__))
TESTRE = re.compile(r'(^|/)(tests?|testing|__tests__|test-data|fixtures?)(/|$)|(^|/)test_|conftest\.py$|/src/test/|Tests?\.java$|\.(spec|test)\.[cm]?[tj]sx?$')
RESOLVED = ('known_edge', 'multi_inferred')
MAX_HOPS = 10


def export(repo, page=None):
    repo = os.path.realpath(repo or '.')
    gdir = os.environ.get('AXIOMCODE_GRAPH') or os.path.join(repo, '.axiomcode')
    db = os.path.join(gdir, 'out', 'graph.sqlite')
    if not os.path.exists(db): sys.exit(f"no graph at {db} — run `axiomcode-graph build {repo}` first")
    con = sqlite3.connect(db); con.row_factory = sqlite3.Row
    q = lambda sql: con.execute(sql).fetchall()
    has = lambda t: bool(con.execute("SELECT 1 FROM sqlite_master WHERE name=?", (t,)).fetchone())
    run = {r['key']: r['value'] for r in q("SELECT key, value FROM run")}
    src = run.get('source_dir') or repo
    def rel(p):
        a = p if os.path.isabs(p) else os.path.join(src, p)
        a = os.path.realpath(a) if os.path.exists(a) else os.path.normpath(a)
        r = os.path.relpath(a, repo); return p.lstrip('/') if r.startswith('..') else r

    # methods: display name the way the query skill shows it when the index is there, Owner.name otherwise
    M = {}
    if has('symbols'):
        for r in q("SELECT method_id, display, file, line, end_line, is_test, signature FROM symbols WHERE method_id IS NOT NULL"):
            M[r['method_id']] = dict(id=r['method_id'], l=r['display'], f=r['file'], a=r['line'], b=r['end_line'], t=int(bool(r['is_test'])), sig=r['signature'] or '')
    for r in q("SELECT id, name, owner_qualified_name, file_path, start_line, end_line, signature FROM methods WHERE provenance='client'"):
        if r['id'] in M: continue
        f = rel(r['file_path']); o = (r['owner_qualified_name'] or '').replace('#', '.').split('.')[-1].replace('$', '.')
        M[r['id']] = dict(id=r['id'], l=f"{o}.{r['name']}" if o else r['name'], f=f, a=r['start_line'], b=r['end_line'], t=int(bool(TESTRE.search(f))), sig=r['signature'] or '')
    lib = {r['id']: r['qualified_name'] for r in q("SELECT id, qualified_name FROM methods WHERE provenance<>'client'")}

    # edges: one per (caller, callee), the best tier among its sites, the number of sites
    E, unresolved, libcalls = {}, collections.Counter(), collections.defaultdict(collections.Counter)
    for r in q("SELECT e.caller_id, e.callee_method_id, e.tier, s.callee_name, s.start_line FROM call_edges e LEFT JOIN call_sites s ON s.id = e.call_site_id"):
        c, t = r['caller_id'], r['callee_method_id']
        if c not in M: continue
        if not t or t not in M:
            if t in lib: libcalls[c][lib[t]] += 1
            else: unresolved[c] += 1
            continue
        k = (c, t); e = E.get(k)
        if e is None: E[k] = dict(s=c, t=t, tier=r['tier'], w=1, line=r['start_line'] or 0)
        else:
            e['w'] += 1
            if r['tier'] == 'known_edge' and e['tier'] != 'known_edge': e['tier'] = 'known_edge'; e['line'] = r['start_line'] or e['line']
    for m, n in unresolved.items(): M[m]['u'] = n
    for m, c in libcalls.items(): M[m]['lib'] = [f"{k}×{v}" if v > 1 else k for k, v in c.most_common(6)]
    entries = collections.defaultdict(list)
    for r in q("SELECT method_id, reason FROM entry_points"):
        if r['method_id'] in M: entries[r['method_id']].append(r['reason'])
    for m, rs in entries.items(): M[m]['e'] = rs

    out = collections.defaultdict(list); indeg = collections.Counter()
    for e in E.values(): out[e['s']].append(e); indeg[e['t']] += 1
    for lst in out.values(): lst.sort(key=lambda e: (e['tier'] not in RESOLVED, -e['w'], -len(out.get(e['t'], ())), M[e['t']]['l']))

    # reach: how many methods a root can get to through resolved edges (what ranks the chains)
    def reach(root):
        seen = {root}; dq = collections.deque([root])
        while dq:
            u = dq.popleft()
            for e in out.get(u, ()):
                if e['tier'] in RESOLVED and e['t'] not in seen: seen.add(e['t']); dq.append(e['t'])
        return len(seen) - 1

    # roots: entry points that are not tests, then non-test methods nothing calls, then tests. One chain per root:
    # the heaviest resolved callee at every hop, until a leaf, a repeat, or MAX_HOPS
    roots = [m for m in M if entries.get(m) and not M[m]['t'] and any(r != 'test' for r in entries[m])]
    roots += [m for m in M if m not in set(roots) and not M[m]['t'] and indeg[m] == 0 and out.get(m)]
    roots += [m for m in M if M[m]['t'] and out.get(m)]
    chains = []
    for r in roots:
        path, seen = [r], {r}
        while len(path) <= MAX_HOPS:
            nxt = next((e for e in out.get(path[-1], ()) if e['tier'] in RESOLVED and e['t'] not in seen), None)
            if not nxt: break
            path.append(nxt['t']); seen.add(nxt['t'])
        if len(path) > 1: chains.append(dict(root=r, path=path, reach=reach(r)))
    chains.sort(key=lambda c: (M[c['root']]['t'], -c['reach'], -len(c['path']), M[c['root']]['l']))

    data = dict(meta=dict(repo=os.path.basename(repo), language=run.get('language', '?'), built=time.strftime('%Y-%m-%d %H:%M'),
                          methods=len(M), edges=len(E), resolved=sum(1 for e in E.values() if e['tier'] in RESOLVED), unresolved_sites=sum(unresolved.values()), chains=len(chains)),
                nodes=list(M.values()), edges=list(E.values()), chains=chains)
    page = page or os.path.join(gdir, 'graph', 'graph.html'); os.makedirs(os.path.dirname(page), exist_ok=True)
    tpl = open(os.path.join(HERE, 'viewer.html'), encoding='utf-8').read()
    open(page, 'w', encoding='utf-8').write(tpl.replace('/*__DATA__*/null', json.dumps(data, separators=(',', ':')).replace('</', '<\\/')))
    m = data['meta']
    print(f"{m['methods']} methods · {m['edges']} call edges ({m['resolved']} resolved) · {m['unresolved_sites']} unresolved sites · {m['chains']} chains")
    print(f"page: {os.path.relpath(page)}")


def build(repo, page):
    repo = os.path.realpath(repo or '.')
    cands = [os.path.join(HERE, '..', '..', 'axiomcode', 'scripts', 'axiomcode-build'), os.path.join(os.environ.get('AXIOMCODE_ENGINE', ''), 'skills', 'axiomcode', 'scripts', 'axiomcode-build')]
    b = next((os.path.realpath(c) for c in cands if os.path.isfile(c)), None)
    if not b: sys.exit("axiomcode-build not found: the axiomcode skill must live beside this one (skills/axiomcode) or AXIOMCODE_ENGINE must point at the engine checkout")
    r = subprocess.run([b, repo])
    if r.returncode: sys.exit(r.returncode)
    export(repo, page)


if __name__ == '__main__':
    a = sys.argv[1:]
    page = None
    if '--out' in a: i = a.index('--out'); page = os.path.abspath(os.path.expanduser(a[i + 1])); del a[i:i + 2]
    verb, pos = (a[0] if a else ''), a[1:]
    if verb == 'build': build(pos[0] if pos else '.', page)
    elif verb == 'export': export(pos[0] if pos else '.', page)
    else: print(__doc__.strip()); sys.exit(0 if verb in ('', '-h', '--help') else 2)
