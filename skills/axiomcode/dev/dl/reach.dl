// reach.dl — the closure `impact` prints, restated as rules over the engine's own tables, and the closure it
// CANNOT print: what becomes reachable if every unresolved site were the client method written at it.
//
// The skill computes the first in Python (edges_up + reach). This program is the independent second
// implementation the validator diffs it against, and the source of the by-name upper bound.
//
// facts (exported from graph.sqlite by validate_impact_dl.py):
//   edge(caller, callee)      resolved client edge (known_edge / multi_inferred, callee_provenance = client)
//   encl(inner, outer)        a callable defined inside another one's body            tier 'enclosing'
//   disp(base, cand)          dispatch candidate of an instantiated type               tier 'dispatch'
//   refl(dispatcher, m)       a by-name lookup (getattr / getMethod) inside the owner  tier 'reflective'
//   test(m)                   m is a test
//   byname(caller, name)      an UNRESOLVED site inside caller, written `name`
//   named(name, m)            a client method declared with that simple name
//   start(q, m)               query q asks about method m

.decl edge(c:symbol, t:symbol)       .input edge
.decl encl(i:symbol, o:symbol)       .input encl
.decl disp(b:symbol, k:symbol)       .input disp
.decl refl(x:symbol, m:symbol)       .input refl
.decl test(m:symbol)                 .input test
.decl byname(c:symbol, n:symbol)     .input byname
.decl named(n:symbol, m:symbol)      .input named
.decl start(q:symbol, m:symbol)      .input start

// up(t, c): c can run t — the four ways the skill admits
.decl up(t:symbol, c:symbol)
up(t, c) :- edge(c, t).
up(i, o) :- encl(i, o).
up(k, b) :- disp(b, k).
up(m, x) :- refl(x, m).

// the sound closure (what impact prints as TRANSITIVE), with the shortest hop count
.decl reach(q:symbol, m:symbol)
reach(q, c) :- start(q, m), up(m, c).
reach(q, c) :- reach(q, t), up(t, c).
.decl hop(q:symbol, m:symbol, d:number)
hop(q, m, 0) :- start(q, m).
hop(q, c, d+1) :- hop(q, t, d), up(t, c), d < 64.
.decl hops(q:symbol, m:symbol, d:number)
hops(q, m, d) :- reach(q, m), d = min x : hop(q, m, x).
.decl tests_reach(q:symbol, m:symbol, d:number)
tests_reach(q, m, d) :- hops(q, m, d), test(m).
// a test class that EXTENDS a reached test class runs the same test methods again under its own file (JUnit, pytest)
.decl file(m:symbol, f:symbol)       .input file
.decl tinh(sub:symbol, anc:symbol)   .input tinh
.decl tests_file(q:symbol, f:symbol)
tests_file(q, f) :- tests_reach(q, m, _), file(m, f).
tests_file(q, sf) :- tests_file(q, f), tinh(sf, f).
.output hops
.output tests_reach
.output tests_file

// the optimistic closure: an unresolved site written `n` inside c MAY call any client method named n.
// reach_opt − reach is exactly the set an agent must VERIFY by hand — and the tests the sound answer can never name.
.decl up_opt(t:symbol, c:symbol)
up_opt(t, c) :- up(t, c).
up_opt(m, c) :- byname(c, n), named(n, m).
.decl reach_opt(q:symbol, m:symbol)
reach_opt(q, c) :- start(q, m), up_opt(m, c).
reach_opt(q, c) :- reach_opt(q, t), up_opt(t, c).
.decl tests_opt(q:symbol, m:symbol)
tests_opt(q, m) :- reach_opt(q, m), test(m), !reach(q, m).
.output tests_opt

// the FIRST by-name hop out of the sound closure: m is soundly reached (or asked about), c holds an unresolved site
// written `n` = m's name, and c is reachable only optimistically. Resolving that one site changes the answer — it is
// what to look at, not a list of 9,000 blind spots
.decl bridge(q:symbol, c:symbol, n:symbol, m:symbol)
bridge(q, c, n, m) :- start(q, m), byname(c, n), named(n, m), !reach(q, c).
bridge(q, c, n, m) :- reach(q, m), byname(c, n), named(n, m), !reach(q, c).
.output bridge
