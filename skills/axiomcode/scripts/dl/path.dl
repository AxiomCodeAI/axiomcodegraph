// path.dl — is there a chain of calls from A to B, and through what?
//
// Facts come from graph.sqlite (exported by axiomcode-path):
//   edge(a, b, tier)   a calls b — a resolved client edge (known_edge / multi_inferred), a dispatch step from a
//                      base to an instantiated override ("dispatch"), or an outer callable to the closure it
//                      defines ("defines"). Never a name match.
//   src(q, m) / dst(q, m)   the endpoints of query q — several rows when an endpoint is a type or a bare name
//   byname(c, n)       an UNRESOLVED site inside c written `n`
//   named(n, m)        a client method declared with simple name n
//
// Two closures. `dist` follows only what the engine resolved: a path it prints is real. `dist_opt` also takes every
// unresolved site as a call to the client method written there: when the sound closure has no path and this one
// does, the difference is exactly the site(s) an agent must look at — printed as the bridge, never as a path.

.decl edge(a:symbol, b:symbol, t:symbol)   .input edge
.decl src(q:symbol, m:symbol)              .input src
.decl dst(q:symbol, m:symbol)              .input dst
.decl byname(c:symbol, n:symbol)           .input byname
.decl named(n:symbol, m:symbol)            .input named

// ── the sound closure, shortest hop count, and the parent relation a path is read back from ──────────────────
.decl step(q:symbol, m:symbol, d:number)
step(q, m, 0) :- src(q, m).
step(q, b, d+1) :- step(q, a, d), edge(a, b, _), d < 40.
.decl dist(q:symbol, m:symbol, d:number)
dist(q, m, d) :- step(q, m, d), d = min x : step(q, m, x).
.decl hit(q:symbol, m:symbol, d:number)
hit(q, m, d) :- dst(q, m), dist(q, m, d).
.decl parent(q:symbol, b:symbol, a:symbol, t:symbol)
parent(q, b, a, t) :- dist(q, b, d), d > 0, dist(q, a, d1), d1 = d - 1, edge(a, b, t).
.output hit
.output parent

// ── one endpoint only: everything that reaches the target (upstream, by shortest hop count) or everything a source
//    reaches (downstream). `path '*' X` reads dist_up; `path X '*'` reads dist (the forward closure above)
.decl step_up(q:symbol, m:symbol, d:number)
step_up(q, m, 0) :- dst(q, m).
step_up(q, a, d+1) :- step_up(q, b, d), edge(a, b, _), d < 40.
.decl dist_up(q:symbol, m:symbol, d:number)
dist_up(q, m, d) :- step_up(q, m, d), d = min x : step_up(q, m, x).
.output dist_up
.output dist

// ── every route, not only the shortest: a method lies on SOME chain from a source to a target iff a source reaches it
//    and it reaches a target. The set of such methods and the edges among them is every path at once, in polynomial
//    size; the driver enumerates simple paths from it on request
.decl fwd(q:symbol, m:symbol)
fwd(q, m) :- src(q, m).
fwd(q, b) :- fwd(q, a), edge(a, b, _).
.decl bwd(q:symbol, m:symbol)
bwd(q, m) :- dst(q, m).
bwd(q, a) :- bwd(q, b), edge(a, b, _).
.decl between(q:symbol, m:symbol)
between(q, m) :- fwd(q, m), bwd(q, m).
.decl between_edge(q:symbol, a:symbol, b:symbol, t:symbol)
between_edge(q, a, b, t) :- between(q, a), between(q, b), edge(a, b, t).
.output between_edge

// ── the optimistic closure: unresolved sites taken by name ─────────────────────────────────────────────────────
.decl edge_opt(a:symbol, b:symbol, t:symbol)
edge_opt(a, b, t) :- edge(a, b, t).
edge_opt(c, m, "by-name") :- byname(c, n), named(n, m).
.decl step_opt(q:symbol, m:symbol, d:number)
step_opt(q, m, 0) :- src(q, m).
step_opt(q, b, d+1) :- step_opt(q, a, d), edge_opt(a, b, _), d < 40.
.decl dist_opt(q:symbol, m:symbol, d:number)
dist_opt(q, m, d) :- step_opt(q, m, d), d = min x : step_opt(q, m, x).
.decl hit_opt(q:symbol, m:symbol, d:number)
hit_opt(q, m, d) :- dst(q, m), dist_opt(q, m, d), !hit(q, m, _).
.decl parent_opt(q:symbol, b:symbol, a:symbol, t:symbol)
parent_opt(q, b, a, t) :- dist_opt(q, b, d), d > 0, dist_opt(q, a, d1), d1 = d - 1, edge_opt(a, b, t).
.output hit_opt
.output parent_opt
