#!/usr/bin/env python3
"""PreToolUse hook for the GATED arm: the graph is the ONLY way to find code.

Stricter than gate-hook in exactly two ways, which are the two that make the experiment
test its own hypothesis:

  gate-hook  (arm `forced`)         gate2-hook (arm `gated`)
  ------------------------------    ----------------------------------------
  Grep/rg allowed after the brief   Grep, Glob and rg/ag/ack DENIED outright
  Read free after the brief         Read of a SOURCE file requires a graph
                                    query to have named it first

WHY. In the `skill` arm only the Grep TOOL was removed, and 3 of 11 runs then made zero
graph queries and simply read whole files instead — they were raw runs wearing the skill
label, and two of them scored as graph-arm wins. Leaving Read open also inverts the token
result by construction: it pushes the agent off cheap targeted search onto expensive
whole-file reads. A hypothesis about the graph replacing text search cannot be tested while
the cheapest substitute for both is still available.

WHAT STAYS OPEN, so a denial means "the graph could not answer" and never "the harness
made the task impossible":
  - everything under .axiomcode/ (the brief and the issue text)
  - non-source files: docs, config, changelogs — the same exemption gate-hook gives Edit
  - running tests, and every other Bash command that is not a text search
  - Read of a file the agent has ALREADY edited (it must be able to re-check its own work)

Every denial is appended to .axiomcode/denials.jsonl so the analysis can separate
"gate blocked progress" from "graph gave the wrong answer" — a run that dies against the
gate is not evidence about the graph and must be excluded, not scored.
"""
import json, os, re, sys

ev = json.load(sys.stdin)
tool = ev.get('tool_name', '')
inp = ev.get('tool_input', {}) or {}
cwd = ev.get('cwd') or os.getcwd()
adir = os.path.join(cwd, '.axiomcode')
log_path = os.path.join(adir, 'queries.jsonl')
den_path = os.path.join(adir, 'denials.jsonl')

# a file whose content is prose or configuration is not what the graph indexes; gating it
# would block the agent on changelogs and setup.cfg and measure nothing about the graph.
NON_SOURCE = ('.md', '.rst', '.txt', '.cfg', '.toml', '.ini', '.json', '.yml', '.yaml',
              'CHANGES', 'CHANGELOG', 'ChangeLog', '.in', '.pot')
TEXT_SEARCH = re.compile(r'(?:^|[|;&(]|\s)\s*(?:sudo\s+)?(?:u?grep|e?grep|f?grep|rg|ag|ack|ripgrep)\b')


def record(why, extra=None):
    try:
        os.makedirs(adir, exist_ok=True)
        with open(den_path, 'a') as fh:
            fh.write(json.dumps({'tool': tool, 'why': why[:80],
                                 'input': {k: str(v)[:200] for k, v in inp.items()},
                                 **(extra or {})}) + '\n')
    except Exception:
        pass


def deny(why, kind):
    record(kind)
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny",
        "permissionDecisionReason": why}}))
    sys.exit(0)


queries = []
if os.path.exists(log_path):
    for line in open(log_path):
        try:
            queries.append(json.loads(line))
        except Exception:
            pass
briefed = any(q.get('tool') == 'axiomcode-brief' for q in queries)
named_files = {f for q in queries for f in q.get('files', [])}
edited = {q.get('edited') for q in queries if q.get('edited')}

cmd = str(inp.get('command', '')) if tool == 'Bash' else ''
is_axiom = tool == 'Bash' and 'axiomcode' in cmd
S = '~/.claude/skills/axiomcode/scripts'


def rel_of(fp):
    return fp.split(cwd.rstrip('/') + '/')[-1] if cwd and fp.startswith(cwd) else fp


# ── 1. text search is gone, before and after the brief ──────────────────────
if tool in ('Grep', 'Glob'):
    deny(f"Text search is disabled in this run. Find code through the graph instead: "
         f"`{S}/axiomcode find <name>` names the file and line, `{S}/axiomcode callers <qualified_name>` "
         f"gives who calls it, and `{S}/axiomcode-dl change_context M=<qualified_name>` gives the files a "
         f"change touches. Reading a source file unlocks once a graph query has named it.", 'text_search')
if tool == 'Bash' and TEXT_SEARCH.search(cmd) and not is_axiom:
    deny(f"grep/rg are disabled in this run — find code through the graph "
         f"(`{S}/axiomcode find|callers|type`, `{S}/axiomcode-dl change_context`). "
         f"Running tests and every other shell command is still allowed.", 'text_search_bash')

# ── 2. the brief comes first ────────────────────────────────────────────────
if not briefed and not is_axiom and tool in ('Read', 'Edit', 'Write', 'Bash', 'MultiEdit', 'NotebookEdit'):
    deny(f"Start from the graph. First run `{S}/axiomcode-brief .axiomcode .axiomcode/issue.md`, "
         f"then anchor its functions with `{S}/axiomcode find|type|callers` and "
         f"`{S}/axiomcode-dl change_context M=<qualified_name>`. Reading and editing unlock after that.",
         'not_briefed')

# ── 3. reading a SOURCE file requires the graph to have named it ────────────
if tool == 'Read':
    fp = str(inp.get('file_path', ''))
    rel = rel_of(fp)
    inside_axiom = rel.startswith('.axiomcode')
    if not inside_axiom and not rel.endswith(NON_SOURCE):
        base = os.path.basename(rel)
        named = any(rel == f or rel.endswith('/' + f) or f.endswith('/' + rel)
                    or base == os.path.basename(f) for f in named_files)
        if not named and rel not in edited:
            deny(f"The graph has not named {rel} yet. Ask it: `{S}/axiomcode find <symbol>` to locate a "
                 f"declaration, `{S}/axiomcode callers <qualified_name>` for its callers, or "
                 f"`{S}/axiomcode-dl change_context M=<qualified_name>` for the files a change to it touches. "
                 f"Reading unlocks for every file a query returns.", 'read_not_named')

# ── 4. editing a source file requires the graph to have named it (as gate-hook) ──
if tool in ('Edit', 'Write', 'MultiEdit'):
    rel = rel_of(str(inp.get('file_path', '')))
    if not rel.endswith(NON_SOURCE):
        base = os.path.basename(rel)
        named = any(rel == f or rel.endswith('/' + f) or f.endswith('/' + rel)
                    or base == os.path.basename(f) for f in named_files)
        if not named:
            deny(f"Before editing {rel}, compute its impact from the graph: `{S}/axiomcode find <function>` "
                 f"then `{S}/axiomcode-dl change_context M=<qualified_name>` (or blast_radius / callers).",
                 'edit_not_named')
sys.exit(0)
