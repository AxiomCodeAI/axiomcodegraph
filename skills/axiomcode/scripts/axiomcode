#!/usr/bin/env python3
"""axiomcode search | impact  — the two questions an agent asks a call graph.

  axiomcode search <anything> [in=<path>]
      <anything> = a name (bar, Foo.bar, Outer.Inner.bar, file.ts:bar, m(int,String)), words from an
      issue ("overload signatures group key"), an error message or flag in quotes, or file:line.
      Returns the matching NODES, each with its one-hop neighbourhood: who calls it, what it calls
      (resolved · library · UNRESOLVED), dispatch siblings, tests reaching it — so the next call is
      `search <a name from the output>` and you walk the graph. A name that is not a declaration
      falls through to references / literals / comments (grep over what the parser saw), and a miss
      lists the nearest names. Never empty. When exactly one node matches, its body is printed too
      (first 120 lines) — that is usually the Read you were about to do. body=no turns it off.

  axiomcode impact <method | Owner.field | Type> [to=<name>]
      What a change touches, as the sets to act on. A METHOD: MUST change if its signature changes
      (every direct caller, by site) · MAY change if its contract changes (overrides/implementations) ·
      VERIFY with (every test that reaches it, whole graph) · TRANSITIVE (everything that can reach it,
      by file) · BLIND SPOTS (unresolved calls that make each set a lower bound); to= adds the path.
      A FIELD / constant: every access grouped by the method it is in — certain inside the owner and
      its subtypes, by-name elsewhere (the engine resolves calls, not field accesses). A TYPE: subtypes,
      who constructs it, who calls its methods, and every declaration that uses it (field type,
      parameter, return, generic argument, new) by context and file.

Every row carries a repo-relative file:line; every edge carries its tier; every printed path is
logged, which is what unlocks Read/Edit under the gate. Options: in=<path-substring> narrows,
limit=N rows (default 60).
"""
import os as _os, sys as _sys, subprocess as _sp
if not _os.environ.get("AXIOMCODE_LOGGED"):   # every printed path is logged: that is what unlocks Read/Edit under the gate
    _e = dict(_os.environ, AXIOMCODE_LOGGED="1"); _p = _sp.run([_sys.executable, _sys.argv[0], *_sys.argv[1:]], env=_e, capture_output=True, text=True)
    _sp.run([_sys.executable, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "_log_query.py"), "axiomcode", *_sys.argv[1:]], input=_p.stdout + _p.stderr, text=True)
    raise SystemExit(_p.returncode)
import os, re, sqlite3, sys, subprocess, collections

HERE = os.path.dirname(os.path.abspath(__file__))
argv = sys.argv[1:]
if '--graph' in argv: i = argv.index('--graph'); os.environ['AXIOMCODE_GRAPH'] = os.path.abspath(argv[i + 1]); del argv[i:i + 2]
GDIR = os.environ.get('AXIOMCODE_GRAPH') or os.path.join(os.getcwd(), '.axiomcode')
DB = os.path.join(GDIR, 'out', 'graph.sqlite')
REPO = os.path.realpath(os.path.join(GDIR, '..'))
if not argv or argv[0] in ('-h', '--help', 'help'): print(__doc__.strip()); sys.exit(0)
if not os.path.exists(DB): print(f"no graph at {DB} — run axiomcode-build . first"); sys.exit(2)
con = sqlite3.connect(DB); con.row_factory = sqlite3.Row
def q(sql, *p): return con.execute(sql, p).fetchall()
if not q("SELECT 1 FROM sqlite_master WHERE name='symbols' AND type='table'"):
    r = subprocess.run([sys.executable, os.path.join(HERE, 'axiomcode-index')], env=dict(os.environ, AXIOMCODE_GRAPH=GDIR), capture_output=True, text=True)
    if r.returncode: print(r.stdout + r.stderr); sys.exit(2)
    con = sqlite3.connect(DB); con.row_factory = sqlite3.Row
META = {r['key']: r['value'] for r in q("SELECT key, value FROM index_meta")}
LANG = META.get('language', '?')

# ── arguments: <verb> positionals k=v ─────────────────────────────────────────────────────────────
OPT_KEYS = {'in', 'kind', 'depth', 'from', 'to', 'type', 'method', 'file', 'limit', 'body'}
verb, pos, opt = argv[0], [], {}
for a in argv[1:]:
    k, _, v = a.partition('=')
    if _ and k in OPT_KEYS and not a.startswith('"'): opt[k] = v
    else: pos.append(a)
def opt_int(k, d):
    try: return int(opt.get(k, d))
    except ValueError: return d
IN = opt.get('in') or opt.get('file')
KINDS = {'fn': ('function', 'method', 'constructor'), 'function': ('function',), 'method': ('method', 'constructor'), 'class': ('class',), 'interface': ('interface',),
         'enum': ('enum', 'enum_member'), 'type': ('class', 'interface', 'enum', 'type', 'namespace'), 'const': ('const', 'variable'), 'variable': ('const', 'variable'),
         'field': ('field',), 'module': ('module',), 'any': None}
CALLABLE = ('function', 'method', 'constructor', 'module')
TYPES = ('class', 'interface', 'enum', 'type', 'namespace')

# ── output: a bounded page, with a hint on how to narrow ─────────────────────────────────────────
OUT = []; ROWS = 0; MAXROWS = opt_int('limit', 60); MAXCH = 4000
def say(s=''): OUT.append(s)
def row(s):
    global ROWS
    ROWS += 1
    if ROWS <= MAXROWS: OUT.append(s)
def flush():
    text = '\n'.join(OUT)
    if ROWS > MAXROWS: text += f"\n… {ROWS - MAXROWS} more rows (narrow with in=<path>, or raise limit=)"
    if len(text) > MAXCH * 3: text = text[:MAXCH * 3] + f"\n… truncated (narrow with in=<path>)"
    print(text)
def loc(r): return f"{r['file']}:{r['line']}" + (f"-{r['end_line']}" if r['end_line'] and r['end_line'] != r['line'] else '')
def fmt(r, sig=False):
    s = f"  {r['kind']:<11} {r['display']}"
    if sig and r['signature']: s += f" {r['signature']}"
    return s + f"   {loc(r)}" + ("  [test]" if r['is_test'] else '')

# ── the resolver: one for every verb ─────────────────────────────────────────────────────────────
def where_extra(kinds, in_):
    w, p = [], []
    if kinds: w.append(f"kind IN ({','.join('?' * len(kinds))})"); p += list(kinds)
    if in_: w.append("file LIKE ?"); p.append(f"%{in_}%")
    return (' AND ' + ' AND '.join(w) if w else ''), p
def sym(where, params, kinds, in_, order="is_test, file, line", limit=200):
    we, pe = where_extra(kinds, in_)
    return q(f"SELECT * FROM symbols WHERE ({where}){we} ORDER BY {order} LIMIT {limit}", *params, *pe)
DEG = {}
def degree(r):
    """how connected a declaration is: resolved callers + callees of a method, callers of a type's methods — the
    definition everything uses ranks above a same-named helper in a fixture"""
    i = r['method_id'] or r['type_id']
    if not i: return 0
    if i not in DEG:
        if r['method_id']:
            DEG[i] = q("SELECT (SELECT count(*) FROM call_edges WHERE callee_method_id=?) + (SELECT count(*) FROM call_edges WHERE caller_id=? AND callee_method_id IS NOT NULL) AS n", i, i)[0]['n']
        else:
            DEG[i] = q("SELECT count(*) AS n FROM call_edges e JOIN methods m ON m.id=e.callee_method_id WHERE m.owner_type_id=?", i)[0]['n']
    return DEG[i]
def dedupe(rows):
    """a TS `const foo = () => …` is both a const and a function at the same line: keep the callable"""
    seen, out = {}, []
    for r in sorted(rows, key=lambda r: (0 if r['method_id'] or r['type_id'] else 1)):
        k = (r['display'], r['file'], r['line'])
        if k not in seen: seen[k] = 1; out.append(r)
    if len(out) > 1: out.sort(key=lambda r: (r['is_test'], -degree(r), -((r['end_line'] or 0) - (r['line'] or 0)), r['file'] or '', r['line'] or 0))   # a body outranks an overload signature
    return out
def tokens(s): return [t.lower() for t in re.findall(r'[A-Z]?[a-z]+|[A-Z]+(?![a-z])|\d+', s) if len(t) >= 3]

def resolve(sel, kinds=None, in_=None):
    """-> (rows, how). Tiers, first non-empty wins; kind= and in= filter every tier."""
    sel = sel.strip().strip('"\'')
    m = re.match(r'^([\w./\\-]+\.[a-z]{1,4})[:#]([A-Za-z_$<][\w.$<>]*)$', sel)      # file.ts:name / file.py#Class.m → narrow to that file
    if m and not re.match(r'^\d+$', m.group(2)): in_ = in_ or m.group(1); sel = m.group(2)
    sig = None
    m = re.match(r'^([^(]+)\((.*)\)$', sel)
    if m: sel, sig = m.group(1), re.sub(r'\s+', '', m.group(2))
    def filt(rows):
        if sig: rows = [r for r in rows if r['signature'] and sig in re.sub(r'\s+', '', r['signature'])] or rows
        return dedupe(rows)
    # 0. "the constructor of X": X.<constructor> · X.<init> · X.__init__ · X.constructor · new X — every language names it differently
    m = re.match(r'^(?:new\s+(.+)|(.+)\.(?:<constructor>|<init>|<new>|__init__|constructor))$', sel)
    if m:
        owner = (m.group(1) or m.group(2)).strip()
        rows = sym("kind = 'constructor' AND (owner = ? OR owner LIKE ?)", [owner, f"%.{owner}"], None, in_)
        if rows: return filt(rows), f"constructor of {owner}"
    # 1. the parser's own spelling
    rows = sym("qualified_name = ?", [sel], kinds, in_)
    if rows: return filt(rows), 'qualified name'
    tail = sel.split('#')[-1]
    rows = sym("display = ?", [tail], kinds, in_)                                   # 2. display name
    if rows: return filt(rows), 'exact'
    parts = tail.split('.')
    for i in range(len(parts) - 1):                                                  # 3. Owner.name suffix, dropping leading packages
        suf = '.'.join(parts[i:])
        rows = sym("display = ? OR display LIKE ?", [suf, f"%.{suf}"], kinds, in_)
        if rows: return filt(rows), f"suffix {suf}"
    last = parts[-1]
    if len(parts) >= 2:                                                              # 3b. Owner.member where Owner INHERITS member: Nominal.__call__ -> Scale.__call__
        owners = sym("display = ? OR display LIKE ?", [parts[-2], f"%.{parts[-2]}"], TYPES, None)
        for o in owners:
            inh = q("""SELECT s.* FROM type_ancestors a JOIN symbols s ON s.owner = (SELECT display FROM symbols t WHERE t.type_id = a.ancestor_type_id LIMIT 1)
                        WHERE a.type_id = ? AND s.name = ? AND s.method_id IS NOT NULL""", o['type_id'], last)
            if inh: return filt(inh), f"inherited: {parts[-2]} gets {last} from {inh[0]['owner']}"
    rows = sym("name = ?", [last], kinds, in_)                                       # 4. simple name (arrow-bound names are already simple names)
    if rows: return filt(rows), 'name' if len(parts) == 1 else f"name {last} (no declaration spelled {tail})"
    rows = sym("lower(name) = lower(?)", [last], kinds, in_)                         # 5. case
    if rows: return filt(rows), 'case-insensitive'
    if len(last) >= 3:
        rows = sym("name LIKE ?", [f"{last}%"], kinds, in_, order="length(name), is_test, file, line", limit=40)     # 6. prefix
        if rows: return filt(rows), 'prefix'
        rows = sym("name LIKE ?", [f"%{last}%"], kinds, in_, order="length(name), is_test, file, line", limit=40)    # 7. substring
        if rows: return filt(rows), 'substring'
    toks = tokens(last)                                                              # 8. camelCase / snake_case tokens
    if toks:
        conds = ' OR '.join('lower(name) LIKE ?' for _ in toks)
        rows = sym(conds, [f"%{t}%" for t in toks], kinds, in_, order="is_test, length(name), file, line", limit=60)
        rows.sort(key=lambda r: (-sum(t in (r['name'] or '').lower() for t in toks), r['is_test'], len(r['name'] or '')))
        if rows: return filt(rows[:12]), f"nearest by tokens {'+'.join(toks)}"
    return [], 'none'

def selector():
    if opt.get('type') or opt.get('method'):
        return '.'.join(x for x in (opt.get('type'), opt.get('method')) if x)
    return ' '.join(pos)
def skipped_note(name):
    hits = q("SELECT file, reason FROM skipped WHERE file LIKE ? LIMIT 3", f"%{name}%")
    for h in hits: say(f"  note: {h['file']} exists but was not indexed in this {LANG} graph ({h['reason'] or 'skipped'})")
def pick(sel, kinds, need):
    """resolve for a verb that needs callables (need='callable') or types (need='type'); ≤5 run, >5 list"""
    rows, how = resolve(sel, kinds, IN)
    want = [r for r in rows if (r['method_id'] if need == 'callable' else r['type_id'])]
    if not rows:
        say(f"nothing named '{sel}' in the {LANG} graph"); skipped_note(sel.split('.')[-1])
        near = resolve(sel.split('.')[-1], None, None)[0][:6]
        if near: say("  nearest declarations:"); [say(fmt(r)) for r in near]
        say(f"  try: axiomcode uses {sel.split('.')[-1]}"); return []
    if not want:
        say(f"'{sel}' resolves to {len(rows)} declaration(s) but none is a {'function' if need == 'callable' else 'type'}:")
        [say(fmt(r)) for r in rows[:8]]; say(f"  for a {rows[0]['kind']} ask: axiomcode uses {rows[0]['name']}"); return []
    if len(want) > 5:
        say(f"'{sel}' is ambiguous ({len(want)} {how} matches) — pick one with in=<path>" + (", kind=method|class" if len({r['kind'] for r in want}) > 1 else '') + (", or the signature m(int,String)" if LANG == 'java' else '') + ":")
        [say(fmt(r, sig=True)) for r in want[:12]]; return []
    if how not in ('qualified name', 'exact') or len(want) > 1:
        say(f"'{sel}' → {len(want)} match(es) by {how}:"); [say(fmt(r, sig=len(want) > 1)) for r in want]; say()
    return want

# ── graph helpers ────────────────────────────────────────────────────────────────────────────────
TIER = {}                                                   # (caller, callee) -> best tier seen; a path prefers known_edge hops
def edges_up():
    """caller <- callee over RESOLVED client edges (callee_method_id set, provenance client): the sound set in every language"""
    up = collections.defaultdict(set)
    for r in q("SELECT caller_id, callee_method_id, tier FROM call_edges WHERE callee_method_id IS NOT NULL AND callee_provenance='client'"):
        up[r['callee_method_id']].add(r['caller_id'])
        if r['tier'] == 'known_edge' or (r['caller_id'], r['callee_method_id']) not in TIER: TIER[(r['caller_id'], r['callee_method_id'])] = r['tier']
    return up
def edges_down():
    dn = collections.defaultdict(set)
    for r in q("SELECT caller_id, callee_method_id, tier FROM call_edges WHERE callee_method_id IS NOT NULL AND callee_provenance='client'"):
        dn[r['caller_id']].add(r['callee_method_id'])
        if r['tier'] == 'known_edge' or (r['caller_id'], r['callee_method_id']) not in TIER: TIER[(r['caller_id'], r['callee_method_id'])] = r['tier']
    return dn
def best_path(src, dst, adj, forward=True):
    """shortest path that prefers known_edge hops (weight 1) over multi_inferred ones (weight 3): a printed chain should
    be made of certain edges wherever one exists; returns [(node, tier_of_hop_into_it)] or None"""
    import heapq
    dist = {src: 0}; par = {src: (None, None)}; pq = [(0, src)]
    while pq:
        d, x = heapq.heappop(pq)
        if x == dst: break
        if d > dist.get(x, 1e9): continue
        for y in adj.get(x, ()):
            t = TIER.get((x, y) if forward else (y, x), 'multi_inferred'); nd = d + (1 if t == 'known_edge' else 3)
            if nd < dist.get(y, 1e9): dist[y] = nd; par[y] = (x, t); heapq.heappush(pq, (nd, y))
    if dst not in par: return None
    chain = []; x = dst
    while x is not None: chain.append((x, par[x][1])); x = par[x][0]
    return chain[::-1]
def reach(start_ids, adj, depth):
    """{id: (min depth, parent)} by BFS, bounded"""
    seen = {s: (0, None) for s in start_ids}; frontier = list(start_ids)
    for d in range(1, depth + 1):
        nxt = []
        for x in frontier:
            for y in adj.get(x, ()):
                if y not in seen: seen[y] = (d, x); nxt.append(y)
        frontier = nxt
        if not frontier: break
    return seen
SYM = {}
def symof(i):
    if i not in SYM:
        r = q("SELECT * FROM symbols WHERE id = ? LIMIT 1", i); SYM[i] = r[0] if r else None
    return SYM[i]
def unresolved_in(i): return q("SELECT count(*) AS n FROM unresolved_sites WHERE caller_id = ?", i)[0]['n']
def has(t): return bool(q("SELECT 1 FROM sqlite_master WHERE name=?", t))

# ── the two surfaces ─────────────────────────────────────────────────────────────────────────────
def dispatch_of(m):
    sib = []
    if has('dispatch_candidates'):
        sib += [(symof(x['candidate_method_id']), f"may run instead ({x['basis']})") for x in q("SELECT candidate_method_id, basis FROM dispatch_candidates WHERE base_method_id=?", m)]
        sib += [(symof(x['base_method_id']), f"overrides ({x['basis']})") for x in q("SELECT base_method_id, basis FROM dispatch_candidates WHERE candidate_method_id=?", m)]
    if not sib and has('overrides'):
        sib += [(symof(x['overriding_method_id']), "may run instead (override)") for x in q("SELECT overriding_method_id FROM overrides WHERE method_id=?", m)]
        sib += [(symof(x['method_id']), "overrides") for x in q("SELECT method_id FROM overrides WHERE overriding_method_id=?", m)]
    return [(x, w) for x, w in sib if x]

def skipped_note(name):
    for h in q("SELECT file, reason FROM skipped WHERE file LIKE ? LIMIT 3", f"%{name}%"): say(f"  note: {h['file']} exists but was not indexed in this {LANG} graph ({h['reason'] or 'skipped'})")

GROUP = {}; BODY = False; BODY_MAX = 120
def set_body(v):
    global BODY; BODY = v
def node_card(r):
    """a node and one hop in every direction — what search prints per match; one traversal step"""
    if r['type_id'] and not r['method_id']:
        say(f"{r['kind']} {r['display']}   {loc(r)}" + ("  [test]" if r['is_test'] else ''))
        mem = q("SELECT kind, name, line FROM symbols WHERE owner=? ORDER BY line", r['display'])
        if mem: say("  members: " + ', '.join(f"{m['name']}" + ('()' if m['kind'] in CALLABLE else '') for m in mem[:30]) + (f" … +{len(mem)-30}" if len(mem) > 30 else ''))
        anc = q("SELECT s.display FROM type_ancestors a JOIN symbols s ON s.type_id=a.ancestor_type_id WHERE a.type_id=?", r['type_id'])
        ancx = q("SELECT ty.qualified_name AS display FROM type_ancestors a JOIN types ty ON ty.id=a.ancestor_type_id WHERE a.type_id=? AND ty.provenance<>'client'", r['type_id'])
        if anc or ancx: say("  extends: " + ', '.join([x['display'] for x in anc] + [x['display'] + ' (library)' for x in ancx]))
        sub = q("SELECT s.display FROM type_ancestors a JOIN symbols s ON s.type_id=a.type_id WHERE a.ancestor_type_id=? ORDER BY s.is_test, s.display", r['type_id'])
        if sub: say(f"  subtypes ({len(sub)}): " + ', '.join(x['display'] for x in sub[:15]) + (' …' if len(sub) > 15 else ''))
        who = q("""SELECT cr.display AS caller, count(*) AS n FROM call_edges e JOIN methods me ON me.id=e.callee_method_id JOIN symbols cr ON cr.id=e.caller_id
                   WHERE me.owner_type_id=? AND e.callee_provenance='client' AND cr.type_id IS NULL GROUP BY cr.id ORDER BY n DESC LIMIT 8""", r['type_id'])
        if who: say("  used by: " + ', '.join(f"{w['caller']} ({w['n']})" for w in who))
        # Java: a call written in a field initializer or a static block has the TYPE as its caller
        init = q("SELECT callee, written, line, tier FROM callees WHERE caller_id=? ORDER BY line", r['type_id'])
        if init:
            res_ = [e for e in init if e['callee']]; unr_ = [e for e in init if not e['callee']]
            say(f"  → its field/static initializers call ({len(res_)} resolved, {len(unr_)} unresolved): " + ', '.join(f"L{e['line']} {e['callee']}" for e in res_[:12]) + (f"; UNRESOLVED: " + ', '.join(f"L{e['line']} {e['written'] or '?'}" for e in unr_[:8]) if unr_ else ''))
        say(f"  next: axiomcode search {r['display']}.<member>"); say(); return
    m = r['method_id']
    # an overload set (TypeScript signatures + implementation, Java overloads by arity) is ONE node to an agent:
    # callers of any member, callees of every member, one card
    group = [r] + [g for g in (GROUP.get((r['display'], r['file'])) or []) if g['method_id'] != m]
    ids = [g['method_id'] for g in group]; ph = ','.join('?' * len(ids))
    say(f"{r['kind']} {r['display']}" + (f" {r['signature']}" if r['signature'] and LANG == 'java' and len(group) == 1 else '') + f"   {loc(r)}" + (f"   in {r['owner']}" if r['owner'] else '') + ("  [test]" if r['is_test'] else '')
        + (f"   ({len(group)} declarations: " + ', '.join(f"L{g['line']}" + (f"-{g['end_line']}" if g['end_line'] and g['end_line'] != g['line'] else '') + (f" {g['signature']}" if g['signature'] else '') for g in sorted(group, key=lambda g: g['line'])) + ")" if len(group) > 1 else ''))
    up = q(f"SELECT caller, file, line, tier FROM callers WHERE callee_id IN ({ph}) ORDER BY file, line", *ids)
    byc = collections.OrderedDict()
    for e in up: byc.setdefault(e['caller'], []).append(e)
    say(f"  ← called by ({len(up)} sites, {len(byc)} callers):")
    for c, es in list(byc.items())[:12]: row(f"      {c}   {es[0]['file']}:{','.join(str(e['line']) for e in es[:12])}{' …+%d' % (len(es)-12) if len(es) > 12 else ''}   {es[0]['tier']}")
    if len(byc) > 12: say(f"      … +{len(byc)-12} (axiomcode impact {r['display']} depth=1)")
    if not up:
        ep = q("SELECT reason FROM entry_points WHERE method_id=?", m) if has('entry_points') else []
        say("      none resolved" + (" — ENTRY POINT: " + ', '.join(x['reason'] for x in ep) if ep else (" (a lower bound: the graph has unresolved sites)" if q("SELECT 1 FROM unresolved_sites LIMIT 1") else '')))
    dn = q(f"SELECT callee, written, file, line, tier, callee_id FROM callees WHERE caller_id IN ({ph}) ORDER BY line", *ids)
    res = [e for e in dn if e['callee_id']]; lib = [e for e in dn if not e['callee_id'] and e['callee']]
    # a NULL callee is a blind spot only for ambiguous_*; the other NULL-callee tiers (JavaScript/TypeScript: ambient_terminal,
    # implicit_constructor, dynamic_terminal, fan_capped, intrinsic_terminal) are correct ENDS — the platform, a synthesised
    # constructor, a computed target — and must never be read as "unknown"
    unr = [e for e in dn if not e['callee_id'] and not e['callee'] and (e['tier'] or '').startswith('ambiguous')]
    term = [e for e in dn if not e['callee_id'] and not e['callee'] and not (e['tier'] or '').startswith('ambiguous')]
    seen = collections.OrderedDict()                       # one row per (line, target): the same target called on three lines is three sites
    for e in res: seen.setdefault((e['line'], e['callee']), e)
    say(f"  → calls ({len({c for _, c in seen})} client targets at {len(seen)} sites, {len(lib)} library, {len(term)} terminal, {len(unr)} unresolved):")
    for (ln, c), e in list(seen.items())[:20]: row(f"      L{ln}  {c}   {e['file']}   {e['tier']}")
    if len(seen) > 20: say(f"      … +{len(seen)-20} sites (axiomcode impact {r['display']} for the full set)")
    if lib: say("      library: " + ', '.join(sorted({e['callee'] for e in lib})[:8]))
    if term: say("      terminal (a correct end, not a blind spot): " + ', '.join(f"L{e['line']} {e['written'] or '?'} [{e['tier']}]" for e in term[:10]) + (f" … +{len(term)-10}" if len(term) > 10 else ''))
    if unr:
        say("      UNRESOLVED (unknown, not absent): " + ', '.join(f"L{e['line']} {e['written'] or '?'}" for e in unr[:16]) + (f" … +{len(unr)-16}" if len(unr) > 16 else ''))
        # the graph stops here; a by-name lookup lets the agent keep walking, labelled as what it is
        for w in list(collections.OrderedDict.fromkeys(e['written'] for e in unr if e['written']))[:5]:
            cands = q("SELECT display, file, line FROM symbols WHERE name=? AND method_id IS NOT NULL AND is_test=0 ORDER BY file LIMIT 4", w)
            if cands: say(f"        {w}: NOT an edge — client declarations with that name: " + ', '.join(f"{c['display']} ({c['file']}:{c['line']})" for c in cands))
    sib = [x for i in ids for x in dispatch_of(i)]
    if sib: say("  ⇄ dispatch (may run instead / overrides): " + ', '.join(x['display'] for x, _ in sib[:8]))
    t = reach(ids, edges_up(), 3); tests = [symof(i) for i, (d, _) in t.items() if d > 0 and symof(i) and symof(i)['is_test']]
    say(f"  ✓ tests reaching it within 3 hops: {len(tests)}" + (" — " + ', '.join(x['display'] for x in tests[:5]) + (' …' if len(tests) > 5 else '') if tests else ''))
    say(f"  next: axiomcode search <a name above>   ·   axiomcode impact {r['display']}")
    if BODY:                                                     # one node matched: the body is the context the agent would Read next — print it, bounded
        impl = max(group, key=lambda g: (g['end_line'] or 0) - (g['line'] or 0))
        a, b = impl['line'], impl['end_line'] or impl['line']
        p = os.path.join(REPO, impl['file'])
        if os.path.exists(p) and a:
            lines = open(p, encoding='utf-8', errors='replace').read().split('\n'); cut = b > a + BODY_MAX
            b2 = min(b, a + BODY_MAX, len(lines))
            say(f"  body {impl['file']}:{a}-{b}" + (f"  (first {BODY_MAX} of {b - a + 1} lines; Read {impl['file']}:{a + BODY_MAX + 1}-{b} for the rest)" if cut else ''))
            for i in range(a, b2 + 1): say(f"  {i:5d}  {lines[i - 1]}")
    say()

def uses_of(last, quiet=False):
    """references, literals, comments — grep over what the parser saw"""
    if META.get('ir_present') != 'true':
        if not quiet: say("(references were not indexed: the parser IR was absent when the graph was built)")
        return False
    we = " AND file LIKE ?" if IN else ''; pe = [f"%{IN}%"] if IN else []
    refs = q(f"SELECT file, line FROM refs WHERE name = ?{we} ORDER BY file, line LIMIT 400", last, *pe)
    lits = q(f"SELECT file, line, value FROM literals WHERE (value = ? OR (length(?) >= 4 AND value LIKE ?)){we} ORDER BY file, line LIMIT 60", last, last, f"%{last}%", *pe)
    coms = q(f"SELECT file, line, text FROM comments WHERE text LIKE ?{we} ORDER BY file, line LIMIT 30", f"%{last}%", *pe)
    if not (refs or lits or coms): return False
    by = collections.OrderedDict()
    for r in refs: by.setdefault(r['file'], []).append((r['line'], 'ref', ''))
    for r in lits: by.setdefault(r['file'], []).append((r['line'], 'literal', repr(r['value'][:50])))
    for r in coms: by.setdefault(r['file'], []).append((r['line'], 'comment', r['text'].strip().replace('\n', ' ')[:60]))
    say(f"mentions of '{last}': {len(refs)} references, {len(lits)} literals, {len(coms)} comments in {len(by)} files" + (f" under *{IN}*" if IN else ''))
    for f, ls in sorted(by.items(), key=lambda x: (bool(re.search(r'(^|/)(tests?|test-data|__tests__)(/|$)|\.(spec|test)\.', x[0] or '')), x[0] or '')):
        ls.sort(); row(f"  {f}: " + ', '.join(f"L{l}" + (f" {k} {e}" if k != 'ref' else '') for l, k, e in ls[:10]) + (f" … +{len(ls)-10}" if len(ls) > 10 else ''))
    # the method that contains the most mentions is usually the node to walk from
    top = collections.Counter()
    for f, ls in by.items():
        for l, k, e in ls[:40]:
            for d in q("SELECT display FROM symbols WHERE file=? AND line<=? AND end_line>=? AND method_id IS NOT NULL AND kind<>'module' ORDER BY (end_line-line) LIMIT 1", f, l, l): top[d['display']] += 1
    if top: say("  inside: " + ', '.join(f"{d} ({n})" for d, n in top.most_common(6)) + "   → axiomcode search <one of these>")
    return True

STOP = {'the', 'and', 'for', 'with', 'when', 'that', 'this', 'from', 'into', 'not', 'are', 'was', 'should', 'does', 'have', 'has', 'but', 'its', 'can', 'will', 'all', 'any', 'get', 'set', 'add', 'use', 'new', 'never', 'each', 'every', 'only'}
def words_search(text):
    toks = [t for t in tokens(text) if t not in STOP]
    if not toks: return False
    we, pe = where_extra(None, IN)
    score = collections.defaultdict(lambda: [0, 0, 0]); hits = {}
    for t in toks:
        for r in q(f"SELECT * FROM symbols WHERE lower(name) LIKE ?{we} LIMIT 400", f"%{t}%", *pe):
            k = (r['display'], r['file'], r['line']); hits[k] = r; score[k][0] += 1
        if META.get('ir_present') == 'true':
            for tbl, col, idx in (('comments', 'text', 1), ('literals', 'value', 2)):
                for r in q(f"SELECT file, line FROM {tbl} WHERE lower({col}) LIKE ?{we} LIMIT 300", f"%{t}%", *pe):
                    for d in q("SELECT * FROM symbols WHERE file=? AND line <= ? + 2 AND end_line >= ? AND method_id IS NOT NULL AND kind <> 'module' ORDER BY (end_line-line) LIMIT 1", r['file'], r['line'], r['line']):
                        k = (d['display'], d['file'], d['line']); hits[k] = d; score[k][idx] += 1
    if not hits: return False
    def total(r):
        sc = score[(r['display'], r['file'], r['line'])]; t = sc[0] * 4 + min(sc[1], 3) + min(sc[2], 3)
        return t / 2 if r['is_test'] else t                       # a fixture that mentions every word is not the code that implements it
    ranked = sorted(hits.values(), key=lambda r: (-total(r), r['is_test'], -degree(r)))
    say(f"search {'+'.join(toks)}: {len(hits)} candidate(s), ranked by name hits, then comments and literals in the body, then how connected" + (f" under *{IN}*" if IN else ''))
    for r in ranked[:15]:
        sc = score[(r['display'], r['file'], r['line'])]
        row(fmt(r) + f"   name×{sc[0]} comment×{sc[1]} literal×{sc[2]} edges {degree(r)}")
    say("  next: axiomcode search <one of these> for its neighbourhood")
    return True

def v_search():
    text = ' '.join(pos).strip().strip('"\'')
    if opt.get('type') or opt.get('method'): text = selector()
    if not text:
        # an empty name usually means the shell ate it: search "$ZodCheck" → ""  (double quotes expand $)
        if any(a == '' for a in argv[1:]): say('search got an EMPTY name — a name starting with $ must be single-quoted: axiomcode search \'$ZodCheckGreaterThan\'')
        else: say('search needs something to look for. Give ONE of: a name as written in the code (bar · Foo.bar · file.ts:bar), 3–6 words from the issue in quotes, an error message in quotes, or file:line.')
        return
    m = re.match(r'^(.+?)[: ](\d+)$', text)                                                   # file:line — a hunk or a stack frame
    if m and ('/' in m.group(1) or re.search(r'\.[a-z]{1,4}$', m.group(1))):
        f, ln = m.group(1).lstrip('/'), int(m.group(2))
        rows = q("SELECT * FROM symbols WHERE (file = ? OR file LIKE ?) AND line <= ? AND end_line >= ? AND (method_id IS NOT NULL OR type_id IS NOT NULL) ORDER BY (kind='module'), (end_line - line) LIMIT 2", f, f"%/{f}", ln, ln)
        if not rows:
            infile = q("SELECT count(*) n FROM symbols WHERE file = ? OR file LIKE ?", f, f"%/{f}")[0]['n']
            say(f"no declaration spans {f}:{ln}" + (" — the file is in the graph (top-level code?)" if infile else f" — the file is not in the {LANG} graph")); skipped_note(os.path.basename(f)); return
        say(f"{f}:{ln} is inside:"); set_body(opt.get('body', 'yes') != 'no'); node_card(rows[0]); return
    bare = re.sub(r'<[^>]*>', '<>', text)                                                      # `Outer.<anon Runnable>.run` is a name, not words
    is_words = ' ' in bare and not re.match(r'^[\w.$#:/()<>,\[\]-]+$', bare)
    if not is_words:
        rows, how = resolve(text, None, IN)
        nodes = [r for r in rows if r['method_id'] or r['type_id']]; others = [r for r in rows if not (r['method_id'] or r['type_id'])]
        if nodes and not how.startswith('nearest'):
            GROUP.clear(); merged = []
            for n_ in nodes:
                k = (n_['display'], n_['file'])
                if n_['method_id'] and k in GROUP: GROUP[k].append(n_)
                else: GROUP[k] = [n_]; merged.append(n_)
            nodes = merged
            if len(nodes) > 3:
                say(f"'{text}' → {len(nodes)} declarations ({how}); the 3 most connected in full, then the rest — narrow with in=<path> or Owner.name:")
                for r in nodes[3:15]: row(fmt(r, sig=LANG == 'java'))
                say()
            elif how not in ('exact', 'qualified name') or len(nodes) > 1: say(f"'{text}' → {len(nodes)} by {how}"); say()
            set_body(len(nodes) == 1 and opt.get('body', 'yes') != 'no')
            for r in nodes[:3]: node_card(r)
            if others and len(nodes) <= 3: say("also declared as: " + ', '.join(f"{r['kind']} {r['display']} ({loc(r)})" for r in others[:5]))
            return
        if others and not how.startswith('nearest'):                                            # a constant, field, enum member: where it is, and where it is used
            say(f"'{text}' is not a function or type ({how}):")
            for r in others[:8]: row(fmt(r))
            say(); uses_of(text.split('.')[-1].split('#')[-1], quiet=True); return
        # nothing declared by that name: mentions first (a message, a flag, a tree-sitter node type), then nearest names
        last = text.split('.')[-1].split('#')[-1]
        found = uses_of(last)
        if not found: say(f"nothing declared or mentioned as '{text}' in the {LANG} graph — the name may be guessed, renamed, or in a file this language's graph does not index"); skipped_note(last)
        if rows: say(f"  nearest declarations ({how}):"); [row(fmt(r)) for r in rows[:10]]
        say("  which one did you mean? re-run `search <one of these>`; if none, describe it instead: search \"<3-6 words from the issue>\" — or, for a string you expect in the code, quote it exactly")
        return
    # words that CONTAIN a name — `Elements.before(Node node)`, `toJSONSchema()`, `HttpConnection.Response` — are tried as names first
    named = []
    for cand in dict.fromkeys(re.findall(r'\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+\b|\b[A-Za-z_]\w{2,}(?=\()', text)):
        if cand.lower() in STOP or re.match(r'^\d', cand): continue
        rows, how = resolve(cand, None, IN)
        if rows and how in ('exact', 'qualified name') or how.startswith(('suffix', 'constructor', 'inherited')):
            named += [r for r in rows if r['method_id'] or r['type_id']][:2]
    if named:
        seen_ = set(); named = [r for r in named if not ((r['display'], r['file']) in seen_ or seen_.add((r['display'], r['file'])))]
        say(f"names in the question: " + ', '.join(r['display'] for r in named[:4])); say()
        GROUP.clear(); set_body(len(named) == 1)
        for r in named[:2]: GROUP[(r['display'], r['file'])] = [r]; node_card(r)
    if not words_search(text) and not named:
        say(f"nothing declared, commented or quoted matches '{text}'" + (f" under *{IN}*" if IN else ''))
        say("  try fewer, more specific words (the nouns the code would use, not the symptom), or one identifier from the issue, or in=<dir> to scope it")

def enclosing(f, ln):
    r = q("SELECT * FROM symbols WHERE file=? AND line<=? AND end_line>=? AND method_id IS NOT NULL AND kind<>'module' ORDER BY (end_line-line) LIMIT 1", f, ln, ln)
    return r[0] if r else None
def type_row(display):
    r = q("SELECT * FROM symbols WHERE type_id IS NOT NULL AND (display=? OR display LIKE ?) LIMIT 1", display, f"%.{display}")
    return r[0] if r else None
def is_subtype(sub_tid, sup_tid):
    return sub_tid == sup_tid or bool(q("SELECT 1 FROM type_ancestors WHERE type_id=? AND ancestor_type_id=?", sub_tid, sup_tid))
def group_sites(sites, cap=14):
    """[(file, line, encl_display)] -> lines grouped by file with the methods they fall in"""
    by = collections.OrderedDict()
    for f, ln, enc in sites: by.setdefault(f, collections.OrderedDict()).setdefault(enc or '<top level>', []).append(ln)
    out = 0
    for f, ms in by.items():
        row(f"    {f}: " + '; '.join(f"{m} L{','.join(map(str, ls[:6]))}" + (f"…+{len(ls)-6}" if len(ls) > 6 else '') for m, ls in list(ms.items())[:6]) + (f" … +{len(ms)-6} methods" if len(ms) > 6 else ''))
        out += 1
        if out >= cap: say(f"    … +{len(by)-cap} more files (limit= / in= to see them)"); break

def impact_field(r):
    """a field / constant / enum member: every access, grouped by the method it is in — the collection to change"""
    say(f"impact of changing {r['kind']} {r['display']}   {loc(r)}" + (f"   in {r['owner']}" if r['owner'] else ''))
    if META.get('ir_present') != 'true': say("  (references were not indexed: the parser IR was absent when the graph was built)"); return
    owner = type_row(r['owner']) if r['owner'] else None
    refs = q("SELECT file, line, kind, entity_kind FROM refs WHERE name=? ORDER BY file, line LIMIT 2000", r['name'])
    certain, byname = [], []
    for x in refs:
        if x['file'] == r['file'] and x['line'] == r['line']: continue                      # the declaration itself
        enc = enclosing(x['file'], x['line'])
        if owner and enc and enc['owner'] and (encT := type_row(enc['owner'])) and is_subtype(encT['type_id'], owner['type_id']):
            certain.append((x['file'], x['line'], enc['display']))                         # inside the owner or a subtype: this IS the field
        else: byname.append((x['file'], x['line'], enc['display'] if enc else None))
    say(f"  NOTE: the engine resolves calls, not field accesses — accesses inside {r['owner'] or 'the declaring scope'} (and its subtypes) are certain; the rest match by name only")
    say(f"  accessed inside the owner/subtypes — change these with it ({len(certain)} sites in {len({e for _, _, e in certain})} methods):")
    group_sites(certain)
    if byname:
        say(f"  same name elsewhere — verify the receiver ({len(byname)} sites in {len({f for f, _, _ in byname})} files):")
        group_sites(byname, cap=8)
    if not refs: say("  no reference by that name anywhere in the graph")
    tests = {f for f, _, _ in certain + byname if re.search(r'(^|/)(tests?|test-data|__tests__)(/|$)|\.(spec|test)\.|Tests?\.java$|/src/test/', f or '')}
    if tests: say("  tests that touch it: " + ', '.join(sorted(tests)[:8]) + (' …' if len(tests) > 8 else ''))

def impact_type(r):
    """a class / interface / type: where it is used in declarations, who constructs it, who calls its methods, what extends it"""
    say(f"{r['kind']} {r['display']}   {loc(r)}")
    tid = r['type_id']
    sub = q("SELECT s.display, s.file, s.line, s.end_line, s.kind, s.is_test FROM type_ancestors a JOIN symbols s ON s.type_id=a.type_id WHERE a.ancestor_type_id=? ORDER BY s.is_test, s.file", tid)
    if sub: say(f"  subtypes / implementations ({len(sub)}) — a contract change lands on each: " + ', '.join(f"{x['display']} ({x['file']}:{x['line']})" for x in sub[:10]) + (' …' if len(sub) > 10 else ''))
    mem = q("SELECT display, kind, name, line, method_id FROM symbols WHERE owner=? ORDER BY line", r['display'])
    fields = [m for m in mem if m['kind'] in ('field', 'const', 'enum_member')]; meths = [m for m in mem if m['method_id']]
    say(f"  members: {len(fields)} fields, {len(meths)} methods" + (" — " + ', '.join(m['name'] for m in fields[:12]) if fields else ''))
    # who constructs it, and who calls its methods (resolved edges)
    ctor = q("SELECT cr.display AS caller, cr.file, s.start_line AS line FROM call_edges e JOIN methods me ON me.id=e.callee_method_id JOIN symbols cr ON cr.id=e.caller_id LEFT JOIN call_sites s ON s.id=e.call_site_id WHERE me.owner_type_id=? AND me.kind IN ('CONSTRUCTOR','DEFAULT_CONSTRUCTOR','COMPACT_CONSTRUCTOR','ALLOCATOR') AND e.callee_provenance='client' ORDER BY cr.file", tid)
    if ctor: say(f"  constructed in ({len(ctor)} sites): " + ', '.join(f"{c['caller']} ({c['file']}:{c['line']})" for c in ctor[:8]) + (' …' if len(ctor) > 8 else ''))
    who = q("SELECT cr.display AS caller, cr.file, count(*) AS n FROM call_edges e JOIN methods me ON me.id=e.callee_method_id JOIN symbols cr ON cr.id=e.caller_id WHERE me.owner_type_id=? AND e.callee_provenance='client' AND cr.type_id IS NULL GROUP BY cr.id ORDER BY n DESC", tid)
    if who: say(f"  methods that call its methods ({len(who)}, {len({w['file'] for w in who})} files): " + ', '.join(f"{w['caller']} ({w['n']})" for w in who[:12]) + (' …' if len(who) > 12 else ''))
    # declaration uses, by context — resolved by NAME (the parser leaves the target of a type reference empty)
    tr = q("SELECT file, line, context FROM type_refs WHERE name=? ORDER BY file, line LIMIT 3000", r['name'])
    if tr:
        byc = collections.Counter(x['context'] for x in tr); files = collections.Counter(x['file'] for x in tr)
        say(f"  used in declarations ({len(tr)} places, {len(files)} files; by name — a same-named type elsewhere would be counted): " + ', '.join(f"{c.lower()} {n}" for c, n in byc.most_common(8)))
        say("    files: " + ', '.join(f"{f} ({n})" for f, n in files.most_common(12)) + (f" … +{len(files)-12}" if len(files) > 12 else ''))
        encl = collections.Counter()
        for x in tr:
            e = enclosing(x['file'], x['line'])
            if e: encl[e['display']] += 1
        if encl: say("    inside methods: " + ', '.join(f"{d} ({n})" for d, n in encl.most_common(12)) + (' …' if len(encl) > 12 else ''))
    elif META.get('ir_present') == 'true': say("  no type reference by that name (only calls and subtypes above)")
    inst = q("SELECT count(*) n FROM type_instantiated WHERE type_id=?", tid)[0]['n']
    say(f"  instantiated: {'yes' if inst else 'no — never constructed in this run (dispatch to it cannot happen)'}")

def impact_method(r, to):
    m = r['method_id']; up = edges_up()
    say(f"impact of changing {r['display']}" + (f" {r['signature']}" if r['signature'] and LANG == 'java' else '') + f"   {loc(r)}")
    u = q("SELECT s.start_line, s.callee_name, s.kind FROM unresolved_sites u LEFT JOIN call_sites s ON s.id = u.call_site_id WHERE u.caller_id = ? ORDER BY 1", m)
    # 1. must change if the SIGNATURE changes: every direct caller, by site
    direct = q("SELECT caller, file, line, tier FROM callers WHERE callee_id=? ORDER BY file, line", m)
    byc = collections.OrderedDict()
    for e in direct: byc.setdefault((e['caller'], e['file']), []).append(e['line'])
    say(f"  MUST change if its signature changes — direct callers: {len(direct)} sites in {len(byc)} methods, {len({f for _, f in byc})} files")
    for (c, f), ls in list(byc.items())[:20]: row(f"    {c}   {f}:{','.join(map(str, ls[:8]))}" + (f"…+{len(ls)-8}" if len(ls) > 8 else ''))
    if len(byc) > 20: say(f"    … +{len(byc)-20} methods (limit=N)")
    # 2. may change if the CONTRACT changes: what may run instead of it, what it overrides
    sib = dispatch_of(m)
    if sib:
        say(f"  MAY change if its contract changes — overrides / implementations ({len(sib)}):")
        for s_, why in sib[:10]: row(f"    {s_['display']}   {loc(s_)}   {why}")
    # 3. verify with: tests that reach it, whole graph
    seen = reach([m] + [s_['method_id'] for s_, _ in sib if s_['method_id']], up, 10**6)
    rr = [(d, i) for i, (d, _) in seen.items() if d > 0 and symof(i)]
    tests = sorted(((d, i) for d, i in rr if symof(i)['is_test']), key=lambda x: x[0]); prod = [(d, i) for d, i in rr if not symof(i)['is_test']]
    tfiles = collections.OrderedDict()
    for d, i in tests: tfiles.setdefault(symof(i)['file'], (d, symof(i)['display']))
    if tests:
        tf = list(tfiles.items())
        say(f"  VERIFY with — tests that reach it: {len(tests)} in {len(tf)} file(s), nearest first: " + ', '.join(f"{f} ({sum(1 for _, i in tests if symof(i)['file'] == f)}; {disp} at {d} hops)" for f, (d, disp) in tf[:8])
            + (("; then " + ', '.join(f for f, _ in tf[8:30]) + (f" … +{len(tf)-30} more test files" if len(tf) > 30 else '')) if len(tf) > 8 else ''))
    else: say("  VERIFY with — no test reaches it through resolved edges" + (" (a lower bound: unresolved sites on the way up may hide one)" if q("SELECT 1 FROM unresolved_sites LIMIT 1") else ''))
    # 4. the rest of the closure, by file
    files = collections.Counter(symof(i)['file'] for _, i in prod); byhop = collections.Counter(d for d, _ in prod)
    say(f"  TRANSITIVE — everything that can reach it: {len(prod)} methods in {len(files)} files" + (" (by hop " + ', '.join(f"{d}:{n}" for d, n in sorted(byhop.items())) + ")" if byhop else ''))
    if files: say("    files: " + ', '.join(f"{f} ({n})" for f, n in files.most_common(15)) + (f" … +{len(files)-15}" if len(files) > 15 else ''))
    unres = sum(1 for _, i in prod if unresolved_in(i))
    if u: say(f"  BLIND SPOTS — unresolved calls inside it ({len(u)}): " + ', '.join(f"L{x['start_line']} {x['callee_name'] or x['kind']}" for x in u[:8]) + (' …' if len(u) > 8 else '') + " — every set above is a lower bound")
    if unres: say(f"  {unres} of the transitive methods contain unresolved calls — something reachable only through those is missing")
    if has('entry_points') and q("SELECT count(*) n FROM entry_points")[0]['n']:
        say("  entry reachable: " + ("yes" if q("SELECT 1 FROM entry_reachable WHERE method_id=?", m) else "NO — dead from every known entry, or reachable only through an unresolved call"))
    if to:
        B = [b for b in resolve(to, None, None)[0] if b['method_id']]
        if not B: say(f"  to={to}: no such function")
        else:
            dn = edges_down(); fw = reach([m], dn, 10**6)
            hit = [b for b in B if b['method_id'] in fw]; rhit = [b for b in B if b not in hit and b['method_id'] in seen]
            def show_chain(chain):   # a hop through a dispatch fan is marked: it is one of a set, not a certainty
                return ' → '.join((symof(c)['display'] if symof(c) else c) + ('' if i == 0 or t == 'known_edge' else ' [dispatch]') for i, (c, t) in enumerate(chain))
            for b in hit:
                chain = best_path(m, b['method_id'], dn, True)
                say(f"  path {r['display']} → {b['display']}: {len(chain)-1} hop(s): " + show_chain(chain) + ("   (every hop known_edge)" if all(t == 'known_edge' for _, t in chain[1:]) else "   ([dispatch] = a hop that is one member of a dispatch set)"))
            for b in rhit:
                chain = best_path(b['method_id'], m, dn, True)
                say(f"  {b['display']} reaches {r['display']} in {len(chain)-1} hop(s): " + show_chain(chain))
            if not hit and not rhit: say(f"  no resolved path between {r['display']} and {', '.join(b['display'] for b in B)}; {sum(1 for i in fw if unresolved_in(i))} method(s) it can reach contain unresolved calls — the path may exist through one of those")

def v_impact():
    """what a change touches, as the sets an agent must act on — for a method, a field/constant, or a type"""
    sel = selector(); to = opt.get('to')
    if not sel: say("usage: axiomcode impact <method | Owner.field | Type> [to=<name>] [in=<path>] [limit=N]"); return
    rows, how = resolve(sel, None, IN)
    nodes = [r for r in rows if r['method_id'] or r['type_id'] or r['kind'] in ('field', 'const', 'variable', 'enum_member')]
    if not nodes:
        say(f"nothing named '{sel}' in the {LANG} graph"); skipped_note(sel.split('.')[-1])
        if rows: say(f"  nearest ({how}):"); [row(fmt(r)) for r in rows[:8]]
        say("  which one did you mean? re-run `impact <one of these>`")
        return
    if len(nodes) > 5:
        say(f"'{sel}' is ambiguous ({len(nodes)} {how} matches) — pick one with in=<path>, Owner.name" + (" or a signature m(int,String)" if LANG == 'java' else '') + ":")
        [row(fmt(r, sig=True)) for r in nodes[:12]]; return
    if how not in ('exact', 'qualified name') or len(nodes) > 1: say(f"'{sel}' → {len(nodes)} by {how}"); say()
    GROUP.clear()
    for r in nodes:
        if r['method_id']: impact_method(r, to)
        elif r['type_id']: impact_type(r)
        else: impact_field(r)
        say()

VERBS = {'search': v_search, 'impact': v_impact}
if verb not in VERBS:
    if verb not in OPT_KEYS and not verb.startswith('-'): pos.insert(0, verb); verb = 'search'      # `axiomcode Foo.bar` means search
    else: print(__doc__.strip()); sys.exit(2)
VERBS[verb](); flush()
