// What $M can run, transitively, through resolved client edges up to $DEPTH hops, with the count of
// unresolved sites inside each — the forward closure blast_radius is the reverse of.
.decl sound(caller:symbol, callee:symbol)
sound(c, t) :- call_edges(_, c, t, _, "client", tier, _), t != "", (tier = "known_edge" ; tier = "multi_inferred").
.decl reach(m:symbol, d:number)
reach("$M", 0).
reach(t, d+1) :- reach(c, d), sound(c, t), d < $DEPTH.
.decl transitive_callees(m:symbol, depth:number, unresolved_inside:number)
transitive_callees(m, d, u) :- reach(m, d), d = min x : reach(m, x), d > 0, u = count : unresolved_sites(m, _).
.output transitive_callees
