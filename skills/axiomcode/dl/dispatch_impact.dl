// Impact of changing $M INCLUDING dispatch: a call that resolves to a base may run any candidate the
// engine admitted, so changing one implementation affects every site typed at the base or at a sibling.
// The envelope comes from the ENGINE — dispatch_candidates (basis nominal/structural/mro) where the bundle
// has it, else overrides (Java, nominal only) — never from a name match. Depth $DEPTH.
.decl sound(caller:symbol, callee:symbol)
sound(c, t) :- call_edges(_, c, t, _, "client", tier, _), t != "", (tier = "known_edge" ; tier = "multi_inferred").
.decl related(a:symbol, b:symbol)
// the engine's envelope: dispatch_candidates where the bundle has it (all languages), overrides (Java) otherwise
related(b, c) :- dispatch_candidates(b, c, _).
related(c, b) :- dispatch_candidates(b, c, _).
related(b, c) :- dispatch_candidates(x, b, _), dispatch_candidates(x, c, _), b != c.
related(b, c) :- overrides(b, c).
related(c, b) :- overrides(b, c).
related(b, c) :- overrides(x, b), overrides(x, c), b != c.
.decl envelope(m:symbol)
envelope("$M").
envelope(s) :- related("$M", s).
.decl reach(m:symbol, d:number)
reach(s, 0) :- envelope(s).
reach(c, d+1) :- reach(t, d), sound(c, t), d < $DEPTH.
.decl dispatch_impact(m:symbol, depth:number, unresolved_inside:number)
dispatch_impact(m, d, u) :- reach(m, d), d = min x : reach(m, x), d > 0, u = count : unresolved_sites(m, _).
.output envelope
.output dispatch_impact
