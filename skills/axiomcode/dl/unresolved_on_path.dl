// The blind spots along the impact set of $M: methods within $DEPTH resolved hops that contain call
// sites the engine could NOT resolve, with the site's written callee and its syntactic kind.
// Any "nothing else is affected" claim about $M is bounded by these rows.
.decl sound(caller:symbol, callee:symbol)
sound(c, t) :- call_edges(_, c, t, _, "client", tier, _), t != "", (tier = "known_edge" ; tier = "multi_inferred").
.decl reach(m:symbol, d:number)
reach("$M", 0).
reach(c, d+1) :- reach(t, d), sound(c, t), d < $DEPTH.
.decl unresolved_on_path(m:symbol, written:symbol, kind:symbol)
unresolved_on_path(m, w, k) :- reach(m, _), unresolved_sites(m, s), call_sites(s, _, k, w, _, _, _, _, _).
.output unresolved_on_path
