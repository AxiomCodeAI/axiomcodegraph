// Everything an agent should have in front of it before editing $M, in one query:
//   role = "callee"     what $M calls (resolved)            role = "caller"  what calls $M
//   role = "dispatch"   siblings a base-typed call may run   role = "test"    tests reaching $M in 3 hops
//   role = "unresolved" a call inside $M the engine could not resolve (the caveat on all of the above)
.decl sound(caller:symbol, callee:symbol)
sound(c, t) :- call_edges(_, c, t, _, "client", tier, _), t != "", (tier = "known_edge" ; tier = "multi_inferred").
.decl up(m:symbol, d:number)
up("$M", 0).
up(c, d+1) :- up(t, d), sound(c, t), d < 3.
.decl change_context(role:symbol, m:symbol, detail:symbol)
change_context("callee", t, "") :- sound("$M", t).
change_context("caller", c, "") :- sound(c, "$M").
change_context("dispatch", s, cat("may run instead: ", basis)) :- dispatch_candidates("$M", s, basis).
change_context("dispatch", b, "base this overrides") :- dispatch_candidates(b, "$M", _).
change_context("dispatch", s, "override") :- overrides("$M", s).
change_context("dispatch", b, "base this overrides") :- overrides(b, "$M").
change_context("test", m, "") :- up(m, d), d > 0, is_test(m).
change_context("unresolved", "$M", w) :- unresolved_sites("$M", s), call_sites(s, _, _, w, _, _, _, _, _).
.output change_context
