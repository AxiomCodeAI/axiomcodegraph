// SCHEMA blast_radius, as Datalog: methods transitively affected if $M changes, through RESOLVED
// client edges only (known_edge, multi_inferred) up to $DEPTH hops — and, for each, how many call
// sites INSIDE it the engine could not resolve. A row with unresolved > 0 is where the answer stops
// being complete: something that method calls is unknown, so something that depends on $M may be missing.
.decl sound(caller:symbol, callee:symbol)
sound(c, t) :- call_edges(_, c, t, _, "client", tier, _), t != "", (tier = "known_edge" ; tier = "multi_inferred").
.decl reach(m:symbol, d:number)
reach("$M", 0).
reach(c, d+1) :- reach(t, d), sound(c, t), d < $DEPTH.
.decl blast_radius(m:symbol, depth:number, unresolved_inside:number)
blast_radius(m, d, u) :- reach(m, d), d = min x : reach(m, x), d > 0, u = count : unresolved_sites(m, _).
.output blast_radius
