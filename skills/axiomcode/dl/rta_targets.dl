// Which of the possible targets of calls to $M's name can actually run, by rapid type analysis: a
// multi_inferred set member whose owner type is never instantiated in this run cannot receive the call.
// Reports every multi_inferred target at sites that resolve to $M, marked live (owner instantiated) or
// dead (owner never constructed). This is the narrowing the engine deliberately does NOT apply itself.
.decl site_of(site:symbol)
site_of(s) :- call_edges(s, _, "$M", _, "client", _, _).
.decl candidate(t:symbol, owner:symbol)
candidate(t, o) :- site_of(s), call_edges(s, _, t, _, "client", "multi_inferred", _), t != "", methods(t, _, _, _, _, o, _, _, _, _, _), o != "".
.decl rta_targets(t:symbol, owner:symbol, status:symbol)
rta_targets(t, o, "live") :- candidate(t, o), type_instantiated(o, _).
rta_targets(t, o, "dead: owner never instantiated") :- candidate(t, o), !type_instantiated(o, _).
.output rta_targets
