.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.keystore
credentials.json
secrets.json
.npmrc
.netrc

# ── Logs & diagnostics ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
profile-*
*.cpuprofile
*.heapsnapshot

# ── Test & coverage output ───────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
.jest-cache/
junit.xml
test-results/

# ── Tool caches ──────────────────────────────────────────────────────────────
.cache/
.npm/
.eslintcache
.stylelintcache
.node_repl_history
.tsc-alias-cache/
*.tgz

# ── Claude Code / agent local state ──────────────────────────────────────────
# .claude/agents/*.md are project source and stay tracked; personal settings,
# session state, and agent scratch output do not.
.claude/
CLAUDE.local.md

# ── Editor & IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
.history/
*.swp
*.swo
*~
.\#*
\#*\#

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Icon?
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.nfs*

# ── Safety net: never ignore engine source ───────────────────────────────────
!src/**/*.ts
!src/**/*.dl
!src/**/*.sh
!src/souffle/export_manifest.tsv
!src/templates/*.map

# ── Safety net: a fixture's INPUTS are enforced, not enumerated ──────────────
# An earlier draft of this listed every source extension under every fixture directory.
# That list is unmaintainable and was already wrong: it covered `fixtures/` but not
# `cases/`, and a negation broad enough to cover both would also have re-included the
# per-run work directories, which is how 122 generated files were committed once before.
#
# So the rules above stay narrow and `test/tools/no-ignored-fixtures.sh` enforces the
# invariant directly: it fails the suite if any file present under test/ is ignored, and
# if any vendored package's declared `types` is missing from the index. A guard that
# checks the property beats a pattern list that tries to anticipate it.

# ── Java engine test suite: per-run work dirs and the generated JDK index ─────
test/java/.work/

# Python bytecode from the test tools
__pycache__/
*.pyc

# fixture harness work directories (generated per run). The plain `.work/` is the one
# run-tests.sh itself uses; the `.work-*` variants are the fixtures'. Only the latter was
# listed, so every run of the TypeScript suite left an untracked directory behind.
test/typescript/.work/
test/typescript/.work-*/
