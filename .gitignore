# ── Safety net: never ignore engine source ───────────────────────────────────
!src/**/*.ts
!src/**/*.dl
!src/**/*.sh
!src/souffle/export_manifest.tsv
!src/templates/*.map

# ── Safety net: a fixture's INPUTS are enforced, not enumerated ──────────────
# An earlier draft of this listed every source extension under every fixture directory.
# That list is unmaintainable and was already wrong: it covered `fixtures/` but not
# `cases/`, and a negation broad enough to cover both would also have re-included the
# per-run work directories, which is how 122 generated files were committed once before.
#
# So the rules above stay narrow and `test/tools/no-ignored-fixtures.sh` enforces the
# invariant directly: it fails the suite if any file present under test/ is ignored, and
# if any vendored package's declared `types` is missing from the index. A guard that
# checks the property beats a pattern list that tries to anticipate it.

# A work directory at the REPOSITORY ROOT, which the per-suite lines below do not
# cover. Scratch written there is measurement scaffolding: run scripts, corpus
# outputs and issue drafts, which routinely carry absolute paths to a machine and to
# whatever corpus was measured. `git add -A` from the root stages all of it, and a
# commit-message guard cannot catch it because the leak is in the FILE, not the
# message. Ignored here so the safe habit is the default one.
.work/

# ── Java engine test suite: per-run work dirs and the generated JDK index ─────
graph/test/java/.work/

# Python bytecode from the test tools
__pycache__/
*.pyc

# fixture harness work directories (generated per run). The plain `.work/` is the one
# run-tests.sh itself uses; the `.work-*` variants are the fixtures'. Only the latter was
# listed, so every run of the TypeScript suite left an untracked directory behind.
graph/test/typescript/.work/
graph/test/typescript/.work-*/
graph/test/javascript/.work/
# the torture and realapp harnesses' own per-run work directories (217 generated files of
# them were committed with the engine and rewritten by every run)
graph/test/javascript/torture/.work/
graph/test/javascript/realapp/.work/

# the one-command pipeline keeps its IR and scratch here
.intermediate/

# lock files are not committed: the engine is not published as a locked artifact, and two
# workspaces' locks drifted on every parser sync
package-lock.json
# A JavaScript fixture dependency is a real package under node_modules — that is the shape
# the parser resolves and the shape the library join is written for.
!graph/test/javascript/cases/*/src/node_modules/
graph/test/*/.work-skill/
__pycache__/

# C# engine dev scratch: compiled binaries and staged facts from run-tests.sh / devrun.sh
.cs-case-work/
.cs-dev-cache/

# evaluation graders: run locally, never shipped in the plugin
plugins/axiomcode/validate/

# agent working notes: local only, never in the repo
CLAUDE.md
AGENTS.md
.claude/
.cursor/
.codex/
.copilot/
.agents/
